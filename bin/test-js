#!/usr/bin/env bash
# Run every test/js/*.test.mjs in its own `node --test` process.
#
# Why: `node --test test/js/*.test.mjs` in one invocation intermittently dies with
# "Unable to deserialize cloned data" (runner IPC between the parent and its
# per-file child). One process per file cuts the failure rate but does not remove
# it on Node 18: the cause is test children that log a lot to stdout (the engine
# code under test console.logs emoji-heavy multi-line text), which the Node 18
# runner occasionally mis-frames. Silencing console.log made
# event-mapping-unlock-door fail 0/12 runs against 2/12 unsilenced.
# So a file whose log contains that exact runner error is re-run, up to
# TEST_JS_RETRIES times (default 3 attempts). Any other failure is final and the
# retry is reported as "PASS (runner IPC retry n)", never hidden.
#
# Usage: bin/test-js [-j N] [-v] [file ...]
#   -j N   files to run at once (default: $TEST_JS_JOBS, else 4)
#   -v     print the output of passing files too (failures are always printed)
#   file   test files to run (default: test/js/*.test.mjs)
# Exit status: 0 if every file passed, 1 if any failed.
set -uo pipefail
cd "$(dirname "$0")/.."

jobs=${TEST_JS_JOBS:-4}
verbose=0
while getopts "j:v" opt; do
  case $opt in
    j) jobs=$OPTARG ;;
    v) verbose=1 ;;
    *) echo "usage: bin/test-js [-j N] [-v] [file ...]" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

if [ $# -gt 0 ]; then files=("$@"); else files=(test/js/*.test.mjs); fi

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
export out

run_one() {
  f=$1
  b=$(basename "$f")
  start=$(date +%s)
  attempt=1
  while :; do
    node --test "$f" >"$out/$b.log" 2>&1
    code=$?
    if [ "$code" -ne 0 ] && [ "$attempt" -lt "${TEST_JS_RETRIES:-3}" ] \
       && grep -q "Unable to deserialize cloned data" "$out/$b.log"; then
      attempt=$((attempt + 1)); continue
    fi
    break
  done
  echo "$code $(( $(date +%s) - start ))" >"$out/$b.status"
  note=""; [ "$attempt" -gt 1 ] && note=" (runner IPC retry, $attempt attempts)"
  if [ "$code" -eq 0 ]; then echo "PASS  $b$note"; else echo "FAIL  $b (exit $code)$note"; fi
}
export -f run_one

echo "Running ${#files[@]} files, $jobs at a time"
printf '%s\0' "${files[@]}" | xargs -0 -n1 -P "$jobs" bash -c 'run_one "$0"'

pass=0; fail=0; failed=()
for f in "${files[@]}"; do
  b=$(basename "$f")
  read -r code _ <"$out/$b.status" 2>/dev/null || code=missing
  if [ "$code" = 0 ]; then
    pass=$((pass + 1))
    [ "$verbose" -eq 1 ] && { echo "=== $b"; cat "$out/$b.log"; }
  else
    fail=$((fail + 1)); failed+=("$b")
    echo "=== FAILED: $b"; cat "$out/$b.log" 2>/dev/null
  fi
done

echo
echo "Files: $pass passed, $fail failed, ${#files[@]} total"
if [ "$fail" -gt 0 ]; then printf 'Failed: %s\n' "${failed[*]}"; exit 1; fi
