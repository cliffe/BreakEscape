            ],
            "default": "open"
          },
          {
            "id": "pp_systems",
            "label": "Don't name internal systems; take down the reposted job advert",
            "closesFacts": [
              "se_intel_df_system"
            ],
            "default": "open"
          },
          {
            "id": "pp_photos",
            "label": "Check the background before posting; crop out badges and screens, and turn off location tags",
            "closesFacts": [
              "se_intel_df_badge"
            ],
            "default": "open"
          },
          {
            "id": "pp_security_answer",
            "label": "Use a made-up security-question answer kept in your password manager, not your real pet's name",
            "closesFacts": [
              "se_intel_df_pet"
            ],
            "default": "open"
          }
        ],
        "note": "Each switch closes one of the things an attacker could piece together about you from a public profile. Tighten these on your own profile."
      }
    },
    "intelFacts": {
      "df_profile": {
        "text": "Your profile shows your employer, your team and your manager's name, there for anyone to read.",
        "reduceNote": "Lock your profile down: an attacker reads your employer, team and manager straight off a public profile."
      },
      "df_system": {
        "text": "A job advert you shared names one of the firm's internal systems.",
        "reduceNote": "Don't name internal systems, security tools or suppliers; a hiring post can give one away."
      },
      "df_badge": {
        "text": "A 'new kit' photo has your lanyard and a whiteboard in shot.",
        "reduceNote": "No badge, pass or screen in a photo; check what's behind you before you post."
      },
      "df_leave": {
        "text": "A leave countdown says you're away all next week.",
        "reduceNote": "Keep leave private: 'away all week' tells an attacker when to strike and who's covering."
      },
      "df_pet": {
        "text": "A dog photo, captioned as a 'name a pet' answer, gives your pet's name, a common security-question answer.",
        "reduceNote": "Keep pet, school, birthday and first car out of public view; use a made-up security answer kept in your manager."
      }
    },
    "awareness": {
      "ruleOfThumb": {
        "heading": "The habit to keep",
        "text": "When a message pressures you to move money, grant access, sign in or read back a code, stop and check it yourself through a route you already trust, not the link, number or page the message gives you. Taking a minute to confirm is always a fair thing to do."
      }
    }
