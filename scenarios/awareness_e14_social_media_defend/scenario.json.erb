        "scored": false,
        "strings": {
          "title": "Post or Not?",
          "heading": "Post, Tweak or Hold?",
          "intro": "Each card is a draft post. Decide whether to Post it, Tweak it first, or Hold it back. The reason shows straight after.",
          "teach": "Suggested: {bin}.",
          "teachFits": "That works.",
          "finish": "See where they went",
          "summaryHeading": "Where the drafts went"
        },
        "cards": [
          {
            "id": "e14_feed_lanyard",
            "situation": "A selfie for your work anniversary, with your lanyard and pass clearly in shot.",
            "answer": "tweak",
            "reason": "Lovely photo. Crop or blur the pass first: a badge in a photo helps someone copy it or tailgate in."
          },
          {
            "id": "e14_feed_system",
            "situation": "'Buried in the new finance system this week but getting there!'",
            "answer": "hold",
            "reason": "Hold this: naming an internal system tells an attacker exactly which pretext to use. Keep the system out of it."
          },
          {
            "id": "e14_feed_whiteboard",
            "situation": "A team photo at your desks, with a whiteboard of client names and go-live dates behind you.",
            "answer": "tweak",
            "reason": "Post the people, not the whiteboard. Client names and dates in the background are a free briefing for anyone watching."
          },
          {
            "id": "e14_feed_leave",
            "situation": "'Two weeks off from Friday, can't wait. House-sitter sorted, cat's in charge.'",
            "answer": [
              "tweak",
              "hold"
            ],
            "reason": "'Away for two weeks' tells work who is short-staffed and tells strangers the house is empty. Tweak it (drop the dates) or hold it until you're back."
          },
          {
            "id": "e14_feed_pet",
            "situation": "A photo of your dog on a walk, posted to connections only, no work or location in it.",
            "answer": "post",
            "reason": "This one's fine: no work details, no badge, no location, and your audience is set to people you know. Post away."
          },
          {
            "id": "e14_feed_screen",
            "situation": "A 'my desk setup' photo with your monitor on, email and a client file open on screen.",
            "answer": "tweak",
            "reason": "Turn the screen off or angle it away first. An open inbox or document in shot can leak names, subjects and even a meeting link."
          },
          {
            "id": "e14_feed_school",
            "situation": "Your child's first-day photo, tagging the school by name and location.",
            "answer": "tweak",
            "reason": "Post the moment, drop the tag. A school name is a common security-question answer and tells strangers where your child is each morning."
          }
        ]
      },
      "privacyPanel": {
        "settings": [
          {
            "id": "pp_profile",
            "label": "Set your profile and work details (employer, team, manager) to connections only",
            "closesFacts": [
