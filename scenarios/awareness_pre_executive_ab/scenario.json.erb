              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "merrinsallow.example",
              "replyTo": "yasmin.chaudhry@merrinsallow.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "default": "Yasmin's real address, a routine change, and it points you to the intranet you already use. It asks for nothing."
              }
            }
          },
          {
            "id": "ea_larkspur_invoice",
            "from": {
              "name": "Larkspur Travel",
              "address": "invoices@larkspurtravel.example"
            },
            "to": "tomas.carvalho@merrinsallow.example",
            "subject": "Invoice LT-5528: Milan, partners' trip",
            "time": "08:40",
            "body": "Dear Tomás,\nPlease find attached invoice LT-5528 for the partners' Milan trip, payable on the usual 30-day terms to the account on file.\nKind regards,\nLarkspur Travel",
            "attachments": [
              {
                "label": "LT-5528.pdf",
                "kind": "pdf"
              }
            ],
            "auth": {
              "spf": "fail",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "mailer.bookingsuite.example",
              "replyTo": "invoices@larkspurtravel.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "senderAuth": "Larkspur sends its invoices through a booking service rather than its own mail system, so one automatic sender check didn't line up. The address is still Larkspur's real domain, which is what matters.",
                "attachmentPlausible": "An invoice PDF for a trip you booked is what you'd expect.",
                "default": "Larkspur's real domain, a trip you booked, and payment to the account on file. Nothing has changed."
              },
              "headerNote": "One check failing on its own is a clue, not proof. Mail sent through another company's service often trips one of these checks while the rest still pass."
            }
          },
          {
            "id": "ea_larkspur_bank",
            "from": {
              "name": "Larkspur Travel",
              "address": "accounts@larkspur-travel.example"
            },
            "to": "tomas.carvalho@merrinsallow.example",
            "subject": "Milan booking LT-5528: our bank details have changed",
            "time": "09:10",
            "body": "Dear Tomás,\nPlease note that we have moved to a new bank. Invoice LT-5528 for the partners' Milan trip should now be paid to:\nAccount name: Larkspur Travel Ltd\nAccount number ending 6150\nPlease update your records before payment.\nKind regards,\nLarkspur Travel Accounts",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "bounce.larkspur-travel.example",
              "replyTo": "accounts@larkspur-travel.example"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "lookalike_domain",
                "changed_bank_details",
                "senderTrust"
              ],
              "perFlagNote": {
                "lookalike_domain": "Larkspur's real domain is larkspurtravel.example. This is larkspur-travel.example, with an added hyphen",
                "changed_bank_details": "New bank details on an open invoice is the commonest invoice-fraud move. The safe step is to ring Larkspur on the number you already hold",
                "senderTrust": "The name says Larkspur, but the address is on larkspur-travel.example, which isn't Larkspur's"
              },
              "headerNote": "All three checks passed because the sender owns larkspur-travel.example. A pass tells you which domain sent it, not that it's Larkspur.",
              "ifTrusted": "The Milan payment would go to an account the sender controls.",
              "reportReply": "Thanks. Larkspur haven't changed bank, and that domain isn't theirs."
            }
          },
          {
            "id": "ea_gift_cards",
            "from": {
              "name": "Catherine Merrin",
              "address": "catherine.merrin.personal@quickpost-mail.example"
            },
            "to": "tomas.carvalho@merrinsallow.example",
            "subject": "Quick favour before 11, keep it quiet",
            "time": "09:35",
            "body": "Tomás,\nI'm in back-to-back meetings. Could you buy eight £100 gift cards for the Brackenmoor team as a thank-you, and send me the codes by email before 11? Keep it a surprise, so don't mention it to anyone, Yasmin included. I'll pay you back.\nCatherine\nSent from my phone",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "quickpost-mail.example",
              "replyTo": "catherine.merrin.personal@quickpost-mail.example"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "senderTrust",
                "secrecy_or_bypass",
                "urgencyCalibrated"
              ],
              "perFlagNote": {
                "senderTrust": "The managing partner's name on a personal inbox at quickpost-mail.example, not merrinsallow.example",
                "secrecy_or_bypass": "'Don't mention it to anyone, Yasmin included' keeps out the person who would check",
                "urgencyCalibrated": "'Before 11' while she's in meetings leaves no time to ask her"
              },
              "headerNote": "All three checks passed because the sender owns quickpost-mail.example. A pass tells you which domain sent it, not that it's Catherine.",
              "ifTrusted": "Gift card codes can be spent at once by whoever has them. £800 would be gone.",
              "reportReply": "Thanks. Catherine didn't send it, and her real address is on merrinsallow.example."
            }
          },
          {
            "id": "ea_vm_tunnel",
            "kind": "voicemail",
            "from": {
              "name": "Catherine Merrin",
              "address": "07700 900582 (not in your contacts)"
            },
            "subject": "Voicemail from Catherine Merrin",
            "time": "10:02",
            "duration": "0:21",
            "audio": {
              "clipId": "VO7_ea_vm_tunnel"
            },
            "transcript": [
              {
                "who": "Catherine",
                "text": "Tomás, it's Catherine, I'm on a borrowed phone, mine's dead. I need the Brackenmoor deposit sent today, I'm texting you the account now. It's a sensitive one, so keep it off the finance list for now. I'm going into a tunnel, so don't ring back. Thanks."
              }
            ],
            "truth": {
              "isPhish": true,
              "flags": [
                "vish_callback_pressure",
                "secrecy_or_bypass"
              ],
              "perFlagNote": {
                "vish_callback_pressure": "A number that isn't in your contacts, a 'dead' phone and 'don't ring back': every route to check it on her real number is closed off",
                "secrecy_or_bypass": "'Keep it off the finance list' skips the people who would check the payment"
              },
              "ifTrusted": "The deposit would go to whatever account the text names, and the sender would have it.",
              "reportReply": "Thanks. We rang Catherine on her own mobile: her phone was fine and she hadn't called. The voice sounded like hers, which is why the number and the request matter more."
            }
          },
          {
            "id": "ea_card_spoof",
            "from": {
              "name": "Yasmin Chaudhry",
              "address": "yasmin.chaudhry@merrinsallow.example"
