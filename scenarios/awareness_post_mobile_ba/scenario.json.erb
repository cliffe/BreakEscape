          "unexpected_qr",
          "smish_shortlink_urgency",
          "reply_stop_trick",
          "lookalike_domain",
          "secrecy_or_bypass",
          "reply_to_differs"
        ],
        "outcome": {
          "setGlobalPrefix": "triage_{stage}_",
          "passPercent": 0
        },
        "messages": [
          {
            "id": "ma_ev_charging_pay",
            "kind": "qr",
            "subject": "EV charging: scan to pay",
            "body": "New payment system for the staff charging bays. Scan to register your card. Vehicles left charging without registering will be clamped from Monday.",
            "qr": {
              "destination": "https://tarrowby-charging.example/pay",
              "location": "Stuck to the charger post in the staff car park"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "unexpected_qr",
                "lookalike_domain"
              ],
              "perFlagNote": {
                "unexpected_qr": "A sticker on a charger asking for card details is where a fake code is easiest to place and hardest to check",
                "lookalike_domain": "tarrowby-charging.example is not Tarrowby's domain; the added word makes it someone else's site"
              },
              "ifTrusted": "The page would collect your card details for a charging fee that doesn't exist.",
              "reportReply": "Thanks. Staff charging is free and has no sticker. We've removed it."
            }
          },
          {
            "id": "ma_ev_charging_guide",
            "kind": "qr",
            "subject": "EV charging bays: how to use them",
            "body": "Charging is free for staff. Plug in and tap your staff pass on the reader. Scan for the full guide and the booking rota.",
            "qr": {
              "destination": "https://facilities.tarrowby.example/ev-charging",
              "location": "Laminated sign in a wall holder beside the charging bays",
              "caption": "Questions: Eilidh Strachan, Facilities, ext. 2210"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "unexpected_qr": "The code goes to facilities.tarrowby.example, Tarrowby's own domain, and the sign asks for no card and no password.",
                "lookalike_domain": "facilities.tarrowby.example is a page on the real domain.",
                "default": "A fixed sign from Facilities with a named contact, a guide rather than a payment, and Tarrowby's real domain behind the code."
              }
            }
          },
          {
            "id": "ma_pool_van",
            "kind": "sms",
