{
  "scenario_brief": "TEST: Access model doors\n\nA test floor for card doors with access lists (ACCESS_MODEL_PLAN.md, step 7). Five beats, each with a sign. D1: the visitor room (off the IT lobby) wants the visitor card on the front desk. D2: copy Dana's badge in conversation; the finance office and its cabinet open for finance staff. D3: borrow Ian's spare badge, copy it from your inventory; the server room opens for IT staff. D4: copy Priya's DESFire badge; the CCTV room takes a UID-only copy, the evidence store does not. D5: copy Gary's plant room card, which Imran carries too; the plant room opens for Imran only. Take the card copier from the lobby table first (after D1).",
  "endGoal": "Test only: run the five door beats.",
  "startRoom": "lobby",
  "startPosition": { "x": 7, "y": 7 },
  "npcNeedsSeed": "test_access_doors",
  "npcWindupMs": 0,
  "needsDebugOverlay": true,

  "globalVariables": {
    "d4_cctv_open": false,
    "d4_evidence_refused": false
  },

  "objectives": [
    {
      "aimId": "door_beats",
      "title": "Run the door beats",
      "description": "Test only. Each task ticks when its beat's lock opens (D4: when both of its doors have answered).",
      "status": "active",
      "order": 0,
      "tasks": [
        { "taskId": "d1_fallback", "title": "D1: open the visitor room with the visitor card", "type": "custom", "status": "active" },
        { "taskId": "d2_copy_in_conversation", "title": "D2: open the finance office and its cabinet with a copy of Dana's badge", "type": "custom", "status": "active" },
        { "taskId": "d3_copy_from_keycard", "title": "D3: open the server room after copying Ian's spare badge", "type": "custom", "status": "active" },
        { "taskId": "d4_uid_only", "title": "D4: CCTV room opens, evidence store refuses the UID-only copy", "type": "custom", "status": "active" },
        { "taskId": "d5_shared_card", "title": "D5: open the plant room with a copy of Gary's card", "type": "custom", "status": "active" }
      ]
    }
  ],

