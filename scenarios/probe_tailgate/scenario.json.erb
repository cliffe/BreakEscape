{
  "scenario_id": "probe_tailgate",
  "scenario_name": "Probe: Tailgate Gate Door",
  "scenario_brief": "Throwaway engine probe for gate doors (systems/door-gates.js), the near-sight challenge and multi-room routes with an unlock action. Not a mission.",
  "endGoal": "Engine probe only.",
  "startRoom": "probe_a",
  "globalVariables": {
    "disguised": false
  },
  "rooms": {
    "probe_a": {
      "type": "room_reception",
      "door_sign": "Probe A",
      "connections": { "north": "probe_b" },
      "doors": [
        { "connectedRoom": "probe_b", "direction": "north",
          "gate": { "openFor": ["guard"], "openRadius": 56, "holdMs": 2500, "playerMayPassIf": "disguised" } }
      ],
      "npcs": [
        {
          "id": "guard",
          "displayName": "Probe Guard",
          "npcType": "person",
          "position": { "x": 4, "y": 5 },
          "spriteSheet": "female_security_guard_v2",
          "storyPath": "scenarios/probe_tailgate/ink/probe_guard.ink.json",
          "currentKnot": "start",
          "los": {
            "enabled": true, "range": 200, "angle": 120,
            "challengeOnSight": {
              "event": "player_in_view_near:guard",
              "near": { "door": "probe_b", "radius": 64 },
              "skipIfGlobal": "disguised",
              "cooldown": 8000,
              "rooms": ["probe_a", "probe_b"]
            }
          },
          "behavior": {
            "patrol": {
              "enabled": true,
              "speed": 80,
              "multiRoom": true,
              "pauseForPlayer": false,
              "waypointMode": "sequential",
              "route": [
                { "room": "probe_a", "waypoints": [
                  { "x": 5, "y": 6 },
                  { "x": 2, "y": 2, "dwellTime": 600, "action": { "unlockRoom": "probe_b" },
                    "_comment": "Door-side, inside the gate's openRadius: a shut gate blocks the path grid, so each room's last waypoint must be where the gate opens for him" }
                ] },
                { "room": "probe_b", "waypoints": [
                  { "x": 5, "y": 4 },
                  { "x": 2, "y": 8, "dwellTime": 400 }
                ] }
              ]
            }
          },
          "eventMappings": [
            {
              "eventPattern": "player_in_view_near:guard",
              "conversationMode": "person-chat",
              "targetKnot": "tailgate_warning",
              "closeDoor": "probe_b",
              "cooldown": 8000
            },
            {
              "_comment": "Never fires: lets the server accept this guard's route-action unlock of probe_b (game.rb npc_mapping_unlocks_door?).",
              "eventPattern": "probe_tailgate_never_fires",
              "unlockDoor": "probe_b"
            }
          ]
        }
      ],
      "objects": []
    },
    "probe_b": {
      "type": "room_office",
      "door_sign": "Probe B",
      "locked": true,
      "lockType": "key",
      "requires": "probe_b_key",
      "connections": { "south": "probe_a" },
      "objects": []
    }
  }
}
