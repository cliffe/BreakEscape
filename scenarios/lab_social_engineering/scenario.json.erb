{
  "scenario_id": "lab_social_engineering",
  "scenario_name": "Phishing and Social Engineering",
  "scenario_brief": "Tarnside Assurance has been hired to test Ledgerwell Ltd. Research the company from public sources, craft spear-phishing email, build a look-alike login page, work a pretext call to the service desk, write the report with no names in it, then turn round and defend against your own attack.",
  "endGoal": "Run the Ledgerwell engagement end to end and hand Tomasz a clean defender profile.",
  "version": "1.0",
  "show_scenario_brief": "on_resume",
  "disableAttacks": true,
  "creditsTheme": "cyber",
  "startRoom": "engagement_office",

  "gameClock": { "start": "Mon 08:00" },

  "player": {
    "id": "player",
    "displayName": "Consultant",
    "spriteSheet": "female_hacker_hood_v2",
    "spriteTalk": "assets/characters/female_hacker_hood_talk.png",
    "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 12 }
  },

  "startItemsInInventory": [
    { "type": "phone", "name": "Your phone", "takeable": true, "phoneId": "player_phone",
      "npcIds": ["ruth_phone"], "observations": "Your work phone, with Ruth on speed dial for a nudge when you are stuck." }
  ],

  "objectives": [
    {
      "aimId": "authorise",
      "title": "Get it in writing",
      "description": "Read the rules of engagement and settle what is in and out of scope before you touch anything.",
      "status": "active",
      "order": 0,
      "tasks": [
        { "taskId": "scope_cards", "title": "Sort the scope cards on the RoE sheet", "type": "manual", "status": "active" },
        { "taskId": "stop_rule", "title": "Answer the stop-rule, then get Gareth to sign", "type": "manual", "status": "active" }
      ]
    },
    {
      "aimId": "plan",
      "title": "Plan the engagement",
      "description": "Decide your objective and the measure you will report against, before you send anything.",
      "status": "locked",
      "order": 1,
      "unlockCondition": { "aimCompleted": "authorise" },
      "tasks": [
        { "taskId": "pick_objectives", "title": "Pick the engagement objective", "type": "manual", "status": "active" },
        { "taskId": "pick_measures", "title": "Pick the success measure", "type": "manual", "status": "active" }
      ]
    },
    {
      "aimId": "recon",
      "title": "Reconnaissance",
      "description": "From public sources only, learn enough about Ledgerwell's people to approach three of them.",
      "status": "locked",
      "order": 2,
      "unlockCondition": { "aimCompleted": "plan" },
      "tasks": [
        { "taskId": "enter_recon", "title": "Go into the Recon Room", "type": "enter_room", "targetRoom": "recon_room", "status": "active" },
        { "taskId": "email_pattern_found", "title": "Work out how Ledgerwell builds email addresses", "type": "manual", "status": "active" },
        { "taskId": "metadata_read", "title": "Read the published PDF's properties", "type": "manual", "status": "active" },
        { "taskId": "ready_hampshire", "title": "Learn enough to approach Chris Hampshire", "type": "manual", "status": "active" },
        { "taskId": "ready_pierce", "title": "Learn enough to approach Melanie Pierce", "type": "manual", "status": "active" },
        { "taskId": "ready_lord", "title": "Learn enough to approach Sofia Lord", "type": "manual", "status": "active" }
      ]
    },
    {
      "aimId": "phish_easy",
      "title": "First two sends",
      "description": "Get Careers and then Melanie Pierce to act on a message: open the file, as they would a real one.",
      "status": "locked",
      "order": 3,
      "unlockCondition": { "aimCompleted": "recon" },
      "tasks": [
        { "taskId": "enter_operations", "title": "Go into the Operations Room", "type": "enter_room", "targetRoom": "operations_room", "status": "active" },
        { "taskId": "test_account", "title": "Create a throwaway test address in the mail client", "type": "manual", "status": "active" },
        { "taskId": "hampshire_landed", "title": "Land a message on the Careers inbox", "type": "manual", "status": "active" },
        { "taskId": "pierce_landed", "title": "Land a message on Melanie Pierce", "type": "manual", "status": "active" }
      ]
    },
    {
      "aimId": "prepare_hard",
      "title": "Prepare for Sofia",
      "description": "Build a look-alike payroll page, and call the service desk for what your recon couldn't find: the portal's name and when payslips go out. Either order.",
      "status": "locked",
      "order": 4,
      "unlockCondition": { "aimCompleted": "phish_easy" },
      "tasks": [
        { "taskId": "payroll_page_attached", "title": "Build the payroll login page", "type": "manual", "status": "active" },
        { "taskId": "call_dev", "title": "Call the service desk about Sofia's payslip", "type": "manual", "status": "active" }
      ]
    },
    {
      "aimId": "phish_hard",
      "title": "The hard send",
      "description": "Put the page and the call facts together and land a message on Sofia Lord.",
      "status": "locked",
      "order": 5,
      "unlockCondition": { "aimCompleted": "prepare_hard" },
      "tasks": [
        { "taskId": "lord_landed", "title": "Land a message on Sofia Lord", "type": "manual", "status": "active" }
      ]
    },
    {
      "aimId": "report",
      "title": "Write the report",
      "description": "Answer two questions on the campaign results, then pair each finding with a cause and a control. No names.",
      "status": "locked",
      "order": 6,
      <%# R11 F5: gate on sends_done (all three landed), not aimCompleted:phish_hard
          (Sofia alone). Landing Sofia out of order (P2 route) completed phish_hard
          and announced this objective while the report workstation still refused,
          since it too requires sends_done. social scenarios run liveGlobalUnlock, so
          the aim opens the moment sends_done flips; on the normal route Sofia lands
          last, so the timing is unchanged. %>
      "unlockCondition": { "globalVariable": "sends_done", "equals": true },
      "tasks": [
        { "taskId": "results_reviewed", "title": "Answer the two questions on the campaign results", "type": "manual", "status": "active" },
        { "taskId": "findings_paired", "title": "Pair each finding with a cause and a control", "type": "manual", "status": "active" }
      ]
    },
    {
      "aimId": "defend",
      "title": "Defend",
      "description": "Triage a mixed inbox and turn your own findings into mitigations for Ledgerwell.",
      "status": "locked",
      "order": 7,
      "unlockCondition": { "aimCompleted": "report" },
      "missionConclusion": true,
      "concludeRequires": {},
      <%# Shipped-mission ending (m02-m10): Tomasz warns first (debrief_confirm),
          the debrief's last line completes closing_debrief, and the credits roll
          from the music event on conversation_closed:tomasz. bond_visualiser here
          only re-opens the credits screen on a reload after the ending. %>
      "conclusionScreen": { "type": "bond_visualiser" },
      "tasks": [
        { "taskId": "enter_blue_team", "title": "Go into the Blue Team Room", "type": "enter_room", "targetRoom": "blue_team_room", "status": "active" },
        { "taskId": "triage_passed", "title": "Pass the inbox triage", "type": "manual", "status": "active" },
        { "taskId": "profile_done", "title": "Choose a mitigation for each fact", "type": "manual", "status": "active" },
        { "taskId": "closing_debrief", "title": "Take Tomasz's debrief", "type": "manual", "status": "active" }
      ]
    }
  ],

  <%# The ending. Tomasz's chat closes many times, so the credits wait for
      engagement_closed, set on the debrief's last line. The closing card keeps
      the sentiment of the old ENGAGEMENT CLOSED end card. %>
  "music": {
    "events": [
      {
        "trigger": "conversation_closed:tomasz",
        "condition": "globalVars.engagement_closed === true",
        "playlist": "victory",
        "track": "Ghost in the Wire",
        "autoStop": true,
        "disableClose": true,
        "fade": true,
        "statusText": "CLOSED",
        "closingCard": {
          "lines": [
            "You phished Ledgerwell, then turned round and defended it.",
            "The report names no one, and the fixes are written.",
            "Gareth keeps his staff, and now he knows where the gaps are."
          ]
        },
        "credits": [
          { "text": "ENGAGEMENT CLOSED", "style": "title" },
          { "text": "LEDGERWELL LTD — PHISHING AND SOCIAL ENGINEERING TEST", "style": "subtitle" },
          { "text": "" },
          { "section": "THE ENGAGEMENT", "lines": [
            { "text": "Scope: signed by Gareth Fairbairn before anything was sent" },
            { "text": "Phishing: all three messages acted on (Careers, Finance, the Finance intern)" },
            { "text": "Service desk: one call was reported; a later call still got what the email needed", "condition": "globalVars.dev_reported && globalVars.pretext_service_desk_call_outcome === 'got_it'" },
            <%# w-C3-1: currently unreachable (got_it is sticky and landing Sofia needs a granting call), kept as a safety net mirroring tomasz.ink's debrief branch. %>
            { "text": "Service desk: gave out what the intern's email needed, and reported a call", "condition": "globalVars.dev_reported && globalVars.pretext_service_desk_call_outcome !== 'got_it'" },
            { "text": "Service desk: gave out what the intern's email needed, with no call-back check", "condition": "!globalVars.dev_reported" },
            { "text": "Report: filed, with no names in it" }
          ] },
          { "section": "THE DEFENCE", "lines": [
            { "text": "Inbox triage: passed" },
            { "text": "Defender profile: a fix chosen for each fact" }
          ] }
        ]
      }
    ]
  },

