              { "id": "role_inboxes", "text": "Keep staff addresses out of everything published (press releases, PDFs, supplier contact lists) and give outsiders role inboxes", "good": true,
                "why": "The team page already does this; the press releases, PDFs and supplier lists don't. Stop adding to them and there's less each year for a lookup tool to learn from." },
              { "id": "hide_team_page", "text": "Take the team page down for a while", "good": false,
                "why": "The names on it matter only because the pattern is already out there. Hiding the page loses the outsiders it serves and doesn't recall a single address." }
            ] },
          { "intel": "username_convention",
            "options": [
              { "id": "rename_usernames", "text": "Change the username scheme to something harder to guess", "good": false,
                "why": "The next document anyone publishes leaks the new scheme the same way, through its author field." },
              { "id": "longer_passwords", "text": "Require longer passwords on staff accounts", "good": false,
                "why": "Good practice, but it doesn't touch this exposure. The username still leaks with every file Ledgerwell publishes." },
              { "id": "strip_metadata", "text": "Strip author and application details from files before publishing", "good": true,
                "why": "The files stay up and the author field no longer gives away a username." }
            ] },
          { "intel": "lord_portal",
            "options": [
              { "id": "private_accounts", "text": "Ask staff to set their social accounts to private", "good": false,
                "why": "Private accounts still have followers, and friends reshare. What gets posted about work is the problem, not who can see it." },
              { "id": "social_policy", "text": "A social-media policy on posting about internal systems", "good": true,
                "why": "Staff stop posting what they're waiting for on work systems, and they still get to post about their weekend. Here the post gave the pretext; the desk filled in the details." },
              { "id": "desk_callback", "text": "A call-back rule on the service desk", "good": false,
                "why": "That fixes the call, and it's in your report. This card is about the post: it told you Sofia was new and waiting on her first payslip, before you rang anyone." }
            ] },
          { "intel": "hampshire_careers",
            "options": [
              { "id": "filter_and_scan", "text": "Route the careers inbox through a filtering gateway that scans attachments", "good": true,
                "why": "The inbox stays open to applicants, and a bad file is caught before Chris opens it." },
              { "id": "pdf_only", "text": "Accept CVs as PDF files only", "good": false,
                "why": "A PDF can carry a link or a malicious file too; an attacker just sends a PDF. Scanning checks every file, whatever its type." },
              { "id": "known_senders", "text": "Only accept CVs from addresses Careers has written to before", "good": false,
                "why": "Careers exists to hear from strangers. An allow-list would turn away every new applicant." }
            ] }
        ]
      }
    }
  },

