        "findings": [
          { "id": "spoofed_colleague", "step": "findings", "text": "Finance acted on mail spoofing a colleague",
            "rootCauses": [
              { "id": "spam_filter_missed", "correct": false,
                "text": "The spam filter didn't flag the message",
                "why": "Spam filters score bulk junk. One well-written message from a known name gives them nothing to catch. Checking the sender is DMARC's job, and DMARC was set to deliver anyway." },
              { "id": "no_banner_dmarc_none", "correct": true,
                "text": "No external-sender banner, and DMARC left at p=none",
                "why": "p=none tells receivers to deliver mail that fails DMARC, so your j.baker@ spoof arrived looking internal. A banner would at least have marked it as outside mail." },
              { "id": "staff_carelessness", "correct": false, "blame": true,
                "text": "Finance staff were careless with a suspicious email",
                "why": "Blaming staff hides the control gap and stops people reporting." }
