{
  "scenario_id": "test_social_freetext",
  "scenario_name": "Test: free-text body mode",
  "scenario_brief": "Fixture for the free-text body mode (design 01 §2 Body, 00 §13). One room, one mail terminal, one open-inbox target. The composer shows an unscored free-text box; typing in it is shown in the sent mail but never judged and never read by the ink, and the templated parts still decide the send.",
  "endGoal": "Send a CV application to the open careers inbox with some words of your own, and have it land.",
  "version": "1.0",
  "disableAttacks": true,
  "startRoom": "ft_room",

  "player": {
    "id": "player",
    "displayName": "Operator",
    "spriteSheet": "female_hacker_hood_v2",
    "spriteTalk": "assets/characters/female_hacker_hood_talk.png",
    "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 12 }
  },

  "objectives": [
    {
      "aimId": "ft_round",
      "title": "Free-text body mode",
      "description": "Write to the careers inbox, add a line in your own words, and get it to land.",
      "status": "active",
      "order": 0,
      "tasks": [
        { "taskId": "chris_landed", "title": "Land an application with the careers inbox", "type": "custom", "status": "active" }
      ]
    }
  ],

  "globalVariables": {
    "se_intel_chris_careers": true,
    "se_intel_careers_attachment": false,
    "phish_chris_landed": false,
    "phish_chris_attempts": 0
  },

  "social": {
    "people": [
      { "id": "chris", "kind": "cast", "address": "careers@corp.example",
        "forms": { "full": "Chris Hampshire" } }
    ],

    "intelFacts": {
      "careers_attachment": {
        "text": "The careers inbox takes a .docx CV from anyone.",
        "subject": "chris",
        "source": "ft_seed",
        "provides": [
          { "type": "document", "value": "cv", "label": "my CV", "kind": "distinctive", "attachmentKind": "document" }
        ]
      }
    },

    "templates": {
      "from_own": { "part": "from", "text": "{account_name} <{account_address}>", "slots": [] },
      "greet_generic": { "part": "greeting", "text": "Hello,", "slots": [] },
      "pretext_apply": { "part": "pretext", "text": "I'm applying for the open role.", "slots": [],
        "implies": [ { "type": "document", "value": "cv" } ], "urgency": "low" },
      "pretext_enquiry": { "part": "pretext", "text": "I have a general enquiry.", "slots": [], "urgency": "low" },
      "ask_review_cv": { "part": "ask", "text": "Could you review my CV when you have a moment?", "slots": [] }
    },

    "mailClient": {
      "accounts": [
        { "id": "guest", "address": "guest@workstation.example", "displayName": "Operator",
          "kind": "given", "person": null, "mailbox": "guest", "spoofsFrom": true }
      ],
      "mailboxes": [ { "id": "guest" } ],
      "contacts": [
        { "id": "chris", "person": "chris", "name": "Chris Hampshire",
          "addresses": ["careers@corp.example"], "role": "Careers",
          "revealedBy": "se_intel_chris_careers", "targetId": "chris" }
      ],
      "seededMessages": [
        { "id": "welcome", "mailbox": "guest",
          "from": { "name": "IT", "address": "it@corp.example" },
          "to": "guest@workstation.example", "subject": "Your new laptop",
          "body": "Hello,\n\nYour workstation is ready.\n\nIT Service Desk",
          "time": "08:05", "unread": true, "folder": "inbox" }
      ],
      "payloadKit": [
        { "id": "kit_cv", "label": "CV.docx", "kind": "document" }
      ],
      "checklistTiming": "onSend",
      "bodyMode": "freeText",
      "freeTextFlavour": true,
      "showRedFlagMeter": false
    },

    "phishTargets": [
      {
        "id": "chris",
        "address": "careers@corp.example",
        "displayName": "Chris Hampshire",
        "subjects": [ { "id": "s_application", "text": "Application", "topic": "recruitment" } ],
        "interests": { "topics": ["recruitment"] },
        "emailReplyDelay": 1,
        "templateSets": { "from": ["from_own"], "greeting": ["greet_generic"],
                          "pretext": ["pretext_apply", "pretext_enquiry"], "ask": ["ask_review_cv"] },
        "primedFor": { "distinctiveValues": ["cv"], "minDistinct": 1, "expectedAttachment": "document",
                       "trusts": ["*"], "story": "an open careers inbox that takes a CV from anyone" },
        "requiredFactors": ["senderTrust", "pretextRelevant", "attachmentPlausible"],
        "advisoryFactors": ["senderAuth"],
        "replies": { "landed": "Thanks, I'll get to this CV when I can." },
        "factorStrings": {
          "senderTrust": { "pass": "✓ The careers inbox takes mail from anyone", "redFlag": null },
          "senderAuth": { "pass": "✓ Sent as your own address, so there is nothing to spoof.", "redFlag": null }
        },
        "outcome": { "setGlobal": { "phish_chris_landed": true } }
      }
    ]
  },

  "rooms": {
    "ft_room": {
      "type": "room_office",
      "door_sign": "Engagement Office",
      "connections": {},
      "npcs": [
        {
          "id": "ft_host",
          "displayName": "Host",
          "npcType": "person",
          "position": { "x": 3, "y": 3 },
          "spriteSheet": "female_blowse_v2",
          "spriteTalk": "assets/characters/female_blowse_talk.png",
          "spriteVisemes": "assets/characters/female_blowse_visemes.png",
          "storyPath": "scenarios/ink/generic-npc.json",
          "currentKnot": "start",
          "eventMappings": [
            {
              "eventPattern": "global_variable_changed:phish_chris_landed",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "chris_landed"
            }
          ]
        }
      ],
      "objects": [
        {
          "type": "mail_terminal",
          "id": "ft_mail_terminal",
          "name": "Mail Terminal",
          "position": { "x": 6, "y": 2 },
          "takeable": false,
          "interactable": true,
          "active": true,
          "locked": false,
          "observations": "A workstation signed in to the Operator mailbox. The composer has a free-text box for your own words.",
          "minigameData": { "accountIds": ["guest"], "defaultAccount": "guest" }
        }
      ]
    }
  }
}
