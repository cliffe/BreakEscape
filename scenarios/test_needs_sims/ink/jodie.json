{"inkVersion":21,"root":[[["done",{"#n":"g-0"}],null],"done",{"start":["#","^speaker:npc","/#","^Hiya. Jodie, maintenance. On call for whatever breaks, mostly the kettle.","\n",{"->":"hub"},null],"hub":[["ev","str","^What do you do here?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Did that light get sorted?","/str",{"VAR?":"job_called"},{"VAR?":"job_cleared"},"!","&&",{"VAR?":"heard_exchange_job_called"},"&&","/ev",{"*":".^.c-1","flg":5},"ev","str","^Busy night?","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^I'll let you get on.","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["\n","#","^speaker:npc","/#","^Fix whatever Keith's radio turns up. Lights, locks, leaks.","\n",{"->":"hub"},null],"c-1":["\n","#","^speaker:npc","/#","^Aye, I swapped the tube. No more flickering. Cheers for flagging it.","\n","#","^set_global:job_cleared:true","/#","ev",true,"/ev",{"VAR=":"job_cleared","re":true},{"->":"hub"},null],"c-2":["\n","#","^speaker:npc","/#","^Comes in waves. Right now it's just us and the boiler.","\n",{"->":"hub"},null],"c-3":["\n","#","^speaker:npc","/#","^Nae bother. Away you go.","\n","#","^exit_conversation","/#","end",null]}],null],"exchange_waiting":["^Keith: Quiet on the radio tonight.","\n","^Jodie: Long shift when it's this slow.","\n","^Keith: I'll take quiet over chaos.","\n","^Jodie: Don't jinx it now, Keith.","\n","^Keith: A brew while we can, then.","\n","done",null],"exchange_job_called":["^Jodie: That light in here still flickering?","\n","^Keith: Neil's put it out on the radio.","\n","^Keith: Someone'll be up soon, Jodie.","\n","done",null],"exchange_job_cleared":["^Keith: They sorted that flickering light.","\n","^Jodie: About time. Hurt my eyes, that did.","\n","^Keith: Peace and quiet again. Lovely.","\n","done",null],"global decl":["ev",false,{"VAR=":"job_called"},false,{"VAR=":"job_cleared"},false,{"VAR=":"heard_exchange_job_called"},"/ev","end",null]}],"listDefs":{}}