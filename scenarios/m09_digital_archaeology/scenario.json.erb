# --- Event-mapping builders ----------------------------------------------------
# Mappings are built as Ruby hashes and emitted with JSON.generate, so the
# long lists below can't drop a comma. Every condition is `&&`-only, written
# globalVars.<name> (lesson 35).
require 'json'
def jgen(list)
  list.map { |h| '            ' + JSON.generate(h) }.join(",\n")
end

# delay: the mapping's delayMs (waits for an open conversation or minigame,
# and re-checks the condition); msg_delay: the text's own delay, used to space
# two texts from one event 5 s apart (README "Space timed texts 4-6 s apart").
def text_map(event, cond, msg, once: true, delay: nil, msg_delay: 0, set: nil, extra: {})
  h = { "eventPattern" => event }
  h["condition"] = cond if cond
  h["onceOnly"] = true if once
  h["delayMs"] = delay if delay
  h["setGlobal"] = set if set
  h["sendTimedMessage"] = { "delay" => msg_delay, "message" => msg }
  h.merge(extra)
end

def call_map(event, cond, knot, delay: nil, voiced: false, forced: true, once: false, resume: false, cooldown0: false, comment: nil)
  h = {}
  h["_comment"] = comment if comment
  h["eventPattern"] = event
  h["condition"] = cond if cond
  h["conversationMode"] = "phone-chat"
  h["targetKnot"] = knot
  h["resume"] = true if resume
  h["disableClose"] = true if forced
  h["voiced"] = true if voiced
  h["delayMs"] = delay if delay
  h["onceOnly"] = true if once
  h["cooldown"] = 0 if cooldown0
  h
end

# The three re-ring events for HaX's scenes (S4 §6 intro): leaving a room, a
# reload, and closing her thread (the engine's "immediately", 500 ms).
def hax_rerings(cond, knot, voiced:)
  [
    call_map("room_exited", cond, knot, voiced: voiced, cooldown0: true),
    call_map("game_loaded", cond, knot, voiced: voiced, cooldown0: true),
    call_map("conversation_closed:agent_0x99", cond, knot, voiced: voiced, cooldown0: true, delay: 500)
  ]
end

