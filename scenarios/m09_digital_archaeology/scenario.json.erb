hax_maps.concat(hax_rerings("globalVars.tesseract_call_started && !globalVars.tesseract_call_done", "tesseract_call", voiced: true))
hax_maps << { "eventPattern" => "global_variable_changed:tesseract_call_done", "condition" => "value === true", "onceOnly" => true, "completeTask" => "hear_the_mirror_job" }
hax_maps << { "eventPattern" => "global_variable_changed:albion_notified", "condition" => "value === true", "onceOnly" => true, "completeTask" => "send_the_notice" }

# Re-ring 3 of the Recruiter's call: HaX's deck_resume, once she has gone
# (S4 §6.1). Voiced.
hax_maps.concat(hax_rerings("globalVars.recruiter_gone && !globalVars.deck_choice_made", "deck_resume", voiced: true))

# The Alpha annotations (stage 7 A-05): the sheet's onRead also fires on the
# blank-stock read, so the export is set only when the readable variant shows.
hax_maps << { "eventPattern" => "global_variable_changed:alpha_annotations_opened", "condition" => "value === true && globalVars.deck_pulled === 'alpha_tapes' && globalVars.identity_scene_done", "onceOnly" => true, "setGlobal" => { "alpha_annotations_read" => true } }

# HaX's document remarks (texts/A_hax_texts.md §4). Each once.
hax_maps << text_map("item_picked_up:notes", "data.itemId === 'lease_file' && !globalVars.m08_tomb_gamma_location_known", "There it is. Tomb Gamma has an address.")
hax_maps << text_map("item_picked_up:notes", "data.itemId === 'lease_file' && globalVars.m08_tomb_gamma_location_known", "Same site Nightshade gave us. Now it has a lease.")
%w[arrested ko].each do |v|
  hax_maps << text_map("item_picked_up:notes", "data.itemId === 'lease_file' && globalVars.m03_victoria_fate === '#{v}'",
                       "Big Sky was in Zero Day's sales ledger. Sterling's keys opened it after Cardiff.", msg_delay: 5000)
end
hax_maps << text_map("global_variable_changed:rent_ledger_read", "value === true && globalVars.m06_irina_recruited", "Irina's tip-off led us to this. Tell her it bought us the deed.")
hax_maps << text_map("global_variable_changed:refit_ledger_read", "value === true && globalVars.m02_paid_ransom", "St. Catherine's money. It bought the blast door.")
%w[protected exposed].each do |fate|
  hax_maps << text_map("global_variable_changed:danny_sheet_read", "value === true && globalVars.m03_danny_fate === '#{fate}' && !globalVars.m03_danny_ko", "Danny's statement just became evidence.")
end
%w[recruited escaped].each do |vf|
  hax_maps << text_map("global_variable_changed:danny_sheet_read", "value === true && globalVars.m03_danny_fate === 'protected' && globalVars.m03_victoria_fate === '#{vf}' && !globalVars.m03_danny_ko",
                       "Danny asked again last week. I didn't have an answer. Tonight I might.", msg_delay: 5000)
end
hax_maps << text_map("global_variable_changed:danny_sheet_read", "value === true && globalVars.m03_danny_fate === 'left' && !globalVars.m03_danny_ko",
                     "\"Loose end, resolved.\" I rang. He's alive, and still hiding from them. Good.")
# The legacy box remark: once, and only while the Series L sheets show
# (stage 9: the feed box's gone state and Noor's base box show other text).
hax_maps << text_map("global_variable_changed:legacy_box_read", "value === true && globalVars.legacy_files_saved && !globalVars.legacy_remark_sent",
                     "Nobody of ours in here. Ours are on her tape, by codename.", set: { "legacy_remark_sent" => true })
hax_maps << text_map("global_variable_changed:legacy_box_read", "value === true && !globalVars.legacy_clock_run && !globalVars.legacy_files_saved && !globalVars.legacy_remark_sent",
                     "Nobody of ours in here. Ours are on her tape, by codename.", set: { "legacy_remark_sent" => true })
hax_maps << text_map("global_variable_changed:noor_box_read", "value === true && globalVars.m05_found_pipeline_list && !globalVars.m05_recruiter_deal_accepted && !globalVars.legacy_remark_sent",
                     "Nobody of ours in here. Ours are on her tape, by codename.", set: { "legacy_remark_sent" => true })
[["surrender", "There's your why. He was told to."], ["expose", "He wanted your headlines."],
 ["fight", "\"Will not stop when they tell him to.\" He didn't."], ["recruit", "He believed this more than the man who wrote it. You turned him anyway."]].each do |v, msg|
  hax_maps << text_map("item_picked_up:notes", "data.itemId === 'derek_file' && globalVars.m01_final_choice === '#{v}'", msg)
end
hax_maps << text_map("global_variable_changed:sleeper_shortlist", "value === true",
                     "After Quantum Dynamics we checked everyone TalentStack ever touched. Harwick & Lowe shut before TalentStack opened.")
hax_maps << text_map("global_variable_changed:sleeper_shortlist", "value === true && globalVars.raid_team_answer === 'quintero'",
                     "You took her side at the briefing. Keep it. Don't take her word.", msg_delay: 5000)
hax_maps << text_map("global_variable_changed:reeves_sheet_read", "value === true",
                     "Reeves' handler, from the hospital. Told to stand down the day we took Reeves.")
hax_maps << text_map("global_variable_changed:asset_tag_read", "value === true && !globalVars.flag3_submitted",
                     "Strategy Directorate. One of ours signed this out and never handed it back. Find out who.")
hax_maps << text_map("global_variable_changed:case_file_read", "value === true && globalVars.m06_monitoring_enabled",
                     "Your tags, from HashChain. Someone's paying rent on a building in Montana that isn't this one.")

# --- The Recruiter's mappings (recruiter, loading_dock) -----------------------
# S4 §4 row 3 and §6.1. The two in_cage setters come first (one NPC's
# mappings for an event run in list order, review N-R3-2).
ring_c = "globalVars.ledger_read_heard && globalVars.cage_opened && !globalVars.in_cage && !globalVars.recruiter_call_started"
rec_maps = []
rec_maps << { "eventPattern" => "room_entered:restricted_cage", "setGlobal" => { "in_cage" => true }, "cooldown" => 0 }
rec_maps << { "eventPattern" => "room_exited", "condition" => "data.roomId === 'restricted_cage'", "setGlobal" => { "in_cage" => false }, "cooldown" => 0 }
rec_maps << call_map("room_exited", "data.roomId === 'restricted_cage' && #{ring_c}", "call", delay: 3000, voiced: true, once: true,
                     comment: "Ring (a): walking out of the cage with the ledger read.")
rec_maps << call_map("global_variable_changed:ledger_read_heard", "value === true && #{ring_c}", "call", delay: 3000, voiced: true, once: true,
                     comment: "Ring (b): the ledger read closes with the cage already open and the player outside it.")
rec_maps << call_map("room_entered", "data.roomId !== 'restricted_cage' && #{ring_c}", "call", voiced: true,
                     comment: "Ring (c), backstop: any room entry outside the cage (also on load).")
re1 = "globalVars.recruiter_call_started && !globalVars.recruiter_said_yes && !globalVars.recruiter_gone && !globalVars.deck_choice_made"
re2 = "globalVars.recruiter_said_yes && !globalVars.sleeper_named && !globalVars.deck_choice_made"
rec_maps << call_map("room_exited", "data.nextRoom !== 'restricted_cage' && #{re1}", "call", voiced: true, resume: true, cooldown0: true, comment: "Re-ring 1: before any answer.")
rec_maps << call_map("game_loaded", re1, "call", voiced: true, resume: true, cooldown0: true)
rec_maps << call_map("room_exited", "data.nextRoom !== 'restricted_cage' && #{re2}", "resume_name", voiced: true, cooldown0: true,
                     comment: "Re-ring 2: between yes and the name (stage 8 m-05: unreachable in practice; kept as a guard).")
rec_maps << call_map("game_loaded", re2, "resume_name", voiced: true, cooldown0: true)
rec_maps << text_map("room_entered:tape_room", "globalVars.recruiter_offer === 'double_crossed'",
                     "You took the name and something off my deck. I said I'd know. Your team's plane is still in the air.")
%>
{
  "scenario_brief": "Helena, Montana, after hours. Last night a courier carried the Architect's order to Mountain States Records & Retention: burn Helena before the Publication. SAFETYNET read it and let it go on. Tonight the archive's director is feeding a shredder box by box, and somewhere in her stacks is the paper ENTROPY can't afford to keep. Get in, open the archive's catalogue server and take what the shredder hasn't reached. Task Force Null follows you to Montana tonight, and Director Netherton wants a name he can say in court.",

  "show_scenario_brief": "on_resume",

  "startRoom": "loading_dock",

<%# VM-WIRE: top-level flag map. Keys must be the real SecGen system_names;
    the fallback arrays are standalone/dev placeholders only. Story order:
    catalogue_server flag 1 = the catalogue (the hidden part), flag 2 = the
    Initiative's ledger; tomb_beta_server flag 1 = the owner's credential,
    flag 2 = full control (the mirror job). %>
  "flags": {
    "catalogue_server": <%= vm_flags_json('catalogue_server', ['flag{m09_catalogue_index}', 'flag{m09_initiative_ledger}']) %>,
    "tomb_beta_server": <%= vm_flags_json('tomb_beta_server', ['flag{m09_tomb_beta_owner}', 'flag{m09_tomb_beta_control}']) %>
  },

  "narrator": {
    "id": "narrator",
    "skipTextValidation": true,
    "voice": {
      "name": "Algenib",
      "style": "Cinematic thriller narrator. Consistent British Received Pronunciation accent throughout -- do not shift to any other accent. Low, unhurried, grave. A records archive burning its own past at night, and the people who were filed in it.",
      "language": "en-GB"
    }
  },

<%# Music (S4 §10). 'victory' carries the closing card and credits
    (texts/C_texts_and_credits.md §2-§3, the F14 format) and fires on the
    debrief's last line (report_done), after report_to_netherton completes. %>
  "music": {
    "events": [
      { "trigger": "game_loaded", "condition": "!globalVars.briefing_played", "playlist": "cutscene", "fade": false },
      { "trigger": "game_loaded", "condition": "globalVars.briefing_played && !globalVars.start_debrief", "playlist": "noir", "fade": false },
      { "trigger": "game_loaded", "condition": "globalVars.start_debrief && !globalVars.report_done", "playlist": "cutscene", "fade": false },
      { "trigger": "conversation_closed:briefing_cutscene", "playlist": "noir", "fade": true },
      { "trigger": "npc_hostile_state_changed", "condition": "isHostile === true", "playlist": "threat", "fade": true },
      { "trigger": "all_hostiles_ko", "playlist": "noir", "fade": true },
      { "trigger": "global_variable_changed:identity_scene_started", "condition": "value === true", "playlist": "cutscene", "fade": true },
      { "trigger": "global_variable_changed:identity_scene_done", "condition": "value === true", "playlist": "noir", "fade": true },
      { "trigger": "global_variable_changed:tesseract_call_started", "condition": "value === true", "playlist": "silence", "fade": true },
      { "trigger": "global_variable_changed:tesseract_call_done", "condition": "value === true", "playlist": "noir", "fade": true },
      { "trigger": "global_variable_changed:start_debrief", "condition": "value === true", "playlist": "cutscene", "fade": true },
      {
        "trigger": "global_variable_changed:report_done",
        "condition": "value === true",
        "playlist": "victory",
        "autoStop": true,
        "disableClose": true,
        "fade": true,
        "closingCard": {
          "lines": [
            { "text": "The Architect: Dr Adrian Tesseract. Proved." },
            { "text": "The Publication: 06:00 UTC, day 13." },
            { "text": "WREN: Halina Kowalczyk. She doesn't know you know.", "condition": "globalVars.recruiter_offer === 'taken'" },
            { "text": "WREN: Halina Kowalczyk. She walked off the apron at Helena.", "condition": "globalVars.recruiter_offer === 'double_crossed'" },
            { "text": "WREN: one of two names on a dead firm's placement record.", "condition": "!globalVars.sleeper_named && globalVars.sleeper_shortlist" },
            { "text": "WREN: one of four. Going into Montana with you.", "condition": "!globalVars.sleeper_named && !globalVars.sleeper_shortlist" },
            { "text": "His vendor notice: sent tonight.", "condition": "globalVars.albion_notified" },
            { "text": "His vendor notice: still on his box.", "condition": "!globalVars.albion_notified" },
            { "text": "The Montana order: signed." }
          ]
        },
        "credits": [
          { "text": "MISSION COMPLETE", "style": "title" },
          { "text": "DIGITAL ARCHAEOLOGY", "style": "subtitle" },
          { "section": "IN THIS OPERATION", "people": [
            { "name": "AGENT HAX", "clauses": [
              { "text": "Told she should have said it. She agreed.", "condition": "globalVars.hax_confession_answer === 'should_have_told'" },
              { "text": "Given her own line back.", "condition": "globalVars.hax_confession_answer === 'afterwards'" },
              { "text": "Thanked, once." }
            ] },
            { "name": "DIRECTOR NETHERTON", "clauses": [
              { "text": "Read the memo on the flight. Signed for Tesseract too.", "condition": "globalVars.memo_stance === 'yes_albion'" },
              { "text": "Said the name. Signed the Montana order." }
            ] },
            { "name": "HALINA KOWALCZYK", "clauses": [
              { "text": "Took a phone call on the apron and walked away.", "condition": "globalVars.recruiter_offer === 'double_crossed'" },
              { "text": "Thanked for her cracker, to her face.", "condition": "globalVars.kowalczyk_reply === 'warm'" },
              { "text": "Asked after her cracker. Got a shrug." }
            ] },
            { "name": "MARGARET SORENSEN", "clauses": [
              { "text": "Wrote down every box she destroyed.", "condition": "globalVars.sorensen_fate === 'talked'" },
              { "text": "Stopped at the shredder. Asked for a lawyer.", "condition": "globalVars.sorensen_fate === 'ko'" },
              { "text": "Fed the shredder all night." }
            ] },
            { "name": "NOOR HADDAD", "clauses": [
              { "text": "Knocked down at her own desk.", "condition": "globalVars.noor_ko" },
              { "text": "A witness in Great Falls. Not allowed to ring her father.", "condition": "globalVars.noor_told" },
              { "text": "Warned in the autumn. Held the last box back.", "condition": "globalVars.m05_found_pipeline_list && !globalVars.m05_recruiter_deal_accepted" },
              { "text": "Went home and rang her father. Still on a list." }
            ] },
            { "name": "CODY OLD COYOTE", "clauses": [
              { "text": "Knocked down on his round.", "condition": "globalVars.old_coyote_ko" },
              { "text": "Sat out the night in his truck.", "condition": "globalVars.old_coyote_told" },
              { "text": "Walked the fence. Saw nothing." }
            ] },
            { "name": "JESSE TRAN", "clauses": [
              { "text": "Walked out and made a phone call.", "condition": "globalVars.tran_outcome === 'talked'" },
              { "text": "In custody. Asked for a phone charger.", "condition": "globalVars.tran_outcome === 'ko'" },
              { "text": "Wiped the tape side. Nobody stopped him." }
            ] },
            { "name": "THE RECRUITER", "clauses": [
              { "text": "Sold you a name and booked the sale.", "condition": "globalVars.recruiter_offer === 'taken'" },
              { "text": "Sold you a name, then warned it.", "condition": "globalVars.recruiter_offer === 'double_crossed'" },
              { "text": "Wiped her own file. You kept a copy.", "condition": "globalVars.recruiter_offer === 'named'" },
              { "text": "Kept her name. You kept his tapes." }
            ] }
          ] },
          { "section": "WHAT THE PURGE TOOK", "lines": [
            { "text": "Saved from the bins: Derek Lawson's file.", "condition": "globalVars.cage_bin === 'derek_file'" },
            { "text": "Saved from the bins: the Social Fabric letters. Teresa Villanueva was warned.", "condition": "globalVars.cage_bin === 'letters'" },
            { "text": "Saved from the bins: what Nightshade cleared from his locker.", "condition": "globalVars.cage_bin === 'nightshade_copy'" },
            { "text": "The deck: wiped, all of it.", "condition": "globalVars.deck_pulled === 'none'" },
            { "text": "The deck: her file pulled, the rest wiped.", "condition": "globalVars.deck_pulled === 'her_file'" },
            { "text": "The deck: Tomb Alpha's tapes pulled, the rest wiped.", "condition": "globalVars.deck_pulled === 'alpha_tapes'" },
            { "text": "The legacy placement files: kept from the shredder.", "condition": "globalVars.legacy_files_saved" },
            { "text": "The tape side: saved.", "condition": "globalVars.tran_outcome !== 'left'" }
          ] },
          { "section": "ELSEWHERE", "lines": [
            { "text": "Albion's controller: the vendor has ninety days for a fix, and four hundred sites to reach. The Critical Mass watch went dark.", "condition": "globalVars.albion_notified" },
            { "text": "Albion's controller: four hundred sites, still open. The watch stays on.", "condition": "!globalVars.albion_notified" },
            { "text": "NIGHTSHADE: Sent his own file. He knows what his teacher wrote.", "condition": "globalVars.m08_nightshade_triple_agent && globalVars.nightshade_shown_file" },
            { "text": "NIGHTSHADE: Kept in play, and in the dark.", "condition": "globalVars.m08_nightshade_triple_agent && !globalVars.nightshade_shown_file" }
          ] }
        ]
      }
    ]
  },

<%# Start kit (S5 §3.1, §5): every tool from m01-m08, plus Kowalczyk's PIN
    cracker, which the briefing narrates her handing over (S4 P15: a
    #give_item in the briefing would give from the briefing's host). The phone
    lists HaX only: the Recruiter and the three branch callers ring by their
    mappings (lesson 36, stage 8 m-12). %>
  "startItemsInInventory": [
    {
      "type": "phone",
      "name": "Your Phone",
      "takeable": true,
      "phoneId": "player_phone",
      "npcIds": ["agent_0x99"],
      "observations": "Your secure phone. HaX is on the line from wheels down."
    },
    {
      "type": "lockpick",
      "name": "Lock Pick Kit",
      "takeable": true,
      "observations": "SAFETYNET field pick kit.",
      "puzzle_graph_role": "tool",
      "puzzle_graph_unlocks": ["front_desk", "enrolment_crate"]
    },
    {
      "type": "rfid_cloner",
      "name": "RFID Cloner",
      "takeable": true,
      "observations": "Concealed RFID cloning device. Stand close to a keycard to copy it.",
      "puzzle_graph_role": "tool",
      "puzzle_graph_unlocks": ["restricted_cage"],
      "puzzle_graph_note": "Clones Sorensen's stacks card across the hatch counter (and Noor's, on route A). On Victoria's route HaX's maintenance code opens the gate instead."
    },
    {
      "type": "fingerprint_kit",
      "name": "Fingerprint Kit",
      "takeable": true,
      "observations": "Powder, brush, lifting tape.",
      "puzzle_graph_role": "tool"
    },
    {
      "type": "workstation",
      "id": "cyberchef_workstation",
      "name": "CyberChef Workstation",
      "takeable": true,
      "observations": "A laptop with CyberChef loaded. Paste anything encoded or enciphered here.",
      "puzzle_graph_role": "tool",
      "puzzle_graph_note": "Vigenere Decode: the salvage code (key from the tape room's shelf marks) and the optional Alpha annotations"
    },
    {
      "type": "pin-cracker",
      "id": "kowalczyk_pin_cracker",
      "name": "PIN Cracker (Kowalczyk's)",
      "takeable": true,
      "observations": "Halina Kowalczyk's own PIN cracker, bench-built and never through stores. It clamps over a keypad and reads each wrong try back to you: how many digits are right and in place, how many are right but elsewhere.",
      "puzzle_graph_role": "tool",
      "puzzle_graph_unlocks": ["director_safe"]
    }
  ],

  "player": {
    "id": "player",
    "displayName": "Agent 0x00",
    "spriteSheet": "male_hacker_hood_down_v2",
    "spriteTalk": "assets/characters/male_hacker_hood_down_talk.png",
    "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 }
  },

<%# Objectives (S4 §13 with stage 8: match_the_hand ships locked, unlocked by
    HaX on nightshade_file_held; the last task reads "Tell HaX to bring you in
    to Netherton"). Reveal tasks ship locked and are opened by #unlock_task in
    the scene that reveals them. concludeRequires holds the four flag tasks
    only. VM-WIRE: the four targetFlags use the story-level system names. %>
  "objectives": [
    {
      "aimId": "get_in",
      "title": "Get In And Set Up The Drop Terminal",
      "description": "Mountain States Records & Retention, after hours. Get inside, set the field laptop up in the reading room and open the archive's catalogue server. The shredder has been running since before you landed.",
      "status": "active",
      "order": 0,
      "tasks": [
        { "taskId": "get_inside", "title": "Get inside the archive", "type": "custom", "status": "active" },
        { "taskId": "meet_the_clerk", "title": "Talk to the clerk at the front desk", "type": "npc_conversation", "targetNPC": "noor_haddad", "status": "active", "optional": true },
        { "taskId": "set_up_drop_terminal", "title": "Set up the field laptop in the reading room", "type": "custom", "status": "active" },
        { "taskId": "submit_catalogue_flag", "title": "Get into the catalogue server and submit the flag", "type": "submit_flags",
          "targetFlags": ["drop_terminal:catalogue_server-flag1"], "targetCount": 1, "currentCount": 0, "showProgress": true, "status": "active",
          "puzzle_graph_unlocks": "restricted_stacks" }
      ]
    },
    {
      "aimId": "restricted_series",
      "title": "Find The Restricted Series Before It Burns",
      "description": "The catalogue puts Series R behind the cage mesh in the restricted stacks, where the director is feeding a shredder from the clerk's trolleys. Get past her and into the cage before it's all ash.",
      "status": "locked",
      "order": 1,
      "unlockCondition": { "aimCompleted": "get_in" },
      "tasks": [
        { "taskId": "enter_restricted_stacks", "title": "Get into the restricted stacks", "type": "enter_room", "targetRoom": "restricted_stacks", "status": "active" },
        { "taskId": "talk_at_the_hatch", "title": "Talk to Sorensen at the cage hatch", "type": "custom", "status": "active" },
        { "taskId": "open_the_cage", "title": "Get through the cage gate", "type": "custom", "status": "active" },
        { "taskId": "open_plan_cabinet", "title": "Open the locked plan cabinet at the back of the cage", "type": "unlock_object", "targetObject": "plan_cabinet", "status": "active" },
        { "taskId": "match_the_hand", "title": "Compare the hand on Nightshade's file with the notebook scan in HaX's case file", "type": "custom", "status": "locked" },
        { "taskId": "stop_the_shredding", "title": "Stop Sorensen's shredding", "type": "custom", "status": "locked", "optional": true },
        { "taskId": "stop_the_tape_wipe", "title": "Stop the tape wipe in the server closet", "type": "custom", "status": "active", "optional": true }
      ]
    },
    {
      "aimId": "read_the_ledger",
      "title": "Read The Initiative's Ledger",
      "description": "The catalogue server keeps the Insider Threat Initiative's ledger live: placements, candidates, and an older legacy section. Pull it, and see who's still on their books.",
      "status": "locked",
      "order": 2,
      "unlockCondition": { "aimCompleted": "get_in" },
      "tasks": [
        { "taskId": "submit_ledger_flag", "title": "Pull the Initiative's ledger off the catalogue server and submit it", "type": "submit_flags",
          "targetFlags": ["drop_terminal:catalogue_server-flag2"], "targetCount": 1, "currentCount": 0, "showProgress": true, "status": "active" },
        { "taskId": "answer_the_offer", "title": "Answer the Recruiter's offer", "type": "custom", "status": "locked", "puzzle_graph_unlocks": "sorensen_office" },
        { "taskId": "cross_reference_wren", "title": "Find WREN's file among Harwick & Lowe's boxes in the open stacks", "type": "custom", "status": "locked", "optional": true }
      ]
    },
    {
      "aimId": "search_the_office",
      "title": "Search The Director's Office",
      "description": "The Recruiter fired the wipe from Sorensen's office, and HaX has the door. Search it. Whatever the night is protecting, she kept the keys to it.",
      "status": "locked",
      "order": 3,
      "unlockCondition": { "aimCompleted": "read_the_ledger" },
