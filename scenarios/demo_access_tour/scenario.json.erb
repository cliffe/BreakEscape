        {
          "id": "ama_phone",
          "displayName": "Ama Owusu",
          "npcType": "phone",
          "avatar": "assets/characters/ama_owusu_headshot.png",
          "spriteTalk": "assets/characters/ama_owusu_talk.png",
          "spriteVisemes": "assets/characters/ama_owusu_visemes.png",
          "phoneId": "player_phone",
          "storyPath": "scenarios/demo_access_tour/ink/ama_phone.json",
          "currentKnot": "start",
          "livePreview": true,
          "eventMappings": [
            <%# The event carries the item's type; the cloner is the tour's only rfid_cloner. %>
            { "eventPattern": "item_picked_up:rfid_cloner", "onceOnly": true, "setGlobal": { "cloner_held": true } },
            <%# P6: the cake went down outside the open plan. No onceOnly: the cooldown spaces repeats. %>
            { "eventPattern": "magnet_placed:cake", "condition": "data.roomId !== 'open_plan'", "cooldown": 30000,
              "sendTimedMessage": { "delay": 4000, "message": "Take the cake through to the open plan, where the desks are.", "targetKnot": "hint_cake" } },
            <%# Julian's session lost when the front desk was signed out (a box-route session has no
                fromPcId; signing out of julian_pc itself has reason sign_out). Not onceOnly: a
                second loss resets julian_back. %>
            { "eventPattern": "pc_signed_out:julian_pc",
              "condition": "data.reason === 'link_dropped' && data.fromPcId === 'reception_pc'",
              "setGlobal": { "julian_lost_with_desk": true, "julian_back": false } },
            { "eventPattern": "pc_signed_in:julian_pc", "condition": "globalVars.julian_lost_with_desk === true",
              "setGlobal": { "julian_back": true } },
            <%# Stop 15: Thandiwe's laptop picks the copy and the key page takes the Staff key. The
                secret is the psk's own render (@random_password, same binding as networks.office_lan),
                never a pasted copy. No captureProof on Thandiwe: the address is an SSID, so this
                mapping's own proof counts. %>
            { "eventPattern": "npc_used:thandiwe_laptop", "condition": "globalVars.staff_twin_up === true", "onceOnly": true,
              "addCapture": {
                "targetId": "staff_wifi_key", "kind": "credential", "roleLabel": "Merrin & Sallow, reception",
                "host": "MerrinSallow-Staff, rogue access point", "address": "MerrinSallow-Staff",
                "secret": "<%= @random_password %>",
                "note": "Thandiwe's laptop picked the copy and the key page took the Staff key (proof: planted).",
                "proof": { "planted": "kit_rogue_ap" }
              },
              "completeTask": "t_capture_key" },
            <%# Slice 5: every mapping that sets a global, completes a task or sends a timed text
                lives here, because ama_phone registers with reception at load (the other rooms
                load later). Delays 4000 to 6000 ms so two that fire together never land at once.
                A skipIfGlobal goes inside sendTimedMessage. %>
            { "eventPattern": "pc_signed_out:reception_pc", "condition": "data.reason === 'sign_out'", "setGlobal": { "front_desk_signed_out": true } },
            { "eventPattern": "network_device_unplugged:meeting_jack", "condition": "data.endedPcIds.includes('julian_pc')", "setGlobal": { "julian_ended_by_unplug": true } },
            { "eventPattern": "device_hidden:kit_rogue_ap", "setGlobal": { "ap_planted": true } },
            { "eventPattern": "card_cloned", "condition": "data.cardName === \"Lorna Easton FAC card\"", "completeTask": "t_copy_badge" },
            { "eventPattern": "network_device_unplugged:meeting_jack", "completeTask": "t_unplug" },
            { "eventPattern": "network_foothold_gained", "condition": "data.via === 'implant'", "completeTask": "t_implant" },
            { "eventPattern": "global_variable_changed:has_julian_rdp", "condition": "value === true", "onceOnly": true,
              "sendTimedMessage": { "delay": 4000, "message": "Before you use that, sign out of Delphine's PC.", "targetKnot": "hint_sign_out", "skipIfGlobal": "done_t_julian_pc" } },
            { "eventPattern": "pc_in_use:thandiwe_laptop", "onceOnly": true, "setGlobal": { "saw_in_use": true },
              "sendTimedMessage": { "delay": 4000, "message": "She's signed in and sitting right there. Read the coffee rota on the wall, then try her laptop while she's away.", "targetKnot": "hint_open_session" } },
            { "eventPattern": "network_foothold_gained:meeting_jack", "onceOnly": true,
              "sendTimedMessage": { "delay": 5000, "message": "Box is talking. Have a look at the network view before you sign in anywhere.", "targetKnot": "hint_network_view" } },
            { "eventPattern": "usb_refused:usb_hub", "onceOnly": true,
              "sendTimedMessage": { "delay": 4000, "message": "Storage is blocked on that hub. A keyboard isn't storage.", "targetKnot": "hint_injector" } },
            { "eventPattern": "network_device_refused:managed_port", "condition": "data.reason === 'port_security'", "onceOnly": true,
              "sendTimedMessage": { "delay": 4000, "message": "That port knows what's meant to be plugged into it. Try the patch panel, see where its spare port goes." } },
            { "eventPattern": "network_device_unplugged:meeting_jack", "condition": "globalVars.tour_full !== true", "onceOnly": true,
              "sendTimedMessage": { "delay": 6000, "message": "Box is out. Have a last look if you like, then come back to reception." } },
            { "eventPattern": "network_device_unplugged:meeting_jack", "condition": "globalVars.tour_full === true", "onceOnly": true,
              "sendTimedMessage": { "delay": 6000, "message": "Box is out. Take it to the comms cupboard and see what the ports in there make of it. Then come back to reception.", "targetKnot": "hint_ports" } }
          ]
        },
        {
          "id": "delphine",
          "voice": { "name": "Despina", "style": "Merrin & Sallow's front-of-house coordinator, in her 30s, poised and polite under a little pressure at the desk. Speak with a consistent southern English accent with a light Mediterranean lilt throughout — do not shift to any other accent.", "language": "en-GB" },
          "displayName": "Delphine Arvanitis",
          "npcType": "person",
          "position": { "x": 4.9, "y": 3.1 },
          "behavior": { "immovable": true },
          "spriteSheet": "delphine_arvanitis",
          "spriteTalk": "assets/characters/delphine_arvanitis_talk.png",
          "spriteVisemes": "assets/characters/delphine_arvanitis_visemes.png",
          "storyPath": "scenarios/demo_access_tour/ink/delphine.json",
          "currentKnot": "start",
          "role": "reception",
          "creds": { "username": "darvanitis", "password": "<%= delphine_pw %>" },
          "habits": { "writesDown": true }
        }
