<%
# demo_access_tour, slice 1 (DEMO_ACCESS_TOUR_PLAN.md section 5, item 1): the seven rooms, their
# doors and locks, the cast placed static, the player's phone and the signs. Slice 2 (item 2)
# adds accounts, the kit, the networks, the sign-in PCs' owners and contents and Lorna's card.
# Slice 3 (item 3) adds the devices (injector, USB stick, rogue AP, capture tablet, the USB hub and
# implant socket, the comms cupboard's ports) and the Staff Wi-Fi capture. Office life and the real
# ink come in later slices.
# The keypad PIN is rendered per game; it is not written anywhere else in this slice.
server_room_pin = @random_pin
# Staff passwords. Each is one literal, written once here and interpolated where it is shown
# (an NPC's creds are server-only; facilities.txt on reception_pc repeats Lorna's).
delphine_pw = "Merrin-Desk-4417"
thandiwe_pw = "Kestrel-Loom-82"
yasmin_pw   = "Saffron-Ledger-31"
lorna_pw    = "Faclab-Tarn-905"
julian_pw   = "Quillon-Fathom-Harrow-6628-Brae"
%>
{
  "scenario_brief": "DEMO: Access tour\n\nMerrin & Sallow, a small firm whose IT is run by Ama Owusu of Fenlow Managed IT. The partners want a walk-round access test of the office. Ama stays at reception; you do the walking.",
  "endGoal": "Demo only: walk the access tour.",
  "startRoom": "reception",
  "show_scenario_brief": "on_resume",
  "startPosition": { "x": 5.4, "y": 7 },
  "npcNeedsSeed": "demo_access_tour",
  "npcWindupMs": 0,

  <%# Lights on everywhere (the default look), so the planted rogue AP can show its status LED. %>
  "lighting": { "enabled": true, "defaultMode": "on" },

  "startItemsInInventory": [
    { "type": "phone", "name": "Your phone", "takeable": true, "phoneId": "player_phone",
      "npcIds": ["ama_phone"], "observations": "Your work phone, with Ama a message away." },
    <%# The cake lever (office-life cake spec, minimal variant): held from the start, so nobody
        knows of it until the player drops it. Dropped in the open plan it empties both desks.
        servings 2 / perPerson 1; cake_servings below must equal servings. %>
    { "type": "cake1", "id": "cake", "name": "Cake", "takeable": true, "droppable": true,
      "observations": "A cake for the office. Choose Drop here in your inventory to put it out where people will see it.",
      "affordance": {
        "satisfies": ["hunger"], "restores": 40, "useSeconds": 12, "capacity": 3, "chatter": "cake", "useSound": "eat_snack",
        "magnet": { "tempt": 30, "servings": 2, "perPerson": 1, "announce": "news_cake", "newsRadius": 5 }
      } }
  ],

  <%# Spoken pools. Bark text lives in these pools and in NPC JSON, never in engine text. %>
  "ttsPregenerateChatter": true,
  "chatter": {
    "coffee": ["Go on, after you.", "Is there any milk left?", "Strong one today?"],
    "cake": ["Who's the cake from?", "Go on, just a small slice.", "Whose birthday is it?", "This is really good."],
    "news_cake": ["Someone's brought a cake in!", "There's cake going, if you're quick.", "Cake! It's somebody's birthday."],
    "grumble_gone": ["Missed it."]
  },

  "defaultPolicy": "desk",

  "policies": {
    <%# No autoLockMin anywhere: a policy without it never auto-locks a password or credential
        session (plan C5). A screen locks only when Yasmin leaves or the presenter presses Lock. %>
    "desk": { "maxAttempts": null, "usb": "storage_blocked", "remote": "allowed", "social": "allowed" },
    "partner": { "maxAttempts": null, "usb": "storage_blocked", "remote": "allowed", "social": "allowed" },
    "infra": { "maxAttempts": null, "usb": "storage_blocked", "remote": "allowed", "social": "allowed" }
  },

  <%# The Staff psk is @random_password. The capture mapping on ama_phone renders @random_password
      again in the same binding (never a pasted copy of the value). Guest has an SSID and no psk: an open network. %>
  "networks": {
    "office_lan": { "name": "Merrin & Sallow office LAN", "wifi": { "ssid": "MerrinSallow-Staff", "psk": "<%= @random_password %>" } },
    "server_lan": { "name": "Server network" },
    "guest": { "name": "Merrin & Sallow guest network", "wifi": { "ssid": "MerrinSallow-Guest" } }
  },

  "networkLinks": [
    ["office_lan", "server_lan"]
  ],

  "social": { "captures": { "revealSecret": true } },

  <%# Shares are resources. client_letters is open to anyone on office_lan. finance_share admits
      the roles finance and partner: a session at yasmin_pc or julian_pc, not the bare foothold. %>
  "resources": {
    "client_letters": {
      "kind": "file_share",
      "name": "Client-Letters",
      "host": "MS-FS01",
      "network": "office_lan",
      "observations": "The firm's outgoing client letters. Any device on the network can list the folder.",
      "contents": [
        {
          "type": "text_file",
          "id": "letter_template",
          "name": "letter_template.txt",
          "takeable": true,
          "readable": true,
          "text": "Merrin & Sallow\n\nDear [client],\n\nThank you for your instructions. We will be in touch shortly.\n\nYours sincerely,",
          "observations": "The firm's standard client letter."
        }
      ]
    },
    "finance_share": {
      "kind": "file_share",
      "name": "Finance",
      "host": "MS-FS01",
      "network": "office_lan",
      "access": { "roles": ["finance", "partner"] },
      "observations": "The firm's finance folder. It lists only to finance and the partners.",
      "contents": [
        {
          "type": "text_file",
          "id": "q3_accounts",
          "name": "q3_accounts.txt",
          "takeable": true,
          "readable": true,
          "text": "Quarter 3 management accounts (draft).\n\nFees billed ahead of plan. Two clients late paying; Julian to chase.",
          "observations": "A draft of the quarter's accounts."
        }
      ]
    }
  },

  "credentials": {
    "lorna_door_pw": {
      "kind": "password",
      "account": "lorna",
      "label": "Lorna's door controller password",
      "proof": { "session": "reception_pc" },
      "foundIn": "facilities_txt"
    },
    "julian_rdp": {
      "kind": "saved_connection",
      "account": "julian",
      "connectsTo": "julian_pc",
      "label": "julian.rdp",
      "proof": { "held": "julian_rdp_file" }
    }
  },

  "globalVariables": {
    "cake_servings": 2,
    "hub_stick_accepted": false,
    "cloner_held": false,
    "seen_julian_rdp": false,
    "has_julian_rdp": false,
    "staff_twin_up": false,
    "ap_planted": false,
    "julian_lost_with_desk": false,
    "julian_back": false,
    "tour_full": false,
    "front_desk_signed_out": false,
    "saw_in_use": false,
    "julian_ended_by_unplug": false,
    "tour_debriefed": false,
    "done_t_meet_ama": false,
    "done_t_kit": false,
    "done_t_front_desk": false,
    "done_t_copy_badge": false,
    "done_t_comms": false,
    "done_t_drop_box": false,
    "done_t_julian_pc": false,
    "done_t_unplug": false,
    "done_t_server_room": false,
    "done_t_open_session": false,
    "done_t_yasmin_pc": false,
    "done_t_door_controller": false,
    "done_t_implant": false,
    "done_t_capture_key": false,
    "done_t_staff_wifi": false,
    "done_t_guest_port": false,
    "done_t_debrief": false
  },

  "objectives": [
    {
      "aimId": "aim_office",
      "title": "Test the office",
      "description": "Get past the doors: the meeting room, the front desk, a copied staff badge and the comms cupboard.",
      "status": "active",
      "order": 0,
      "tasks": [
        { "taskId": "t_meet_ama", "title": "Talk to Ama at reception", "type": "npc_conversation", "targetNPC": "ama", "status": "active",
          "onComplete": { "setGlobal": { "done_t_meet_ama": true } } },
        { "taskId": "t_kit", "title": "Get into the meeting room", "type": "unlock_room", "targetRoom": "meeting_room", "status": "active",
          "onComplete": { "setGlobal": { "done_t_kit": true } } },
        { "taskId": "t_front_desk", "title": "Sign in at the front desk", "type": "unlock_object", "targetObject": "reception_pc", "status": "active",
          "onComplete": { "setGlobal": { "done_t_front_desk": true } } },
        { "taskId": "t_copy_badge", "title": "Copy a staff badge", "type": "manual", "status": "active",
          "onComplete": { "setGlobal": { "done_t_copy_badge": true } } },
        { "taskId": "t_comms", "title": "Get into the comms cupboard", "type": "unlock_room", "targetRoom": "comms_cupboard", "status": "active",
          "onComplete": { "setGlobal": { "done_t_comms": true } } }
      ]
    },
    {
      "aimId": "aim_network",
      "title": "Test the network",
      "description": "Plug the drop box in, reach the partner's PC through it, and pull the box out to see what drops.",
      "status": "active",
      "order": 1,
      "tasks": [
        { "taskId": "t_drop_box", "title": "Plug the drop box into a live port", "type": "unlock_object", "targetObject": "meeting_jack", "status": "active",
          "onComplete": { "setGlobal": { "done_t_drop_box": true } } },
        { "taskId": "t_julian_pc", "title": "Connect to the partner's PC", "type": "unlock_object", "targetObject": "julian_pc", "status": "active",
          "onComplete": { "setGlobal": { "done_t_julian_pc": true } } },
        { "taskId": "t_unplug", "title": "Unplug the drop box", "type": "manual", "status": "active",
          "onComplete": { "setGlobal": { "done_t_unplug": true } } }
      ]
    },
    {
      "aimId": "aim_around",
      "title": "Look around (optional)",
      "optional": true,
      "description": "Optional. The server room, a laptop left signed in, and a locked screen.",
      "status": "active",
      "order": 2,
      "tasks": [
        { "taskId": "t_server_room", "title": "Get into the server room", "type": "unlock_room", "targetRoom": "server_room", "optional": true, "status": "active",
          "onComplete": { "setGlobal": { "done_t_server_room": true } } },
        { "taskId": "t_open_session", "title": "Use a laptop its owner left signed in", "type": "unlock_object", "targetObject": "thandiwe_laptop", "optional": true, "status": "active",
          "onComplete": { "setGlobal": { "done_t_open_session": true } } },
        { "taskId": "t_yasmin_pc", "title": "Get past a locked screen", "type": "unlock_object", "targetObject": "yasmin_pc", "optional": true, "status": "active",
          "onComplete": { "setGlobal": { "done_t_yasmin_pc": true } } }
      ]
    },
    {
      "aimId": "aim_deeper",
      "title": "Go deeper (optional)",
      "optional": true,
      "description": "Optional. The door controller, the front desk implant, the rogue access point and the comms cupboard's ports.",
      "status": "active",
      "order": 3,
      "tasks": [
        { "taskId": "t_door_controller", "title": "Sign in to the door controller", "type": "unlock_object", "targetObject": "door_controller", "optional": true, "status": "active",
          "onComplete": { "setGlobal": { "done_t_door_controller": true } } },
        { "taskId": "t_implant", "title": "Get a foothold through the front desk PC", "type": "manual", "optional": true, "status": "active",
          "onComplete": { "setGlobal": { "done_t_implant": true } } },
        { "taskId": "t_capture_key", "title": "Capture the Staff Wi-Fi key", "type": "manual", "optional": true, "status": "active",
          "onComplete": { "setGlobal": { "done_t_capture_key": true } } },
        { "taskId": "t_staff_wifi", "title": "Join Staff Wi-Fi", "type": "unlock_object", "targetObject": "staff_ap", "optional": true, "status": "active",
          "onComplete": { "setGlobal": { "done_t_staff_wifi": true } } },
        { "taskId": "t_guest_port", "title": "Find where the patch panel's spare port goes", "type": "unlock_object", "targetObject": "guest_vlan_port", "optional": true, "status": "active",
          "onComplete": { "setGlobal": { "done_t_guest_port": true } } }
      ]
    },
    {
      "aimId": "aim_wrap",
      "title": "Report back",
      "description": "Find Ama at reception once the office and network aims are done.",
      "status": "locked",
      "unlockCondition": { "aimsCompleted": ["aim_office", "aim_network"] },
      "order": 4,
      "missionConclusion": true,
      "concludeRequires": {},
      "conclusionScreen": { "type": "bond_visualiser" },
      "tasks": [
        { "taskId": "t_debrief", "title": "Report back to Ama", "type": "npc_conversation", "targetNPC": "ama", "status": "active",
          "onComplete": { "setGlobal": { "done_t_debrief": true } } }
      ]
    }
  ],

  "music": {
    "events": [
      {
        "trigger": "conversation_closed:ama",
        "condition": "globalVars.tour_debriefed === true",
        "playlist": "victory",
        "track": "Ghost in the Wire",
        "fade": true,
        "statusText": "TOUR DONE",
        "closingCard": {
          "lines": [
            "Merrin & Sallow: access tour complete."
          ]
        },
        "credits": [
          { "text": "ACCESS TOUR COMPLETE", "style": "title" },
          { "text": "MERRIN & SALLOW", "style": "subtitle" },
          { "text": "" },
          { "section": "WHAT THE TOUR SHOWED", "lines": [
            { "text": "Doors: the visitor card opened the meeting room and nothing else", "condition": "globalVars.done_t_kit === true" },
            { "text": "Front desk: a sticky note signed in to the reception PC", "condition": "globalVars.done_t_front_desk === true" },
            { "text": "Drop box: a live wall port put the box on the office network", "condition": "globalVars.done_t_drop_box === true" },
            { "text": "Saved connection: the partner's PC opened from a file on the front desk", "condition": "globalVars.done_t_julian_pc === true" },
            { "text": "Badge cloning: the facilities card copied and used on the comms cupboard", "condition": "globalVars.done_t_copy_badge === true && globalVars.done_t_comms === true" },
            { "text": "Door controller: reached through the partner's PC, signed in with the password from facilities.txt", "condition": "globalVars.done_t_door_controller === true" },
            { "text": "Open session: a laptop left signed in while its owner was away", "condition": "globalVars.done_t_open_session === true" },
            { "text": "Locked screen: a note on the desk got past it", "condition": "globalVars.done_t_yasmin_pc === true" },
            { "text": "Implant: a keystroke injector gave a foothold through the front desk PC", "condition": "globalVars.done_t_implant === true" },
            { "text": "Rogue access point: the Staff Wi-Fi key captured from a copy of the network", "condition": "globalVars.done_t_capture_key === true" },
            { "text": "Staff Wi-Fi: joined with the captured key", "condition": "globalVars.done_t_staff_wifi === true" },
            { "text": "Port security: the managed port refused the box, the patch panel's guest port took it", "condition": "globalVars.done_t_guest_port === true" },
            { "text": "Clean-up: the box came out and the sessions through it went with it", "condition": "globalVars.done_t_unplug === true" }
          ] }
        ]
      }
    ]
  },

  "rooms": {

    "reception": {
      "type": "room_aw_merrin_lobby",
      <%# The planted AP's status LED, drawn on its overlay once it is tucked in a plant. Offsets measured
          against rogue_ap_tucked, as in lab_physical_pentest. %>
      "lighting": {
        "emitters": {
          "planted_rogue_ap": { "color": "#3fa8ff", "radius": 5, "intensity": 0.7, "effect": "blink", "above": true, "offsetX": -4, "offsetY": 3 }
        }
      },
      "door_sign": "Reception",
      "connections": { "north": "open_plan", "west": "partner_office", "east": "meeting_room" },
      "objects": [
        <%# The lobby map's own pc8 (on the west table) and two planters stay as they are. The
            front-desk PC sits on the counter's left end, and the two plants (hiding spots for the
            rogue AP in a later slice) stand on clear floor beside the counter. %>
        {
          "type": "pc",
          "id": "reception_pc",
          "name": "Front desk PC",
          "sprite": "pc10",
          "position": { "x": 3.5, "y": 3.95 },
          "takeable": false,
          "interactable": true,
          "active": true,
          "owner": "delphine",
          "host": "MS-FRONT-01",
          "network": "office_lan",
          "locked": true,
          "lockType": "login",
          "access": { "people": ["delphine"] },
          "observations": "Delphine's PC at the front desk.",
          "contents": [
            {
              "type": "text_file",
              "id": "facilities_txt",
              "name": "facilities.txt",
              "takeable": false,
              "readable": true,
              "text": "Facilities contacts and logins.\n\nLorna Easton (facilities): door controller, user leaston, password <%= lorna_pw %>\nCleaners: Tuesday and Friday evenings.",
              "observations": "A plain-text file of facilities contacts, left on the front desk PC."
            },
            {
              "type": "text_file",
              "id": "julian_rdp_file",
              "name": "julian.rdp",
              "takeable": true,
              "droppable": true,
              "readable": true,
              "credential": "julian_rdp",
              "onRead": { "setVariable": { "seen_julian_rdp": true } },
              "onPickup": { "setVariable": { "has_julian_rdp": true } },
              "text": "Saved connection to Julian Sallow's PC. Copy it to keep the connection.",
              "observations": "A saved remote-desktop connection to the partner's PC."
            }
          ]
        },
        {
          "type": "keycard",
          "id": "visitor_card",
          "name": "Visitor card 07",
          "card_id": "VISITOR-07",
          "position": { "x": 1.3, "y": 6.3, "elevation": 30 },
          "takeable": true,
          "observations": "A visitor card from the front desk, numbered 07."
        },
        <%# Both access points sit on the back wall, well clear of the front desk and the doors. %>
        {
          "type": "pc",
          "id": "staff_ap",
          "name": "MerrinSallow-Staff access point",
          "sprite": "lw_staff_ap",
          "position": { "x": 5.0, "y": 1.6 },
          "takeable": false,
          "wifiAp": true,
          "network": "office_lan",
          "observations": "A wall access point. Its label reads MerrinSallow-Staff. It asks for a key."
        },
        {
          "type": "pc",
          "id": "guest_ap",
          "name": "MerrinSallow-Guest access point",
          "sprite": "lw_guest_ap",
          "position": { "x": 7.0, "y": 1.6 },
          "takeable": false,
          "wifiAp": true,
          "network": "guest",
          "observations": "A second access point on the wall. Its label reads MerrinSallow-Guest."
        },
        {
          "type": "notes1",
          "id": "guest_wifi_card",
          "name": "Reception Wi-Fi card",
          "sprite": "lw_guest_card",
          "position": { "x": 2.5, "y": 5.95, "elevation": 30 },
          "takeable": false,
          "readable": true,
          "readDisplay": "gameDisplay",
          "addToNotes": false,
          "text": "Visitors: connect your laptop to the wireless.\nNetwork name (SSID): MerrinSallow-Guest",
          "observations": "A printed card on the front desk with the guest Wi-Fi name."
        },
        {
          "type": "plant",
          "id": "reception_plant_west",
          "name": "Plant by the front desk",
          "sprite": "planter_fig1",
          "position": { "x": 2.1, "y": 3.3 },
          "takeable": false,
          "interactable": true,
          "active": true,
          "observations": "A leafy plant in a planter at the end of the front desk, thick enough to hide a small box behind the leaves."
        },
        {
          "type": "plant",
          "id": "reception_plant_east",
          "name": "Plant beside the front desk",
          "sprite": "plant-large11",
          "position": { "x": 7.8, "y": 3.95 },
          "takeable": false,
          "interactable": true,
          "active": true,
          "observations": "A big leafy plant at the other end of the front desk, thick enough to hide a small box behind the leaves."
        },
        {
          "type": "notes",
          "id": "sign_meeting_room",
          "name": "Sign: meeting room",
          "sprite": "uni_doorcard1",
          "position": { "x": 9.0, "y": 2.9 },
          "takeable": false,
          "readable": true,
          "readDisplay": "gameDisplay",
          "addToNotes": false,
          "observations": "A card holder beside the meeting room door.",
          "text": "Booked: Fenlow Managed IT, all day."
        },
        <%# Two USB sockets beside the front-desk PC (an item plant cannot sit on the PC itself). The
            hub takes the stick only: the desk policy blocks storage, so the engine's own refusal line
            shows. The socket takes the injector, which presents as a keyboard and gets past. %>
        {
          "type": "usb_bowl1",
          "id": "usb_hub",
          "name": "USB hub",
          "position": { "x": 4.4, "y": 4.4 },
          "takeable": false,
          "interactable": true,
          "active": true,
          "policy": "desk",
          "requiresItem": "demo_stick",
          "requiresItemHint": "You need a USB stick to plug in here.",
          "triggerOnInteract": [
            { "type": "set_global", "key": "hub_stick_accepted", "value": true }
          ],
          "observations": "A USB hub on the front desk, wired to Delphine's PC."
        },
        {
          "type": "pc",
          "id": "implant_socket",
          "name": "USB socket by the front desk PC",
          "sprite": "usb_bowl1",
          "position": { "x": 5.5, "y": 4.3 },
          "takeable": false,
          "interactable": true,
          "active": true,
          "requiresItem": "kit_injector",
          "requiresItemHint": "You would need a device to plug in here.",
          "observations": "A spare USB socket on the front desk. Useful only while you are signed in at the front desk PC.",
          "triggerOnInteract": [
            {
              "type": "confirm_action",
              "text": "Plug the keystroke injector into the front desk PC? It only types into a PC you are signed in at, and it is used up once it runs.",
              "confirmLabel": "Plug it in",
              "cancelLabel": "Leave it",
              "onConfirm": [
                { "type": "grant_foothold", "pc": "reception_pc", "needsSession": true, "needsHeld": "kit_injector" }
              ]
            }
          ]
        },
        <%# The rogue AP's console. Not placed from room data: hiddenWith ties it to kit_rogue_ap's
            hideable, and the engine draws it only as the overlay on whichever reception plant the
            player hid the kit in. No secret in it: the Staff key is the capture on ama_phone. %>
        {
          "type": "pc",
          "id": "planted_rogue_ap",
          "name": "Planted rogue AP",
          "sprite": "rogue_ap_planted",
          "hiddenWith": "kit_rogue_ap",
          "takeable": false,
          "interactable": true,
          "active": true,
          "wifiTwin": true,
          "observations": "Your pocket rogue AP, tucked into the plant. Click the plant to open its console.",
          "apScan": [
            {
              "ssid": "MerrinSallow-Staff", "security": "WPA2", "signal": 4, "clients": 3, "inScope": true,
              "cloneGlobals": { "staff_twin_up": true },
              "cloneLog": "Copy of MerrinSallow-Staff up (open), showing the key page. Waiting for someone to pick the copy.",
              "knownClients": [ { "npcId": "thandiwe", "label": "Thandiwe's laptop" } ]
            },
            {
              "ssid": "MerrinSallow-Guest", "security": "WPA2", "signal": 3, "clients": 1, "inScope": true,
              "cloneGlobals": { "staff_twin_up": false },
              "cloneLog": "Copy of MerrinSallow-Guest up (open). It harvests nothing worth having: the guest network has no key, and staff laptops hold the staff network, not this one."
            },
            {
              "ssid": "BT-Hub-4F2A", "security": "WPA2", "signal": 2, "clients": 2, "inScope": false,
              "refusal": "Out of scope. BT-Hub-4F2A belongs to a neighbour, not Merrin & Sallow."
            },
            {
