<%
# demo_access_tour, slice 1 (DEMO_ACCESS_TOUR_PLAN.md section 5, item 1): the seven rooms, their
# doors and locks, the cast placed static, the player's phone and the signs. Slice 2 (item 2)
# adds accounts, the kit, the networks, the sign-in PCs' owners and contents and Lorna's card.
# Devices, office life and the real ink come in later slices.
# The keypad PIN is rendered per game; it is not written anywhere else in this slice.
server_room_pin = @random_pin
# Staff passwords. Each is one literal, written once here and interpolated where it is shown
# (an NPC's creds are server-only; facilities.txt on reception_pc repeats Lorna's).
delphine_pw = "Merrin-Desk-4417"
thandiwe_pw = "Kestrel-Loom-82"
yasmin_pw   = "Saffron-Ledger-31"
lorna_pw    = "Faclab-Tarn-905"
julian_pw   = "Quillon-Fathom-Harrow-6628-Brae"
%>
{
  "scenario_brief": "DEMO: Access tour\n\nMerrin & Sallow, a small firm whose IT is run by Ama Owusu of Fenlow Managed IT. The partners want a walk-round access test of the office. Ama stays at reception; you do the walking.",
  "endGoal": "Demo only: walk the access tour.",
  "startRoom": "reception",
  "startPosition": { "x": 5.4, "y": 7 },
  "npcNeedsSeed": "demo_access_tour",
  "npcWindupMs": 0,

  "startItemsInInventory": [
    { "type": "phone", "name": "Your phone", "takeable": true, "phoneId": "player_phone",
      "npcIds": ["ama_phone"], "observations": "Your work phone, with Ama a message away." }
  ],

  "defaultPolicy": "desk",

  "policies": {
    <%# No autoLockMin anywhere: a policy without it never auto-locks a password or credential
        session (plan C5). A screen locks only when Yasmin leaves or the presenter presses Lock. %>
    "desk": { "maxAttempts": null, "usb": "storage_blocked", "remote": "allowed", "social": "allowed" },
    "partner": { "maxAttempts": null, "usb": "storage_blocked", "remote": "allowed", "social": "allowed" },
    "infra": { "maxAttempts": null, "usb": "storage_blocked", "remote": "allowed", "social": "allowed" }
  },

  <%# The Staff psk is @random_password, used for this psk only. The capture mapping in a later
      slice repeats the same render. Guest has an SSID and no psk: an open network. %>
  "networks": {
    "office_lan": { "name": "Merrin & Sallow office LAN", "wifi": { "ssid": "MerrinSallow-Staff", "psk": "<%= @random_password %>" } },
    "server_lan": { "name": "Server network" },
    "guest": { "name": "Merrin & Sallow guest network", "wifi": { "ssid": "MerrinSallow-Guest" } }
  },

  "networkLinks": [
    ["office_lan", "server_lan"]
  ],

  "social": { "captures": { "revealSecret": true } },

  <%# Shares are resources. client_letters is open to anyone on office_lan. finance_share admits
      the roles finance and partner: a session at yasmin_pc or julian_pc, not the bare foothold. %>
  "resources": {
    "client_letters": {
      "kind": "file_share",
      "name": "Client-Letters",
      "host": "MS-FS01",
      "network": "office_lan",
      "observations": "The firm's outgoing client letters. Any device on the network can list the folder.",
      "contents": [
        {
          "type": "text_file",
          "id": "letter_template",
          "name": "letter_template.txt",
          "takeable": true,
          "readable": true,
          "text": "Merrin & Sallow\n\nDear [client],\n\nThank you for your instructions. We will be in touch shortly.\n\nYours sincerely,",
          "observations": "The firm's standard client letter."
        }
      ]
    },
    "finance_share": {
      "kind": "file_share",
      "name": "Finance",
      "host": "MS-FS01",
      "network": "office_lan",
      "access": { "roles": ["finance", "partner"] },
      "observations": "The firm's finance folder. It lists only to finance and the partners.",
      "contents": [
        {
          "type": "text_file",
          "id": "q3_accounts",
          "name": "q3_accounts.txt",
          "takeable": true,
          "readable": true,
          "text": "Quarter 3 management accounts (draft).\n\nFees billed ahead of plan. Two clients late paying; Julian to chase.",
          "observations": "A draft of the quarter's accounts."
        }
      ]
    }
  },

  "credentials": {
    "lorna_door_pw": {
      "kind": "password",
      "account": "lorna",
      "label": "Lorna's door controller password",
      "proof": { "session": "reception_pc" },
      "foundIn": "facilities_txt"
    },
    "julian_rdp": {
      "kind": "saved_connection",
      "account": "julian",
      "connectsTo": "julian_pc",
      "label": "julian.rdp",
      "proof": { "held": "julian_rdp_file" }
    }
  },

  "globalVariables": {
    "cloner_held": false,
    "seen_julian_rdp": false,
    "has_julian_rdp": false
  },

  "objectives": [
    {
      "aimId": "aim_office",
      "title": "Test the office",
      "description": "Slice 1 stub: the full aims and tasks arrive with the objectives slice.",
      "status": "active",
      "order": 0,
      "tasks": [
        { "taskId": "t_kit", "title": "Get into the meeting room", "type": "unlock_room", "targetRoom": "meeting_room", "status": "active" }
      ]
    }
  ],

  "rooms": {

    "reception": {
      "type": "room_aw_merrin_lobby",
      "door_sign": "Reception",
      "connections": { "north": "open_plan", "west": "partner_office", "east": "meeting_room" },
      "objects": [
        <%# The lobby map's own pc8 (on the west table) and two planters stay as they are. The
            front-desk PC sits on the counter's left end, and the two plants (hiding spots for the
            rogue AP in a later slice) stand on clear floor beside the counter. %>
        {
          "type": "pc",
          "id": "reception_pc",
          "name": "Front desk PC",
          "sprite": "pc10",
          "position": { "x": 3.5, "y": 3.95 },
          "takeable": false,
          "interactable": true,
          "active": true,
          "owner": "delphine",
          "host": "MS-FRONT-01",
          "network": "office_lan",
          "locked": true,
          "lockType": "login",
          "access": { "people": ["delphine"] },
          "observations": "Delphine's PC at the front desk.",
          "contents": [
            {
              "type": "text_file",
              "id": "facilities_txt",
              "name": "facilities.txt",
              "takeable": false,
              "readable": true,
              "text": "Facilities contacts and logins.\n\nLorna Easton (facilities): door controller, user leaston, password <%= lorna_pw %>\nCleaners: Tuesday and Friday evenings.",
              "observations": "A plain-text file of facilities contacts, left on the front desk PC."
            },
            {
              "type": "text_file",
              "id": "julian_rdp_file",
              "name": "julian.rdp",
              "takeable": true,
              "droppable": true,
              "needsTag": "julian_rdp_file",
              "readable": true,
              "credential": "julian_rdp",
              "onRead": { "setVariable": { "seen_julian_rdp": true } },
              "onPickup": { "setVariable": { "has_julian_rdp": true } },
              "text": "Saved connection to Julian Sallow's PC. Copy it to keep the connection.",
              "observations": "A saved remote-desktop connection to the partner's PC."
            }
          ]
        },
        {
          "type": "keycard",
          "id": "visitor_card",
          "name": "Visitor card 07",
          "card_id": "VISITOR-07",
          "position": { "x": 6.0, "y": 4.0 },
          "takeable": true,
          "observations": "A visitor card from the front desk, numbered 07."
        },
        <%# Both access points sit on the back wall, well clear of the front desk and the doors. %>
        {
          "type": "pc",
          "id": "staff_ap",
          "name": "MerrinSallow-Staff access point",
          "sprite": "lw_staff_ap",
          "position": { "x": 5.0, "y": 1.6 },
          "takeable": false,
          "wifiAp": true,
          "network": "office_lan",
          "observations": "A wall access point. Its label reads MerrinSallow-Staff. It asks for a key."
        },
        {
          "type": "pc",
          "id": "guest_ap",
          "name": "MerrinSallow-Guest access point",
          "sprite": "lw_guest_ap",
          "position": { "x": 7.0, "y": 1.6 },
          "takeable": false,
          "wifiAp": true,
          "network": "guest",
          "observations": "A second access point on the wall. Its label reads MerrinSallow-Guest."
        },
        {
          "type": "notes1",
          "id": "guest_wifi_card",
          "name": "Reception Wi-Fi card",
          "sprite": "lw_guest_card",
          "position": { "x": 7.0, "y": 2.9 },
          "takeable": false,
          "readable": true,
          "readDisplay": "gameDisplay",
          "addToNotes": false,
          "text": "Visitors: connect your laptop to the wireless.\nNetwork name (SSID): MerrinSallow-Guest",
          "observations": "A printed card on the front desk with the guest Wi-Fi name."
        },
        {
          "type": "plant",
          "id": "reception_plant_west",
          "name": "Plant by the front desk",
          "sprite": "plant-large1",
          "position": { "x": 2.1, "y": 3.3 },
          "takeable": false,
          "observations": "A tall plant at the end of the front desk."
        },
        {
          "type": "plant",
          "id": "reception_plant_east",
          "name": "Plant beside the front desk",
          "sprite": "plant-large1",
          "position": { "x": 7.8, "y": 3.95 },
          "takeable": false,
          "observations": "A tall plant at the other end of the front desk."
        },
        {
          "type": "notes",
          "id": "sign_meeting_room",
          "name": "Sign: meeting room",
          "sprite": "uni_doorcard1",
          "position": { "x": 9.0, "y": 2.9 },
          "takeable": false,
          "readable": true,
          "readDisplay": "gameDisplay",
          "addToNotes": false,
          "observations": "A card holder beside the meeting room door.",
          "text": "Booked: Fenlow Managed IT, all day."
        }
      ],
      "npcs": [
        {
          "id": "ama",
          "displayName": "Ama Owusu",
          "npcType": "person",
          "position": { "x": 6.9, "y": 6.0 },
          "behavior": { "immovable": true },
          "spriteSheet": "ama_owusu",
          "spriteTalk": "assets/characters/ama_owusu_talk.png",
          "spriteVisemes": "assets/characters/ama_owusu_visemes.png",
          "storyPath": "scenarios/demo_access_tour/ink/ama.json",
          "currentKnot": "start"
        },
        {
          "id": "ama_phone",
          "displayName": "Ama Owusu",
          "npcType": "phone",
          "avatar": "assets/characters/ama_owusu_headshot.png",
          "spriteTalk": "assets/characters/ama_owusu_talk.png",
          "spriteVisemes": "assets/characters/ama_owusu_visemes.png",
          "phoneId": "player_phone",
          "storyPath": "scenarios/demo_access_tour/ink/ama_phone.json",
          "currentKnot": "start",
          "livePreview": true,
          "eventMappings": [
            <%# The event carries the item's type; the cloner is the tour's only rfid_cloner. %>
            { "eventPattern": "item_picked_up:rfid_cloner", "onceOnly": true, "setGlobal": { "cloner_held": true } }
          ]
        },
        {
          "id": "delphine",
          "displayName": "Delphine Arvanitis",
          "npcType": "person",
          "position": { "x": 4.9, "y": 3.1 },
          "behavior": { "immovable": true },
          "spriteSheet": "delphine_arvanitis",
          "spriteTalk": "assets/characters/delphine_arvanitis_talk.png",
          "spriteVisemes": "assets/characters/delphine_arvanitis_visemes.png",
          "storyPath": "scenarios/demo_access_tour/ink/delphine.json",
          "currentKnot": "start",
          "role": "reception",
          "creds": { "username": "darvanitis", "password": "<%= delphine_pw %>" },
          "habits": { "writesDown": true }
        }
      ]
    },

    "open_plan": {
      "type": "room_aw_merrin_sallow",
      "door_sign": "Open plan",
      "connections": { "south": "reception", "north": "server_room", "west": "kitchen", "east": "comms_cupboard" },
      "objects": [
        <%# Two desks against the north wall, square to it, each with its owner's chair on the
            south side. The map's conference table, studio chairs and kiosk are untouched. %>
        <%# The shared course map draws its plan chest over this room's north door. The map stays
            as it is: a scenario object with the chest's own sprite claims that slot (as the
            reception PC does for pc8) and puts the chest on the east wall, south of the kiosk and clear of the table chairs. %>
        {
          "type": "plan_chest",
          "id": "plan_chest",
          "name": "Plan chest",
          "sprite": "plan_chest2",
          "position": { "x": 7.8, "y": 6.5 },
          "takeable": false,
          "observations": "A flat plan chest. The drawers hold the studio's old drawings."
        },
        {
          "type": "table",
          "id": "desk_thandiwe",
          "name": "Thandiwe's desk",
          "sprite": "desk3",
          "position": { "x": 3.1, "y": 2.0 },
          "takeable": false,
          "observations": "A tidy desk in the west half of the open plan."
        },
        {
          "type": "pc",
          "id": "thandiwe_laptop",
          "name": "Thandiwe's laptop",
          "sprite": "laptop1",
          "position": { "x": 3.1, "y": 2.0, "elevation": 30 },
          "takeable": false,
          "interactable": true,
          "active": true,
          "owner": "thandiwe",
          "host": "MS-LAPTOP-TM",
          "network": "office_lan",
          "locked": true,
          "lockType": "login",
          "lockChance": 0,
          "access": { "people": ["thandiwe"] },
          "observations": "Thandiwe's laptop on her desk."
        },
        {
          "type": "chair",
          "id": "chair_thandiwe",
          "name": "Thandiwe's chair",
          "sprite": "aw_studio_chair_n1",
          "position": { "x": 3.3, "y": 3.3 },
          "takeable": false,
          "observations": "Thandiwe's chair."
        },
        {
          "type": "table",
          "id": "desk_yasmin",
          "name": "Yasmin's desk",
          "sprite": "desk3",
          "position": { "x": 5.3, "y": 2.0 },
          "takeable": false,
          "observations": "A neat desk in the east half of the open plan."
        },
        {
          "type": "pc",
          "id": "yasmin_pc",
          "name": "Yasmin's PC",
          "sprite": "pc3",
          "position": { "x": 5.3, "y": 2.0, "elevation": 30 },
          "takeable": false,
          "interactable": true,
          "active": true,
          "owner": "yasmin",
          "host": "MS-FIN-01",
          "network": "office_lan",
          "locked": true,
          "lockType": "login",
          "locksScreenOnLeave": true,
          "access": { "people": ["yasmin"] },
          "observations": "Yasmin's desktop PC."
        },
        {
          "type": "chair",
          "id": "chair_yasmin",
          "name": "Yasmin's chair",
          "sprite": "aw_studio_chair_n1",
          "position": { "x": 5.5, "y": 3.3 },
          "takeable": false,
          "observations": "Yasmin's chair."
        },
        {
          "type": "notes",
          "id": "rota_board",
          "name": "Coffee rota",
          "sprite": "rota_board1",
          "position": { "x": 8.3, "y": 1.1 },
          "takeable": false,
          "readable": true,
          "readDisplay": "gameDisplay",
          "addToNotes": false,
          "observations": "The coffee rota, on the wall by the window.",
          "text": "Coffee rota. Whoever's name is up makes the next round."
        }
      ],
      "npcs": [
        {
          "id": "thandiwe",
          "displayName": "Thandiwe Moyo",
          "npcType": "person",
          "position": { "x": 3.6, "y": 5.0 },
          "behavior": { "immovable": true },
          "spriteSheet": "thandiwe_moyo",
          "spriteTalk": "assets/characters/thandiwe_moyo_talk.png",
          "spriteVisemes": "assets/characters/thandiwe_moyo_visemes.png",
          "storyPath": "scenarios/demo_access_tour/ink/thandiwe.json",
          "currentKnot": "start",
          "role": "design",
          "creds": { "username": "tmoyo", "password": "<%= thandiwe_pw %>" }
        },
        {
          "id": "yasmin",
          "displayName": "Yasmin Chaudhry",
          "npcType": "person",
          "position": { "x": 5.8, "y": 5.0 },
          "behavior": { "immovable": true },
          "spriteSheet": "yasmin_chaudhry",
          "spriteTalk": "assets/characters/yasmin_chaudhry_talk.png",
          "spriteVisemes": "assets/characters/yasmin_chaudhry_visemes.png",
          "storyPath": "scenarios/demo_access_tour/ink/yasmin.json",
          "currentKnot": "start",
          "role": "finance",
          "creds": { "username": "ychaudhry", "password": "<%= yasmin_pw %>" },
          "habits": { "writesDown": true }
        },
        {
          "id": "lorna",
          "displayName": "Lorna Easton",
          "npcType": "person",
          "position": { "x": 8.2, "y": 5.8 },
          "behavior": { "immovable": true },
          "spriteSheet": "lorna_easton",
          "spriteTalk": "assets/characters/lorna_easton_talk.png",
          "spriteVisemes": "assets/characters/lorna_easton_visemes.png",
          "storyPath": "scenarios/demo_access_tour/ink/lorna.json",
          "currentKnot": "start",
          "role": "facilities",
          "creds": {
            "username": "leaston",
            "password": "<%= lorna_pw %>",
            "card": { "name": "Lorna Easton FAC card", "card_id": "FAC-LORNA-01", "rfid_protocol": "EM4100" }
          }
        }
      ]
    },

    "server_room": {
      "type": "room_servers",
      "door_sign": "Server room",
      "connections": { "south": "open_plan" },
      "locked": true,
      "lockType": "pin",
      "requires": "<%= server_room_pin %>",
      "objects": [
        {
          "type": "pc",
          "id": "door_controller",
          "name": "Door controller",
          "host": "MS-DOOR-01",
          "sprite": "network_rack1",
          "network": "server_lan",
          "policy": "infra",
          "position": { "x": 5.0, "y": 3.0 },
          "takeable": false,
          "locked": true,
          "lockType": "login",
          "headless": true,
          "access": { "roles": ["facilities"] },
          "observations": "A door controller with no screen or keyboard. It is managed over the network.",
          "contents": [
            {
              "type": "text_file",
              "id": "door_codes",
              "name": "Door codes",
              "takeable": false,
              "readable": true,
              "text": "Door controller: current codes.\n\nServer room keypad: <%= server_room_pin %>",
              "observations": "The door controller's code list."
            }
          ]
        }
      ]
    },

    "kitchen": {
      "type": "room_qdc_break",
      "door_sign": "Kitchen",
      "connections": { "east": "open_plan" },
      "objects": [
        <%# The coffee station is the map's own espresso machine on the north counter (claimed by
            type, so nothing doubles up). The approach cell is the floor in front of it; the queue
            runs east along the same row. %>
        {
          "type": "qdc_espresso",
          "id": "coffee_station",
          "name": "Coffee station",
          "takeable": false,
          "interactable": true,
          "active": true,
          "observations": "The kitchen's coffee machine, on the north counter.",
          "affordance": { "satisfies": "caffeine", "restores": 70, "useSeconds": 30, "useFrom": { "dx": 0, "dy": 1 }, "queue": { "cells": [{ "dx": 1, "dy": 0 }, { "dx": 2, "dy": 0 }], "maxWaitSeconds": 90 } }
        },
        {
          "type": "notes",
          "id": "sign_kitchen",
          "name": "Sign: coffee",
          "sprite": "hq_break_sign1",
          "position": { "x": 7.7, "y": 1.0 },
          "takeable": false,
          "readable": true,
          "readDisplay": "gameDisplay",
          "addToNotes": false,
          "observations": "A sign by the coffee machine.",
          "text": "Coffee's on a rota. The board's in the open plan. (Or just wait. Someone always comes in for coffee.)"
        }
      ],
      "npcs": [
        {
          "id": "julian",
          "displayName": "Julian Sallow",
          "npcType": "person",
          "position": { "x": 1.7, "y": 6.5 },
          "behavior": { "immovable": true },
          "spriteSheet": "julian_sallow",
          "spriteTalk": "assets/characters/julian_sallow_talk.png",
          "spriteVisemes": "assets/characters/julian_sallow_visemes.png",
          "storyPath": "scenarios/demo_access_tour/ink/julian.json",
          "currentKnot": "start",
          "role": "partner",
          "creds": { "username": "jsallow", "password": "<%= julian_pw %>" }
        }
      ]
    },

    "partner_office": {
      "type": "room_ceo",
      "door_sign": "Partner's office",
      "connections": { "east": "reception" },
      "locked": true,
      "lockType": "rfid",
      "access": { "people": ["julian"] },
      "lockedHint": "Julian's office. His card only.",
      "objects": [
        {
          "type": "pc",
          "id": "julian_pc",
          "name": "Julian's PC",
          "sprite": "pc10",
          "position": { "x": 4.0, "y": 3.3 },
          "takeable": false,
          "interactable": true,
          "active": true,
          "owner": "julian",
          "host": "MS-PARTNER-01",
          "network": "office_lan",
          "policy": "partner",
          "locked": true,
          "lockType": "login",
          "access": { "people": ["julian"] },
          "observations": "Julian's PC on the partner's desk.",
          "contents": [
            {
              "type": "text_file",
              "id": "partner_note",
              "name": "partners_notes.txt",
              "takeable": false,
              "readable": true,
              "text": "Partners' notes.\n\nOffice move is off until spring. Ask Ama about the server room cabling.",
              "observations": "A short notes file on the partner's desktop."
            }
          ]
        }
      ]
    },

    "meeting_room": {
      "type": "room_meeting",
      "door_sign": "Meeting room",
      "connections": { "west": "reception" },
      "locked": true,
      "lockType": "rfid",
      "requires": ["VISITOR-07"],
      "objects": [
        <%# Kit table (the map has four tables along the wall, items at y about 3.9). The existing
            table items sit at x about 2.65, 4.4, 6.25 and 7.1, so the kit takes the gaps. %>
        {
          "type": "rfid_cloner",
          "id": "rfid_cloner",
          "name": "RFID cloner",
          "sprite": "rfid_cloner",
          "position": { "x": 3.3, "y": 3.9375, "elevation": 30 },
          "takeable": true,
          "interactable": true,
          "active": true,
          "saved_cards": [],
          "observations": "A handheld RFID cloner. Keep it in a pocket, chat to someone close up, and it reads the card on them."
        },
        {
          "type": "pc",
          "id": "kit_dropbox",
          "name": "Network drop box",
          "sprite": "network_dropbox",
          "position": { "x": 5.3, "y": 3.9375, "elevation": 30 },
          "takeable": true,
          "rogueDevice": true,
