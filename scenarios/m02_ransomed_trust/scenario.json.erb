<%# =========================================================================
    Decision-weight timers — sparing use (see DECISION_WEIGHT_PLAN.md).
    Mission success is NEVER gated on these; they only ever change patient state.
    - bed2_ambient_drift : INVISIBLE. Mrs Hargreaves (ECMO) quietly worsens while the
      player works, and recovers when the incident resolves. Never fatal.
    - bed4_slow_path_window / bed4_death_window : the ONE visible countdown, and only
      on the deliberately-slow offline-keys recovery. The player can save Mr Pryce by
      switching him to manual ventilation (talk to him at the bedside) — that sets
      bed4_manually_stabilised, which cancels both. Fast recovery (ward_recovering)
      also cancels them. Losses, never game-over.
========================================================================= %>
  "timers": [
    {
      "id": "bed2_ambient_drift",
      "label": "Patient Deterioration",
      "delayMs": 600000,
      "condition": "!globalVars.ward_recovering",
      "setGlobal": { "patient_bed2_state": "distressed" },
      "showCountdown": false,
      "onceOnly": true
    },
    {
      "id": "bed4_slow_path_window",
      "label": "Bed 4 — critical",
      "delayMs": 100000,
      "startOnGlobal": "slow_path_window_open",
      "condition": "!globalVars.bed4_manually_stabilised && !globalVars.ward_recovering",
      "setGlobal": { "patient_bed4_state": "critical", "bed4_critical": true },
      "showCountdown": true,
      "onceOnly": true
    },
    {
      "id": "bed4_death_window",
      "label": "Bed 4 — failing",
      "delayMs": 45000,
      "startOnGlobal": "bed4_critical",
      "condition": "!globalVars.bed4_manually_stabilised && !globalVars.ward_recovering",
      "setGlobal": { "patient_bed4_deceased": true },
      "showCountdown": true,
      "onceOnly": true
    }
  ],

