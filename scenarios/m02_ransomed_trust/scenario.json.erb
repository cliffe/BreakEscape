            },
            {
              "eventPattern": "global_variable_changed:insider_asset_arrested",
              "condition": "value === true && !globalVars.insider_hostile",
              "onceOnly": true,
              "setVisible": false
            },
            {
              "eventPattern": "global_variable_changed:insider_asset_escaped",
              "condition": "value === true",
              "onceOnly": true,
              "setVisible": false
            },
            {
              "_comment": "Catch-up for the three mappings above, which only exist once this room has loaded. awaiting_ambush and insider_asset_escaped are saved globals, so reading them on room entry covers an event that fired before the player ever came here (the terminal sits in this room, so that is rare). The ambush plays here, on arrival, with Reeves already standing by the terminal. The first mapping above stays for when the room is loaded and the player is standing in it (in_conference_room, kept by closing_debrief_trigger); if the room is loaded but the player is next door, this entry plays it on arrival. The ambush ink sets insider_confronted as it starts, so the two entries cannot both play it.",
              "eventPattern": "room_entered:conference_room",
              "condition": "globalVars.awaiting_ambush === true && !globalVars.mission_complete && !globalVars.insider_identified && !globalVars.insider_confronted",
              "onceOnly": true,
