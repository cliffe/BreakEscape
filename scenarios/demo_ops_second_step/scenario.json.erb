            { "eventPattern": "pc_in_use:lorna_pc", "condition": "globalVars.step_holds_done !== true", "onceOnly": true, "cooldown": 0, "bark": "Nobody signs in at a PC while its owner is sitting there." },
            { "eventPattern": "global_variable_changed:see_note_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "A password under a keyboard. The second step is what stands between that note and her desktop." },
            { "eventPattern": "global_variable_changed:see_temper_note_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "Frustrated people write things down. You'll see it on his sign-in screen at lunch." },
            { "eventPattern": "global_variable_changed:overhear_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "He said his login out loud to help a colleague. Now you have it too." },
            { "eventPattern": "global_variable_changed:step_holds_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "Right password, and still no way in. The request went to Lorna's phone, and she didn't answer." },
            { "eventPattern": "global_variable_changed:open_screen_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "His screen was open, so no password and no second step. The step guards the sign-in, not an open screen." },
            { "eventPattern": "global_variable_changed:fob_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "The fob's six digits change every minute. Whoever holds the fob holds the second step." },
            { "eventPattern": "global_variable_changed:number_match_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "The number on screen had to match his phone, and a wrong pick cancels. With his phone in your hand, you could match it." },
            { "eventPattern": "global_variable_changed:exempt_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "This account has no second step at all. One gap like that undoes the rest." },
            { "eventPattern": "global_variable_changed:reset_password_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "Two facts anyone could read were enough for a new password. His old one is dead, and the new one fills his tile." },
            { "eventPattern": "global_variable_changed:reenrol_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "Yusuf's approvals come to your phone now, and his own phone shows nothing. The desk never checked who was asking." },
            { "eventPattern": "global_variable_changed:desk_refuses_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "Three wrong tries and the desk stopped listening. It never said whether the name was real." },
            { "eventPattern": "global_variable_changed:door_step_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "The door's second step went to Gwen's phone. With her phone in your hand, you approved it yourself." },
            { "eventPattern": "global_variable_changed:propped_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "Nobody approved anything. Fatima propped the door, and the step never came into it." },
            { "eventPattern": "global_variable_changed:safe_step_done", "condition": "data.value === true && data.oldValue !== true", "onceOnly": true, "cooldown": 0, "bark": "The safe asked for the fob's code after the PIN. Same fob, same six digits, on a lock this time." },
