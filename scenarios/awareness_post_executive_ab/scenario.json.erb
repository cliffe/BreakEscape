          {
            "id": "eb_ropewalk_booking",
            "from": {
              "name": "The Ropewalk",
              "address": "events@theropewalk.example"
            },
            "to": "tomas.carvalho@merrinsallow.example",
            "subject": "Booking RW-1907 confirmed: Julian Sallow",
            "time": "08:40",
            "body": "Dear Tomás,\nThis confirms booking RW-1907: Julian Sallow's talk on Thursday at 14:00 and a stand in the main hall. Our invoice follows on the usual terms, payable to the account on file.\nKind regards,\nThe Ropewalk Events Team",
            "attachments": [
              {
                "label": "RW-1907-confirmation.pdf",
                "kind": "pdf"
              }
            ],
            "auth": {
              "spf": "fail",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "mailer.venuedesk.example",
              "replyTo": "events@theropewalk.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "senderAuth": "The Ropewalk sends its confirmations through a booking service rather than its own mail system, so one automatic sender check didn't line up. The address is still the venue's real domain, which is what matters.",
                "attachmentPlausible": "A booking confirmation PDF for a booking you made is what you'd expect.",
                "default": "The venue's real domain, a booking you made, and payment to the account on file. Nothing has changed."
              },
              "headerNote": "One check failing on its own is a clue, not proof. Mail sent through another company's service often trips one of these checks while the rest still pass."
            }
          },
          {
            "id": "eb_ropewalk_bank",
            "from": {
              "name": "The Ropewalk Events",
              "address": "accounts@theropewalk-events.example"
            },
            "to": "tomas.carvalho@merrinsallow.example",
            "subject": "Booking RW-1907: please use our new bank details",
            "time": "09:10",
            "body": "Dear Tomás,\nWe have changed banks. The balance on booking RW-1907 (Julian Sallow's talk and stand) should now be paid to:\nAccount name: The Ropewalk Ltd\nAccount number ending 2274\nPlease update your records before you pay.\nKind regards,\nThe Ropewalk Accounts",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "bounce.theropewalk-events.example",
              "replyTo": "accounts@theropewalk-events.example"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "lookalike_domain",
                "changed_bank_details",
                "senderTrust"
              ],
              "perFlagNote": {
                "lookalike_domain": "The Ropewalk's real domain is theropewalk.example. This is theropewalk-events.example, with an added word",
                "changed_bank_details": "New bank details on an open booking is the commonest invoice-fraud move. The safe step is to ring the venue on the number you already hold",
                "senderTrust": "The name says The Ropewalk, but the address is on theropewalk-events.example, which isn't the venue's"
              },
              "headerNote": "All three checks passed because the sender owns theropewalk-events.example. A pass tells you which domain sent it, not that it's the venue.",
              "ifTrusted": "The booking payment would go to an account the sender controls.",
              "reportReply": "Thanks. The Ropewalk haven't changed bank, and that domain isn't theirs."
            }
          },
          {
