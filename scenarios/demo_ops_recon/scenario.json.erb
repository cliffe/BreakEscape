  "logSources": {
    "network_log": {
      "title": "Network log",
      "events": ["net_link_up", "net_link_down", "share_folder_opened", "network_swept", "host_scanned", "service_checked", "finding_confirmed", "technique_used", "technique_refused"],
      "seedRows": [
        { "id": "s1", "at": "Tue 07:10", "event": "net_link_up", "where": { "kind": "jack", "id": "kitchen_jack" }, "result": "ok" },
        { "id": "s2", "at": "Tue 07:12", "event": "network_swept", "where": { "kind": "network", "id": "office_lan" }, "result": "ok", "detail": { "from": "kitchen_jack" } },
        { "id": "s3", "at": "Tue 07:14", "event": "host_scanned", "where": { "kind": "host", "id": "printer_host" }, "result": "ok", "detail": { "from": "kitchen_jack" } }
      ]
    }
  },

