    {
      "aimId": "evening",
      "title": "Evening: what it looked like",
      "description": "Most staff go home. The network log keeps everything you did.",
      "status": "active",
      "order": 2,
      "tasks": [
        { "taskId": "open_share", "title": "Open the shared drive", "type": "custom", "status": "active" },
        { "taskId": "read_log", "title": "Find yourself in the network log", "type": "custom", "status": "active" }
      ]
    }
  ],

