        { "taskId": "sweep", "title": "List what answers on the office network", "type": "custom", "status": "active" },
        { "taskId": "scan_printer", "title": "Find out what the printer runs", "type": "custom", "status": "active" }
      ]
    },
    {
      "aimId": "midday",
      "title": "Midday: real or false?",
      "description": "Some reported weaknesses are real and some are not. Test them, then try a technique.",
