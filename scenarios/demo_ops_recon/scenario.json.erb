{
  "scenario_brief": "Ops demo: on the network. A working day at Merrin & Sallow. Fenlow Managed IT has been asked to show what an outsider could see from one spare network port. Ama Owusu hosts. While the office gets on with its day, plug a drop box in when nobody is at the hot desk, list what answers on the network, look at what each machine runs, test which reported weaknesses are real, and use the technique cards you are handed. Graham in IT shows you the network log at the end. Authorised practice in a fictional office; nothing to break and no combat.",
  "endGoal": "Demo only: see what the network shows, then read your own trail in the network log.",
  "startRoom": "office",
  "startPosition": { "x": 5, "y": 6 },
  "npcNeedsSeed": "demo_ops_recon",
  "npcWindupMs": 700,
  "showPressingNeeds": true,
  "officePresets": true,
  "roomTone": true,
  "disableAttacks": true,
  "lighting": { "enabled": true, "defaultMode": "on" },

  "gameClock": { "start": "Tue 08:30", "rate": 1 },

  "chatter": {
    "coffee": ["Go on, after you.", "Is there any milk left?", "This machine takes forever.", "Strong one today?", "Who keeps taking the mugs?", "Busy morning?"],
    "cooler": ["Did you see the car park email?", "Friday drinks again?", "How was the weekend?", "Is it raining again?", "Train was late again.", "Any plans for lunch?", "Quiet one today, isn't it?", "Have you tried the new sandwich place?"],
    "grumble_off": ["Who switched the coffee off?", "It's off. Typical.", "No coffee here, then."],
    "grumble_gone": ["Missed it."],
    "cake": ["Who's the cake from?", "Go on, just a small slice.", "Whose birthday is it?", "This is really good."],
    "work_fail_printer": ["The printer's off again.", "Nothing's coming out of the printer.", "Who switched the printer off?"],
    "work_fail": ["Why is nothing working today?"]
  },

  "actionIcons": {
    "upkeep": "icon:npc-upkeep"
  },

  "defaultPolicy": "desk",

  "policies": {
    "desk": { "maxAttempts": null, "remote": "allowed" },
    "infra": { "maxAttempts": null, "remote": "allowed" }
  },

  "networks": {
    "office_lan": {
      "name": "Office network",
      "discovery": "scan",
      "cli": {
        "range": "10.30.0.0/24",
        "hosts": {
          "printer_host": { "address": "10.30.0.20" },
          "lobby_camera": { "address": "10.30.0.31" },
          "file_server": { "address": "10.30.0.10" },
          "agnieszka_pc": { "address": "10.30.0.52" },
          "chidi_pc": { "address": "10.30.0.51" },
          "jun_pc": { "address": "10.30.0.53" },
          "graham_pc": { "address": "10.30.0.54" }
        }
      }
    }
  },

  "hosts": {
    "printer_host": {
      "name": "Office printer",
      "network": "office_lan",
      "sprite": "pnw_portable_printer1",
      "offWhen": "printer_off",
      "services": [
        { "name": "print", "port": 9100, "product": "Inkvale JetServe", "version": "1.4" },
        {
          "name": "admin_page", "label": "Admin page", "port": 80, "product": "Inkvale WebPanel", "version": "2.0",
          "cli": { "protocol": "tcp", "service": "http", "banner": "Inkvale WebPanel 2.0 admin page ready" },
          "weaknesses": [
            {
              "id": "factory_login", "class": "default_creds", "severity": "high",
              "summary": "The admin page still accepts the account it shipped with.",
              "grants": { "credential": "print_admin" }
            }
          ],
          "decoys": [
            {
              "id": "old_build", "class": "unpatched", "severity": "low",
              "summary": "The page reports a build number with known problems.",
              "falseBecause": "The build listed is older than the one this printer runs. The page only shows a stale label."
            }
          ]
        }
      ]
    },
    "lobby_camera": {
      "name": "Reception camera",
      "network": "office_lan",
      "sprite": "cctv_camera1",
      "services": [
        {
          "name": "stream", "port": 554, "product": "Tarnwick ViewLine", "version": "1.0",
          "cli": { "protocol": "tcp", "service": "viewline", "banner": "Tarnwick ViewLine 1.0 stream ready" },
          "decoys": [
            {
              "id": "stream_label", "class": "misconfig", "severity": "low",
              "summary": "The stream page mentions an open setting.",
              "falseBecause": "The wording is only a banner. The setting it names is switched off."
            }
          ]
        }
      ]
    }
  },

  "techniques": {
    "factory_accounts": {
      "name": "Factory accounts",
      "summary": "Devices often ship with a published account that nobody changes.",
      "worksOn": { "class": "default_creds" }
    },
    "update_gap": {
      "name": "Known update gap",
      "summary": "For a service that has fallen behind its published fixes.",
      "worksOn": { "class": "unpatched", "product": "Tarnwick FileHold", "versions": ["4.2"] }
    },
    "open_settings": {
      "name": "Left-open settings",
      "summary": "For a setting somebody left open by mistake.",
      "worksOn": { "class": "misconfig" }
    }
  },

  "credentials": {
    "print_admin": {
      "kind": "saved_connection",
      "label": "Printer's saved link",
      "account": "agnieszka_duda",
      "connectsTo": "agnieszka_pc",
      "proof": { "technique_card": "printer_host.admin_page.factory_login" }
    }
