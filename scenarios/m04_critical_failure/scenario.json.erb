              "eventPattern": "global_variable_changed:hydrogen_alarm",
              "condition": "value === true && globalVars.crew_warned !== true && globalVars.vance_is_ally === true && globalVars.robert_vance_ko !== true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 5000, "message": "Hall 2's night foreman rang the ops desk. Nine of them behind the inverter wall can smell it. Vance can still sound the evacuation. Then the button.", "skipIfGlobal": "attack_prevented" }
            },
            {
              "eventPattern": "global_variable_changed:hydrogen_alarm",
              "condition": "value === true && globalVars.crew_warned !== true && globalVars.vance_is_ally !== true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 5000, "message": "Hall 2's night foreman just rang the ops desk. Nine of them behind the inverter wall, and they can smell it. Get to that button.", "skipIfGlobal": "attack_prevented" }
            },
            {
              "eventPattern": "global_variable_changed:hydrogen_alarm",
              "condition": "value === true && globalVars.crew_warned !== true && globalVars.vance_is_ally === true && globalVars.robert_vance_ko === true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 5000, "message": "Hall 2's night foreman just rang the ops desk. Nine of them behind the inverter wall, and they can smell it. Get to that button.", "skipIfGlobal": "attack_prevented" }
            },
            {
              "eventPattern": "global_variable_changed:hydrogen_alarm",
              "condition": "value === true && globalVars.crew_warned === true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 5000, "message": "Bank B's venting. Hall 2 is empty, thanks to Vance's alarm. Now get to that button.", "skipIfGlobal": "attack_prevented" }
            },
            <%# Pass 5 decision 1: the night crew can be warned. Vance sounds the
                evacuation (his hub or his phone, #set_global:crew_warned).
                Round 2 (review M1, orchestrator decision 1, option b): an EARLY
                alarm (before the attack is mapped, Voltage still up) sets crew_warned_early, which
                starts the alarm's own longer clock (h2_advisory_alarm 24 min,
                racks_vent_alarm 30 min) alongside the normal clocks, which still
                start when the attack is mapped. Whichever fires first wins. A LATE
                alarm costs no time: the clock is already running. clock_started is
                the music phase only. Two disjoint mappings. %>
            {
              "eventPattern": "global_variable_changed:crew_warned",
              "condition": "value === true && globalVars.attack_mechanism_known !== true && globalVars.voltage_neutralised !== true",
              "onceOnly": true,
              "setGlobal": { "clock_started": true, "crew_warned_early": true },
              "sendTimedMessage": { "delay": 8000, "message": "That's the evacuation. Good. But Voltage heard it too, and he won't wait for eight now. You've about half an hour. The clock's on your screen.", "skipIfGlobal": "attack_prevented" }
            },
            {
              "eventPattern": "global_variable_changed:crew_warned",
              "condition": "value === true && globalVars.attack_mechanism_known === true && globalVars.voltage_neutralised !== true",
              "onceOnly": true,
              "setGlobal": { "clock_started": true },
              "sendTimedMessage": { "delay": 8000, "message": "That's the evacuation. Nine out of Hall 2. Voltage knows we're here now, but your clock was already running. It cost you no time.", "skipIfGlobal": "attack_prevented" }
            },
            <%# Round 4 (review M2): with Voltage already down nobody fires early, so
                the alarm is free whenever it comes: no alarm clock, and no music
                change (clock_started is left alone).
                Scenario design m10: the three alarm texts wait 8 s (were 3), so they
                don't land while Vance's chat is still open (lesson 20). %>
            {
              "eventPattern": "global_variable_changed:crew_warned",
              "condition": "value === true && globalVars.voltage_neutralised === true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 8000, "message": "That's the evacuation. Nine out of Hall 2. Nobody left in the plant room to hear it.", "skipIfGlobal": "attack_prevented" }
            },
            <%# crew_lost: a bank vented (the 14-minute timer or the trigger race)
                with the night crew still in Hall 2. Read by the credits and the
                debrief. crew_warned can't be set after a vent (its choices are
                gated on racks_vented), so this is settled at the vent. %>
            {
              "eventPattern": "global_variable_changed:racks_vented",
              "condition": "value === true && globalVars.crew_warned !== true",
              "onceOnly": true,
              "setGlobal": { "crew_lost": true }
            },
            <%# Pass 5 A4: the shutdown. The debrief no longer opens here; the call-in
                task opens and HaX asks for a sweep. (The ESD can only be pressed
                with Voltage dealt with, so the plant room is safe to search.) %>
            {
              "eventPattern": "global_variable_changed:attack_prevented",
              "condition": "value === true",
              "onceOnly": true,
              "unlockTask": "call_in_after_sweep",
              "sendTimedMessage": { "delay": 2500, "message": "Grid control confirms it. Banks isolated, vents at full, the trigger's dead. Sweep the plant room and the dock, then call me and I'll bring you in." }
            },
            <%# Pass 5 A5: the hub's plant-reader and Voltage hints key on this. %>
            {
              "eventPattern": "room_entered:plant_room",
              "onceOnly": true,
              "setGlobal": { "plant_room_entered": true }
            },
            <%# Puzzle chains R3-2: the hub asks whether the player is past the gate,
                not how (signed in, slipped past, or the guard down). Doesn't set
                guard_admitted, which would make the guard greet them as signed in. %>
            {
              "eventPattern": "room_entered:operations_office",
              "onceOnly": true,
              "setGlobal": { "checkpoint_passed": true }
            },
            <%# PASS 3 P9, re-keyed by the fingerprint redesign: fires on every lift of
                Vance's print (dusting is now the only way to collect one), and lifted
                prints are saved with the game. %>
            {
              "eventPattern": "fingerprint_collected:robert_vance",
              "onceOnly": true,
              "setGlobal": { "vance_print_lifted": true },
              "sendTimedMessage": { "delay": 1000, "message": "That's Vance's print. He leaves it on every panel he touches, and the reader in Hall 2 can't tell a lift from a living thumb." }
            },
            {
              "eventPattern": "room_entered:security_office",
              "onceOnly": true,
              "setGlobal": { "lockpicking_guide_offered": true },
              "sendTimedMessage": { "delay": 2000, "message": "That equipment locker is a pin tumbler. Say the word and I'll send you the lockpicking guide." }
            },
            {
              "eventPattern": "room_entered:engineering_workshop",
              "onceOnly": true,
              "setGlobal": { "recon_guide_offered": true, "vuln_guide_offered": true, "server_room_reached": true, "lockpicking_guide_offered": true },
              "sendTimedMessage": { "delay": 3000, "message": "You're on the OT network. The BMS jump server is their way in; scan it from the terminal. Four flags make the case: status page, FTP drop, distcc foothold, root." }
            },
            <%# Round 2 (re-review m7): the 87-word workshop text split in two. The
                guides offer and the tool-case pointer (fix 2a) follow it. %>
            {
              "eventPattern": "room_entered:engineering_workshop",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 9000, "message": "I've guides for mapping the network and reading its attack surface, if you want them. And that OptiGrid case by the bench is theirs. Open it." }
            },
            {
              "eventPattern": "objective_task_completed:submit_ftp_intel_flag",
              "onceOnly": true,
              "completeTask": "investigate_compromised_services",
              "setGlobal": { "distcc_guide_offered": true },
              "sendTimedMessage": { "delay": 2000, "message": "There's a legacy distccd on that box too. The crew left it as a way back in. Prove it works. I've a guide if you want it.", "skipIfGlobal": "flag_distcc_exploit_submitted" }
            },
            <%# PASS 3 P15 (review): the sudo offer on the FTP flag, only if the
                distcc flag hasn't already made it. %>
            {
              "eventPattern": "objective_task_completed:submit_ftp_intel_flag",
              "condition": "globalVars.privesc_guide_offered !== true",
              "onceOnly": true,
              "setGlobal": { "privesc_guide_offered": true },
              "sendTimedMessage": { "delay": 7000, "message": "And once you're on the box, I've a sudo guide for getting to root." }
            },
            <%# PASS 3 P15: if the distcc flag lands first, offer the privesc guide then. %>
            {
              "eventPattern": "objective_task_completed:submit_distcc_exploit_flag",
              "condition": "globalVars.privesc_guide_offered !== true",
              "onceOnly": true,
              "setGlobal": { "privesc_guide_offered": true },
              "sendTimedMessage": { "delay": 2500, "message": "You're on the box. If you want the sudo guide for getting to root, ask." }
            },
            <%# Pass 5 (alignment minor): the privesc flag's story beat. Skipped at
                delivery when it was the last flag (all_flags_in is set by a mapping
                on the same event), where the mechanism or what-is-missing texts
                take over. %>
            {
              "eventPattern": "objective_task_completed:submit_privesc_flag",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 4000, "message": "Root. Now you can see what they changed from that box: the charge-ceiling override on every bank. That's how they're pushing the racks past safe.", "skipIfGlobal": "all_flags_in" }
            },
            <%# PASS 3 P19: m02's exploit, m03's directive. %>
            <%# PASS 4 fix 20: the same message offers the ProFTPD guide. %>
            {
              "eventPattern": "objective_task_completed:submit_network_scan_flag",
              "onceOnly": true,
              "setGlobal": { "proftpd_guide_offered": true },
              "sendTimedMessage": { "delay": 1500, "message": "That FTP service. Same backdoored build you met at St Catherine's. Zero Day supplies, Critical Mass executes. I've the ProFTPD guide if you want a refresher.", "skipIfGlobal": "flag_ftp_intel_submitted" }
            },
            {
              "eventPattern": "global_variable_changed:lore_safehouse_address_found",
              "condition": "value === true",
              "onceOnly": true,
              "setGlobal": { "cyberchef_guide_offered": true },
              "sendTimedMessage": { "delay": 2000, "message": "That card in the go-bag is Base64. Paste it into the CyberChef workstation in your kit. Decoding guide on request." }
            },
            <%# operatives_defeated counter, keyed on npc_ko:<id>. History: in pass 2
                globalVarOnKO wrote operative_*_defeated without emitting
                global_variable_changed (lesson 18), so global_variable_changed
                mappings never fired on a KO. That was fixed in pass 3 (see the
                correction to PASS2 lesson 18); npc_ko is kept because it works. The other
                operative's _defeated flag is already written when this fires
                (globalVarOnKO runs after npc_ko for the same NPC but the other
                NPC was KO'd earlier), so the conditions give the right running
                total in either order. %>
            {
              "eventPattern": "npc_ko:operative_cipher",
              "condition": "globalVars.operative_relay_defeated !== true",
              "onceOnly": true,
              "setGlobal": { "operatives_defeated": 1 }
            },
            {
              "eventPattern": "npc_ko:operative_cipher",
              "condition": "globalVars.operative_relay_defeated === true",
              "onceOnly": true,
              "setGlobal": { "operatives_defeated": 2 }
            },
            {
              "eventPattern": "npc_ko:operative_relay",
              "condition": "globalVars.operative_cipher_defeated !== true",
              "onceOnly": true,
              "setGlobal": { "operatives_defeated": 1 }
            },
            {
              "eventPattern": "npc_ko:operative_relay",
              "condition": "globalVars.operative_cipher_defeated === true",
              "onceOnly": true,
              "setGlobal": { "operatives_defeated": 2 }
            },
            <%# B1 KO keycard fallback. On Relay's KO, HaX phones and hands over a
                relayed copy of the workshop card she carried, in case the physical
                drop failed. Cipher carries no card since PASS 3 P3. %>
            {
              "eventPattern": "npc_ko:operative_relay",
              "onceOnly": true,
              "conversationMode": "phone-chat",
              "targetKnot": "on_relay_ko_card"
            },
            <%# Playtest D2: vance_provided_keycard used to be set by Vance's ink just
                before #give_item, so when the give did not land the flag was already
                true and the "I still need a facility keycard" safety net never
                appeared. The flag is now set only when the card is actually in the
                player's inventory (item_picked_up is emitted by type; the id rides in
                data.itemId -- lesson 1). %>
            {
              "eventPattern": "item_picked_up:keycard",
              "condition": "data.itemId === 'vance_level1_keycard'",
              "onceOnly": true,
              "setGlobal": { "vance_provided_keycard": true }
            },
            <%# PASS 3 P2: the normal route. Vance's card is cloned, not handed over.
                card_cloned carries only cardName (rfid-minigame.js:245-249). %>
            {
              "eventPattern": "card_cloned",
              "condition": "data.cardName === 'Level 1 Facility Card'",
              "onceOnly": true,
              "setGlobal": { "vance_provided_keycard": true, "vance_card_cloned": true }
            },
            <%# PASS 3 P7: the reader export is a fourth infiltration source. %>
            {
              "eventPattern": "global_variable_changed:evidence_reader_spoof_found",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "find_infiltration_evidence"
            },
            <%# PASS 3 P11b: the trigger race. Turning Voltage hostile -- the #hostile
                stance or a first punch (player-combat.js:309-311) -- starts the
                trigger_race timer. (a) sets the start global unconditionally; (b)
                telegraphs it, unless the bank has already vented. %>
            {
              "eventPattern": "npc_hostile_state_changed",
              "condition": "data.npcId === 'voltage' && data.isHostile === true",
              "onceOnly": true,
              "setGlobal": { "voltage_fight_started": true }
            },
            {
              "eventPattern": "npc_hostile_state_changed",
              "condition": "data.npcId === 'voltage' && data.isHostile === true && globalVars.racks_vented !== true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 1500, "message": "Fight's on. Don't let him reach that bench.", "skipIfGlobal": "voltage_neutralised" }
            },
            <%# Fix pass 2026-10-17 (the lead's Restart ruling): a Restart that calms an
                operative (engine reset event, reset: true) undoes that fight, so the
                "hostile and up" latches go: HaX's call-in no longer says he's still
                on you, and Cipher can challenge on sight again (his ink opens on the
                standoff, since his radio call stands). cell_alerted and the Voltage
                trigger race are story events, not the fight, and are kept (the race
                is forfeit by design, see trigger_race). On this always-registered
                phone NPC so the reset is caught wherever the player went down. %>
            {
              "eventPattern": "npc_hostile_state_changed",
              "condition": "data.npcId === 'operative_cipher' && data.reset === true",
              "cooldown": 0,
              "setGlobal": { "cipher_engaged": false }
            },
            {
              "eventPattern": "npc_hostile_state_changed",
              "condition": "data.npcId === 'operative_relay' && data.reset === true",
              "cooldown": 0,
              "setGlobal": { "relay_engaged": false }
            },
            {
              "eventPattern": "npc_hostile_state_changed",
              "condition": "data.npcId === 'operative_static' && data.reset === true",
              "cooldown": 0,
              "setGlobal": { "static_engaged": false }
            },
            <%# Playtest D7: the three optional methodology tasks never ticked.
                Each is completed by the flag its step produces: the scan finds the
                exposed status page (flag 1), enumeration finds the FTP drop (flag
                2, wired on the FTP handler above), and the distcc foothold is flag 4. %>
            {
              "eventPattern": "objective_task_completed:submit_network_scan_flag",
              "onceOnly": true,
              "completeTask": "scan_scada_network"
            },
            {
              "eventPattern": "objective_task_completed:submit_distcc_exploit_flag",
              "onceOnly": true,
              "completeTask": "exploit_distcc_vulnerability"
            },
            <%# Voltage neutralised. The ARREST and ESCAPE paths set
                voltage_captured / voltage_escaped from ink (both emit
                global_variable_changed, so those two mappings fire). The FIGHT
                path is a KO, handled by the npc_ko:voltage mapping below. (In pass 2
                a KO's global write didn't emit, lesson 18, so without this mapping
                the combat ending soft-locked the ESD; fixed in pass 3, mapping kept.)
                Voltage has no globalVarOnKO, so npc_ko is the KO signal. %>
            {
              "eventPattern": "npc_ko:voltage",
              "condition": "globalVars.voltage_escaped !== true",
              "onceOnly": true,
              "setGlobal": { "voltage_neutralised": true, "voltage_captured": true }
            },
            {
              "eventPattern": "global_variable_changed:voltage_captured",
              "condition": "value === true",
              "onceOnly": true,
              "setGlobal": { "voltage_neutralised": true }
            },
            {
              "eventPattern": "global_variable_changed:voltage_escaped",
              "condition": "value === true",
              "onceOnly": true,
              "setGlobal": { "voltage_neutralised": true }
            },
            <%# attack_mechanism_known is set when the OT-network aim completes (all
                four flags in), not on the last flag submission -- so the ESD gate
                below is really "you have proved how they did it", whichever flag
                the player happened to submit last. %>
            <%# PASS 4 fix 13: one ESD, and no "the trigger is in the plant room" once
                Voltage is dealt with. The text lives in two disjoint mappings; the
                global is set by the first, unconditionally. %>
            <%# Pass 5: clock_started too (the timers' start). If Vance's evacuation
                alarm already started the clock, setting it again does not restart
                it (scenario-timer-dispatcher.js startOnGlobal handler). %>
            {
              "eventPattern": "objective_aim_completed:map_the_attack",
              "onceOnly": true,
              "setGlobal": { "attack_mechanism_known": true, "clock_started": true }
            },
            <%# These mappings track the flags (flag_*_submitted, all_flags_in). History:
                in the pass-4 playtest map_the_attack waited on confirm_the_lie, so the
                four flags without a paper-evidence document left the ESD unarmed, and a
                HaX text sent the player for the paper. Since engine 657f6158 an
                aimCompleted aim completes on its own tasks (objectives-manager.js
                checkAimCompletion defers only globalVariable aims), so map_the_attack
                completes on the four flags alone and sets attack_mechanism_known.
                Pass 5 puzzle chains R2-1: the paper gate is retired. The evidence
                documents stay as optional story (find_infiltration_evidence and,
                since R3-3, one credits line; the debrief doesn't read them); nothing
                requires them, and the "break-in on paper" text, ESD variant and hub
                branch are gone. The dial is still
                required (the ESD's anomaly_detected condition). %>
            { "eventPattern": "objective_task_completed:submit_network_scan_flag", "onceOnly": true, "setGlobal": { "flag_network_scan_submitted": true } },
            { "eventPattern": "objective_task_completed:submit_ftp_intel_flag", "onceOnly": true, "setGlobal": { "flag_ftp_intel_submitted": true } },
            { "eventPattern": "objective_task_completed:submit_distcc_exploit_flag", "onceOnly": true, "setGlobal": { "flag_distcc_exploit_submitted": true } },
            { "eventPattern": "objective_task_completed:submit_privesc_flag", "onceOnly": true, "setGlobal": { "flag_privesc_submitted": true } },
            { "eventPattern": "objective_task_completed:submit_network_scan_flag", "condition": "globalVars.flag_ftp_intel_submitted === true && globalVars.flag_distcc_exploit_submitted === true && globalVars.flag_privesc_submitted === true", "onceOnly": true, "setGlobal": { "all_flags_in": true } },
            { "eventPattern": "objective_task_completed:submit_ftp_intel_flag", "condition": "globalVars.flag_network_scan_submitted === true && globalVars.flag_distcc_exploit_submitted === true && globalVars.flag_privesc_submitted === true", "onceOnly": true, "setGlobal": { "all_flags_in": true } },
            { "eventPattern": "objective_task_completed:submit_distcc_exploit_flag", "condition": "globalVars.flag_network_scan_submitted === true && globalVars.flag_ftp_intel_submitted === true && globalVars.flag_privesc_submitted === true", "onceOnly": true, "setGlobal": { "all_flags_in": true } },
            { "eventPattern": "objective_task_completed:submit_privesc_flag", "condition": "globalVars.flag_network_scan_submitted === true && globalVars.flag_ftp_intel_submitted === true && globalVars.flag_distcc_exploit_submitted === true", "onceOnly": true, "setGlobal": { "all_flags_in": true } },
            { "eventPattern": "global_variable_changed:all_flags_in", "condition": "value === true && globalVars.anomaly_detected !== true", "onceOnly": true, "sendTimedMessage": { "delay": 2500, "message": "Flags are in. Grid control still wants a real reading off the racks. The dial thermometer on the Rack Bank C wall, Hall 1. It isn't on their network.", "skipIfGlobal": "anomaly_detected" } },
            <%# Browser M-1: with the dial unread the ESD won't arm, so this text drops
                "Get to the ESD" and the dial text on all_flags_in follows it. %>
            {
              "eventPattern": "objective_aim_completed:map_the_attack",
              "condition": "globalVars.voltage_neutralised !== true && globalVars.anomaly_detected !== true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 1500, "message": "Their route in, proven. They pushed the charge-ceiling override from that box, and the bypass modules hide it." }
            },
            {
              "eventPattern": "objective_aim_completed:map_the_attack",
              "condition": "globalVars.voltage_neutralised !== true && globalVars.anomaly_detected === true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 1500, "message": "Their route in, proven. They pushed the charge-ceiling override from that box, and the bypass modules hide it. The trigger is in the plant room. Get to the ESD.", "skipIfGlobal": "voltage_neutralised" }
            },
            <%# Blind run A (M3): the HUD clock starts here, and nothing said what it
                counts down to; a player who had asked HaX earlier remembered "about
                half an hour". This names the clock and what zero does. Nightshade's
                briefing line ("I'll tell you how much time we actually have") pays off. %>
            {
              "eventPattern": "objective_aim_completed:map_the_attack",
              "condition": "globalVars.voltage_neutralised !== true && globalVars.attack_prevented !== true && globalVars.hydrogen_alarm !== true && globalVars.racks_vented !== true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 6000, "message": "Nightshade's run the numbers off that box. Bank B won't last till eight. The clock on your screen is when its hydrogen alarm goes.", "skipIfGlobal": "attack_prevented" }
            },
            <%# Puzzle chains R3-5: the disjoint twin, so the root beat (what the flags
                showed) still lands when Voltage was dealt with first. 1.5 s, before the
                2.5 s ESD-live text from the attack_mechanism_known mapping. %>
            {
              "eventPattern": "objective_aim_completed:map_the_attack",
              "condition": "globalVars.voltage_neutralised === true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 1500, "message": "Their route in, proven. They pushed the charge-ceiling override from that box, and the bypass modules hide it." }
            },

            <%# ESD authorisation requires all THREE: the thermal hazard confirmed
                (anomaly_detected), the man on the trigger dealt with
                (voltage_neutralised), and the attack proven on the network
                (attack_mechanism_known). M1: without the last condition the player
                could reach battery_hall_2 on the Level 1 card, go straight to the
                plant room and press the button with no VM work done, and the
                mission-conclusion flags would never be required. Each mapping fires
                on one prerequisite landing and checks the other two, so whichever
                is last grants authorisation. %>
            {
              "eventPattern": "global_variable_changed:voltage_neutralised",
              "condition": "value === true && globalVars.anomaly_detected === true && globalVars.attack_mechanism_known === true",
              "onceOnly": true,
              "setGlobal": { "esd_authorized": true },
              "sendTimedMessage": { "delay": 1200, "message": "He's out of the way, the sixty-one degrees in Hall 1 is on record, and so is the attack. Grid control's standing by. The ESD is live. Press it." }
            },
            {
              "eventPattern": "global_variable_changed:anomaly_detected",
              "condition": "value === true && globalVars.voltage_neutralised === true && globalVars.attack_mechanism_known === true",
              "onceOnly": true,
              "setGlobal": { "esd_authorized": true },
              "sendTimedMessage": { "delay": 1200, "message": "He's out of the way, the sixty-one degrees in Hall 1 is on record, and so is the attack. Grid control's standing by. The ESD is live. Press it." }
            },
            {
              "eventPattern": "global_variable_changed:attack_mechanism_known",
              "condition": "value === true && globalVars.anomaly_detected === true && globalVars.voltage_neutralised === true",
              "onceOnly": true,
              "setGlobal": { "esd_authorized": true },
              "sendTimedMessage": { "delay": 2500, "message": "He's out of the way, the sixty-one degrees in Hall 1 is on record, and so is the attack. Grid control's standing by. The ESD is live. Press it." }
            },
            <%# find_infiltration_evidence has four sources (lesson 8): the
                unscheduled work order, the workshop access log, the camera tampering
                log, and the plant-reader export (its mapping is with the card
                mappings above). Any of them completes it; the work order also
                delivers the "don't take the SCADA screens on trust" text, only
                while the dial is unread. completeTask is idempotent, so later ones
                firing is harmless. %>
            {
              "eventPattern": "global_variable_changed:evidence_maintenance_logs_found",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "find_infiltration_evidence"
            },
            {
              "eventPattern": "global_variable_changed:evidence_maintenance_logs_found",
              "condition": "value === true && globalVars.anomaly_detected !== true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 1500, "message": "That work order was never authorised. There's your evidence. Don't take the SCADA screens on trust.", "skipIfGlobal": "anomaly_detected" }
            },
            {
              "eventPattern": "global_variable_changed:evidence_access_logs_found",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "find_infiltration_evidence"
            },
            {
              "eventPattern": "global_variable_changed:evidence_camera_tampering_found",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "find_infiltration_evidence"
            },
            <%# PASS 4 fix 21: the optional second print. fingerprint_identified fires
                only on a NEW identification (biometrics.js:96-98), so the compare step
                is what earns it; a lift logged as unidentified does not. %>
            {
              "eventPattern": "fingerprint_identified:voltage",
              "onceOnly": true,
              "setGlobal": { "voltage_print_on_bypass": true },
              "sendTimedMessage": { "delay": 1500, "message": "Voltage's own thumb, on the bypass module. Whatever else he says tonight, that puts his hand in the cabinet." }
            }
          ]
        },
        {
          <%# Blind run A (M1): this contact shared the display name "Robert Vance" with
              the person NPC and registers first (phone NPCs load at start), so every
              "Robert Vance:" prefix in his person-chat ink and the debrief resolved to
              this artless phone NPC: a coarse hooded fallback portrait. A distinct
              name keeps the prefixes on robert_vance. (Engine item E3: prefer the
              conversation's own or a person NPC on a display-name tie.) %>
          "id": "robert_vance_phone",
          "displayName": "Robert Vance (ops desk)",
          "npcType": "phone",
          "voice": {
            "name": "Orus",
            "style": "Operations manager and OT engineer at a grid battery site, mid-fifties. Speak with a consistent North-East English (Teesside) accent throughout -- do not shift to any other accent. Firm, low-to-mid pitch; brisk, clipped pace. Conscientious and overworked; defensive at first, then alarmed and determined once he realises the threat is real. Speaking over a phone line from the control room.",
            "language": "en-GB"
          },
          "storyPath": "scenarios/m04_critical_failure/ink/m04_phone_robert_vance.json",
          "avatar": "assets/characters/robert_vance_headshot.png",
          "phoneId": "player_phone",
          "currentKnot": "start",
          "timedMessages": [
            {
              "delay": 20000,
              "message": "Every screen I've got says twenty-eight, and I don't believe one of them. Anything in Hall 1 older than the network, read it.",
              "type": "text",
              "waitForEvent": "global_variable_changed:vance_phone_available",
              "skipIfGlobal": "anomaly_detected"
            }
          ],
          "eventMappings": [
            <%# Lesson 20: fire this when the in-person Vance conversation CLOSES
                (and he turned ally), not on the vance_is_ally change itself -- that
                change happens mid-conversation, so a 2s phone text would land on
                top of the talk the player is still in. %>
            {
              "eventPattern": "conversation_closed:robert_vance",
              "condition": "globalVars.vance_is_ally === true && globalVars.vance_met === true",
              "onceOnly": true,
              "setGlobal": { "vance_phone_available": true },
              "sendTimedMessage": { "delay": 2500, "message": "It's Vance. I'm on the ops desk, and on comms if you're moving. Call me for the engineering side — the BMS and the shutdown." }
            }<% %w[main_entrance operations_office security_office scada_control_room battery_hall_1 engineering_workshop battery_hall_2 plant_room loading_dock].each do |r| %>,
            {
              "_comment": "Pass 5 hear-the-debrief backstop (m03 hear_debrief pattern): report_to_0x99 completes on the debrief's last line. If the page reloads mid-debrief, debrief_started is set and the debrief won't replay, so the next room entry completes the task and the mission concludes. Kept on this always-loaded NPC so it doesn't share a pattern with the debrief NPC's re-emit backstop.",
              "eventPattern": "room_entered:<%= r %>",
              "condition": "globalVars.debrief_started === true",
              "onceOnly": true,
              "completeTask": "report_to_0x99"
            }<% end %>
          ]
        },
        {
          "id": "agent_0x99_debrief",
          "displayName": "Agent HaX",
          "npcType": "person",
          "storyPath": "scenarios/m04_critical_failure/ink/m04_closing_debrief.json",
          "avatar": "assets/characters/agent_hax_headshot.png",
          "currentKnot": "start",
          "position": { "x": 500, "y": 500 },
          "spriteSheet": "agent_hax",
          "spriteTalk": "assets/characters/agent_hax_talk.png",
          "spriteVisemes": "assets/characters/agent_hax_visemes.png",
          "spriteConfig": {
            "idleFrameRate": 6,
            "walkFrameRate": 10
          },
          "voice": {
            "name": "Aoede",
            "style": "Professional intelligence handler in debrief. Speak with a consistent British Received Pronunciation accent throughout — do not shift to any other accent. Use a steady, mid-range pitch. Unhurried — the emergency is over and she is choosing her words carefully.",
            "language": "en-GB"
          },
          "behavior": {
            "initiallyHidden": true
          },
          "eventMappings": [
            {
              "eventPattern": "global_variable_changed:mission_complete",
              "condition": "value === true",
              "conversationMode": "person-chat",
              "targetKnot": "start",
              "background": "assets/backgrounds/hq1.png",
              "onceOnly": true,
              "disableClose": true
            }<% %w[main_entrance operations_office security_office scada_control_room battery_hall_1 engineering_workshop battery_hall_2 plant_room loading_dock].each do |r| %>,
            {
              "_comment": "Pass 5 reload backstop (m03 P3-1 pattern): the player asked to be brought in but the page reloaded before the debrief's first line. Re-emitting mission_complete (setGlobal emits even when unchanged) re-fires the mapping above, whose onceOnly is only recorded when the scene closes. debrief_started is set on the debrief's first line.",
              "eventPattern": "room_entered:<%= r %>",
              "condition": "globalVars.mission_complete === true && globalVars.debrief_started !== true",
              "onceOnly": true,
              "setGlobal": { "mission_complete": true }
            }<% end %>
          ]
        }
      ],
      "objects": [
