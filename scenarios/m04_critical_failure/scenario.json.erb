                the unscheduled work order, the workshop access log, and the camera
                tampering log. Any of them completes it; the first also delivers the
                "don't trust the SCADA screens" nudge. completeTask is idempotent,
                so later ones firing is harmless. %>
            <%# Round 2: the "go and check the racks" text only while nobody has. %>
            {
              "eventPattern": "global_variable_changed:evidence_maintenance_logs_found",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "find_infiltration_evidence"
            },
            {
              "eventPattern": "global_variable_changed:evidence_maintenance_logs_found",
              "condition": "value === true && globalVars.anomaly_detected !== true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 1500, "message": "That work order was never authorised — there's your evidence. Don't trust the SCADA screens; they're spoofed. Check the racks against the physical dial in Battery Hall 1." }
            },
            {
              "eventPattern": "global_variable_changed:evidence_access_logs_found",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "find_infiltration_evidence"
            },
            {
              "eventPattern": "global_variable_changed:evidence_camera_tampering_found",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "find_infiltration_evidence"
            },
            <%# PASS 4 fix 21: the optional second print. fingerprint_identified fires
                only on a NEW identification (biometrics.js:96-98), so the compare step
                is what earns it; a lift logged as unidentified does not. %>
            {
              "eventPattern": "fingerprint_identified:voltage",
              "onceOnly": true,
              "setGlobal": { "voltage_print_on_bypass": true },
              "sendTimedMessage": { "delay": 1500, "message": "Voltage's own thumb, on the bypass module. Whatever else he says tonight, that puts his hand in the cabinet." }
            }
          ]
        },
        {
          "id": "robert_vance_phone",
          "displayName": "Robert Vance",
          "npcType": "phone",
          "voice": {
            "name": "Orus",
            "style": "Operations manager and OT engineer at a grid battery site, mid-fifties. Speak with a consistent North-East English (Teesside) accent throughout -- do not shift to any other accent. Firm, low-to-mid pitch; brisk, clipped pace. Conscientious and overworked; defensive at first, then alarmed and determined once he realises the threat is real. Speaking over a phone line from the control room.",
            "language": "en-GB"
          },
          "storyPath": "scenarios/m04_critical_failure/ink/m04_phone_robert_vance.json",
          "avatar": "assets/characters/male_telecom_headshot.png",
          "phoneId": "player_phone",
          "currentKnot": "start",
          "timedMessages": [
            {
              "delay": 20000,
              "message": "It's Vance. The historian has the cells far hotter than the SCADA admits. Get to the hardwired ESD in the plant room. The software won't save us.",
              "type": "text",
              "waitForEvent": "global_variable_changed:vance_phone_available",
              "skipIfGlobal": "attack_prevented"
            }
          ],
          "eventMappings": [
            <%# Lesson 20: fire this when the in-person Vance conversation CLOSES
                (and he turned ally), not on the vance_is_ally change itself -- that
                change happens mid-conversation, so a 2s phone text would land on
                top of the talk the player is still in. %>
            {
              "eventPattern": "conversation_closed:robert_vance",
              "condition": "globalVars.vance_is_ally === true && globalVars.vance_met === true",
              "onceOnly": true,
              "setGlobal": { "vance_phone_available": true },
              "sendTimedMessage": { "delay": 2500, "message": "It's Vance. I'm on the ops desk with the historian up, and on comms if you're moving. Call me for the engineering side — the BMS and the shutdown." }
            }
          ]
        },
