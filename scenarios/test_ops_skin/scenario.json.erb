            { "eventPattern": "network_swept", "onceOnly": true, "completeTask": "k1_swept" },
            { "eventPattern": "network_host_scanned", "onceOnly": true, "completeTask": "k2_scanned" },
            { "eventPattern": "network_service_checked", "onceOnly": true, "completeTask": "k3_checked" },
            { "eventPattern": "network_finding_confirmed", "onceOnly": true, "completeTask": "k4_confirmed" },
            { "eventPattern": "network_technique_used", "onceOnly": true, "completeTask": "k5_used" }
          ]
        }
      ]
    },

    "comms_room": {
      "type": "room_servers",
      "door_sign": "Comms room",
      "connections": { "south": "lobby" },
      "network": "office_lan",
      "objects": [
        {
          "type": "pc",
          "id": "files01",
          "name": "File server",
          "host": "FILES01",
          "sprite": "pc_desktop",
          "position": { "x": 3, "y": 4 },
          "takeable": false,
          "locked": true,
          "lockType": "login",
          "headless": true,
          "access": { "roles": ["it"] },
          "policy": "managed",
          "observations": "A file server with no screen or keyboard. It is managed over the network.",
