{
  "scenario_brief": "TEST: Ops skin\n\nA test floor for the two looks of the network view (S6). A lobby with a drop box, an office wall port and a cabinet of field notes; a comms room with two servers. Plug the box in, sweep and scan, check the file server's service, confirm what you find, use the field notes, then look at the share and the printer. Nothing to solve.",
  "endGoal": "Test only: use a field note on a confirmed finding, then unplug the box.",
  "startRoom": "lobby",
  "startPosition": { "x": 7, "y": 7 },
  "npcNeedsSeed": "test_ops_skin",
  "npcWindupMs": 0,
  "needsDebugOverlay": true,

  "networkView": { "defaultSkin": "cli" },

  "networks": {
    "office_lan": {
      "name": "Office network",
      "discovery": "scan",
      "cli": {
        "range": "10.20.0.0/24",
        "hosts": { "files01": { "address": "10.20.0.10" } }
      }
    },
    "guest_lan": {
      "name": "Guest network",
      "cli": {
        "range": "10.40.0.0/28",
        "hosts": { "guest_cam01": { "address": "10.40.0.4" } }
      }
    }
  },

  "networkLinks": [
    ["office_lan", "guest_lan"]
  ],

  "hosts": {
    "guest_cam01": {
      "name": "Guest lounge camera",
      "network": "guest_lan",
      "sprite": "cctv_camera1",
      "services": [
        {
          "name": "stream", "port": 554, "product": "Tarnwick ViewLine", "version": "1.0",
          "cli": { "protocol": "tcp", "service": "viewline", "banner": "Tarnwick ViewLine 1.0 stream ready" }
        }
      ]
    }
  },

  "resources": {
    "office_drop": {
      "kind": "file_share",
      "name": "Office-Drop",
      "host": "OFFICE-FS",
      "network": "office_lan",
      "contents": [
        {
          "type": "text_file",
          "id": "drop_note",
          "name": "welcome.txt",
          "takeable": true,
          "readable": true,
          "text": "Welcome to the office network. Nothing secret lives in this share.",
          "observations": "A readme in the office's open share."
        }
      ]
    },
    "floor_printer": {
      "kind": "printer",
      "name": "Floor print queue",
      "host": "OFFICE-PRN",
      "network": "office_lan",
      "observations": "A print queue anyone on the network can read."
    }
  },

  "techniques": {
    "update_notes": {
      "name": "Update notes: FileHold 4.2",
      "summary": "For a service that has fallen behind its published fixes.",
      "worksOn": { "class": "unpatched", "product": "Tarnwick FileHold", "versions": ["4.2"] }
    },
    "settings_review": {
      "name": "Settings review",
      "summary": "For a setting somebody left open by mistake.",
      "worksOn": { "class": "misconfig" }
    }
  },

  "credentials": {
    "file_link": {
      "kind": "saved_connection",
      "label": "File server link",
      "account": "ian",
      "connectsTo": "files01",
      "proof": { "technique_card": "files01.storage.entry_c" }
    }
  },

  "logSources": {
    "network_audit": {
      "title": "Network audit",
      "events": ["network_swept", "host_scanned", "service_checked", "finding_confirmed", "technique_refused", "technique_used"]
    }
  },

  "policies": {
    "managed": { "remote": "allowed" },
    "sealed": { "remote": "blocked" }
  },

  "gameClock": { "start": "Tue 08:30", "rate": 1 },

  "objectives": [
    {
      "aimId": "skin_beats",
      "title": "Look over the office network",
      "description": "Test only. Each task ticks when its beat's event fires.",
      "status": "active",
      "order": 0,
      "tasks": [
        { "taskId": "k1_swept", "title": "Sweep the office network", "type": "custom", "status": "active" },
        { "taskId": "k2_scanned", "title": "Scan the file server", "type": "custom", "status": "active" },
        { "taskId": "k3_checked", "title": "Check the file server's service", "type": "custom", "status": "active" },
        { "taskId": "k4_confirmed", "title": "Confirm a finding", "type": "custom", "status": "active" },
        { "taskId": "k5_used", "title": "Use a field note on a confirmed finding", "type": "custom", "status": "active" }
      ]
    }
  ],

  "rooms": {
