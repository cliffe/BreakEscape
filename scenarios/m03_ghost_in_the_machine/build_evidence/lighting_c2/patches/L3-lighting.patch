+  stampNpcTorches(rt, stamp, ox, oy, state, ambient, time) {
+    const npcs = window.npcManager?.npcs;
+    if (!npcs) return;
+    const k = npcTorchStrength(ambient);
+    if (k <= 0.01) return;
+    const room = window.rooms[state.roomId];
+    const gv = window.gameState?.globalVariables || {};
+    const angles = this.npcTorchAngles || (this.npcTorchAngles = new Map());
+    for (const npc of npcs.values()) {
+      const torch = npc.behavior?.torch;
+      if (!torch) continue;
+      const sp = npc._sprite;
+      if (!sp?.active || !sp.visible) continue;
+      if (typeof torch === 'object' && torch.condition) {
+        let holds = false;
+        try { holds = evaluateGlobalCondition(torch.condition, gv); } catch (err) { holds = false; }
+        if (!holds) continue;
+      }
+      const fx = sp.body?.center?.x ?? sp.x, fy = sp.body?.center?.y ?? sp.y;
+      if (!this.fillAreas(state.roomId).some(a => fx >= a.x && fx <= a.x + a.w && fy >= a.y && fy <= a.y + a.h)) continue;
+      const beh = window.npcBehaviorManager?.getBehavior?.(npc.id);
+      if (window.npcHostileSystem?.isNPCKO?.(npc.id)) continue;  // a guard on the floor drops his torch
+      const target = FACING_ANGLES[beh?.direction] ?? 90;
+      const prev = angles.get(npc.id) ?? target;
+      const diff = ((target - prev + 540) % 360) - 180;
+      const angle = (prev + diff * 0.25 + 360) % 360;
+      angles.set(npc.id, angle);
+      const color = parseColor(typeof torch === 'object' ? torch.color : null, 0xfff0d8);
+      this.stampBeam(rt, stamp, ox, oy, room, sp.x, fy - 4, angle, k * 0.85, color);
+    }
+  }
