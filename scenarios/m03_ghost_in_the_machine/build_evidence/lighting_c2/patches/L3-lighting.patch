+/**
+ * How strongly an NPC's torch shows in a room whose ambient is currently `ambient`:
+ * 0 in a lit office, rising as the room darkens, 1 in a dark room.
+ */
+export function npcTorchStrength(ambient) {
+  return Math.max(0, Math.min(1, (0.62 - luma(ambient)) / 0.4));
+}
