+/**
+ * A room's lighting block with its first matching variant merged in. Variants are
+ * partial blocks with an optional condition (globalVars syntax); `emitters` merge by
+ * key, everything else replaces. Returns { cfg, index } (index -1: the block itself).
+ */
+export function resolveRoomLighting(block, globalVars = {}) {
+  const { variants, ...base } = block || {};
+  if (!Array.isArray(variants)) return { cfg: base, index: -1 };
+  for (let i = 0; i < variants.length; i++) {
+    const { condition, ...v } = variants[i] || {};
+    let holds = !condition;
+    if (!holds) {
+      try { holds = evaluateGlobalCondition(condition, globalVars) === true; } catch (err) { holds = false; }
+    }
+    if (!holds) continue;
+    const cfg = { ...base, ...v };
+    if (base.emitters || v.emitters) cfg.emitters = { ...(base.emitters || {}), ...(v.emitters || {}) };
+    return { cfg, index: i };
+  }
+  return { cfg: base, index: -1 };
+}
