              "id": "m03_rfid_field_guide",
              "name": "SAFETYNET Field Guide: RFID Cloning",
              "takeable": true,
              "labUrl": "https://cliffe.github.io/HacktivityLabSheets/labs/safetynet/rfid-cloning/",
              "observations": "Read, crack, emulate: cloning MIFARE badges — weak-default cards in seconds, custom-key cards with a recovery attack"
            },
            {
              "type": "lab-workstation",
              "id": "m03_lockpicking_field_guide",
              "name": "SAFETYNET Field Guide: Lockpicking",
              "takeable": true,
              "labUrl": "https://cliffe.github.io/HacktivityLabSheets/labs/safetynet/lockpicking/",
              "observations": "Pin-tumbler lockpicking technique with operational notes on staying out of the guard's line of sight"
            },
            {
              "type": "lab-workstation",
              "id": "m03_recon_field_guide",
              "name": "SAFETYNET Field Guide: Reconnaissance and Network Mapping",
              "takeable": true,
              "labUrl": "https://cliffe.github.io/HacktivityLabSheets/labs/safetynet/reconnaissance-and-network-mapping/",
              "observations": "nmap host and service discovery — map the training network before you touch it"
            },
            {
              "type": "lab-workstation",
              "id": "m03_netexploit_field_guide",
              "name": "SAFETYNET Field Guide: distcc Exploitation",
              "takeable": true,
              "labUrl": "https://cliffe.github.io/HacktivityLabSheets/labs/safetynet/distcc-exploitation/",
              "observations": "Exploit the legacy distcc daemon (CVE-2004-2687) for command execution and the operational logs"
            },
            {
              "type": "lab-workstation",
              "id": "m03_cyberchef_field_guide",
              "name": "SAFETYNET Field Guide: Encoding and Decoding with CyberChef",
              "takeable": true,
              "labUrl": "https://cliffe.github.io/HacktivityLabSheets/labs/safetynet/encoding-and-decoding-with-cyberchef/",
              "observations": "ROT13, Base64, hex and multi-layer decoding — encoding is not encryption"
            }
          ],
          "eventMappings": [
            {
              "eventPattern": "room_entered:executive_wing_hallway",
              "onceOnly": true,
              "setGlobal": { "lockpicking_guide_offered": true },
              "sendTimedMessage": { "delay": 1500, "message": "Sterling's office is keyed, not carded, so it's your pick kit. There's a guard on this corridor. Wait until his back's turned before you kneel at that door; if he sees you picking, you're made. I've a lockpicking field guide if you want it." }
            },
            {
              "eventPattern": "room_entered:server_room",
              "onceOnly": true,
              "setGlobal": { "netexploit_guide_offered": true },
              "sendTimedMessage": { "delay": 2500, "message": "You're at their VM terminal. Recon first, then the services, then the legacy distcc daemon -- that's where their records live. Submit everything at the drop-site. I've field guides on recon, distcc and CyberChef if you want them." }
            },
            {
              "eventPattern": "objective_task_completed:clone_reception_badge",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 1500, "message": "Reception badge is in the cloner. Emulate it at the conference room reader. Read, crack, emulate -- same order every time." }
            },
            {
              "eventPattern": "objective_task_completed:clone_rfid_card",
              "setGlobal": { "mission_phase": "act2_infiltration", "time_of_day": "night" },
              "onceOnly": true
            },
            {
              "_comment": "D6: the clone completes mid-conversation with Victoria, so the call waits until the player has left her room. D14: onceOnly does not survive a reload, so the clone_call_done global (saved with game state) stops it replaying.",
              "eventPattern": "room_entered:main_hallway",
              "condition": "globalVars.mission_phase === 'act2_infiltration' && globalVars.victoria_ko !== true && globalVars.clone_call_done !== true",
              "targetKnot": "on_rfid_clone_success",
              "conversationMode": "phone-chat",
              "setGlobal": { "clone_call_done": true },
              "onceOnly": true
            },
            {
              "eventPattern": "item_picked_up:workstation",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 1200, "message": "That's their decoding laptop. Anything that looks like gibberish on paper, paste it in. Encoding isn't encryption -- if it doesn't read after one pass, try another." }
            },
            {
              "eventPattern": "objective_task_completed:access_victoria_computer",
              "targetKnot": "on_victoria_computer_accessed",
              "conversationMode": "phone-chat",
              "onceOnly": true
            },
            {
              "eventPattern": "objective_task_completed:lore_fragment_1",
              "onceOnly": true,
              "setGlobal": { "lore_history_found": true }
            },
            {
              "eventPattern": "objective_task_completed:lore_fragment_2",
              "targetKnot": "on_exploit_catalog_found",
              "conversationMode": "phone-chat",
              "setGlobal": { "lore_catalogue_found": true },
              "onceOnly": true
            },
            {
              "eventPattern": "objective_task_completed:lore_fragment_3",
              "targetKnot": "on_architect_directive_found",
              "conversationMode": "phone-chat",
              "setGlobal": { "lore_directive_found": true },
              "onceOnly": true
            },
            {
              "eventPattern": "objective_task_completed:submit_network_scan_flag",
              "onceOnly": true,
              "setGlobal": { "flag_scan_submitted": true }
            },
            {
              "eventPattern": "objective_task_completed:submit_ftp_flag",
              "onceOnly": true,
              "setGlobal": { "flag_ftp_submitted": true }
            },
            {
              "eventPattern": "objective_task_completed:submit_http_flag",
              "onceOnly": true,
              "setGlobal": { "flag_http_submitted": true }
            },
            {
              "eventPattern": "objective_task_completed:submit_distcc_flag",
              "targetKnot": "m2_revelation_call",
              "conversationMode": "phone-chat",
              "completeTask": "find_operational_logs",
              "setGlobal": { "flag_distcc_submitted": true },
              "onceOnly": true
            },
            <%# The confrontation opens only when all four flags are in, because the
                ending is gated on all four (concludeRequires). Confronting Victoria
                earlier would roll the debrief and then refuse the conclusion. The
                flags can land in any order, so each flag global carries the same
                all-four check; only the last one to arrive passes it. %>
            {
              "eventPattern": "global_variable_changed:flag_scan_submitted",
              "condition": "value === true && globalVars.flag_ftp_submitted === true && globalVars.flag_http_submitted === true && globalVars.flag_distcc_submitted === true && globalVars.night_confrontation_ready !== true",
              "onceOnly": true,
              "setGlobal": { "night_confrontation_ready": true }
            },
            {
              "eventPattern": "global_variable_changed:flag_ftp_submitted",
              "condition": "value === true && globalVars.flag_scan_submitted === true && globalVars.flag_http_submitted === true && globalVars.flag_distcc_submitted === true && globalVars.night_confrontation_ready !== true",
              "onceOnly": true,
              "setGlobal": { "night_confrontation_ready": true }
            },
            {
              "eventPattern": "global_variable_changed:flag_http_submitted",
              "condition": "value === true && globalVars.flag_scan_submitted === true && globalVars.flag_ftp_submitted === true && globalVars.flag_distcc_submitted === true && globalVars.night_confrontation_ready !== true",
              "onceOnly": true,
              "setGlobal": { "night_confrontation_ready": true }
            },
            {
              "eventPattern": "global_variable_changed:flag_distcc_submitted",
              "condition": "value === true && globalVars.flag_scan_submitted === true && globalVars.flag_ftp_submitted === true && globalVars.flag_http_submitted === true && globalVars.night_confrontation_ready !== true",
              "onceOnly": true,
              "setGlobal": { "night_confrontation_ready": true }
            },
            {
              "eventPattern": "global_variable_changed:night_confrontation_ready",
              "condition": "value === true && globalVars.victoria_ko !== true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 4000, "message": "That's everything off their network. And Sterling's card just went through the conference room reader. She's still in the building. She's waiting for someone. If you want a say in what happens to Danny Foster, his office is in the executive wing: go there first. Then go and see her." }
            },
            <%# Victoria KO. Keyed on npc_ko:<id>, which the engine emits, NOT on
                global_variable_changed:victoria_ko: globalVarOnKO writes the global
                without emitting a change event (npc-hostile.js:159-166), so handlers
                on that pattern never fired (playtest D2). npc_ko fires BEFORE
                globalVarOnKO is written, so these handlers set victoria_ko themselves.
                Several handlers fire together on purpose: they complete different
                tasks. Her fate is settled only once the network work is in, so the
                debrief can't roll before the evidence exists. %>
            {
              "eventPattern": "npc_ko:victoria_sterling",
              "condition": "globalVars.victoria_choice_made !== true",
              "onceOnly": true,
              "completeTask": "meet_victoria",
              "setGlobal": { "victoria_ko": true, "victoria_fate": "ko" }
            },
            {
              "eventPattern": "npc_ko:victoria_sterling",
              "onceOnly": true,
              "completeTask": "clone_rfid_card"
            },
            {
              "_comment": "D3: knocked out before her card was cloned, and her physical card never drops (no sprite outside the start room). HaX hands over a working copy by phone so the server room stays reachable.",
              "eventPattern": "npc_ko:victoria_sterling",
              "condition": "globalVars.mission_phase !== 'act2_infiltration'",
              "onceOnly": true,
              "targetKnot": "on_victoria_ko_card",
              "conversationMode": "phone-chat"
            },
            {
              "_comment": "Night KO: all four flags already in, and she's in front of you. Settle it now.",
              "eventPattern": "npc_ko:victoria_sterling",
              "condition": "globalVars.night_confrontation_ready === true && globalVars.victoria_choice_made !== true",
              "onceOnly": true,
              "completeTask": "victoria_choice_made",
              "setGlobal": { "victoria_choice_made": true }
            },
            {
              "_comment": "Day-KO path. Settling her fate the instant the last flag lands would fire the debrief on top of the revelation call and the drop-site. Instead HaX sends the player back to her, and the fate settles on entering the conference room.",
              "eventPattern": "global_variable_changed:night_confrontation_ready",
              "condition": "value === true && globalVars.victoria_ko === true && globalVars.victoria_choice_made !== true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 6000, "message": "That's everything off their network. Sterling's still in the conference room where you left her. Go back and we'll close this out -- and if you want a say in Danny Foster's end, his office first." }
            },
            {
              "eventPattern": "room_entered:conference_room_01",
              "condition": "globalVars.victoria_ko === true && globalVars.night_confrontation_ready === true && globalVars.victoria_choice_made !== true",
              "onceOnly": true,
              "completeTask": "victoria_choice_made",
              "setGlobal": { "victoria_choice_made": true }
            },
            {
              "eventPattern": "npc_ko:danny_foster",
              "condition": "globalVars.james_fate === ''",
              "onceOnly": true,
              "setGlobal": { "james_ko": true, "james_fate": "ko" }
            },
<% %w[reception_lobby main_hallway conference_room_01 server_room executive_wing_hallway executive_office james_office].each do |r| %>
            {
              "_comment": "hear_debrief backstop: it completes on the debrief's last line. If the page reloads mid-debrief, debrief_played is already set and the debrief won't replay, so the next room entry completes the task and the mission can conclude.",
              "eventPattern": "room_entered:<%= r %>",
              "condition": "globalVars.debrief_played === true",
              "onceOnly": true,
              "completeTask": "hear_debrief"
            },
<% end %>
            {
              "eventPattern": "global_variable_changed:whiteboard_seen",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "decode_whiteboard"
            },
            {
              "eventPattern": "global_variable_changed:roster_seen",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "decode_client_roster"
            },
            {
              "eventPattern": "global_variable_changed:usb_seen",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "lore_fragment_3"
            }
          ]
        },
        {
          "_comment": "Closing debrief: hidden in-person scene at HQ (m02 pattern), launched when Victoria's fate is settled.",
          "id": "closing_debrief",
          "displayName": "Agent HaX",
          "npcType": "person",
          "position": {"x": 500, "y": 500},
          "spriteSheet": "female_spy_v2",
          "avatar": "assets/characters/female_spy_headshot.png",
          "spriteTalk": "assets/characters/female_spy_talk.png",
          "spriteVisemes": "assets/characters/female_spy_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/m03_ghost_in_the_machine/ink/m03_closing_debrief.json",
          "currentKnot": "start",
          "behavior": { "initiallyHidden": true },
          "voice": {
            "name": "Aoede",
            "style": "Intelligence handler giving a mission debrief in person. Speak with a consistent British Received Pronunciation accent throughout -- do not shift to any other accent. Use a steady, mid-range pitch. Measured now the job is done.",
            "language": "en-GB"
          },
          "eventMappings": [
            {
              "eventPattern": "global_variable_changed:victoria_choice_made",
              "condition": "value === true && globalVars.debrief_played !== true",
              "onceOnly": true,
              "conversationMode": "person-chat",
              "targetKnot": "start",
              "background": "assets/backgrounds/hq1.png",
              "disableClose": true
            }
          ]
        }
      ]
    },

    "main_hallway": {
      "type": "hall_1x2gu",
      "connections": {
        "south": "reception_lobby",
        "west": "conference_room_01",
        "north": "server_room",
        "east": "executive_wing_hallway"
      },
      "objects": [],
      "npcs": []
    },

    "conference_room_01": {
      "type": "room_office",
      "locked": true,
      "lockType": "rfid",
      "requires": "receptionist_badge",
      "connections": {
        "east": "main_hallway"
      },
      "objects": [
        {
          "type": "notes",
          "name": "Presentation Materials",
          "takeable": false,
          "readable": true,
          "text": "WhiteHat Security Services -- Selected Engagements\n\nRetail, logistics, two county councils, a building society. Clean reports, happy clients, a testimonial from a bank.\n\nThe healthcare page is blank except for the heading.",
          "observations": "A glossy portfolio squared off on the conference table"
        },
        {
          "type": "notes",
          "name": "Conference Whiteboard",
          "takeable": false,
          "readable": true,
          "text": "TRAINING LAB -- 192.168.100.0/24\n\nRecon -> enumerate -> exploit -> report\n\nHosts: FTP, web, and a box labelled LEGACY BUILD (distcc) with three underlines.\n\nIn the corner, smaller: \"students do NOT touch .50 after hours\"",
          "observations": "The training lab diagram Sterling likes to stand beside"
        }
      ],
      "npcs": [
        {
          "id": "victoria_sterling",
          "displayName": "Victoria Sterling",
          "npcType": "person",
          "position": {"x": 5, "y": 4},
          "storyPath": "scenarios/m03_ghost_in_the_machine/ink/m03_npc_victoria.json",
          "currentKnot": "start",
          "globalVarOnKO": "victoria_ko",
          "spriteSheet": "female_blowse_v2",
          "spriteTalk": "assets/characters/female_blowse_talk.png",
          "spriteVisemes": "assets/characters/female_blowse_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "voice": {
            "name": "Despina",
            "style": "CEO and former conference speaker. Consistent British Received Pronunciation accent throughout. Cool, precise and amused; never raises her voice, because she has never needed to.",
            "language": "en-GB"
          },
          "eventMappings": [
            {
              "_comment": "Once her fate is decided she leaves the room (arrested, walked out, or back to running the front). A KO'd body stays where it fell.",
              "eventPattern": "global_variable_changed:victoria_choice_made",
              "condition": "value === true && globalVars.victoria_fate !== 'ko'",
              "onceOnly": true,
              "setVisible": false
            }
          ],
          "rfidCard": {
            "card_id": "victoria_keycard_clone",
            "rfid_protocol": "MIFARE_Classic_Custom_Keys",
            "name": "Executive Keycard"
          },
          "itemsHeld": [
            {
              "type": "keycard",
              "card_id": "victoria_keycard_clone",
              "rfid_protocol": "MIFARE_Classic_Custom_Keys",
              "name": "Executive Keycard",
              "takeable": true,
              "observations": "Victoria's physical executive keycard — opens the server room. Taking it off her means you never needed to clone it."
            }
          ]
        }
      ]
    },

    "server_room": {
      "type": "room_servers",
      "connections": {
        "south": "main_hallway"
      },
      "locked": true,
      "lockType": "rfid",
      "requires": "victoria_keycard_clone",
      "objects": [
        {
          "type": "safe",
          "id": "server_filing_cabinet",
          "name": "Filing Cabinet",
          "takeable": false,
          "locked": true,
          "lockType": "key",
          "keyPins": [30, 45, 35, 50],
          "difficulty": "easy",
          "observations": "A four-drawer filing cabinet, locked. Day-staff paperwork; not where the sensitive material lives.",
          "contents": [
            {
              "type": "notes",
              "name": "Training Lab Runbook",
              "takeable": true,
              "readable": true,
              "text": "STUDENT RUNBOOK -- 192.168.100.0/24\n\n1. nmap the subnet. Everything you need is on live hosts.\n2. The FTP box allows anonymous login. Read what you are given.\n3. The web host serves the price list. It is only encoded, not encrypted.\n4. The legacy build runs distcc. Do not run exploits against it without sign-off.\n\nInstructor note: the legacy box is not a toy. Leave it alone."
            }
          ]
        },
        {
          "type": "safe",
          "id": "wall_safe_server",
          "name": "Wall Safe",
          "takeable": false,
          "locked": true,
          "lockType": "pin",
          "requires": "<%= catalogue_safe_code %>",
          "difficulty": "medium",
          "observations": "A wall safe with a four-digit keypad. Whoever set it didn't write the code anywhere obvious.",
          "contents": [
            {
              "type": "text_file",
              "name": "Exploit Catalogue",
              "takeable": true,
              "readable": true,
              "text": "<%= json_escape(lore_fragment_2) %>",
              "observations": "Zero Day's price list. The healthcare line names Ghost, St. Catherine's and Sable's sign-off."
            }
          ]
        },
        {
          "type": "notes",
          "name": "Server Room Whiteboard",
          "takeable": false,
          "readable": true,
          "text": "<%= whiteboard_message_encoded %>",
          "observations": "Someone has written a note across the whiteboard. The letters are scrambled but the word lengths and punctuation hold -- each letter swapped for another, not gibberish. The decoding laptop will read it.",
          "onRead": { "setVariable": { "whiteboard_seen": true } }
        },
        {
          "type": "vm-launcher",
          "id": "vm_launcher_zero_day",
          "name": "VM Access Terminal",
          "takeable": false,
          "observations": "Zero Day's VM access terminal. From here you reach their training network -- the box they rehearse exploits on before they sell them.",
          "hacktivityMode": <%= vm_context && vm_context['hacktivity_mode'] ? 'true' : 'false' %>,
          "vm": <%= vm_object('ghost_in_machine_vm_network', {"id":1,"title":"Zero Day Training Network","ip":"192.168.100.0/24","enable_console":true}) %>
        },
        {
          "type": "workstation",
          "id": "cyberchef_workstation",
          "name": "CyberChef Workstation",
          "takeable": true,
          "puzzle_graph_role": "tool",
          "puzzle_graph_note": "Decoding tool — take it, then paste the whiteboard, Sterling's draft, the client roster and the desk drive to reveal the intel",
          "observations": "A laptop left open on CyberChef. Take it, then paste anything encoded you find — ROT13, Base64, hex, and layered combinations all decode here. Encoding is not encryption; there is no key to find."
        },
        {
          "type": "flag-station",
          "id": "flag_station_dropsite",
          "name": "Drop-Site Terminal",
          "takeable": false,
          "observations": "A SAFETYNET drop-site terminal. Submit the flags you recover from the training network here; each one goes straight to HaX.",
          "acceptsVms": ["ghost_in_machine_vm_network"],
          "flags": <%= flags_for_vm('ghost_in_machine_vm_network', ['flag{network_scan_complete}', 'flag{ftp_intel_gathered}', 'flag{pricing_intel_decoded}', 'flag{distcc_legacy_compromised}']) %>,
          <%# rewards[i] pairs with flags[i]. The distcc flag pays out the transaction
              log as a document the player carries (m02 71e8852e pattern). %>
          "flagRewards": [
            { "type": "emit_event", "event_name": "m03_scan_flag_submitted", "description": "Network map recorded" },
            { "type": "emit_event", "event_name": "m03_ftp_flag_submitted", "description": "FTP intelligence recorded" },
            { "type": "emit_event", "event_name": "m03_http_flag_submitted", "description": "Pricing intelligence recorded" },
            { "type": "give_item", "item_name": "Zero Day Transaction Log", "description": "distcc flag submitted - the drop-site prints the recovered transaction log" }
          ],
          "itemsHeld": [
            {
              "type": "text_file",
              "id": "zero_day_transaction_log",
              "name": "Zero Day Transaction Log",
              "takeable": true,
              "readable": true,
              "text": "<%= json_escape(operational_log_content) %>",
              "observations": "Printed by the drop-site from what you pulled off the distcc box. The sale to Ghost, with Sable's approval on it."
            }
          ]
        }
      ],
      "npcs": []
    },

    "executive_wing_hallway": {
      "type": "hall_1x2gu",
      "connections": {
        "west": "main_hallway",
        "north": "executive_office",
        "south": "james_office"
      },
      "objects": [],
      "npcs": [
        {
          "_comment": "Pass 2: moved here from main_hallway (no pickable lock there, so the lockpick LoS check could never fire). Deliberately VISIBLE all mission: the engine's LoS interrupt ignores visibility/KO (npc-manager.js:248-325), so a hidden guard would catch a day-time pick invisibly. His ink is phase-aware (staff-only by day, closed building at night). Patrol kept to x 5..8, y 3..4 of the 10x6 hall: clear of the west doorway (y2.5) and the south door (bottom-left), under the north door he watches.",
          "id": "night_guard",
          "displayName": "Security Guard",
          "npcType": "person",
          "position": {"x": 6, "y": 3},
          "storyPath": "scenarios/m03_ghost_in_the_machine/ink/m03_npc_guard.json",
          "currentKnot": "start",
          "spriteSheet": "male_security_guard_v2",
          "spriteTalk": "assets/characters/male_security_guard_talk.png",
          "spriteVisemes": "assets/characters/male_security_guard_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "voice": {
            "name": "Algieba",
            "style": "Contract security guard in his fifties. Consistent Estuary English accent throughout. Tired, dry and procedural; not stupid, and not paid enough to be a hero.",
            "language": "en-GB"
