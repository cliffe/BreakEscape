# ERB Helper Methods for Mission 3: Ghost in the Machine
require 'base64'
require 'json'

# Encoding helper functions
def rot13(text)
  text.tr("A-Za-z", "N-ZA-Mn-za-m")
end

def base64_encode(text)
  Base64.strict_encode64(text)
end

def hex_encode(text)
  text.unpack('H*').first
end

def json_escape(text)
  text.to_json[1..-2]  # Remove surrounding quotes from .to_json output
end

# Narrative content variables
#
# CONTINUITY: m02 Ransomed Trust is the source of truth for these figures.
#   exploit  - the ProFTPD 1.3.3c source backdoor (the trojaned 2010 release);
#              it has no CVE of its own, so none is quoted in this mission
#   sale     - invoice ZDS-2024-0847 to Ghost (Ransomware Incorporated);
#              exploit $25,000 within a $55,000 package (incl. 214-hospital recon)
#   attack   - Friday 15 November 2024, 02:47; ransom GBP 150,000 in Bitcoin
#   deaths   - m02 ends with two or six dead depending on the player's recovery
#              choice, so nothing in m03 states a count
# m03 is set in early December 2024, "last month" from St. Catherine's.
#
# SAFE CHAIN (pass 2, reworded pass 3): the catalogue safe no longer shares the
# founding year with the password. The server-room whiteboard (the night team's ROT13
# house style, kept from the day staff) says Sable is mailing the new code from her office; Sterling's
# unsent draft to the night team is stored as raw MIME with a Base64 body and
# carries the code.
#   whiteboard (server room) -> Sterling's PC (exec office) -> draft -> wall safe
catalogue_safe_code = "5829"
whiteboard_message_encoded = rot13("NIGHT TEAM: CATALOGUE STAYS IN THE WALL SAFE. SABLE HAS CHANGED THE CODE. SHE IS MAILING THE NEW ONE FROM HER OFFICE - DO NOT WRITE IT ON THIS BOARD.")

client_roster_content = "ZERO DAY -- ACTIVE CLIENT ROSTER (export)\n- GHOST / Ransomware Incorporated: healthcare package, DELIVERED\n- OBSIDIAN: ransomware deployment, Q4 pricing sent\n- VORTEX: credential harvesting\n- CRITICAL MASS: grid storage / BMS access, Phase 2 priority\n- ECLIPSE: industrial espionage"
client_roster_hex = hex_encode(client_roster_content)

architect_directive = "PHASE 2 -- INFRASTRUCTURE.\nZero Day supplies. Critical Mass executes.\nPriority one: grid storage and substation control (BMS, SCADA). Priority two: hospitals on generator when the grid drops.\nThe window opens within weeks. Winter.\nSt. Catherine's was the proof of concept. Either they paid, or they buried people. Both fund us; both teach the next client.\n-- A"
architect_directive_double = base64_encode(rot13(architect_directive))

lore_fragment_1 = "ZERO DAY: A BRIEF HISTORY (internal -- not for day staff)\n\nWhiteHat Security Services: founded 2010 by Victoria Sterling. Legitimate pentest firm. Still is, on the ground floor.\n\nThe research division is the other thing. It stopped reporting what it found to vendors and started selling it -- first quietly, then as a marketplace. Cell name: Zero Day Syndicate. Cell lead: 0day (identity held).\n\nSterling runs the front and the sales floor under the sign-off name SABLE. She answers to 0day and, above him, the Architect.\n\nHouse line: 'Every vulnerability we sell proves security was already broken. We just got paid for the honesty.'"

lore_fragment_2 = "Q4 2024 EXPLOIT CATALOGUE (internal)\n\nPremium tier:\n- ProFTPD 1.3.3c source backdoor: $25,000 (healthcare premium +40% applied)\n- Apache Struts2 RCE: $18,000\n- Windows SMBv3 RCE: $45,000\n\nStandard tier:\n- distcc 2.x remote exec (CVE-2004-2687): $3,200 (legacy estates)\n- Assorted SQLi vectors: $800-$2,400\n\nNote: healthcare buyers carry a 40% premium. They pay fast and they pay quietly.\n\nSOLD: ProFTPD package to GHOST (Ransomware Incorporated), inv. ZDS-2024-0847. Target: St. Catherine's Regional Medical Centre. Approved: SABLE."

lore_fragment_3_encoded = architect_directive_double

operational_log_content = "ZERO DAY TRANSACTION LOG (recovered from the training network)\n\n[2024-10-21 14:32] ProFTPD 1.3.3c source backdoor\n  Buyer: GHOST (Ransomware Incorporated), verified\n  Invoice: ZDS-2024-0847 -- package $55,000 incl. 214-hospital recon\n  Premium: healthcare +40%\n  Approved: SABLE\n  Status: DELIVERED\n\n[2024-11-15 02:47] Deployment confirmed\n  Target: St. Catherine's Regional Medical Centre\n  Ransom demand: GBP 150,000 (BTC)\n\n[NOTE] Architect sign-off on file. Phase 2 sourcing continues."

