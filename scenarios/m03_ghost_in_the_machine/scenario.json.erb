    "server_room": {
      "type": "room_servers",
      "connections": {
        "south": "main_hallway"
      },
      "locked": true,
      "lockType": "rfid",
      "requires": "victoria_keycard_clone",
      "objects": [
        {
          "type": "safe",
          "id": "server_filing_cabinet",
          "name": "Filing Cabinet",
          "takeable": false,
          "locked": true,
          "lockType": "key",
          "keyPins": [30, 45, 35, 50],
          "difficulty": "easy",
          "observations": "A four-drawer filing cabinet, locked. Day-staff paperwork; not where the sensitive material lives.",
          "contents": [
            {
              "type": "notes",
              "name": "Training Lab Runbook",
              "takeable": true,
              "readable": true,
              "text": "STUDENT RUNBOOK -- TRAINING LAB\n\n1. nmap the lab network from the server room terminal. Everything you need answers a scan.\n2. The FTP box runs ProFTPD 1.3.3c, the trojaned 2010 build. Anonymous login works; nothing that matters lives in the anonymous folder.\n3. The web host serves the price list. It is only encoded, not encrypted.\n4. The legacy build runs distcc. Do not run exploits against it without sign-off.\n\nInstructor note: the legacy box is not a toy. Leave it alone."
            }
          ]
        },
        {
          "type": "safe",
          "id": "wall_safe_server",
          "name": "Wall Safe",
          "_comment": "Pass 3b: pinned high on the west wall (tiles, room-relative). room_servers has its two safe slots stacked 26 px apart at the west wall (x 10-11, y 200/226), so the filing cabinet and this safe landed on top of each other and an interact by the safe opened the cabinet's pick. The strip left of the first server row (x 0-68, y 64-88) is clear in the template.",
          "position": { "x": 0.6, "y": 2.6 },
          "takeable": false,
          "locked": true,
          "lockType": "pin",
          "requires": "<%= catalogue_safe_code %>",
          "difficulty": "medium",
          "observations": "A wall safe with a four-digit keypad. Whoever set it didn't write the code anywhere obvious.",
          "contents": [
            {
              "type": "text_file",
              "name": "Exploit Catalogue",
              "takeable": true,
              "readable": true,
              "text": "<%= json_escape(lore_fragment_2) %>",
              "observations": "Zero Day's price list. The healthcare line names Ghost, St. Catherine's and Sable's sign-off.",
              "onRead": { "setVariable": { "catalogue_seen": true } }
            }
          ]
        },
        {
          "type": "notes",
          "name": "Server Room Whiteboard",
          "takeable": false,
          "readable": true,
          "text": "<%= whiteboard_message_encoded %>",
          "observations": "Someone has written a note across the whiteboard. The letters are scrambled but the word lengths and punctuation hold -- each letter swapped for another, not gibberish. The decoding laptop will read it.",
          "onRead": { "setVariable": { "whiteboard_seen": true } },
          "puzzle_graph_role": "clue",
          "puzzle_graph_unlocks": ["wall_safe_server"],
          "puzzle_graph_and_with": "cyberchef_workstation",
          "puzzle_graph_optional": true
        },
        {
          "type": "vm-launcher",
          "id": "vm_launcher_zero_day",
          "name": "VM Access Terminal",
          "takeable": false,
          "observations": "Zero Day's VM access terminal. From here you reach their training network -- the box they rehearse exploits on before they sell them.",
          "puzzle_graph_role": "vm",
          "hacktivityMode": <%= vm_context && vm_context['hacktivity_mode'] ? 'true' : 'false' %>,
          "vm": <%= vm_object('ghost_in_machine_vm_network', {"id":1,"title":"Zero Day Training Network","ip":"192.168.100.0/24","enable_console":true}) %>
        },
        {
          "type": "workstation",
          "id": "cyberchef_workstation",
          "name": "CyberChef Workstation",
          "_comment": "Pass 3e: pinned on the west small desk. room_servers puts the workstation and flag-station slots on top of each other on the east desk (260,166 / 262,172), so interacting with the drop-site picked the laptop up. Elevation keeps it drawn on top of the desk.",
          "position": { "x": 4.53, "y": 5.25, "elevation": 32 },
          "takeable": true,
          "puzzle_graph_role": "tool",
          "puzzle_graph_note": "Decoding tool — take it, then paste the whiteboard, Sterling's draft, the client roster and the desk drive to reveal the intel",
          "observations": "A laptop left open on CyberChef. Take it, then paste anything encoded you find — ROT13, Base64, hex, and layered combinations all decode here. Encoding is not encryption; there is no key to find."
        },
        {
          "type": "flag-station",
          "id": "flag_station_dropsite",
          "name": "Drop-Site Terminal",
          "takeable": false,
          "observations": "A SAFETYNET drop-site terminal. Submit the flags you recover from the training network here; each one goes straight to HaX.",
          "acceptsVms": ["ghost_in_machine_vm_network"],
          "flags": <%= flags_for_vm('ghost_in_machine_vm_network', ['flag{network_scan_complete}', 'flag{ftp_intel_gathered}', 'flag{pricing_intel_decoded}', 'flag{distcc_legacy_compromised}']) %>,
          <%# rewards[i] pairs with flags[i]. The distcc flag pays out the transaction
              log as a document the player carries (m02 71e8852e pattern). %>
          "flagRewards": [
            { "type": "emit_event", "event_name": "m03_scan_flag_submitted", "description": "Network map recorded" },
            { "type": "emit_event", "event_name": "m03_ftp_flag_submitted", "description": "FTP intelligence recorded" },
            { "type": "emit_event", "event_name": "m03_http_flag_submitted", "description": "Pricing intelligence recorded" },
            { "type": "give_item", "item_name": "Zero Day Transaction Log", "description": "distcc flag submitted - the drop-site prints the recovered transaction log" }
          ],
          "itemsHeld": [
            {
              "type": "text_file",
              "id": "zero_day_transaction_log",
              "name": "Zero Day Transaction Log",
              "takeable": true,
              "readable": true,
              "text": "<%= json_escape(operational_log_content) %>",
              "observations": "Printed by the drop-site from what you pulled off the distcc box. The sale to Ghost, with Sable's approval on it."
            }
          ]
        }
      ],
      "npcs": []
    },

    "executive_wing_hallway": {
      "type": "hall_1x2gu",
      "connections": {
        "west": "main_hallway",
        "north": "executive_office",
        "south": "danny_office"
      },
      "objects": [],
      "npcs": [
        {
          "_comment": "Pass 2: moved here from main_hallway (no pickable lock there, so the lockpick LoS check could never fire). Visible all mission; his ink is phase-aware (staff-only by day, closed building at night). Since engine 18237332 a hidden or KO'd NPC no longer sees lockpicking, so knocking him out makes picks free; Perfect Stealth therefore excludes a KO (pass 3, P6). Patrol kept to x 5..8, y 3..4 of the 10x6 hall: clear of the west doorway (y2.5) and the south door (bottom-left), under the north door he watches.",
          "id": "night_guard",
          "displayName": "Security Guard",
          "npcType": "person",
          "position": {"x": 6, "y": 3},
          "storyPath": "scenarios/m03_ghost_in_the_machine/ink/m03_npc_guard.json",
          "currentKnot": "start",
          "spriteSheet": "male_security_guard_v2",
          "spriteTalk": "assets/characters/male_security_guard_talk.png",
          "spriteVisemes": "assets/characters/male_security_guard_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "voice": {
            "name": "Algieba",
            "style": "Contract security guard in his fifties. Speak with a consistent Estuary English (Essex) accent throughout -- do not shift to any other accent. Low, slightly gravelly pitch; slow, flat pace. Tired, dry and procedural; not stupid, and not paid enough to be a hero.",
            "language": "en-GB"
          },
          "globalVarOnKO": "guard_knocked_out",
          "behavior": {
            "_comment": "Pass 3: hostile tuning set explicitly to m01's mildest guard-type NPC (Sarah: chaseSpeed 100, attackDamage 10, pauseToAttack true). Before this he used the engine defaults (chaseSpeed 145, attackDamage 10, pauseToAttack true, npc-behavior.js:343-347). He also no longer goes hostile on a detection without a choice (m03_npc_guard.ink on_lockpick_detected). Pass 3c: facePlayer and pauseForPlayer default to true with a 96 px radius (npc-behavior.js:318-328), and every point of this loop is within 96 px of the office door, so he stopped and turned to face anyone at the door: no back-turned window existed. Both off; he walks his loop and the cone does the work. Pass 3e: the 140-degree cone put his west-end dwell (facing up, about 63-69 degrees off the door line) on the cone edge, so the same moment sometimes caught and sometimes didn't. The loop now ends with a short step east into the (5,3) dwell, so he dwells facing east, clearly inside a 120-degree cone (about 25 degrees off the door line); every other dwell is clearly outside. Window: seen about 4.9 s (west dwell, then east under the door), safe about 8.1 s (east dwell facing down, the walk west, the step up) of a 13 s loop.",
            "hostile": {
              "chaseSpeed": 100,
              "attackDamage": 10,
              "pauseToAttack": true
            },
            "facePlayer": false,
            "patrol": {
              "enabled": true,
              "pauseForPlayer": false,
              "waypoints": [
                { "x": 5, "y": 3, "dwellTime": 2500 },
                { "x": 8, "y": 3 },
                { "x": 8, "y": 4, "dwellTime": 2500 },
                { "x": 4, "y": 4 },
                { "x": 4, "y": 3 }
              ],
              "speed": 40,
              "loop": true
            }
          },
          "los": {
            "enabled": true,
            "range": 150,
            "angle": 120,
            "visualize": true
          },
          "eventMappings": [
            {
              "_comment": "Deliberately repeatable. Pass 3b: one approach = one strike. The ink sets guard_grace on a catch and plays a no-strike 'still here' line until the player leaves the corridor (closing_debrief clears it on main_hallway / danny_office entry). Cooldown cut from 30 s to 3 s because the engine's interrupt gate (npc-manager.js shouldInterruptLockpickingWithPersonChat) ignores the mapping cooldown, so a retry inside a long cooldown was swallowed silently: no pick, no line. Pass 4 round 2: once the player has told him they're SAFETYNET or paid him, he keeps his word and doesn't catch the pick (the LOS gate evaluates this condition, npc-manager.js shouldInterruptLockpickingWithPersonChat). Perfect Stealth excludes both routes.",
              "condition": "globalVars.guard_told_safetynet !== true && globalVars.guard_bribed !== true",
              "eventPattern": "lockpick_used_in_view",
              "targetKnot": "on_lockpick_detected",
              "conversationMode": "person-chat",
              "background": "assets/backgrounds/background1.png",
              "onceOnly": false,
              "cooldown": 3000
            }
          ]
        }
      ]
    },

    "executive_office": {
