      "difficulty": "medium",
      "objects": [
        {
          "type": "safe",
          "id": "exec_filing_cabinet",
          "name": "Filing Cabinet",
          "takeable": false,
          "locked": true,
          "lockType": "key",
          "keyPins": [45, 35, 55, 30, 50],
          "difficulty": "medium",
          "observations": "A locked cabinet in the corner of Sterling's office. Not day-staff paperwork.",
          "contents": [
            {
              "type": "text_file",
              "name": "Zero Day: A Brief History",
              "takeable": true,
              "readable": true,
              "text": "<%= json_escape(lore_fragment_1) %>",
              "observations": "An internal history, written for the people who already know what the firm is."
            }
          ]
        },
        {
          "type": "pc",
          "id": "victoria_computer",
          "name": "Executive Computer",
          "takeable": false,
          "locked": true,
          "lockType": "password",
          "requires": "Sterling2010",
          "postitNote": "IT reset: Surname + year founded (e.g. Smith1999). Change it!",
          "showPostit": true,
          "difficulty": "medium",
          "observations": "Victoria Sterling's executive computer, password protected. A helpdesk slip is stuck to the monitor: your password was reset to the house default, surname plus the year we were founded (e.g. Smith1999). Please change it at next login. It doesn't look as if she did.",
          "contents": [
            {
              "type": "text_file",
              "name": "Unsent email to the night team (raw source)",
              "takeable": true,
              "readable": true,
              "text": "<%= base64_encode('To: night team. From: Sable.\nCatalogue safe re-coded to 5829 -- memorise it, do not write it on the board again.\nObsidian Q4 pricing goes out Friday: ProFTPD-class $25k, Struts $18k, healthcare +40% as ever.\nArchitect wants the Phase 2 list same day. -V') %>",
              "observations": "An unsent email to the night team, shown as raw message source. Her mail client saved it before it was ever sent: one unbroken block of upper and lower case letters, digits, + and /. Not a word of English in it.",
              "onRead": { "setVariable": { "draft_seen": true } },
              "puzzle_graph_role": "clue",
              "puzzle_graph_unlocks": ["wall_safe_server"],
              "puzzle_graph_and_with": "cyberchef_workstation",
              "puzzle_graph_optional": true
            },
            {
              "type": "text_file",
              "name": "Client Roster",
              "takeable": true,
              "readable": true,
              "text": "<%= client_roster_hex %>",
              "observations": "A raw export from the marketplace database: nothing but digits and the letters a to f, in pairs.",
              "onRead": { "setVariable": { "roster_seen": true } }
            }
          ]
        },
        {
          "type": "suitcase",
          "name": "Desk Drawer",
          "takeable": false,
          "locked": false,
          "observations": "A shallow compartment under the top drawer of Sterling's desk, not locked. She did not expect anyone to go through her desk.",
          "contents": [
            {
              "type": "text_file",
              "name": "Hidden USB Drive",
              "takeable": true,
              "readable": true,
              "text": "<%= lore_fragment_3_encoded %>",
              "observations": "A drive with one file on it: one unbroken block of letters, digits, + and /. Whoever wrote it didn't want it read at a glance, and one pass may not be enough.",
              "onRead": { "setVariable": { "usb_seen": true } }
            }
          ]
        }
      ],
      "npcs": []
    },

    "danny_office": {
      "type": "room_office",
      "connections": {
        "north": "executive_wing_hallway"
      },
      "objects": [
        {
          "type": "notes",
          "name": "Performance Review",
          "takeable": false,
          "readable": true,
          "text": "Danny Foster -- annual review. \"Exceptional standards. Strong instincts on responsible disclosure. A conscience the team relies on.\" Signed: V. Sterling.",
          "observations": "Danny Foster's performance review, signed by Sterling herself"
        },
        {
          "type": "notes",
          "name": "Family Photo",
          "takeable": false,
          "readable": true,
          "text": "Danny with his wife and their daughter, maybe four. She's holding a crayon sign: 'MY DAD IS A GOOD HACKER'.",
          "observations": "A framed photo on the desk, turned so he can see it while he works"
        },
        {
          "type": "pc",
          "name": "Danny's Workstation",
          "takeable": false,
          "locked": false,
          "observations": "Danny's computer, unlocked. Open on his own files.",
          "contents": [
            {
              "type": "text_file",
              "name": "Folder: GHOST -- Hospital Infrastructure Assessment",
              "takeable": true,
              "readable": true,
              "text": "GHOST -- HOSPITAL INFRASTRUCTURE ASSESSMENT (D. Foster)\n\nNetwork map of St. Catherine's Regional. Patient monitoring and critical care topology. FTP server flagged: ProFTPD, unpatched source build. Exploitation feasibility: HIGH.\n\nEmail, D. Foster to V. Sterling: \"Assessment complete. FTP vulnerability confirmed exploitable, architecture documented. Ready for the client. -DF\"\n\nSterling's reply, one line: \"Perfect. Security-awareness client, as discussed. Bill it to research.\"",
              "observations": "The reconnaissance that made St. Catherine's possible -- with Sterling's lie about the client sitting right underneath it.",
              "onRead": { "setVariable": { "danny_evidence_seen": true } }
            },
            {
              "type": "text_file",
              "name": "Personal notes (unsent)",
              "takeable": true,
              "readable": true,
              "text": "It was my map. My vulnerability notes. She said it was a security-awareness client.\n\nThen I saw the news. The ward. The topology matched exactly what I documented.\n\nI asked her. She said I was being paranoid, that hospitals get attacked all the time. Then she offered me a raise and called me 'essential'. She knows that I know.\n\nI should go to someone. But if I do, I'm the man who drew the map. What happens to them? To me?",
              "observations": "Danny's own notes to himself. Not sent to anyone."
            }
          ]
        }
      ],
      "npcs": [
        {
          "id": "danny_foster",
          "displayName": "Danny Foster",
          "npcType": "person",
          "position": {"x": 5, "y": 4},
          "spriteSheet": "male_nerd_v2",
          "spriteTalk": "assets/characters/male_nerd_talk.png",
          "spriteVisemes": "assets/characters/male_nerd_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "voice": {
            "name": "Iapetus",
            "style": "Security consultant in his late thirties, exhausted and frightened. Speak with a consistent East Midlands (Nottingham) accent throughout -- do not shift to any other accent. Mid-range pitch that tightens and rises under stress; quiet, quick pace. Quick to explain himself, close to tears without ever quite getting there.",
            "language": "en-GB"
          },
          "storyPath": "scenarios/m03_ghost_in_the_machine/ink/m03_danny_choice.json",
          "currentKnot": "start",
          "globalVarOnKO": "danny_ko",
          "taskOnKO": "danny_choice_made",
          "behavior": { "initiallyHidden": true },
          "eventMappings": [
            {
              "_comment": "Night-only scene (he is 'sitting in the dark'). Out at client sites in the afternoon; appears when the player enters his office after mission_phase flips. Not onceOnly: setVisible is idempotent, and re-firing re-reveals him after a reload (an initiallyHidden NPC is re-hidden on room load, npc-sprites.js:222). His office has no pickable lock, so a hidden Danny can't trip a lockpick LoS interrupt.",
              "eventPattern": "room_entered:danny_office",
              "condition": "globalVars.mission_phase === 'act2_infiltration'",
              "setVisible": true
            }
          ],
          "observations": "Danny Foster, a WhiteHat consultant. He looks like a man who hasn't slept properly in weeks."
        }
      ]
    }
