<%
# ========================================================================
# ALBION ENERGY STORAGE — BATTERY HALL CRISIS SCENARIO
# Case 2: Energy (CyBOK Phase 7 SIS Project)
# Version: Draft 1 — April 2026
# ========================================================================
#
# SCENARIO PREMISE (fix pass, 2026-10-05; facts per DIALOGUE_REVIEW.md "Decisions")
#   Saturday 21 March 2026. Albion Energy Storage, on the Trent near Newark (designated OES).
#   Friday 23:12 the historian proxy starts writing a flat 28.0°C; Saturday 01:47 the dormant
#   c.ellison account (a commissioning integrator's contractor, left 14 months ago, default
#   password on the jump server's local accounts) opens RDP from an internal enterprise host;
#   03:22 the SIS thermal trip goes 55→85°C and the hydrogen alarm 1.0→3.8% by volume.
#   06:15 Helen Marsh arrives; 06:30 she briefs the response and engineering team booked for
#   the 07:00 PLC-GRID maintenance window (the players).
#
# ROOM LAYOUT
#   scada_control_room (start) → north → battery_hall_1  [rfid: battery_hall_badge]
#                              → east  → engineering_workshop [rfid: workshop_rfid_key]
#
# ESD: never gated. Stations by the Battery Hall 1 door (control room side), on the control
#   room console, and a local one inside the hall. Anyone may press one on a credible hazard.
#
# DECISION SCENES (each gated in Priya S.'s debrief and the credits)
#   gauge_verdict        Helen: dial or screen            (HEL-1)
#   shutdown_argument    Helen / Marcus: shut down now     (HEL-5, MAR-1, R1)
#   evidence_before_esd  Marcus: photo of the screen first (R2)
#   isolation_scope      Marcus: how far to cut            (MAR-2, R5)
#   tom_refused_unverified  Tom rings back to verify       (TOM-2)
#   nis_initial_choice   Marcus: send now or wait          (MAR-3)
#   en002_verdict        Priya: does CLAIM-EN-002 hold     (PRI-6, R9)
#   patch_decision       Priya: risk owner today           (PRI-5, R3)
#
# ========================================================================
# ERB VARIABLES
# ========================================================================

require 'base64'

%>
{
  "scenario_brief": "Saturday 21 March 2026, 06:30. Albion Energy Storage, on the Trent near Newark: 100 MW and 200 MWh of lithium-ion batteries, designated an operator of essential services. You are the response and engineering team booked for the 07:00 maintenance window on the grid interface PLC. Helen Marsh, the site's SCADA engineer, got in at 06:15. Every screen in the control room says the night was normal. Helen isn't so sure, and she wants a word before anyone touches anything.",
  "show_scenario_brief": "on_resume",
  "disableAttacks": true,
  "lighting": { "enabled": true, "defaultMode": "on", "ambient": "#b8bfce" },

  "startRoom": "scada_control_room",

  "globalVariables": {
    "briefing_played": false,
    "helen_briefed": false,
    "hmi_reviewed": false,
    "incident_folder_read": false,
    "battery_hall_badge_collected": false,

    "anomaly_detected": false,
    "historian_flatline_found": false,
    "rate_of_change_viewed": false,
    "compare_racks_viewed": false,
    "gauge_verdict": "",
    "shutdown_argument": "",

    "jump_server_confirmed": false,
    "jump_server_isolated": false,
    "jump_server_threat_intel_viewed": false,
    "sis_audit_reviewed": false,
    "castletech_contacted": false,
    "network_isolated": false,
    "network_isolation_authorised": false,
    "cable_pull_agreed": false,
    "isolation_scope": "",
    "tom_refused_unverified": false,

    "sis_config_seen": false,
    "sis_certification_seen": false,
    "sis_tamper_confirmed": false,
    "helen_patch_view_heard": false,
    "marcus_airgap_view_heard": false,

<%# ESD (decision 3): esd_stations_live is the minigame's authVar and is always true, so no station
    is ever gated on a conversation. early_esd_activation = pressed before the historian was read;
    esd_before_dial = pressed before anyone read the dial. evidence_before_esd is Marcus's R2 scene
    ("photo" / "press"). facility_evacuated = the gas reached 2.0% by volume before any ESD: Helen
    presses the console station on the way out and Hall 1 is lost (decision 7); the debrief still runs. %>
    "esd_stations_live": true,
    "early_esd_activation": false,
    "esd_before_dial": false,
    "esd_activated": false,
    "evidence_before_esd": "",
    "hydrogen_alarm": false,
    "facility_evacuated": false,

    "marcus_webb_contacted": false,
    "network_isolation_requested": false,
    "en001_claim_assessed": false,

<%# NIS (decisions 5 and 6). nis_notified = Marcus sent the initial notification to Ofgem (competent
    authority, with DESNZ) with the NCSC copied. nis_deadline is an abstract game clock: when it runs
    out it sets nis_deadline_missed (Helen's bark, the debrief and the credits) and nothing else; it
    no longer opens the debrief. nis_initial_choice is Marcus's MAR-3 scene ("now" / "wait"). %>
    "nis_form_read": false,
    "nis_notified": false,
    "nis_initial_choice": "",
    "nis_deadline_missed": false,
    "trent_water_notified": false,
    "trent_water_raised": false,
    "trent_water_verify_first": false,
    "trent_lateral_ioc_viewed": false,

    "facility_safe_state": false,
    "priya_s_visible": false,
    "en002_verdict": "",
    "patch_decision": "",
    "debrief_complete": false,
    "network_architecture_reviewed": false
  },

  "narrator": {
    "id": "narrator",
    "skipTextValidation": true,
    "voice": {
      "name": "Charon",
      "style": "Calm, precise narrator; measured industrial tone; unhurried",
      "language": "en-GB"
    }
  },

  "player": {
    "sprite": "male_nerd"
  },

  "startItemsInInventory": [
    {
      "type": "phone",
      "name": "Albion Site Phone",
      "takeable": true,
      "phoneId": "site_phone",
      "npcIds": ["marcus_webb", "tom_hadley"],
      "observations": "The facility duty phone. Contacts: Marcus Webb (OT Security Manager) and CastleTech SOC."
