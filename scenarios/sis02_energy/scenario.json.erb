  "objectives": [

    {
      "aimId": "assess_control_room",
      "title": "Understand the Facility State",
      "description": "Get a briefing from Helen Marsh. Review the SCADA HMI. Read the Incident Response folder on the duty desk.",
      "status": "active",
      "order": 0,
      "tasks": [
        {
          "taskId": "talk_to_helen",
          "title": "Get a briefing from Helen Marsh",
          "type": "npc_conversation",
          "targetNPC": "helen_marsh",
          "status": "active"
        },
        {
          "taskId": "check_hmi_readings",
          "title": "Review the SCADA HMI readings on HMI-OPS-01",
          "type": "manual",
          "status": "active"
        },
        {
          "taskId": "read_incident_folder",
          "title": "Read the Incident Response folder",
          "type": "manual",
          "status": "active"
        }
      ]
    },

    {
      "aimId": "conduct_walkdown",
      "title": "Battery Hall 1 Walkdown",
      "description": "Go into Battery Hall 1 and read the local dial gauge at Rack A2. Compare it with what HMI-OPS-01 says.",
      "status": "locked",
      "order": 1,
      "unlockCondition": { "aimCompleted": "assess_control_room" },
      "tasks": [
        {
          "taskId": "enter_battery_hall",
          "title": "Enter Battery Hall 1",
          "type": "enter_room",
          "targetRoom": "battery_hall_1",
          "status": "active"
        },
        {
          "taskId": "check_thermometer",
          "title": "Read the local dial gauge at Rack A2",
          "type": "manual",
          "status": "active"
        }
      ]
    },

    {
      "aimId": "verify_anomaly",
      "title": "Check the Historian",
      "description": "Back on HMI-OPS-01, open the historian trend for the Hall 1 racks. Find out how long the screen has been showing the same number.",
      "status": "locked",
      "order": 2,
      "unlockCondition": { "aimCompleted": "conduct_walkdown" },
      "tasks": [
        {
          // MG-VM01: ScadaHistorianMinigame — sets historian_flatline_found + completes task
          "taskId": "review_historian",
          "title": "Identify and annotate the historian anomaly on HMI-OPS-01",
          "type": "manual",
          "status": "active"
        }
      ]
    },

    {
      "aimId": "contact_marcus_investigate",
      "title": "Call Marcus Webb and Investigate",
      "description": "Message Marcus Webb, the OT Security Manager. Get into the Engineering Workshop and find out who is on the jump server.",
      "status": "locked",
      "order": 3,
      "unlockCondition": { "aimCompleted": "verify_anomaly" },
      "tasks": [
        {
          "taskId": "call_marcus_initial",
          "title": "Message Marcus Webb (OT Security Manager)",
          "type": "npc_conversation",
          "targetNPC": "marcus_webb",
          "status": "active"
        },
        {
          "taskId": "find_workshop_key",
          "title": "Locate the Engineering Workshop RFID key",
          "type": "collect_items",
          "targetGroup": "workshop_key_group",
          "targetCount": 1,
          "showProgress": true,
          "status": "active"
        },
        {
          "taskId": "unlock_workshop",
          "title": "Unlock the Engineering Workshop",
          "type": "unlock_room",
          "targetRoom": "engineering_workshop",
          "status": "active"
        },
        {
          // MG-VM02: hmi_eng_02 — LogFilterMinigame (log-filter), IMPLEMENTED
          "taskId": "identify_rdp_session",
          "title": "Find the session on the jump server that shouldn't be there",
          "type": "manual",
          "status": "active"
        }
      ]
    },

    {
      "aimId": "investigate_sis",
      "title": "Investigate the SIS",
      "description": "Read the SIS configuration panel in the workshop. Find the certified setpoints in the filing cabinet and compare them. Then report what you find.",
      "status": "locked",
      "order": 4,
      "unlockCondition": { "aimCompleted": "contact_marcus_investigate" },
      "tasks": [
        {
          // IMPLEMENTED: sis_config_panel — custom SIS threshold viewer MG-03
          "taskId": "read_sis_config",
          "title": "Read the SIS configuration panel",
          "type": "manual",
          "status": "active"
        },
        {
          "taskId": "find_certification_doc",
          "title": "Find the SIS safety requirements extract in the filing cabinet",
          "type": "manual",
          "status": "active"
        },
        {
          "taskId": "confirm_sis_tamper",
          "title": "Report the SIS setpoint changes",
          "type": "manual",
          "status": "active"
        }
      ]
    },

<%# Decision 3: the ESD is never gated. The aim unlocks once the dial has been read (Helen's
    anomaly_detected mapping) or the walkdown is done, but every station works from the start. %>
    {
      "aimId": "initiate_esd",
      "title": "Shut Down Hall 1 (ESD)",
      "description": "Press an emergency shutdown station: by the Battery Hall 1 door, or on the control room console. Anyone may press one on a credible hazard. Nobody needs permission.",
      "status": "locked",
      "order": 5,
      "unlockCondition": { "aimCompleted": "conduct_walkdown" },
      "tasks": [
        {
          "taskId": "press_esd_button",
          "title": "Press an ESD station for Battery Hall 1",
          "type": "manual",
          "status": "active"
        }
      ]
    },

    {
      "aimId": "isolate_network",
      "title": "Isolate the Attacker",
      "description": "Pull the jump server's network cable. Get CastleTech to shut the enterprise side off from SCADA: they will check with Marcus before they change anything.",
      "status": "locked",
      "order": 6,
      "unlockCondition": { "aimCompleted": "contact_marcus_investigate" },
      "tasks": [
        {
          "taskId": "pull_ethernet_cable",
          "title": "Pull the jump server's network cable",
          "type": "manual",
          "status": "active"
        },
        {
          "taskId": "contact_castletech",
          "title": "Get Tom Hadley (CastleTech SOC) to isolate the enterprise side",
          "type": "npc_conversation",
          "targetNPC": "tom_hadley",
          "status": "active"
        }
      ]
    },

    {
      "aimId": "nis_notification",
      "title": "Send the NIS Notification",
      "description": "Read the NIS form on the clipboard by the workshop door. Then message Marcus Webb: he signs it off and sends it to Ofgem, with the NCSC copied. Send what you know now; it can be updated later.",
      "status": "locked",
      "order": 7,
      "unlockCondition": { "aimCompleted": "contact_marcus_investigate" },
      "tasks": [
        {
          "taskId": "complete_nis_form",
          "title": "Read the NIS form, then message Marcus Webb to send it",
          "type": "manual",
          "status": "active"
        }
      ]
    },

    {
      "aimId": "trent_water_notification",
      "title": "(Optional) Warn Trent Water",
      "description": "Trent Water shares Albion's file server. Decide whether CastleTech should warn them, and when.",
      "status": "locked",
      "order": 8,
      "unlockCondition": { "aimCompleted": "verify_anomaly" },
      "tasks": [
        {
          "taskId": "call_trent_water",
          "title": "Let Tom Hadley warn Trent Water Services",
          "type": "manual",
          "status": "active",
          "optional": true
        }
      ]
    },

    {
      "aimId": "post_incident_debrief",
      "title": "Post-Incident Debrief",
      "missionConclusion": true,
      "concludeRequires": { "globals": ["debrief_complete"] },
<%# Mission conclusion (2026-10-05). As in sis01: no VM flags, so the only gate is the end of the
    debrief itself. debrief_complete is set on the last beat of npc_priya_s.ink closing_end; the
    music event on it rolls the credits and POSTs /conclude. Nothing optional (Trent Water, NIS
    form, SIS tamper, cable pull) is required: the credits report those instead. The aim unlocks
    when Priya S. appears (priya_s_visible): on the safe state, or after the Hall 1 evacuation. %>
      "description": "Priya S. from the NCSC is in the control room. Go through the incident with her when you are ready.",
      "status": "locked",
      "order": 9,
      "unlockCondition": { "aimsCompleted": ["initiate_esd", "isolate_network"] },
      "tasks": [
        {
          "taskId": "talk_to_priya_s",
          "title": "Go through the debrief with Priya S. (NCSC)",
          "type": "npc_conversation",
          "targetNPC": "priya_s",
          "status": "active"
        }
      ]
    }

  ],

  "timers": [
<%# [MG-05] NIS notification clock (decision 6). An abstract game clock, not 72 real hours: the
    countdown widget shows it so players feel "without undue delay". When it runs out it sets
    nis_deadline_missed, which only drives Helen's bark, a debrief line and a credits line. It
    never opens or forces the debrief (the old forced-debrief mapping is gone). %>
    {
      "id": "nis_deadline",
      "label": "NIS notification clock (game time)",
      "delayMs": 2700000,
      "condition": "!globalVars.nis_notified",
      "setGlobal": { "nis_deadline_missed": true },
      "showCountdown": true,
      "onceOnly": true
    },
<%# [MG-04] Hydrogen progression (decisions 6 and 7). Both timers start when Helen's briefing ends
    (helen_briefed), not when the dial is read, and both are cancelled by any ESD station.
    T+25m: hydrogen at 1.0% by volume (25% LEL): alarm and ventilate; Helen rings the fire service.
    T+43m: hydrogen at 2.0% by volume (50% LEL): evacuate. Helen's evacuation scene presses the
    console ESD on the way out (esd_activated) and Hall 1 is lost to fire, everyone out, fire
    service attending. That is the correct response, not a failure: the debrief still runs. %>
    {
      "id": "h2_advisory",
      "label": "Hydrogen alarm (1.0% by volume)",
      "startOnGlobal": "helen_briefed",
      "delayMs": 1500000,
      "cancelOnGlobal": "esd_activated",
      "setGlobal": { "hydrogen_alarm": true },
      "showCountdown": false,
      "onceOnly": true,
      "actions": [
        {
          "type": "tint_objects",
          "roomId": "battery_hall_1",
          "textureKey": "batrack",
          "color": 16729122,
          "pulse": true
        }
      ]
    },
    {
      "id": "h2_evacuation",
      "label": "Hydrogen evacuation (2.0% by volume)",
      "startOnGlobal": "helen_briefed",
      "delayMs": 2580000,
      "cancelOnGlobal": "esd_activated",
      "condition": "!globalVars.esd_activated",
      "setGlobal": { "facility_evacuated": true },
      "showCountdown": false,
      "onceOnly": true
    }
  ],

  "music": {
    "events": [
      {
        "trigger": "game_loaded",
        "condition": "!globalVars.briefing_played",
        "playlist": "cutscene",
        "fade": false
      },
      {
        "trigger": "game_loaded",
        "condition": "globalVars.briefing_played === true",
        "playlist": "noir",
        "fade": false
      },
      {
        "trigger": "conversation_closed:helen_marsh",
        "condition": "globalVars.briefing_played === true",
        "playlist": "noir",
        "fade": true
      },
      {
        "trigger": "global_variable_changed:esd_activated",
        "condition": "value === true",
        "playlist": "cutscene",
        "fade": true
      },
      {
<%# Credits roll once (2026-10-05). The #set_global tag emits global_variable_changed every time it
    runs, even when the value is already true, so a replayed tag would roll the credits and POST
    /conclude a second time. The ink no longer replays it (npc_priya_s.ink start guard), and this
    condition ignores a re-set of a value that was already true. typeof guards the ink-observer path,
    whose payload carries no oldValue. %>
        "trigger": "global_variable_changed:debrief_complete",
        "condition": "value === true && (typeof oldValue === 'undefined' || oldValue !== true)",
        "playlist": "victory",
        "autoStop": true,
        "disableClose": true,
        "fade": true,
        "credits": [
          { "text": "INCIDENT CONTAINED",             "style": "title",    "condition": "globalVars.esd_activated && globalVars.network_isolated && !globalVars.facility_evacuated" },
          { "text": "HALL 1 LOST, EVERYONE OUT",      "style": "title",    "condition": "globalVars.facility_evacuated" },
          { "text": "CELLS SAFE, ATTACKER STILL CONNECTED", "style": "title", "condition": "!globalVars.facility_evacuated && !(globalVars.esd_activated && globalVars.network_isolated)" },
          { "text": "ALBION ENERGY STORAGE, SATURDAY 21 MARCH 2026", "style": "subtitle" },

          { "text": "── PHYSICAL SAFETY ──", "style": "section-header" },
          { "text": "Dial or screen: you backed the dial", "style": "entry", "condition": "globalVars.gauge_verdict === 'dial'" },
          { "text": "Dial or screen: you backed the screen", "style": "entry", "condition": "globalVars.gauge_verdict === 'screen'" },
          { "text": "Dial or screen: you wanted the historian first", "style": "entry", "condition": "globalVars.gauge_verdict === 'historian'" },
          { "text": "Shutdown argued on the hazard, before the cause was known", "style": "entry", "condition": "globalVars.shutdown_argument === 'hazard'" },
          { "text": "Shutdown held back for evidence first", "style": "entry", "condition": "globalVars.shutdown_argument === 'evidence'" },
          { "text": "ESD pressed before anyone had read the dial", "style": "entry", "condition": "globalVars.esd_before_dial" },
          { "text": "ESD pressed on the dial reading, before the historian was checked", "style": "entry", "condition": "globalVars.early_esd_activation && !globalVars.esd_before_dial" },
          { "text": "ESD pressed before the hydrogen alarm: Racks A1 to A4 off charge and cooling", "style": "entry", "condition": "globalVars.esd_activated && !globalVars.hydrogen_alarm" },
          { "text": "ESD pressed after the hydrogen alarm (1.0% by volume): Hall 1 saved, margin spent", "style": "entry", "condition": "globalVars.esd_activated && globalVars.hydrogen_alarm && !globalVars.facility_evacuated" },
          { "text": "Hydrogen reached 2.0% by volume: everyone out, Helen pressed the ESD on the way, Hall 1 lost to fire, fire service attending", "style": "entry", "condition": "globalVars.facility_evacuated" },
          { "text": "Live screen photographed before the ESD reset the BMS registers", "style": "entry", "condition": "globalVars.evidence_before_esd === 'photo'" },
          { "text": "ESD pressed without saving the screen: the falsified register values were lost", "style": "entry", "condition": "globalVars.evidence_before_esd === 'press'" },

          { "text": "── NETWORK CONTAINMENT ──", "style": "section-header" },
          { "text": "Jump server cable pulled on Marcus Webb's word: attacker's RDP session cut", "style": "entry", "condition": "globalVars.jump_server_isolated && globalVars.cable_pull_agreed" },
          { "text": "Jump server cable pulled before telling Marcus Webb: attacker's RDP session cut", "style": "entry", "condition": "globalVars.jump_server_isolated && !globalVars.cable_pull_agreed" },
          { "text": "Jump server cable left in", "style": "entry", "condition": "!globalVars.jump_server_isolated" },
          { "text": "Isolation scope: historian's enterprise leg cut too; dispatch feed lost for a day", "style": "entry", "condition": "globalVars.isolation_scope === 'historian'" },
          { "text": "Isolation scope: historian left connected and watched", "style": "entry", "condition": "globalVars.isolation_scope === 'watch'" },
          { "text": "Isolation scope: SCADA shut down; Hall 2 on hourly manual rounds", "style": "entry", "condition": "globalVars.isolation_scope === 'scada'" },
          { "text": "Enterprise side isolated by CastleTech, after they rang Marcus Webb back", "style": "entry", "condition": "globalVars.network_isolated" },
          { "text": "CastleTech refused a boundary change until it was verified", "style": "entry", "condition": "globalVars.tom_refused_unverified" },
          { "text": "Enterprise side not isolated", "style": "entry", "condition": "!globalVars.network_isolated" },

          { "text": "── SIS INVESTIGATION ──", "style": "section-header" },
          { "text": "Jump server session found: c.ellison, a commissioning contractor's account, left live for 14 months", "style": "entry", "condition": "globalVars.jump_server_confirmed" },
          { "text": "Jump server logs not reviewed", "style": "entry", "condition": "!globalVars.jump_server_confirmed" },
          { "text": "SIS changes confirmed: thermal trip 55°C → 85°C, hydrogen alarm 1.0% → 3.8% by volume", "style": "entry", "condition": "globalVars.sis_tamper_confirmed" },
          { "text": "SIS changes not confirmed during the response", "style": "entry", "condition": "!globalVars.sis_tamper_confirmed" },

          { "text": "── NOTIFICATIONS ──", "style": "section-header" },
          { "text": "NIS initial notification sent to Ofgem, NCSC copied, inside the clock", "style": "entry", "condition": "globalVars.nis_notified && !globalVars.nis_deadline_missed" },
          { "text": "NIS notification sent after the clock ran out", "style": "entry", "condition": "globalVars.nis_notified && globalVars.nis_deadline_missed" },
          { "text": "NIS notification held back to wait for the full picture", "style": "entry", "condition": "!globalVars.nis_notified && globalVars.nis_initial_choice === 'wait'" },
          { "text": "NIS notification not sent", "style": "entry", "condition": "!globalVars.nis_notified && globalVars.nis_initial_choice !== 'wait'" },
          { "text": "Trent Water warned straight away, with Albion's consent", "style": "entry", "condition": "globalVars.trent_water_notified && !globalVars.trent_water_verify_first" },
          { "text": "Trent Water warned after checking the evidence first", "style": "entry", "condition": "globalVars.trent_water_notified && globalVars.trent_water_verify_first" },
          { "text": "Trent Water not yet warned: still verifying", "style": "entry", "condition": "!globalVars.trent_water_notified && globalVars.trent_water_verify_first" },
          { "text": "Trent Water not warned", "style": "entry", "condition": "!globalVars.trent_water_notified && !globalVars.trent_water_verify_first" },

          { "text": "── SAFETY CASE ──", "style": "section-header" },
          { "text": "CLAIM-EN-002 (SIS isolation): judged broken before the attack", "style": "entry", "condition": "globalVars.en002_verdict === 'broken'" },
          { "text": "CLAIM-EN-002 (SIS isolation): judged to have held. Its condition was already false", "style": "entry", "condition": "globalVars.en002_verdict === 'held'" },
          { "text": "SIS patch, as risk owner: patch, and own eight weeks of manual rounds", "style": "entry", "condition": "globalVars.patch_decision === 'active_management'" },
          { "text": "SIS patch, as risk owner: defer, with controls someone checks", "style": "entry", "condition": "globalVars.patch_decision === 'deferral'" },

