    "ot_forensics_reviewed": false,
    "warranty_evidence_reviewed": false,

    "warranty_checklist_complete": false,
    "underwriting_file_reviewed": false,
    "loss_quantum_reviewed": false,
    "attribution_brief_reviewed": false,
    "coverage_form_reviewed": false,

    "trent_water_assessed": false,
    "trent_water_in_scope": false,

    "coverage_decision_made": false,
    "coverage_decision": "not_yet",
    "war_exclusion_invoked": false,
    "disclosure_position": "not_yet",

    "ins001_assessed": false,
    "ins003_assessed": false,
    "ins008_assessed": false,
    "ins009_assessed": false,

    "eleanor_debrief_mode": false,
    "debrief_started": false,
    "debrief_complete": false
  },

  "startItemsInInventory": [
    {
      "type": "phone",
      "name": "Meridian Claims Phone",
      "takeable": true,
      "phoneId": "claims_phone",
      "npcIds": ["james_whitworth", "simon_hartley", "robert_ngata"],
      "observations": "Meridian's dedicated claims response mobile. Contacts: James Whitworth (Albion General Manager), Simon Hartley (Fairbridge Associates), Robert Ngata (NCSC threat assessment lead; call him once you have read the NCSC brief)."
    }
  ],

  "narrator": {
    "id": "narrator",
    "skipTextValidation": true,
    "voice": {
      "name": "Charon",
      "style": "Calm, authoritative narrator for a corporate insurance investigation. Measured pace.",
      "language": "en-GB"
    }
  },

  "objectives": [
    {
      "aimId": "initial_briefing",
      "title": "Open the Albion Claim",
      "description": "Receive your initial briefing from Eleanor Vance. Understand the claim scope and the three coverage issues requiring analysis.",
      "status": "active",
      "order": 0,
      "tasks": [
        {
          "taskId": "talk_to_eleanor_initial",
          "type": "npc_conversation",
          "targetNPC": "eleanor_vance",
          "status": "active",
          "title": "Receive initial briefing from Eleanor Vance"
        }
      ]
    },

    {
      "aimId": "investigate_claim",
      "title": "Confirm Coverage and Trace the Forensic Chain",
      "description": "Review the Albion policy binder to confirm the incident falls within the insuring clause. Use the Forensic Data Platform terminal to trace the causal chain from cyber event to physical damage.",
      "status": "locked",
      "order": 1,
      "unlockCondition": { "aimCompleted": "initial_briefing" },
      "tasks": [
        {
          "taskId": "read_policy_binder",
          "type": "manual",
          "status": "locked",
          "title": "Read the Albion policy binder — identify the insuring clause, warranty schedule, and act-of-war exclusion"
        },
        {
          "taskId": "read_claim_file",
          "type": "manual",
          "status": "active",
          "title": "Read Whitworth's incident notification — confirm claim quantum and timeline"
        },
        {
          "taskId": "submit_forensic_flag",
          "type": "manual",
          "status": "active",
          "title": "Verify the forensic causal chain on the FDP terminal"
        }
      ]
    },

    {
      "aimId": "access_evidence_archive",
      "title": "Access the Evidence Archive",
      "description": "Use the archive access code from Eleanor to enter the Evidence Archive. Review all three forensic evidence packets.",
      "status": "locked",
      "order": 2,
      "unlockCondition": { "aimCompleted": "investigate_claim" },
<%# The exhibit tasks ship active: unlockAim only activates the first task (enter_archive), so
    once inside the archive the aim showed nothing left to do. %>
      "tasks": [
        {
          "taskId": "enter_archive",
          "type": "enter_room",
          "targetRoom": "meridian_evidence_archive",
          "status": "locked",
          "title": "Enter the Meridian Evidence Archive"
        },
        {
          "taskId": "read_packet_a",
          "type": "manual",
          "status": "active",
          "title": "Review Exhibit A — IT forensics summary"
        },
        {
          "taskId": "read_packet_b",
          "type": "manual",
          "status": "active",
          "title": "Review Exhibit B — OT forensics summary (note the evidence gaps)"
        },
        {
          "taskId": "read_packet_c",
          "type": "manual",
          "status": "active",
          "title": "Review Exhibit C — warranty compliance evidence"
        }
      ]
    },

    {
      "aimId": "assess_warranties",
      "title": "Assess Warranty Compliance",
      "description": "Talk to Eleanor Vance and discuss all four warranty positions — W-03, W-07, W-09, and W-12 — to complete the compliance assessment. The W-03 SIS patch deferral requires careful reasoning about the IEC 61511 constraint and the compensating controls Albion failed to implement.",
      "status": "locked",
      "order": 3,
      "unlockCondition": { "aimCompleted": "access_evidence_archive" },
      "tasks": [
        {
          "taskId": "talk_to_eleanor_warranties",
          "type": "npc_conversation",
          "targetNPC": "eleanor_vance",
          "status": "locked",
          "title": "Discuss warranty compliance with Eleanor Vance"
        }
      ]
    },

    {
      "aimId": "make_recommendation",
      "title": "Review and Make Coverage Recommendation",
      "description": "Review Simon Hartley's loss adjustment report, open the NCSC attribution brief, and review the underwriting file. Then make your coverage recommendation to Eleanor.",
      "status": "locked",
      "order": 4,
      "unlockCondition": { "aimCompleted": "assess_warranties" },
<%# The three reading tasks ship active, so the aim always shows something to do when it
    opens (unlockAim only activates the first task). The decision task unlocks once the
    NCSC brief and the underwriting file are both read (Eleanor eventMappings), and
    completes when the form is submitted (coverage_decision_made mapping), not when
    Eleanor hands the form over. %>
      "tasks": [
        {
          "taskId": "read_hartley_report",
          "type": "manual",
          "status": "active",
          "title": "Review Simon Hartley's independent loss adjustment report"
        },
        {
          "taskId": "read_ncsc_brief",
          "type": "manual",
          "status": "active",
          "title": "Open and read the NCSC Attribution Brief (TLP:AMBER)"
        },
        {
          "taskId": "read_underwriting_file",
          "type": "manual",
          "status": "active",
          "title": "Review the Meridian underwriting file — the renewal memo is critical"
        },
        {
          "taskId": "talk_to_eleanor_decision",
          "type": "manual",
          "status": "locked",
          "title": "Get the Coverage Decision Form from Eleanor Vance and submit your recommendation"
        },
        {
          "taskId": "complete_warranty_checklist",
          "type": "manual",
          "status": "active",
          "optional": true,
          "title": "Complete the warranty compliance assessment — record breach positions for W-03, W-07, W-09, and W-12"
        }
      ]
    },

    {
      "aimId": "trent_water_assessment",
      "title": "Assess Trent Water Exposure (Optional)",
      "description": "Call Robert Ngata at the NCSC to discuss the Trent Water cross-sector exposure. Decide whether to include the third-party liability in scope or refer out pending investigation.",
      "status": "locked",
      "order": 5,
      "unlockCondition": { "globalVariable": "attribution_brief_reviewed", "equals": true },
      "tasks": [
        {
          "taskId": "assess_trent_water",
          "type": "npc_conversation",
          "targetNPC": "robert_ngata",
          "status": "locked",
          "title": "Call Robert Ngata (NCSC) — assess Trent Water third-party exposure"
        }
      ]
    },

    {
      "aimId": "closing_debrief",
      "title": "Closing Debrief — Insurance as Safety Governance",
      "missionConclusion": true,
<%# No VM or flag work in this SIS game, so there is nothing the server must hold the ending
    for: the empty gate trusts the client (README_scenario_design.md, concludeRequires). The
    only task completes on the debrief's last line, after debrief_complete has rolled the
    credits. A globals gate on debrief_complete would race that task's POST against the
    state sync and could flash "Not Yet" over the credits. %>
      "concludeRequires": {},
      "description": "Eleanor Vance reviews the coverage decision and its implications for insurance as a safety governance mechanism. Topics vary based on what you found and what you decided.",
      "status": "locked",
      "order": 6,
      "unlockCondition": { "aimCompleted": "make_recommendation" },
      "tasks": [
        {
          "taskId": "talk_to_eleanor_debrief",
          "type": "npc_conversation",
          "targetNPC": "eleanor_vance",
          "status": "locked",
          "title": "Closing debrief with Eleanor Vance"
        }
      ]
    }
  ],

  "music": {
    "events": [
      {
        "trigger": "game_loaded",
        "condition": "!globalVars.briefing_played",
        "playlist": "cutscene",
        "fade": false
      },
