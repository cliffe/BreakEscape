<%# ---------------------------------------------------------------------------
    THE COUNTDOWN (PASS 2 rework, lesson 29). Real engine timers; nothing here
    fails the mission. The old clock started at the briefing and ran 60 real
    minutes, VM time included, so most players watched it hit zero and then
    saved the grid anyway. Now:
      architect_t20_played    10 min after team_assigned  (he names what was left)
      architect_t10_played    30 min after team_assigned  (the redirect warning)
      redirect_window_closed  40 min after team_assigned  (or on flag 3, below)
      redirect_window_display the same 40 min, shown on the HUD only once the
                              player has found the correction with the window open
      -- the cascade is ARMED when the player logs in to the attack host (flag 3) --
      architect_t5_played     10 min after flag3_submitted
      architect_t1_played     14 min after flag3_submitted
      countdown_expired       15 min after flag3_submitted (step one runs: Seattle)
    Only the armed clock is shown. All cancelled by grid_saved.
    PASS 2 review M1: the HUD (ui/scenario-timer.js) ignores cancelOnGlobal, so
    each timer also carries a "condition" on grid_saved: the HUD hides a timer
    whose condition fails and the dispatcher skips its setGlobal. PASS 5
    scenario design r1 (m5): the dispatcher now resumes started timers on
    reload from their saved start times (scenario-timer-dispatcher.js, D14),
    so the fifteen-minute clock survives a reload; the guards stay. The redirect
    window also closes on flag3_submitted (agent_0x99 mapping).
    PASS 5 alignment r1 (M4): T-10 used to share the 40-minute timer with the
    window, so it always opened with the window shut and its open-window lines
    could never play. It has its own timer at 30 minutes now. (M3): the window
    is shown on the HUD once it matters; that timer sets nothing.
%>
  "timers": [
    {
      "id": "architect_taunt_t20",
      "condition": "!globalVars.grid_saved",
      "label": "Incoming transmission",
      "delayMs": 600000,
      "startOnGlobal": "team_assigned",
      "cancelOnGlobal": "grid_saved",
      "setGlobal": { "architect_t20_played": true },
      "showCountdown": false,
      "onceOnly": true
    },
    {
      "id": "architect_taunt_t10",
      "condition": "!globalVars.grid_saved",
      "label": "Incoming transmission",
      "delayMs": 1800000,
      "startOnGlobal": "team_assigned",
      "cancelOnGlobal": "grid_saved",
      "setGlobal": { "architect_t10_played": true },
      "showCountdown": false,
      "onceOnly": true
    },
    {
      "id": "redirect_window_close",
      "condition": "!globalVars.grid_saved",
      "label": "Redirect window",
      "delayMs": 2400000,
      "startOnGlobal": "team_assigned",
      "cancelOnGlobal": "grid_saved",
      "setGlobal": { "redirect_window_closed": true },
      "showCountdown": false,
      "onceOnly": true
    },
    {
      "id": "redirect_window_display",
      "condition": "globalVars.projection_revised && !globalVars.redirect_window_closed && !globalVars.team_redirected && globalVars.team_assignment !== 'trojan_horse' && !globalVars.grid_saved",
      "label": "Team redirect window",
      "delayMs": 2400000,
      "startOnGlobal": "team_assigned",
      "cancelOnGlobal": "grid_saved",
      "showCountdown": true,
      "onceOnly": true
    },
    {
      "id": "architect_taunt_t5",
      "condition": "!globalVars.grid_saved",
      "label": "Cascade in 05:00",
      "delayMs": 600000,
      "startOnGlobal": "cascade_armed",
      "cancelOnGlobal": "grid_saved",
      "setGlobal": { "architect_t5_played": true },
      "showCountdown": false,
      "onceOnly": true
    },
    {
      "id": "architect_taunt_t1",
      "condition": "!globalVars.grid_saved",
      "label": "Cascade in 01:00",
      "delayMs": 840000,
      "startOnGlobal": "cascade_armed",
      "cancelOnGlobal": "grid_saved",
      "setGlobal": { "architect_t1_played": true },
      "showCountdown": false,
      "onceOnly": true
    },
    {
      "id": "cascade_zero",
      "condition": "!globalVars.grid_saved && !globalVars.countdown_expired",
      "label": "Cascade sequence",
      "delayMs": 900000,
      "startOnGlobal": "cascade_armed",
      "cancelOnGlobal": "grid_saved",
      "setGlobal": { "countdown_expired": true },
      "showCountdown": true,
      "onceOnly": true
    },
    <%# PASS 4 (design review fix 1): the debrief no longer opens by itself the
        moment the Architect hangs up, so a player who left the plant for after
        the abort can still go down. The player asks for it on HaX's hub
        (debrief_requested); this is the backstop so nobody waits forever. It
        sets a separate latch, and HaX's mappings turn it into debrief_requested
        with a text (flags in, or still missing). Round 2 (re-review F2): starts
        on grid_saved, so a reload mid sign-off can't strand it; 9 min covers
        the roughly 1-minute sign-off plus the "eight minutes" HaX promises. %>
    {
      "id": "debrief_fallback",
      "condition": "!globalVars.debrief_requested",
      "label": "Debrief",
      "delayMs": 540000,
      "startOnGlobal": "grid_saved",
      "cancelOnGlobal": "debrief_requested",
      "setGlobal": { "debrief_timer_fired": true },
      "showCountdown": false,
      "onceOnly": true
    }
  ],

<%# LIGHTING (pass 5): a grid control facility at night, mid-evacuation. Night ambient as m02/m06. Plan: LIGHTING_PLAN.md. %>
  "lighting": { "enabled": true, "defaultMode": "on", "ambient": "#b8bfce" },

  "rooms": {

