    {
      "aimId": "reach_the_control_network",
      "title": "Get Onto The Control Network",
      "description": "The server hall is badge-controlled and the cascade is being driven from a host on the other side of that door. Get in, get a working box, and start pulling whatever the attackers left behind.",
