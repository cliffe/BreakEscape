<%
# ============================================================================
# MISSION 7: THE ARCHITECT'S GAMBIT - SCENARIO FILE
# ============================================================================
# Break Escape - Season 1: The Architect's Shadow
#
# Rebuilt for the DELEGATION model (see PASS2_IMPROVEMENTS.md, "Design rationale").
# The authoritative identifier contract for this mission is CONTRACT.md.
# Anything in this file that names an NPC, room, object, global, flag, task or
# ink knot is fixed by CONTRACT.md. Do not rename without updating that file.
#
# WP1 SCOPE (this pass): rooms, room types, connections, the lock chain,
# objects, starting inventory, NPC blocks (id / displayName / npcType /
# storyPath / currentKnot / position / patrol / los), globalVariables and the
# engine countdown timers.
#
# DELIBERATELY ABSENT — owned by later work packages:
#   WP2  objectives + tasks, flagRewards, taskOnKO / globalVarOnKO
#   WP6  itemsHeld field guides on agent_0x99, dialogue eventMappings
#   WP7  Architect taunt eventMappings, Hollis / Park barks
#   WP9  voice blocks, the music block, narrator block
#
# ROOM LAYOUT (grid units; 1 GU = 5 x 4 tiles = 160 x 128 px)
#
#                                   [SCADA Control]      (2x1 GU, password)
#                                          |
#   [Security Checkpoint]--[Ops Floor]--[Server Room]    (2x2 GU each, rfid on Server)
#         START                              |
#                                   [Backup Generator Room]   (4x2 GU, key+lockpick)
#                                          |
#                                   [Underground Cable Vault] (2x1 GU, pin)
#
#   Verified overlap-free by scripts/validate_scenario.rb and
#   scripts/predict_door_sides.py. Room boxes in GU:
#     security_checkpoint (0,0)-(2,2)   operations_floor (2,0)-(4,2)
#     server_room         (4,0)-(6,2)   scada_control    (4,-1)-(6,0)
#     generator_room      (4,2)-(8,4)   cable_vault      (4,4)-(6,5)
#
# LOCK CHAIN -- every gate has a redundant source so no KO strands the run:
#   rfid     server_room     <- Hollis's badge (talk / KO drop) | badge station
#                               in the checkpoint (PIN from the ops-floor handover)
#   key      generator_room  <- maintenance key (ops) | lockpick (start inventory)
#   pin      cable_vault     <- rule (flag-1 decode | Hollis) + ATS-1 plate | Elena
#   password scada_control   <- Elena Rodriguez       | C2 capture (flag 2 payout)
#   flag     crisis_control_system <- flag 4 reward unlock_object (no requires:
#            one submission point per flag, PASS 2 lesson 6)
#
# THE COUNTDOWN (PASS 2, lesson 29). The sequence is loaded but armed by the
# attack host. It arms when the player logs in to that host (flag 3): from then
# a visible fifteen-minute clock runs. If it reaches zero the first step
# (Seattle metro) executes and the abort stops steps two to four. Nothing
# fails the mission. The redirect window closes on the 40-minute timer OR
# flag 3. Ink reads redirect_window_closed and countdown_expired only.
# ============================================================================

# --- Secrets -----------------------------------------------------------------
# PASS 3: the last four of the ATS-1 transfer switch's plate serial (generator
# room). The rule (read it off the plate) is in the flag-1 relay decode and in
# what a talked-round Hollis says; Elena speaks the number. The maintenance log's
# old code is void.
vault_pin = "4703"

# Badge station PIN, on the shift handover sheet on the operations floor.
badge_pin = "0616"

# SCADA control room door. Elena gives it; the C2 capture handed over for VM
# flag 2 carries it as the redundant source.
scada_password = "CascadeWindow19"
%>
{
  "scenario_brief": "Four ENTROPY operations went live inside the same sixty seconds. SAFETYNET has one agent in range and one tactical team. You are the agent, forty minutes from a grid control facility outside Portland, where a loaded sequence can black out three states in winter. The team can reach one of the other three crises. You decide which. Two go unanswered, and somebody will read out what happened at both.",

  "show_scenario_brief": "on_resume",

  "startRoom": "security_checkpoint",

  "flags": {
    "scada_attack_host": <%= vm_flags_json('scada_attack_host', ['flag{nfs_coordination_traffic}', 'flag{netcat_c2_intercepted}', 'flag{root_on_attack_host}', 'flag{cascade_scripts_terminated}']) %>
  },

<%# WP9 -- Narrator voice. Every ink file in this mission carries Narrator: scene
    beats; without this block they render silently. Shape copied from m01. %>
  "narrator": {
    "id": "narrator",
    "skipTextValidation": true,
    "voice": {
      "name": "Algenib",
      "style": "Cinematic thriller narrator. Consistent British Received Pronunciation accent throughout -- do not shift to any other accent. Low, unhurried, grave. A building full of machinery that is about to be used against people.",
      "language": "en-GB"
    }
  },

<%# WP9 -- Dynamic music. Structure copied from m02_ransomed_trust.
    Beat map:
      approach / briefing ......... cutscene   (until the team is committed)
      inside, clock running ....... noir       (on team_assigned)
      Hollis or Park turns ...... threat     (back to noir when they are down)
      the control room ............ spy-action (room_entered:scada_control -- Mercer)
      the grid holds .............. end        (grid_saved)
      debrief closes .............. victory + credits
    'victory' auto-opens the Bond Visualiser (bond-visualiser.js:1590), so it is
    held back until the debrief has actually finished -- the m01/m02 pattern. %>
  "music": {
    "events": [
      {
        "trigger": "game_loaded",
        "condition": "!globalVars.team_assigned && !globalVars.inside_reached",
        "playlist": "cutscene",
        "fade": false
      },
      <%# PASS 3: an uncommitted player is inside the building with the cutscene
          playlist still running. inside_reached is set once (HaX mapping on the
          first ops-floor entry), so this fires once and never re-rolls the track. %>
      {
        "trigger": "game_loaded",
        "condition": "globalVars.inside_reached === true && !globalVars.team_assigned",
        "playlist": "noir",
        "fade": false
      },
      {
        "trigger": "global_variable_changed:inside_reached",
        "condition": "value === true && !globalVars.team_assigned",
        "playlist": "noir",
        "fade": true
      },
      {
        "trigger": "game_loaded",
        "condition": "globalVars.team_assigned === true",
        "playlist": "noir",
        "fade": false
      },
      {
        "trigger": "global_variable_changed:team_assigned",
        "condition": "value === true && !globalVars.inside_reached",
        "playlist": "noir",
        "fade": true
      },
      {
        "trigger": "npc_hostile_state_changed",
        "condition": "isHostile === true",
        "playlist": "threat",
        "fade": true
      },
      {
        "trigger": "all_hostiles_ko",
        "playlist": "noir",
        "fade": true
      },
      {
        "trigger": "room_entered:scada_control",
        "playlist": "spy-action",
        "fade": true
      },
      {
        "trigger": "global_variable_changed:grid_saved",
        "condition": "value === true",
        "playlist": "end",
        "fade": true
      },
      {
        "trigger": "conversation_closed:closing_debrief",
        "playlist": "victory",
        "track": "Entropy Failsafe",
        "autoStop": true,
        "disableClose": true,
        "fade": true,
        "credits": [
          { "text": "MISSION COMPLETE", "style": "title" },
          { "text": "THE ARCHITECT'S GAMBIT", "style": "subtitle" },
          { "text": "" },
          { "text": "PACIFIC NORTHWEST REGIONAL GRID: SEQUENCE ABORTED", "style": "entry", "condition": "globalVars.grid_saved" },
          { "text": "CUSTOMERS AFFECTED: 0 of 8,400,000 — 147 substations held", "style": "entry", "condition": "globalVars.grid_saved && !globalVars.countdown_expired" },
          { "text": "STEP ONE RAN: Seattle metro dark until the abort — steps two to four never executed", "style": "warning", "condition": "globalVars.grid_saved && globalVars.countdown_expired" },
          { "text": "CASCADE SEQUENCE RAN TO COMPLETION — three states dark", "style": "warning", "condition": "!globalVars.grid_saved" },
          { "text": "" },
          { "text": "── THE TRIAGE ──", "style": "section-header" },
          { "text": "TACTICAL TEAM: Operation Fracture — voter records exfiltrated, Social Fabric cluster seized intact", "style": "entry", "condition": "globalVars.team_assignment === 'fracture'" },
          { "text": "TACTICAL TEAM: Operation Trojan Horse — 840 signing keys burned, no backdoor shipped", "style": "entry", "condition": "globalVars.team_assignment === 'trojan_horse' && !globalVars.team_redirected" },
          { "text": "TACTICAL TEAM: Operation Trojan Horse, redirected mid-flight — injection stopped at 30%, dispatch keys reached first", "style": "entry", "condition": "globalVars.team_redirected" },
          { "text": "TACTICAL TEAM: Operation Meltdown — 4,200 hospitals ran a normal night", "style": "entry", "condition": "globalVars.team_assignment === 'meltdown'" },
          { "text": "TACTICAL TEAM: Never committed — stood by in Denver for the duration", "style": "warning", "condition": "!globalVars.team_assignment" },
          { "text": "PROJECTION CORRECTED: Trojan Horse dormancy nine days, not ninety — EHR and dispatch keys on the manifest", "style": "entry", "condition": "globalVars.projection_revised" },
          { "text": "REDIRECT OFFERED WITH THE WINDOW OPEN: weighed, and held", "style": "entry", "condition": "globalVars.redirect_declined && !globalVars.team_redirected" },
          { "text": "PROJECTION UNCHALLENGED: Two copies of the correction were in the building; neither was read", "style": "warning", "condition": "!globalVars.projection_revised && globalVars.team_assignment !== 'trojan_horse'" },
          { "text": "" },
          { "text": "── INSIDE THE FACILITY ──", "style": "section-header" },
          { "text": "DR. JAMES MERCER (BLACKOUT): Detained — signed casualty projection in evidence", "style": "entry", "condition": "globalVars.mercer_fate === 'arrested'" },
          { "text": "DR. JAMES MERCER (BLACKOUT): Neutralised at the console — questioning deferred", "style": "warning", "condition": "globalVars.mercer_ko" },
          { "text": "DR. JAMES MERCER (BLACKOUT): Left the building during the abort — no trace", "style": "warning", "condition": "globalVars.mercer_fate === 'escaped' && !globalVars.mercer_ko" },
          { "text": "DR. JAMES MERCER (BLACKOUT): Came at the agent, then gone before the police reached the room", "style": "warning", "condition": "globalVars.mercer_fate === 'ko' && !globalVars.mercer_ko" },
          { "text": "DR. JAMES MERCER (BLACKOUT): Left at the console — gone before the police reached the room", "style": "warning", "condition": "!globalVars.mercer_fate && !globalVars.mercer_ko" },
          { "text": "MERCER ON RECORD: Named the dead he had already costed", "style": "entry", "condition": "globalVars.mercer_stance === 'condemned' && globalVars.mercer_fate === 'arrested' && !globalVars.mercer_ko" },
          { "text": "MERCER, CONFRONTED: Told what he was", "style": "entry", "condition": "globalVars.mercer_stance === 'condemned' && globalVars.mercer_fate !== 'arrested'" },
          { "text": "MERCER ON RECORD: Argued his arithmetic to the end", "style": "entry", "condition": "globalVars.mercer_stance === 'reasoned' && globalVars.mercer_fate === 'arrested' && !globalVars.mercer_ko" },
          { "text": "MERCER, CONFRONTED: Argued with, to the end", "style": "entry", "condition": "globalVars.mercer_stance === 'reasoned' && globalVars.mercer_fate !== 'arrested'" },
          { "text": "MERCER ON RECORD: Said nothing", "style": "entry", "condition": "globalVars.mercer_stance === 'silent' && globalVars.mercer_fate === 'arrested' && !globalVars.mercer_ko" },
          { "text": "MERCER, CONFRONTED: Given nothing to answer", "style": "entry", "condition": "globalVars.mercer_stance === 'silent' && globalVars.mercer_fate !== 'arrested'" },
          { "text": "MERCER TOLD: He was the diversion, not the operation", "style": "entry", "condition": "globalVars.mercer_told_diversion" },
          { "text": "ELENA RODRIGUEZ: Turned — cooperating, contractor survey work now evidence", "style": "entry", "condition": "globalVars.elena_outcome === 'turned'" },
          { "text": "ELENA RODRIGUEZ: Left the site before the abort — whereabouts unknown", "style": "warning", "condition": "globalVars.elena_outcome === 'fled'" },
          { "text": "ELENA RODRIGUEZ: Neutralised — never questioned", "style": "warning", "condition": "globalVars.elena_ko" },
          { "text": "ELENA RODRIGUEZ: Never spoken to — in the wind with everything she knows", "style": "warning", "condition": "!globalVars.elena_outcome && !globalVars.elena_ko && !globalVars.elena_met" },
          { "text": "ELENA RODRIGUEZ: Spoken to, left at the rack — still there when the police came down", "style": "warning", "condition": "!globalVars.elena_outcome && !globalVars.elena_ko && globalVars.elena_met" },
          { "text": "RAY HOLLIS: Talked, and handed over the zone badge", "style": "entry", "condition": "globalVars.hollis_resolved === 'talked'" },
          { "text": "RAY HOLLIS: Neutralised on shift", "style": "warning", "condition": "globalVars.hollis_ko" },
          { "text": "RAY HOLLIS: Evaded — still on the checkpoint desk, still on their payroll", "style": "warning", "condition": "globalVars.hollis_resolved === 'evaded' && !globalVars.hollis_ko" },
          { "text": "RAY HOLLIS: Left at his post — still on their payroll", "style": "warning", "condition": "!globalVars.hollis_ko && globalVars.hollis_resolved !== 'talked' && globalVars.hollis_resolved !== 'evaded'" },
          { "text": "THOMAS PARK: Talked — the transfer switch was left intact", "style": "entry", "condition": "globalVars.park_resolved === 'talked'" },
          { "text": "THOMAS PARK: Neutralised in the vault", "style": "warning", "condition": "globalVars.park_ko" },
          { "text": "THOMAS PARK: Evaded — finished the cut and walked out", "style": "warning", "condition": "globalVars.park_resolved === 'evaded' && !globalVars.park_ko" },
          { "text": "THOMAS PARK: Fought off, not stopped — finished the cut and walked out", "style": "warning", "condition": "globalVars.park_resolved === 'ko' && !globalVars.park_ko" },
          { "text": "THOMAS PARK: Seen, left to work — finished the cut and walked out", "style": "warning", "condition": "globalVars.vault_entered === true && !globalVars.park_ko && globalVars.park_resolved !== 'talked' && globalVars.park_resolved !== 'evaded' && globalVars.park_resolved !== 'ko'" },
          { "text": "THOMAS PARK: Never found — the backup was cut before anyone went down", "style": "warning", "condition": "!globalVars.vault_entered && !globalVars.park_ko" },
          { "text": "" },
          { "text": "── RECOVERED ──", "style": "section-header" },
          { "text": "TOMB GAMMA: Dossier recovered — the Architect's workshop, no coordinates on file", "style": "entry", "condition": "globalVars.found_tomb_gamma" },
          { "text": "MOLE INTERCEPT: Evidence recovered — SAFETYNET tasking read before it was sent", "style": "entry", "condition": "globalVars.found_mole_evidence" },
          { "text": "NOTHING FURTHER RECOVERED: The site's other papers went to the evidence team unread", "style": "warning", "condition": "!globalVars.found_tomb_gamma && !globalVars.found_mole_evidence" },
          { "text": "" },
          { "text": "── ON THE RECORD ──", "style": "section-header" },
          { "text": "AGENT 0x00: Defended the call — the triage was sound on what was known", "style": "entry", "condition": "globalVars.debrief_stance === 'defended'" },
