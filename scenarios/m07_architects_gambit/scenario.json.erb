            },
            {
              "eventPattern": "room_entered:operations_floor",
              "condition": "!globalVars.hurt_line_said && globalVars.team_assigned === true",
              "onceOnly": true,
              "setGlobal": { "hurt_line_said": true },
              "sendTimedMessage": { "delay": 1000, "message": "You're inside. Whatever you decide tonight, let it hurt afterwards, not during." }
