    {
      "aimId": "trace_the_intrusion",
      "title": "Trace How They Got In (Optional)",
      "description": "The control stack did not reach the breakers by wishing. Something physical was put in this building months ago. Follow it down through the plant, before the abort or after it. Once you call HaX for the debrief, the building belongs to the police.",
      "status": "locked",
      "order": 2,
      "unlockCondition": { "aimCompleted": "commit_the_team" },
