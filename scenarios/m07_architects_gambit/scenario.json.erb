            },
            {
              "_comment": "PASS 2 review minor 2: the player already moved the team on Elena's word.",
              "eventPattern": "global_variable_changed:flag1_submitted",
              "condition": "value === true && globalVars.team_redirected",
              "onceOnly": true,
