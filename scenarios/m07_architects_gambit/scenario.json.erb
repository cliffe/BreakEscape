              "sendTimedMessage": { "delay": 1500, "message": "One frightened engineer, but it fits. Their share will have it in writing. If the team's in the wrong place, call me before you log in on their host." }
            },
            {
              "_comment": "PASS 5 alignment r2 (m8): the team isn't committed yet, so there is no wrong place for it to be in.",
              "eventPattern": "conversation_closed:elena_rodriguez",
              "condition": "globalVars.projection_revised === true && !globalVars.verdict_sent && !globalVars.team_assigned && !globalVars.redirect_window_closed",
