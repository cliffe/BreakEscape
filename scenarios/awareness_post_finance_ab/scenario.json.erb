            "to": "payments@brightwellfoods.example",
            "subject": "Payment held: sign in to release",
            "time": "11:02",
            "body": "A payment from your business account has been held for review. Sign in to release it.\n{{link:signin}}\nFernhill Business Bank",
            "links": [
              {
                "id": "signin",
