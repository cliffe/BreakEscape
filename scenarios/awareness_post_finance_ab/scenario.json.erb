  "social": {
    "triageSets": [
      {
        "id": "finance_form_b",
        "title": "Payments inbox check",
        "brief": "Ten messages from a Brightwell Foods payments inbox. For each one, choose Trust, Report or Delete, then tick what you noticed. You'll see how you did at the end. Reporting a real message never costs you anything.",
        "stage": "post",
        "scoringProfile": "awareness",
        "feedbackMode": "end",
        "headerPanel": "collapsed",
        "glossary": "closed",
        "channelTells": [
          "lookalike_domain",
          "changed_bank_details",
          "secrecy_or_bypass",
          "reply_to_differs"
        ],
        "outcome": {
          "setGlobalPrefix": "triage_{stage}_",
          "passPercent": 0
        },
        "messages": [
          {
            "id": "fb_expenses_cutoff",
            "from": {
              "name": "Agnieszka Duda",
              "address": "agnieszka.duda@brightwellfoods.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "October expenses: claims by Thursday",
            "time": "08:05",
            "body": "Hi everyone,\nOctober expense claims need to be approved in the expenses system by Thursday to make this month's payroll. Anything later goes into November as usual.\nThanks,\nAgnieszka\nPayroll",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "brightwellfoods.example",
              "replyTo": "agnieszka.duda@brightwellfoods.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "urgencyCalibrated": "Thursday is the normal payroll cut-off, and anything late simply rolls to next month.",
                "default": "Payroll's real address, a routine reminder, and nothing to pay or sign in to."
              }
            }
          },
          {
            "id": "fb_castell_bank",
            "from": {
              "name": "Castell Fruit Co. Accounts",
              "address": "accounts@castellfruit-co.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "Our bank details have changed",
            "time": "08:32",
            "body": "Dear Accounts Payable,\nWe have moved our business banking. Please update your records and pay all invoices from today, including CF-20931, to the account below.\nAccount name: Castell Fruit Co. Ltd\nAccount number ending 5521\nDiolch,\nIfan Jenkins\nAccounts",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "bounce.castellfruit-co.example",
              "replyTo": "accounts@castellfruit-co.example"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "lookalike_domain",
                "changed_bank_details"
              ],
              "perFlagNote": {
                "lookalike_domain": "Castell's real domain is castellfruit.example; this one adds -co",
                "changed_bank_details": "New bank details for every invoice from today is the change invoice fraud depends on. Ring Castell on the number in your supplier file"
              },
              "headerNote": "All three checks passed because the sender owns castellfruit-co.example. A pass tells you which domain sent it, not that it's Castell's.",
              "ifTrusted": "Castell's payments would go to the sender's account until someone noticed Castell hadn't been paid.",
              "reportReply": "Thanks. That isn't Castell's domain. We've rung them on the number on file: their bank hasn't changed."
            }
          },
          {
            "id": "fb_castell_invoice",
            "from": {
              "name": "Castell Fruit Co.",
              "address": "invoices@castellfruit.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "Invoice CF-20874 for PO-4318",
            "time": "08:50",
            "body": "Hello,\nPlease find attached invoice CF-20874 for the apple purée delivered on 15 October against your PO-4318.\nPayment terms as agreed. Any questions, ring us on the number on your supplier record.\nCastell Fruit Co.",
            "attachments": [
              {
                "label": "CF-20874.pdf",
                "kind": "pdf"
              }
            ],
            "auth": {
              "spf": "fail",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "billing-relay.castellfruit.example",
              "replyTo": "invoices@castellfruit.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "senderAuth": "SPF failed because it came through Castell's billing service, but DKIM passed and DMARC passed for castellfruit.example, their real domain.",
                "default": "Castell's real domain, a purchase order Brightwell raised, and no change to how you pay them."
              },
              "headerNote": "One failed check on its own is a clue, not proof. Billing services and forwarding often break SPF while DKIM still passes."
            }
          },
          {
            "id": "fb_fd_vouchers",
            "from": {
              "name": "Adaeze Okafor",
              "address": "adaeze.okafor.finance@quickpost-mail.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "Quick favour before 2pm",
            "time": "09:14",
            "body": "Hi, are you free? I need ten £100 shopping vouchers for this afternoon's staff awards. It's a surprise, so don't mention it to anyone, and put it through petty cash rather than a purchase order.\nSend me the voucher codes by 2. I'm on calls all day so email is best.\nAdaeze",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "quickpost-mail.example",
              "replyTo": "adaeze.okafor.finance@quickpost-mail.example"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "senderTrust",
                "secrecy_or_bypass",
                "urgencyCalibrated"
              ],
              "perFlagNote": {
                "senderTrust": "The finance manager's name on a personal inbox at quickpost-mail.example",
                "secrecy_or_bypass": "'Don't mention it' and 'petty cash rather than a purchase order' route round the normal checks",
                "urgencyCalibrated": "'By 2' and 'on calls all day' leave no time to walk over and ask"
              },
              "ifTrusted": "£1,000 of voucher codes would go to the sender, and vouchers can't be traced or clawed back.",
              "reportReply": "Thanks. Adaeze didn't send it. Her real address is on brightwellfoods.example."
            }
          },
          {
            "id": "fb_system_maintenance",
            "from": {
              "name": "Gwen Pritchard",
              "address": "gwen.pritchard@brightwellfoods.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "Finance system offline Saturday 08:00 to 12:00",
            "time": "09:40",
            "body": "Hi all,\nThe finance system will be offline on Saturday from 08:00 to 12:00 for planned updates. You don't need to do anything. Progress will be on the IT status page:\n{{link:status}}\nGwen\nIT Service Desk",
            "links": [
              {
                "id": "status",
                "text": "status.brightwellfoods.example",
                "destination": "https://status.brightwellfoods.example/"
              }
            ],
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "brightwellfoods.example",
              "replyTo": "gwen.pritchard@brightwellfoods.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "linkCredible": "The link goes where it says, to a status page on Brightwell's own domain, and it doesn't ask you to sign in.",
                "default": "IT's real address, a planned outage, and 'you don't need to do anything'."
              }
            }
          },
          {
            "id": "fb_creditors_spoof",
            "from": {
              "name": "Mei Lin Chau",
              "address": "meilin.chau@brightwellfoods.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "Aged creditors list please",
            "time": "10:05",
            "body": "Hi,\nCould you send me this month's aged creditors list, with the supplier contact details column included? I'm reviewing suppliers off site today, so just reply with it attached.\nThanks,\nMei Lin",
            "auth": {
              "spf": "fail",
              "dkim": "none",
              "dmarc": "fail",
              "envelopeFrom": "mailer.quickpost-mail.example",
              "replyTo": "meilin.chau.procure@quickpost-mail.example"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "senderAuth",
                "reply_to_differs"
              ],
              "perFlagNote": {
                "senderAuth": "SPF and DMARC both failed for brightwellfoods.example: Brightwell's own servers didn't send this",
                "reply_to_differs": "Replies go to meilin.chau.procure@quickpost-mail.example, not to Mei Lin's Brightwell address"
              },
              "headerNote": "Open the details: the From shows Mei Lin's real address, but the checks failed and the reply-to points somewhere else.",
              "ifTrusted": "An aged creditors list names every supplier, what they're owed and who to contact: everything needed to write a convincing bank-change email.",
              "reportReply": "Thanks. Mei Lin is in the office today and didn't send it."
            }
          },
          {
            "id": "fb_quarter_end",
            "from": {
              "name": "Ravinder Sandhu",
              "address": "ravinder.sandhu@brightwellfoods.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "Quarter end: approvals by Friday",
            "time": "10:30",
            "body": "Hi all,\nThank you for a strong quarter. To close it on time, please make sure every supplier invoice you're holding is in the approval queue by Friday. Adaeze's team will take it from there as usual.\nRavinder",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "brightwellfoods.example",
              "replyTo": "ravinder.sandhu@brightwellfoods.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "urgencyCalibrated": "There's a deadline, but it sends work into the normal approval queue rather than round it.",
                "secrecy_or_bypass": "Nothing here is secret, and it keeps Adaeze's team in the loop.",
                "default": "The chief executive's real address, a note to everyone, and the usual process kept."
              }
            }
          },
          {
            "id": "fb_bank_portal",
            "from": {
              "name": "Fernhill Business Bank",
              "address": "alerts@fernhillbusinessbank.example"
