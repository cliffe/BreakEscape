              "perFlagNote": {
                "linkCredible": "The link text says fernhillbusinessbank.example, but it goes to fernhill-secure-login.example",
                "pretextRelevant": "Brightwell doesn't bank with Fernhill, so there's no payment of yours for them to hold"
              },
              "ifTrusted": "The link opens a sign-in page that collects banking passwords.",
              "reportReply": "Thanks. Brightwell doesn't bank with Fernhill, and we've blocked the sign-in page."
            }
          },
          {
            "id": "fb_insurance_renewal",
            "from": {
              "name": "Marcus Bell",
              "address": "marcus.bell@brookwaterbrokers.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "Your insurance renewal schedule",
            "time": "11:45",
            "body": "Hello,\nAttached is the renewal schedule for Brightwell's property and stock cover, as discussed with Adaeze last week. The premium is collected by direct debit as before, so there's nothing to pay by hand.\nBest wishes,\nMarcus Bell\nAccount Manager, Brookwater Insurance Brokers",
            "attachments": [
              {
                "label": "Brightwell_renewal_schedule.pdf",
                "kind": "pdf"
              }
            ],
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "brookwaterbrokers.example",
              "replyTo": "marcus.bell@brookwaterbrokers.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "attachmentPlausible": "A renewal schedule as a PDF is what a broker sends, and it asks for no payment.",
                "default": "The broker's real domain, a renewal Adaeze already discussed, and payment by the usual direct debit."
              }
            }
          },
          {
            "id": "fb_seren_query",
            "from": {
              "name": "Daniel Osei",
              "address": "daniel.osei@serenvalley.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "Query on remittance for SV-3310",
            "time": "12:20",
            "body": "Hi,\nThanks for last week's payment. I can't match SV-3310 on the remittance; it may have been paid with another invoice. No rush; when you get a moment, could you check?\nDaniel Osei\nAccounts, Seren Valley Mushrooms",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "serenvalley.example",
              "replyTo": "daniel.osei@serenvalley.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "default": "A supplier's real domain, a routine query, no change to bank details and no pressure: 'no rush' is the opposite of the fake ones."
              }
            }
          }
