        {
          "type": "notes1",
          "id": "maint_log",
          "name": "Maintenance log",
          "position": { "x": 4, "y": 7 },
          "takeable": false,
          "readable": true,
          "readDisplay": "gameDisplay",
          "addToNotes": false,
          "text": "Maintenance log, second floor.\n\nPrinter: the panel was updated last month, so the build number it shows is only a label. The account it shipped with was never removed from the admin page. The manual is in the supply cupboard.\n\nThe ceiling cameras: the date their recorder shows is left over from the factory image. Nothing to do.\n\nFile server: the open share was left on after the move. The wall switch turns it off.",
          "observations": "A maintenance log left on the desk."
        },
        {
          "type": "notes1",
          "id": "sign_lobby",
          "name": "Sign: Start here",
          "position": { "x": 4, "y": 3 },
          "takeable": false,
          "readable": true,
          "readDisplay": "gameDisplay",
          "addToNotes": false,
          "text": "Ops findings test. Take the drop box and plug it into a port. The office network opens empty: sweep it, scan a machine, then check one of its services. The log on the desk says what is real. The supply cupboard is to the west.",
          "observations": "A sign on a stand by the front desk."
        }
      ],
      "npcs": [
        {
          "id": "ian",
          "displayName": "Ian Okafor",
          "npcType": "person",
          "position": { "x": 6, "y": 5 },
          "spriteSheet": "male_office_worker_v2",
          "spriteTalk": "assets/characters/male_office_worker_talk.png",
          "spriteVisemes": "assets/characters/male_office_worker_visemes.png",
          "storyPath": "scenarios/test_ops_findings/ink/ian.json",
          "currentKnot": "start",
          "behavior": { "facePlayer": true, "facePlayerDistance": 96 },
          "role": "it",
          "creds": { "username": "iokafor", "password": "Dockyard-Ian-41" },
          "eventMappings": [
            { "eventPattern": "network_service_checked", "condition": "data.hostId === 'printer01' && data.service === 'admin_page'", "onceOnly": true, "completeTask": "s1_check_admin" },
            { "eventPattern": "network_finding_confirmed", "condition": "data.status === 'false'", "onceOnly": true, "completeTask": "s2_confirm_false" }
          ]
        }
      ]
    },

    "supply_room": {
