{
  "scenario_brief": "TEST: Ops findings\n\nA test floor for the ops core's second stage (OPS_CORE_PLAN.md, S2). One lobby with a drop box, two office ports, a wall switch, a desk log and a sign; a supply cupboard; a comms room with a file server. Plug the box in, sweep the office network, scan a machine and check its services. Nothing to solve.",
  "endGoal": "Test only: check, confirm and read what a finding needs.",
  "startRoom": "lobby",
  "startPosition": { "x": 7, "y": 7 },
  "npcNeedsSeed": "test_ops_findings",
  "npcWindupMs": 0,
  "needsDebugOverlay": true,

  "networks": {
    "office_lan": { "name": "Office network", "discovery": "scan" }
  },

  "hosts": {
    "printer01": {
      "name": "Second floor printer",
      "network": "office_lan",
      "sprite": "pnw_portable_printer1",
      "services": [
        { "name": "print", "port": 9100, "product": "Inkvale JetServe", "version": "1.4" },
        {
          "name": "admin_page", "label": "Admin page", "port": 80, "product": "Inkvale WebPanel", "version": "2.0",
          "weaknesses": [
            {
              "id": "factory_login", "class": "default_creds", "severity": "high",
              "summary": "The admin page still accepts the account it shipped with.",
              "needs": { "item": "printer_manual" }
            }
          ],
          "decoys": [
            {
              "id": "old_banner", "class": "unpatched", "severity": "medium",
              "summary": "The page reports an old build number.",
              "falseBecause": "The build number is cosmetic. The panel was updated last month."
            }
          ]
        }
      ]
    },
    "camrec01": {
      "name": "Camera recorder",
      "network": "office_lan",
      "sprite": "cctv_camera1",
      "services": [
        {
          "name": "stream", "port": 554, "product": "Lookwell RecordView", "version": "5.0",
          "decoys": [
            {
              "id": "old_firmware", "class": "unpatched", "severity": "low",
              "summary": "The recorder reports a firmware date from years ago.",
              "falseBecause": "The date is a leftover from the factory image. The firmware was replaced when the unit was installed."
            }
          ]
        }
      ]
    }
  },

  "credentials": {
    "archivist_login": {
      "kind": "password",
      "account": "ian",
      "proof": { "session": "desk01" },
      "foundIn": "vault_note"
    }
  },

  "logSources": {
    "findings_audit": {
      "title": "Findings audit",
      "events": ["network_swept", "host_scanned", "service_checked", "finding_confirmed"]
    }
  },

  "policies": {
    "managed": { "remote": "allowed" }
  },

  "globalVariables": {
    "share_locked": false
  },

  "gameClock": { "start": "Tue 08:30", "rate": 1 },

  "objectives": [
    {
      "aimId": "finding_beats",
      "title": "Check and confirm",
      "description": "Test only. Each task ticks when its beat's event fires.",
      "status": "active",
      "order": 0,
      "tasks": [
        { "taskId": "s1_check_admin", "title": "Check the printer's admin page", "type": "custom", "status": "active" },
        { "taskId": "s2_confirm_false", "title": "Confirm a finding that turns out false", "type": "custom", "status": "active" }
      ]
    }
  ],

  "rooms": {
    "lobby": {
      "type": "room_reception",
      "door_sign": "Lobby",
      "connections": { "north": "comms_room", "east": "back_office", "west": "supply_room" },
      "objects": [
        {
          "type": "pc",
          "id": "kit_dropbox",
          "name": "Network drop box",
          "sprite": "drop_box1",
          "position": { "x": 8, "y": 4 },
          "takeable": true,
          "rogueDevice": true,
          "observations": "A small grey box with a network port and a status light. It plugs into a wall port."
        },
        {
          "type": "pc",
          "id": "office_port",
