        "messages": [
          {
            "id": "fa_close_timetable",
            "from": {
              "name": "Adaeze Okafor",
              "address": "adaeze.okafor@brightwellfoods.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "October month-end timetable",
            "time": "08:05",
            "body": "Morning all,\nThe October close timetable is below. Same as last month, one day earlier because of the bank holiday.\nSupplier invoices in by Wednesday 5pm. Accruals by Thursday noon. Final reports Monday.\nShout if anything clashes.\nAdaeze",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "brightwellfoods.example",
              "replyTo": "adaeze.okafor@brightwellfoods.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "urgencyCalibrated": "The dates are the normal month-end deadlines, and nothing asks you to skip a step to meet them.",
                "default": "Your finance manager's real address, a routine timetable, and nothing to pay or sign in to."
              }
            }
          },
          {
            "id": "fa_pennine_bank",
            "from": {
              "name": "Pennine Oat Mills Accounts",
              "address": "accounts@pennine-oatmills.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "Change of bank account from 1 November",
            "time": "08:32",
            "body": "Dear Accounts Payable,\nFrom 1 November our bank account has changed. Please update your records and make all future payments, including invoice POM-5512, to the account below.\nAccount name: Pennine Oat Mills Ltd\nAccount number ending 3048\nKind regards,\nBryony Thwaite\nCredit Control",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "bounce.pennine-oatmills.example",
              "replyTo": "accounts@pennine-oatmills.example"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "lookalike_domain",
                "changed_bank_details"
              ],
              "perFlagNote": {
                "lookalike_domain": "Pennine's real domain is pennineoatmills.example; this one adds a hyphen",
                "changed_bank_details": "A new bank account for future payments is the change invoice fraud depends on. Ring Pennine on the number in your supplier file"
              },
              "headerNote": "All three checks passed because the sender owns pennine-oatmills.example. A pass tells you which domain sent it, not that it's Pennine's.",
              "ifTrusted": "Pennine's next payments would go to the sender's account until someone noticed Pennine hadn't been paid.",
              "reportReply": "Thanks. That isn't Pennine's domain. We've rung them on the number on file: their bank hasn't changed."
            }
          },
          {
            "id": "fa_pennine_invoice",
            "from": {
              "name": "Pennine Oat Mills",
              "address": "invoices@pennineoatmills.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "Invoice POM-5498 for PO-4302",
            "time": "08:50",
            "body": "Hello,\nPlease find attached invoice POM-5498 for the oat flour delivered on 14 October against your PO-4302.\nPayment terms as agreed. Any questions, call us on the number on your supplier record.\nPennine Oat Mills",
            "attachments": [
              {
                "label": "POM-5498.pdf",
                "kind": "pdf"
              }
            ],
            "auth": {
              "spf": "fail",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "billing-relay.pennineoatmills.example",
              "replyTo": "invoices@pennineoatmills.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "senderAuth": "SPF failed because it came through Pennine's billing service, but DKIM passed and DMARC passed for pennineoatmills.example, their real domain.",
                "default": "Pennine's real domain, a purchase order Brightwell raised, and no change to how you pay them."
              },
              "headerNote": "One failed check on its own is a clue, not proof. Billing services and forwarding often break SPF while DKIM still passes."
            }
          },
          {
            "id": "fa_ceo_transfer",
            "from": {
              "name": "Ravinder Sandhu",
              "address": "ravinder.sandhu.ceo@inboxly.example"
            },
            "to": "payments@brightwellfoods.example",
            "subject": "Confidential: payment needed this morning",
            "time": "09:14",
            "body": "Are you at your desk? I need £24,750 sent to a new supplier before 11. It's tied to a deal I can't talk about yet, so keep it between us and don't raise it with Adaeze.\nI'm in meetings all day, so email only. I'll send the account details once you confirm.\nRavinder",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "inboxly.example",
              "replyTo": "ravinder.sandhu.ceo@inboxly.example"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "senderTrust",
                "secrecy_or_bypass",
