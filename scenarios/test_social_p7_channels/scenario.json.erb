            "from": { "name": "Ledgerwell Payroll", "address": "payroll@ledgerwell-hr.example" },
            "to": "you@ledgerwell.example",
            "subject": "Confirm your bank details today",
            "time": "09:12",
            "body": "Hi,\nWe are updating payroll records. Confirm your bank details today to avoid a delay to your pay.\n{{link:verify}}",
            "links": [ { "id": "verify", "text": "ledgerwell.example/payroll", "destination": "https://ledgerwell-hr.example/login" } ],
            "auth": { "spf": "pass", "dkim": "pass", "dmarc": "pass" },
            "truth": {
              "isPhish": true,
              "flags": ["senderTrust", "linkCredible"],
              "perFlagNote": {
                "senderTrust": "ledgerwell-hr is not ledgerwell: a look-alike domain.",
                "linkCredible": "The text says ledgerwell.example; the link goes to ledgerwell-hr.example."
              },
              "headerNote": "All three passed because the sender owns the look-alike domain.",
              "reportReply": "Thanks. Confirmed as a phish."
            }
          },
          {
            "id": "chk_laptop",
            "from": { "name": "IT Helpdesk", "address": "it@ledgerwell.example" },
            "to": "you@ledgerwell.example",
            "subject": "Your new laptop",
            "time": "08:05",
            "body": "Your new laptop is ready to collect from the IT desk.",
            "auth": { "spf": "pass", "dkim": "pass", "dmarc": "pass" },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": { "default": "The address is IT's real one, every check passes, and you were expecting a laptop." }
            }
          }
        ]
      }
