        { "taskId": "a3_checked", "title": "Check a service", "type": "custom", "status": "active" },
        { "taskId": "a4_confirmed", "title": "Confirm a finding", "type": "custom", "status": "active" },
        { "taskId": "a5_refused", "title": "Use a note that does not fit", "type": "custom", "status": "active" },
        { "taskId": "a6_used", "title": "Use a note that fits", "type": "custom", "status": "active" }
      ]
    }
