{
  "scenario_brief": "TEST: Ops access\n\nA test floor for the ops core's third stage (OPS_CORE_PLAN.md, S3). A lobby with a drop box, two wall ports, a wall switch and a cabinet; a supply room with a cupboard and a drawer; a comms room with two servers; a back office with a desk PC. Plug the box in, sweep and scan, check and confirm what you find, then use the field notes you gather. Nothing to solve.",
  "endGoal": "Test only: use a technique card on a confirmed finding, then open what it gives.",
  "startRoom": "lobby",
  "startPosition": { "x": 7, "y": 7 },
  "npcNeedsSeed": "test_ops_access",
  "npcWindupMs": 0,
  "needsDebugOverlay": true,

  "networks": {
    "office_lan": { "name": "Office network", "discovery": "scan" },
    "plant_lan": { "name": "Plant network", "discovery": "scan" }
  },

  "networkLinks": [
    ["office_lan", "plant_lan"]
  ],

  "hosts": {
    "printer01": {
      "name": "Second floor printer",
      "network": "office_lan",
      "sprite": "pnw_portable_printer1",
      "services": [
        { "name": "print", "port": 9100, "product": "Inkvale JetServe", "version": "1.4" },
        {
          "name": "admin_page", "label": "Admin page", "port": 80, "product": "Inkvale WebPanel", "version": "2.0",
          "weaknesses": [
            {
              "id": "factory_login", "class": "default_creds", "severity": "high",
              "summary": "The admin page still accepts the account it shipped with.",
              "needs": { "item": "printer_manual" },
              "grants": { "credential": "print_admin" }
            }
          ],
          "decoys": [
            {
              "id": "old_banner", "class": "default_creds", "severity": "medium",
              "summary": "The page greets visitors with a stock sign-in hint.",
              "falseBecause": "The hint is only text on the page. The account it mentions was removed when the panel was set up."
            }
          ]
        }
      ]
    },
    "pumpctl01": {
      "name": "Pump controller",
      "network": "plant_lan",
      "sprite": "m09_door_controller1",
      "services": [
        { "name": "control", "port": 502, "product": "Tidewell PumpLink", "version": "1.0" }
      ]
    }
  },

  "techniques": {
    "factory_accounts": {
      "name": "Factory accounts",
      "summary": "Devices often ship with a published account that nobody changes.",
      "worksOn": { "class": "default_creds" }
    },
    "release_notes": {
      "name": "Release notes: current build",
      "summary": "For a service that has fallen behind its published fixes.",
      "worksOn": { "class": "unpatched", "product": "Brackley ShareServe", "versions": ["3.1"] }
    },
    "older_release_notes": {
      "name": "Release notes: older build",
      "summary": "For a service that has fallen behind its published fixes.",
      "worksOn": { "class": "unpatched", "product": "Brackley ShareServe", "versions": ["2.4"] }
    },
    "config_review": {
      "name": "Configuration review",
      "summary": "For a setting somebody left open by mistake.",
      "worksOn": { "class": "misconfig" }
    }
  },

  "credentials": {
    "print_admin": {
      "kind": "saved_connection",
      "account": "ian",
      "connectsTo": "files01",
      "proof": { "technique_card": "printer01.admin_page.factory_login" }
    }
  },

  "logSources": {
    "access_audit": {
      "title": "Access audit",
      "events": ["network_swept", "host_scanned", "service_checked", "finding_confirmed", "technique_refused", "technique_used"]
    }
  },

  "policies": {
    "managed": { "remote": "allowed" },
    "sealed": { "remote": "blocked" }
  },

  "globalVariables": {
    "share_locked": false,
    "technique_used_seen": false
  },

  "gameClock": { "start": "Tue 08:30", "rate": 1 },

  "objectives": [
