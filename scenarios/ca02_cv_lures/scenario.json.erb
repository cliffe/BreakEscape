      "brand": {
        "name": "Tarrowby Logistics",
        "logoText": "TARROWBY",
        "accent": "#3b5b8c"
      },
      "variant": "full",
      "durationTargetMin": 15,
      "scopeNote": "Authorised exercise at Tarrowby Logistics, a fictional company. In scope: one job application email to the recruitment contact you find, and the Tarrowby recruitment inbox. Nothing you write leaves the game, and the attachment is a label, not a file.",
      "stages": [
        "brief",
        "osint",
        "write",
        "flip",
        "defend",
        "debrief"
      ],
      "conclusionTaskId": "sort_recruitment_inbox",
      "attack": {
        "target": "recruiter_contact",
        "siteIds": [
          "tarrowby_site",
          "tarrowby_social"
        ],
        "accountIds": [
          "analyst"
        ],
        "defaultAccount": "analyst",
        "showRedFlagMeter": true,
