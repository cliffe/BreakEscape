          },
          "spriteSheet": "female_security_guard_v2",
          "storyPath": "scenarios/ink/generic-npc.json",
          "currentKnot": "start",
          "behavior": {
            "hostile": {
              "startHostile": true,
              "chaseSpeed": 1,
              "attackDamage": 1
            }
          }
        },
        {
          "id": "day_guard",
          "displayName": "Day Guard",
          "npcType": "person",
          "position": {
            "x": 4,
            "y": 5
          },
          "spriteSheet": "female_security_guard_v2",
          "storyPath": "scenarios/ink/generic-npc.json",
          "currentKnot": "start",
          "behavior": {
            "hostile": {
              "startHostile": true,
              "chaseSpeed": 60,
              "attackDamage": 1
            }
          },
          "eventMappings": [
            {
              "_comment": "Night: the day guard is hidden, still hostile and conscious.",
              "eventPattern": "global_variable_changed:night",
              "condition": "value === true",
              "setVisible": false
            },
            {
              "_comment": "Dawn: shown again, so the fight is back on.",
              "eventPattern": "global_variable_changed:dawn",
              "condition": "value === true",
              "setVisible": true
            }
          ]
        }
      ],
      "objects": []
    },
    "cellar": {
      "type": "room_office",
      "door_sign": "Cellar",
      "locked": true,
      "lockType": "pin",
      "requires": "9999",
      "connections": {
        "north": "lobby"
      },
      "objects": []
    },
    "closet": {
      "type": "room_office",
      "door_sign": "Closet",
      "locked": true,
      "lockType": "pin",
      "requires": "5678",
      "connections": {
        "east": "lobby"
      },
      "objects": []
    }
  }
