{
  "scenario_id": "test_hidden_hostiles",
  "scenario_name": "Test: hidden hostiles and fight music",
  "scenario_brief": "Engine check (hidden hostiles and music).\n\n1. The fight music (threat) plays: two guards start hostile.\n2. Try the vault door: the day guard is hidden (setVisible false).\n3. Knock out the other guard: the fight music ends (noir), though the hidden guard is still hostile and conscious.",
  "endGoal": "Check that anyHostilesAlive skips an NPC hidden by a setVisible mapping.",
  "startRoom": "lobby",
  "globalVariables": {
    "night": false
  },
  "music": {
    "events": [
      { "trigger": "game_loaded", "playlist": "threat", "fade": false },
      { "trigger": "all_hostiles_ko", "playlist": "noir", "fade": true }
    ]
  },
  "rooms": {
    "lobby": {
      "type": "room_office",
      "door_sign": "Lobby",
      "connections": { "north": "vault" },
      "npcs": [
        {
          "id": "fight_guard",
          "displayName": "Guard",
          "npcType": "person",
          "position": { "x": 8, "y": 6 },
          "spriteSheet": "female_security_guard_v2",
          "storyPath": "scenarios/ink/generic-npc.json",
          "currentKnot": "start",
          "behavior": { "hostile": { "startHostile": true, "chaseSpeed": 60, "attackDamage": 1 } }
        },
        {
          "id": "day_guard",
          "displayName": "Day Guard",
          "npcType": "person",
          "position": { "x": 2, "y": 6 },
          "spriteSheet": "female_security_guard_v2",
          "storyPath": "scenarios/ink/generic-npc.json",
          "currentKnot": "start",
          "behavior": { "hostile": { "startHostile": true, "chaseSpeed": 60, "attackDamage": 1 } },
          "eventMappings": [
            {
              "_comment": "Trying the vault door turns night on (the mission's night turn).",
              "eventPattern": "door_unlock_attempt",
              "condition": "data.connectedRoom === 'vault'",
              "onceOnly": true,
              "setGlobal": { "night": true }
            },
            {
              "_comment": "Night: the day guard is hidden, still hostile and conscious.",
              "eventPattern": "global_variable_changed:night",
              "condition": "value === true",
              "setVisible": false
            }
          ]
        }
      ],
      "objects": []
    },
    "vault": {
      "type": "room_office",
      "door_sign": "Vault",
      "locked": true,
      "lockType": "pin",
      "requires": "1234",
      "connections": { "south": "lobby" },
      "objects": []
    }
  }
}
