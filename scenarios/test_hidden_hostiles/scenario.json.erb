{
  "scenario_id": "test_hidden_hostiles",
  "scenario_name": "Test: hidden hostiles and fight music",
  "scenario_brief": "Engine check (hidden hostiles and music).\n\nMusic: game_loaded plays noir, any hostile turning plays threat, all_hostiles_ko plays noir.\n1. Enter the annex: the day guard (hostile) turns up and the fight music (threat) plays.\n2. Try the vault door (night): the day guard is hidden (setVisible false). Knock out the lobby guard: the fight music ends, though the hidden guard is still hostile and conscious. Or knock out the lobby guard first and then try the vault door: hiding the last conscious hostile ends the fight too.\n3. Reload: the hidden guard does not bring the fight music back when the annex loads.\n4. Try the closet door (dawn): the day guard is shown again and the fight music returns.\n5. The reserve guard (startHostile, initiallyHidden) is in the lobby but unseen. While it is hidden it is not hostile, plays no fight music and does not stop all_hostiles_ko (knock out the lobby guard: noir music). Reload while it is hidden: still no cue. Try the cellar door: the reserve guard appears, turns hostile and the fight music plays once.",
  "endGoal": "Check that anyHostilesAlive skips an NPC hidden by a setVisible mapping.",
  "startRoom": "lobby",
  "globalVariables": {
    "night": false,
    "dawn": false,
    "reserve": false,
    "proof_voice_off": false,
    "proof_forced_off": false
  },
  "music": {
    "events": [
      {
        "trigger": "game_loaded",
        "playlist": "noir",
        "fade": false
      },
      {
        "trigger": "npc_hostile_state_changed",
        "condition": "isHostile === true",
        "playlist": "threat",
        "fade": false
      },
      {
        "trigger": "all_hostiles_ko",
        "playlist": "noir",
        "fade": true
      }
    ]
  },
  "rooms": {
    "lobby": {
      "type": "room_office",
      "door_sign": "Lobby",
      "connections": {
        "north": "vault",
        "east": "annex",
        "west": "closet",
        "south": "cellar"
      },
      "npcs": [
        {
          "id": "fight_guard",
          "displayName": "Guard",
          "npcType": "person",
          "position": {
            "x": 8,
            "y": 6
          },
          "spriteSheet": "female_security_guard_v2",
          "storyPath": "scenarios/ink/generic-npc.json",
          "currentKnot": "start",
          "behavior": {
            "hostile": {
              "startHostile": true,
              "chaseSpeed": 60,
              "attackDamage": 1
            }
          }
        },
        {
          "id": "reserve_guard",
          "displayName": "Reserve Guard",
          "npcType": "person",
          "position": {
            "x": 7,
            "y": 3
          },
          "spriteSheet": "female_security_guard_v2",
          "storyPath": "scenarios/ink/generic-npc.json",
          "currentKnot": "start",
          "behavior": {
            "initiallyHidden": true,
            "hostile": {
              "startHostile": true,
              "chaseSpeed": 60,
              "attackDamage": 1
            }
          },
          "eventMappings": [
            {
              "_comment": "Revealed by the cellar door attempt (m10's reinforcements): hostile only from this moment.",
              "eventPattern": "global_variable_changed:reserve",
              "condition": "value === true",
              "setVisible": true
            }
          ]
        },
        {
          "id": "clerk",
          "displayName": "Clerk",
          "npcType": "person",
          "position": {
            "x": 5,
            "y": 4
          },
          "spriteSheet": "female_security_guard_v2",
          "storyPath": "scenarios/ink/generic-npc.json",
          "currentKnot": "start",
          "eventMappings": [
            {
              "_comment": "Trying the vault door turns night on (the mission's night turn).",
              "eventPattern": "door_unlock_attempt",
              "condition": "data.connectedRoom === 'vault'",
              "onceOnly": true,
              "setGlobal": {
                "night": true
              }
            },
            {
              "_comment": "Trying the cellar door reveals the reserve guard.",
              "eventPattern": "door_unlock_attempt",
              "condition": "data.connectedRoom === 'cellar'",
              "onceOnly": true,
              "setGlobal": {
                "reserve": true
              }
            },
            {
              "_comment": "Trying the closet door turns dawn on (the day guard comes back).",
              "eventPattern": "door_unlock_attempt",
              "condition": "data.connectedRoom === 'closet'",
              "onceOnly": true,
              "setGlobal": {
                "dawn": true
              }
            }
          ]
        },
        {
          "id": "proof_text",
          "displayName": "Text Contact",
          "npcType": "phone",
          "phoneId": "player_phone",
          "storyPath": "scenarios/ink/generic-npc.json",
          "currentKnot": "start",
          "eventMappings": [
            {
              "_comment": "Combat-hold check: a scripted text thread opens on this event, held while a fight is on.",
              "eventPattern": "proof_text",
              "conversationMode": "phone-chat",
              "targetKnot": "start",
              "cooldown": 0,
              "onceOnly": true
            }
          ]
        },
        {
          "id": "proof_voice",
          "displayName": "Voice Contact",
          "npcType": "phone",
          "phoneId": "player_phone",
          "storyPath": "scenarios/ink/generic-npc.json",
          "currentKnot": "start",
          "eventMappings": [
            {
              "_comment": "Combat-hold check: a voiced call goes to the ringer, held while a fight is on; its condition is re-checked all the while it is queued (set proof_voice_off during the fight and it never rings).",
              "eventPattern": "proof_voice",
              "condition": "!globalVars.proof_voice_off",
              "conversationMode": "phone-chat",
              "targetKnot": "start",
              "voiced": true,
              "cooldown": 0,
              "onceOnly": true
            }
          ]
        },
        {
          "id": "proof_forced",
          "displayName": "Forced Contact",
          "npcType": "phone",
          "phoneId": "player_phone",
          "storyPath": "scenarios/ink/generic-npc.json",
          "currentKnot": "start",
          "eventMappings": [
            {
              "_comment": "Combat-hold check: a forced voiced call is held while a fight is on and rings again after a reload (an ordinary call would count as missed); its condition is read once as it leaves the hold (set proof_forced_off during the fight and it never rings).",
              "eventPattern": "proof_forced",
              "condition": "!globalVars.proof_forced_off",
              "conversationMode": "phone-chat",
              "targetKnot": "start",
              "voiced": true,
              "disableClose": true,
              "cooldown": 0,
              "onceOnly": true
            }
          ]
        }
      ],
      "objects": []
    },
    "vault": {
      "type": "room_office",
