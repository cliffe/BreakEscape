  "objectives": [
    {
      "aimId": "network_beats",
      "title": "Run the network beats",
      "description": "Test only. Each task ticks when its beat's event fires; the plant and the vault are checked by the server.",
      "status": "active",
      "order": 0,
      "tasks": [
        { "taskId": "p1_open_share_keyboard", "title": "P1: open the open share from Sam's desktop", "type": "custom", "status": "active" },
        { "taskId": "p2_plant", "title": "P2: plant the box in the comms room", "type": "unlock_object", "targetObject": "comms_port", "status": "active" },
        { "taskId": "p3_see", "title": "P3: look at what the box reaches", "type": "custom", "status": "active" },
        { "taskId": "p4_share_from_view", "title": "P4: copy the letter from the open share", "type": "custom", "status": "active" },
        { "taskId": "p5_remote_signin", "title": "P5: sign in to Lena's PC through the box, then open the locked folder", "type": "custom", "status": "active" },
        { "taskId": "p6_switch_remote", "title": "P6: Switch user on Lena's remote desktop is refused for Sam", "type": "custom", "status": "active" },
        { "taskId": "p7_remote_off", "title": "P7: sign in at the kiosk itself", "type": "custom", "status": "active" },
        { "taskId": "p8_headless_chain", "title": "P8: open the lobby vault with the code from the store's door controller", "type": "unlock_object", "targetObject": "lobby_vault", "status": "active" },
        { "taskId": "p9_sit_down", "title": "P9: open Lena's PC at her desk", "type": "custom", "status": "active" },
        { "taskId": "p10_unplug", "title": "P10: unplug the box from the comms room", "type": "custom", "status": "active" },
        { "taskId": "p11_other_network", "title": "P11: plant the box in the workshop and look", "type": "custom", "status": "active" },
        { "taskId": "p12_reload", "title": "P12: after a reload, Lena's PC opens through the box with no password", "type": "custom", "status": "active" },
        { "taskId": "n11_dropped_implant", "title": "N11: a dropped stick an NPC uses gives a foothold on the door controller's network", "type": "custom", "status": "active" },
        { "taskId": "n12_badusb_implant", "title": "N12: a BadUSB at Sam's desk gives a foothold and is consumed", "type": "custom", "status": "active" },
        { "taskId": "n13_usb_refused", "title": "N13: the kiosk's USB policy refuses the BadUSB", "type": "custom", "status": "active" },
        { "taskId": "n8_wifi_join", "title": "N8: join the guest Wi-Fi with the key and look at what it reaches", "type": "unlock_object", "targetObject": "guest_ap", "status": "active" },
        { "taskId": "n9_second_ap", "title": "N9: join again through the second guest access point", "type": "unlock_object", "targetObject": "guest_ap2", "status": "active" },
        { "taskId": "n2_pivot", "title": "N2: after signing in to an office PC through the box, the server network appears", "type": "custom", "status": "active" },
        { "taskId": "n3_signin_across", "title": "N3: sign in to the server host across the link", "type": "custom", "status": "active" },
        { "taskId": "n4_signout", "title": "N4: sign out of the office pivot and the server session ends", "type": "custom", "status": "active" },
        { "taskId": "n10_port_security", "title": "N10: a secured port refuses the box and keeps it", "type": "custom", "status": "active" },
        { "taskId": "n5_outage", "title": "N5: take the server network down; it leaves the box's view and a sign-in on it is refused", "type": "custom", "status": "active" },
        { "taskId": "n6_repair", "title": "N6: restore the server network; its block fills in and its host signs in again", "type": "custom", "status": "active" },
        { "taskId": "n7_held_route", "title": "N7: a held server session survives the outage, shows no route, and reopens on repair", "type": "custom", "status": "active" },
        { "taskId": "n14_host_off", "title": "N14: the bench PC is not responding while its power is off; switch it on and sign in to it through the box", "type": "custom", "status": "active" }
      ]
    }
  ],

