        "scoringProfile": "awareness",
        "verifyVerdict": true,
        "feedbackMode": "end",
        "headerPanel": "collapsed",
        "glossary": "closed",
        "channelTells": [
          "vish_callback_pressure",
          "borrowed_authority",
          "secrecy_or_bypass",
          "unrequested_mfa_push",
          "reply_to_differs",
          "lookalike_domain"
        ],
        "outcome": {
          "setGlobalPrefix": "triage_{stage}_",
          "passPercent": 0
        },
        "messages": [
          {
            "id": "ha_push_night",
            "kind": "push",
            "subject": "Sign-in request at 02:14",
            "time": "02:14",
            "push": {
              "app": "Quayholt Sign-in",
              "request": "Are you trying to sign in?",
              "account": "leila.nassar@quayholt.example",
              "location": "Unknown location, outside the UK",
              "device": "Windows PC"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "unrequested_mfa_push"
              ],
              "perFlagNote": {
                "unrequested_mfa_push": "You were asleep at 02:14. A prompt you didn't start means someone else has your password"
              },
              "ifTrusted": "Approving would let the sender into your account.",
              "reportReply": "Thanks. We've reset your password and blocked that sign-in."
            }
          },
          {
            "id": "ha_rota_weekend",
            "from": {
              "name": "Darren Price",
              "address": "darren.price@quayholt.example"
            },
            "to": "servicedesk@quayholt.example",
            "subject": "Weekend cover rota",
            "time": "08:02",
            "body": "Morning all,\nThis weekend's cover rota is on the team page. Leila and Owen are on Saturday, I'm on call Sunday. Swaps through me as usual, please.\nDarren",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "quayholt.example",
              "replyTo": "darren.price@quayholt.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "default": "Your team lead's real address, a routine rota, and nothing to reset, sign in to or keep quiet."
              }
            }
          },
          {
            "id": "ha_ticket_relay",
            "from": {
              "name": "Quayholt Service Desk",
              "address": "tickets@quayholt.example"
            },
            "to": "servicedesk@quayholt.example",
            "subject": "Ticket SD-44817 assigned to you",
            "time": "09:30",
            "body": "Ticket SD-44817 (printer jam, second floor) has been assigned to you.\nOpen it from the service desk queue as usual.\nQuayholt Service Desk",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "quayholt.example",
              "replyTo": "tickets@quayholt.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "default": "An ordinary ticket notice from Quayholt's own address, tickets@quayholt.example. It points you to the service desk queue you already use, with nothing to follow and nothing to send back."
              }
            }
          },
          {
            "id": "ha_list_spoof",
            "from": {
              "name": "IT Security",
              "address": "it-security@quayholt-corp.example"
            },
            "to": "servicedesk@quayholt.example",
            "subject": "Quick one: MFA exemption list",
            "time": "10:12",
            "body": "Hi,\nFor an audit we need the list of staff accounts that are exempt from the sign-in prompts. Could you reply with it? Just paste it into your reply.\nThanks,\nIT Security",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "quayholt-corp.example",
              "replyTo": "it-security@quayholt-corp.example"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "senderTrust",
                "lookalike_domain"
              ],
              "flagAlternatives": [
                [
                  "senderTrust",
                  "lookalike_domain"
                ]
              ],
              "perFlagNote": {
                "senderTrust": "A request like this would come from a Quayholt address the desk already knows, not from a sender no one has dealt with",
                "lookalike_domain": "Read the address: it ends in quayholt-corp.example, not quayholt.example. The added '-corp' makes a separate domain anyone can register"
              },
              "ifTrusted": "A list of accounts with no second sign-in step is a list of the easiest accounts to break into.",
              "reportReply": "Thanks. That address isn't ours, and no audit asked for that list. We've blocked quayholt-corp.example."
            }
          },
          {
            "id": "ha_vm_locked",
            "kind": "voicemail",
            "from": {
              "name": "Hana Novak",
              "address": "ext. 4402"
            },
            "subject": "Voicemail from Hana Novak",
            "time": "10:40",
            "duration": "0:21",
            "transcript": [
              {
                "who": "Hana",
                "text": "Hi, it's Hana Novak in Claims. I think I've locked myself out after the password change. No rush, I'm on paper files this morning. Ring me back when you can, I'm on 4402, it's in the directory. Thanks."
              }
            ],
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "default": "She points you to the directory and gives you time. Ring her back on the extension the directory lists, then help as usual."
              }
            }
          },
          {
            "id": "ha_ceo_mfa_bypass",
            "from": {
              "name": "Helen Achterberg",
              "address": "helen.achterberg.ceo@inboxly.example"
            },
            "to": "servicedesk@quayholt.example",
            "subject": "Urgent: remove my sign-in prompts today",
            "time": "09:05",
            "body": "I'm flying to Rotterdam this morning and the sign-in prompts keep failing on my new phone. Please turn off the extra sign-in step on my account before 10. No need to raise a ticket or tell Darren, I'll explain when I'm back.\nHelen\nSent from my phone",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "inboxly.example",
              "replyTo": "helen.achterberg.ceo@inboxly.example"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "senderTrust",
                "secrecy_or_bypass",
                "urgencyCalibrated"
              ],
              "perFlagNote": {
                "senderTrust": "The chief executive's name on a personal inbox at inboxly.example, not quayholt.example",
                "secrecy_or_bypass": "'No need to raise a ticket or tell Darren' skips the record and the person who would check",
                "urgencyCalibrated": "'Before 10' while she's 'flying' leaves no time to ring her"
              },
              "headerNote": "The automatic checks pass because the message really was sent from inboxly.example. A pass tells you which mail system sent it, not that it's Helen.",
              "ifTrusted": "Her account would lose its second sign-in step, so anyone with her password could get straight in.",
              "reportReply": "Thanks. Helen didn't send it, and her account is unchanged. Her real address is on quayholt.example."
            }
          },
          {
            "id": "ha_call_hr_awkward",
            "kind": "call",
            "callerId": "Sofia Marchetti, HR (calling from a mobile)",
            "from": {
              "name": "Sofia Marchetti",
              "address": "Mobile, ending 562"
            },
            "time": "08:41",
            "transcript": [
              {
                "who": "Sofia",
                "text": "It's Sofia in HR. I'm locked out of the HR system and I've got interviews from nine. This is the third time this month."
              },
              {
                "who": "Sofia",
                "text": "Honestly, it's me, but I know how it goes. Ring me back on the mobile you've got for me, just be quick about it."
              }
            ],
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "vish_callback_pressure": "She's fed up and in a hurry, but she lets you ring back on the number on file. Impatience isn't a tell; talking you out of the callback is.",
                "default": "A real colleague having a bad morning. Ringing her back on the number on file costs her a minute and settles it. Refusing to help would leave her stuck, so offer the callback rather than saying no."
              }
            }
          },
          {
            "id": "ha_password_expiry",
            "from": {
              "name": "Quayholt IT",
              "address": "it-notices@quayholt.example"
            },
            "to": "servicedesk@quayholt.example",
            "subject": "Your password expires in 7 days",
            "time": "11:15",
            "body": "Your Quayholt password expires in 7 days. You can change it at any time on the sign-in page:\n{{link:sso}}\nOr press Ctrl+Alt+Del on your work laptop and choose Change a password.\nQuayholt IT",
            "links": [
              {
                "id": "sso",
