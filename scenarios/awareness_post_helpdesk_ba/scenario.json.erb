            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "quayholt.example",
              "replyTo": "it-notices@quayholt.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "linkCredible": "The link goes where it says, to Quayholt's own sign-in page, and the email gives you a way that needs no link at all.",
                "urgencyCalibrated": "Seven days is a normal reminder, not a rush.",
                "default": "IT's real address, a routine reminder, and no request to reply with anything."
              }
            }
          },
          {
            "id": "ha_call_facilities",
            "kind": "call",
            "callerId": "Owen Treharne, Facilities (calling from a mobile)",
            "from": {
              "name": "Owen Treharne",
              "address": "07700 900418"
            },
            "time": "08:20",
            "transcript": [
              {
                "who": "Owen",
                "text": "Hiya, Owen Treharne, Facilities. I'm locked out of the door-access system and the contractors are stood outside the loading bay."
              },
              {
                "who": "Owen",
                "text": "No point ringing the desk back, the work phone's dead and I'm on my personal mobile. The Operations Director wants that bay open by half eight, so just reset it now and I'll sort the paperwork later."
              }
            ],
            "truth": {
              "isPhish": true,
              "flags": [
                "vish_callback_pressure",
                "borrowed_authority"
              ],
              "perFlagNote": {
                "vish_callback_pressure": "He steers you off the callback: the work phone is 'dead', so the number on file can't be used",
                "borrowed_authority": "'The Operations Director wants it open' is there to rush you past the check"
              },
              "ifTrusted": "The caller would have Owen's door-access account, and with it every door on the site.",
              "reportReply": "Thanks. We rang Owen's desk on the number on file and he's in a meeting upstairs. He hasn't been locked out of anything."
            }
          },
          {
            "id": "ha_call_printer",
            "kind": "call",
            "callerId": "Ayaan Warsame, Claims (ext. 4415)",
            "from": {
              "name": "Ayaan Warsame",
              "address": "ext. 4415"
            },
            "time": "11:50",
            "transcript": [
              {
                "who": "Ayaan",
                "text": "Hi, Ayaan in Claims. The second-floor printer is jammed again. Could someone have a look this afternoon?"
              },
              {
                "who": "Ayaan",
                "text": "Yes, that's my desk. Thanks."
              }
            ],
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "default": "A printer job asks for nothing that a caller could misuse, and he's calling from his own desk extension, so there's little an impostor could gain here. A quick check of who you're speaking to is still the habit that catches the calls that do matter."
              }
            }
          }
