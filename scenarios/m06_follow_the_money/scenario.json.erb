              "condition": "<%= [cond, all_in].compact.join(' && ') %>",
              "setGlobal": { "start_debrief_cutscene": true },
              "conversationMode": "person-chat",
              "targetKnot": "start",
              "background": "assets/backgrounds/hq1.png",
              "onceOnly": true,
              "disableClose": true
            }<%= i < triggers.size - 1 ? ',' : '' %>
<% end %>
          ]
        }
