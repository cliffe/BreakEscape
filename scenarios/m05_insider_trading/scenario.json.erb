          { "text": "RECRUITMENT PIPELINE — TalentStack link not documented", "style": "entry", "condition": "!globalVars.found_pamphlet && !globalVars.found_pipeline_list" },
          { "text": "" },
          { "text": "── DAVID TORRES ──",                                  "style": "section-header" },
          { "text": "TURNED — working for SAFETYNET inside ENTROPY's network", "style": "entry", "condition": "globalVars.final_choice === 'turn_double_agent'" },
          { "text": "HANDED TO THE POLICE — talked to SAFETYNET first",    "style": "entry", "condition": "globalVars.final_choice === 'arrest' && globalVars.elena_treatment_funded" },
          { "text": "HANDED TO THE POLICE — said nothing",                 "style": "entry", "condition": "globalVars.final_choice === 'arrest' && !globalVars.elena_treatment_funded" },
          { "text": "DETAINED AFTER A FIGHT — handed to the police",       "style": "entry", "condition": "globalVars.final_choice === 'combat_nonlethal'" },
          { "text": "DEAD — left injured on the data-centre floor",        "style": "warning", "condition": "globalVars.final_choice === 'combat_lethal'" },
          { "text": "EXPOSED — named publicly as \"The Quantum Traitor\"",  "style": "warning", "condition": "globalVars.final_choice === 'public_exposure'" },
          { "text": "" },
          { "text": "── ELENA TORRES ──",                                  "style": "section-header" },
          { "text": "Treatment paid for by SAFETYNET — first dose Monday", "style": "entry", "condition": "globalVars.elena_treatment_funded" },
