          { "text": "Widowed — still fighting Stage 3 cancer, alone",       "style": "warning", "condition": "globalVars.final_choice === 'combat_lethal'" },
          { "text": "" },
          { "text": "── SOFIA (11) AND MIGUEL (8) TORRES ──",                "style": "section-header" },
