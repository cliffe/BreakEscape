          { "text": "Father facing trial, mother in treatment",            "style": "entry", "condition": "globalVars.final_choice === 'arrest' && globalVars.elena_treatment_funded" },
          { "text": "Father facing trial, mother untreated",               "style": "entry", "condition": "(globalVars.final_choice === 'arrest' && !globalVars.elena_treatment_funded) || globalVars.final_choice === 'combat_nonlethal'" },
          { "text": "Father dead — and, without treatment, they may lose their mother too", "style": "warning", "condition": "globalVars.final_choice === 'combat_lethal'" },
