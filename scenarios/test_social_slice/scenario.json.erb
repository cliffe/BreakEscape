    "conceptCards": [
      { "id": "tool_hunter", "title": "Hunter",
        "text": "Hunter reports the address pattern a company uses, for example first initial then surname. A tester reads it to work out how any named employee would be addressed. Defence: publish role inboxes such as careers@ledgerwell.example, not a list of staff addresses." },
      { "id": "tool_harvester", "title": "theHarvester",
        "text": "theHarvester collects names, email addresses and sub-domains from public sources. The results are noisy: two people can share a name, so check each hit against what the company's own site says before you rely on it." },
      { "id": "tool_recon", "title": "Recon-ng",
        "text": "Recon-ng is a framework that runs many lookups like the ones above from one place. A handle that returns nothing is a result too: it tells you not to spend time on that lead." },
      { "id": "tool_exiftool", "title": "exiftool",
        "text": "exiftool reads the metadata a file carries: author, software, saved-by name and folder path. Staff publish documents without clearing it, and the author field often shows the username convention." },
      { "id": "typo-squat", "title": "Typo-squat",
        "text": "A name one look-alike pair away, such as ledgerwall for ledgerwell. Read the address letter by letter before you trust it." },
      { "id": "homograph", "title": "Homograph",
        "text": "A letter from another alphabet that looks the same, so the address reads right but is not. The browser shows the real xn-- form." },
      { "id": "padlock", "title": "Padlock",
        "text": "A padlock means the connection is private, not that the site is who it claims to be. A fake page can have one too." },
      { "id": "hover-link", "title": "Hover the link",
        "text": "The words of a link are not where it goes. Hover, or read the status bar, to see the real address before clicking." },
      { "id": "right-to-left", "title": "Read right to left",
        "text": "Read a domain from the right. The part just before the final label is the real owner; everything to its left can be made up." },
      { "id": "five-habits", "title": "Five habits",
        "text": "Stop before you type a password. Read the address. Check the link target. Ignore the padlock as proof. Open the real site yourself if unsure." }
    ],

