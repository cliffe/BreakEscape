          "senderAuth": { "pass": "✓ Sent as your own address, so there is nothing to spoof and nothing to fail.", "redFlag": null },
          "attachmentPlausible": {
            "pass": "✓ The CV is attached",
            "missing": { "fail": "You mention a CV, but there's nothing attached.", "redFlag": null },
            "wrong-type": { "fail": "That isn't a file type I can open as a CV.", "redFlag": null }
          }
        },
