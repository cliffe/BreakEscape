        "interests": { "topics": ["finance"] },
        "addressedAs": ["teague_first", "teague_short", "teague_formal"],
        "templateSets": {
          "from": ["from_named"],
          "greeting": ["greet_named"],
          "pretext": ["pretext_sheet", "pretext_generic"],
          "ask": ["ask_open_attached"]
        },
        "senderAuth": { "domainPublishesAuth": true, "spoofAligns": false, "dmarcPolicy": "none" },
        "redFlagMeter": false,
        "urgency": { "advisoryMax": "medium" },
        "primedFor": {
          "distinctiveValues": ["ledger_export"],
          "genericValues": ["tuesday"],
          "minDistinct": 1,
          "expectedAttachment": "spreadsheet",
          "trusts": ["shah"],
          "story": "a Q3 ledger export from Ravi, on a Tuesday"
        },
        "requiredFactors": ["senderTrust", "addressedTo", "pretextRelevant", "attachmentPlausible"],
        "advisoryFactors": ["senderAuth", "urgencyCalibrated"],
        "factorStrings": {
          "open": { "pass": "✓ She would open it", "fail": "Nothing about the sender or the subject made her open it.", "redFlag": null },
          "senderTrust": { "pass": "✓ From someone she trusts", "fail": "Sorry, who is this? I don't recognise the address.", "redFlag": null },
          "addressedTo": { "pass": "✓ Addressed her by name", "fail": "This isn't addressed the way anyone who actually knows her would.", "redFlag": null },
          "pretextRelevant": { "pass": "✓ Relevant to her", "fail": "I'm not expecting anything like this.", "redFlag": null },
          "senderAuth": {
            "pass": "✓ Sender authentication would pass",
            "fail": "The spoofed r.shah@ address fails the domain's alignment check. Ledgerwell publishes its DMARC policy as p=none, so a receiver would still deliver it.",
            "redFlag": null
          },
          "attachmentPlausible": {
            "pass": "✓ The ledger export is attached",
            "missing": { "fail": "You said you'd attach it, but there's nothing here.", "redFlag": null },
            "wrong-type": { "fail": "That isn't a file I can open as a ledger.", "redFlag": null }
          }
        },
        "hints": ["Think about who Morgan trusts.", "What does she expect to receive, and from whom?",
                  "This account can only send as itself. The Operator account lets you choose the sender."]
      }
    ]
