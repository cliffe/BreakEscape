      "pretext_enquiry": { "part": "pretext", "text": "I'd like to ask about your accounting services.", "slots": [],
        "urgency": "low" },
      "ask_review_cv": { "part": "ask", "text": "Could you review my CV when you have a moment?", "slots": [],
        "urgency": "low" },

      "from_named": { "part": "from", "text": "{sender_name} <{sender_address}>",
        "slots": [ { "id": "sender_name", "type": "name", "about": "sender", "label": "sender's name" },
                   { "id": "sender_address", "type": "address", "label": "sender's address" } ] },
      "greet_named": { "part": "greeting", "text": "Hi {name},",
        "slots": [ { "id": "name", "type": "name", "about": "recipient", "label": "name to greet them by" } ] },
      "pretext_sheet": { "part": "pretext", "text": "Here is {document} you wanted {when}.",
        "slots": [ { "id": "document", "type": "document", "label": "which file" }, { "id": "when", "type": "date", "label": "when they asked for it" } ],
        "urgency": "low" },
      "pretext_generic": { "part": "pretext", "text": "Please see attached.", "slots": [],
        "urgency": "low" },
      "ask_open_attached": { "part": "ask", "text": "Can you open the attached file and check it, please?", "slots": [],
        "urgency": "low" }
