{
  "scenario_brief": "TEST: Access model devices\n\nA test floor for the physical pentest devices (PHYSICAL_PENTEST_DEVICES_PLAN.md). The rogue AP half is in reception: hide the pocket rogue AP in a reception plant, clone a network from its console and wait for Kieran's laptop. The drop box half sits behind the patch panel.",
  "endGoal": "Test only: run the device beats.",
  "startRoom": "reception",
  "startPosition": { "x": 6, "y": 7 },
  "npcNeedsSeed": "test_access_devices",
  "npcWindupMs": 0,
  "needsDebugOverlay": true,

  "social": { "captures": { "revealSecret": true } },

  <%# H4: lighting on so the planted rogue AP's LED emitter (room lighting.emitters) can be seen and measured. %>
  "lighting": { "enabled": true, "defaultMode": "on" },

  "networks": {
    <%# B1 (drop box, patch panel). office_lan is the data VLAN behind network_port and
        secured_port; lw_voice and lw_guest are the wrong VLANs behind voice_port and guest_port. %>
    "office_lan": { "name": "Ledgerwell office LAN", "wifi": { "ssid": "Ledgerwell-Staff", "psk": "<%= @random_password %>" } },
    "lw_voice": { "name": "Ledgerwell voice VLAN" },
    "lw_guest": { "name": "Ledgerwell guest Wi-Fi", "wifi": { "ssid": "Ledgerwell-Guest", "psk": "Visitor-Pebble-2026" } }
  },

  <%# B1: the voice VLAN's phones are resources, not room objects (sign-in hosts are room objects,
      so headless phones would otherwise be clickable sprites). Call signalling and extension
      numbers only: no files, no staff PCs. %>
  "resources": {
    "lw_fs01_records": {
      "kind": "file_share",
      "name": "Client-Records",
      "host": "LW-FS01",
      "network": "office_lan",
      "observations": "Top folders, one per client. Any device on the network can list the names; what is inside them is client records, so open none of it."
    },
    "lw_callmgr": {
      "kind": "phone", "name": "Call manager", "host": "LW-CM01", "network": "lw_voice",
      "observations": "The call manager for the office phones. It answers on the voice network with the extension list: 100 reception, 101 open plan. Calls are set up here and nothing else."
    },
    "lw_ph_recep": {
      "kind": "phone", "name": "Reception desk phone", "host": "LW-PH-RECEP", "network": "lw_voice",
      "observations": "A desk phone registered as extension 100. Its call signalling is all that answers."
    },
    "lw_ph_open1": {
      "kind": "phone", "name": "Open plan desk phone", "host": "LW-PH-OPEN1", "network": "lw_voice",
      "observations": "A desk phone registered as extension 101. Its call signalling is all that answers."
    }
  },

  "accountProfiles": {
    "kieran_desktop": {
      "for": { "people": ["kieran"] },
      "contents": [
        {
          "type": "text_file",
          "id": "kieran_requests",
          "name": "Facilities requests",
          "takeable": false,
          "readable": true,
          "onRead": { "setVariable": { "kp_signed_in": true } },
          "text": "Facilities requests (test)\n\nDoor faults, the post-room printer and the contractor visits booked this week. The booking list tells a stranger which names and uniforms reception expects. Booking a visit is out of scope."
        }
      ]
    }
  },

  "globalVariables": {
    <%# ap_planted is set only by the rogue AP kit's hideable.onHidden (below), which is what this
        fixture keeps it for: the one test of onHidden's set_global. The lab dropped it. The staff-copy
        hint reads it so the validator's unread-global check stays quiet, and because a copy can only
        run after the kit is hidden. %>
    "ap_planted": false,
    "ap_twin_staff": false,
    "ap_twin_wrong": false,
    "ap_portal_account": false,
    "kp_twin_captured": false,
    "kp_twin_account_captured": false,
    "kp_twin_signed_in": false,
    "kp_wifi_joined": false,
    "kp_signed_in": false,
    "lw_staff_ap_planted": false,
    "lw_guest_ap_planted": false,
    "network_port_planted": false,
    "voice_port_planted": false,
    "guest_port_planted": false
  },

  "startItemsInInventory": [
    { "type": "rogue_ap", "sprite": "rogue_ap", "id": "kit_rogue_ap", "name": "Pocket rogue AP", "takeable": true, "droppable": false,
      "observations": "A pocket box that broadcasts a copy of a Wi-Fi network's name. The copy is open, because it cannot know the real key, so nobody's laptop joins it on its own: a person has to pick it. Hide it in a plant in reception, then set it up from its console.",
      "hideable": {
        "rooms": ["reception"],
        "spots": "plants",
        "exclude": ["reception_plant-large11-top-ani3_76"],
        "device": "planted_rogue_ap",
        "overlay": { "sprite": "rogue_ap_tucked" },
        "confirm": "Hide the pocket rogue AP in this plant?",
        <%# The onHidden test: hiding the kit sets ap_planted (see the globalVariables note). %>
        "onHidden": [ { "type": "set_global", "key": "ap_planted", "value": true } ]
      } },
    { "type": "page-builder", "id": "captures_terminal", "name": "Harvested Credentials",
      "sprite": "tablet", "takeable": true,
      "observations": "Your capture tablet: the keys and passwords the test has recorded, each shown in full.",
      "minigameData": { "view": "captures", "landingPageId": "cm_captures" } },
    { "type": "phone", "name": "Your phone", "takeable": true, "phoneId": "player_phone",
      "npcIds": ["ruth_phone"], "observations": "Your work phone, with Ruth a message away." },
    { "type": "pc", "id": "kit_dropbox", "name": "Network drop box", "sprite": "pi_cluster1",
      "takeable": true, "rogueDevice": true,
      "observations": "A palm-sized network drop box from the kit, with an Ethernet socket and its own radio. Plug it into a live wall port to join that port's network." }
  ],

  "objectives": [
    {
      "aimId": "wireless",
      "title": "Wireless",
      "description": "Plant the pocket rogue AP in reception and see what a copy of the staff Wi-Fi harvests: the shared Wi-Fi key, or one person's staff sign-in. Either harvest completes this aim.",
      "status": "active",
      "order": 0,
      "tasks": [
        { "taskId": "wireless_harvest", "title": "Harvest something with the rogue AP: the Wi-Fi key page or the staff sign-in page", "type": "manual", "status": "active" },
        { "taskId": "opt_rogue_ap", "title": "Optional: harvest the staff Wi-Fi key with the rogue AP's key page", "type": "manual", "optional": true, "status": "active" },
        { "taskId": "opt_wifi_join", "title": "Optional: join the staff Wi-Fi with the harvested key", "type": "unlock_object", "targetObject": "lw_staff_ap", "optional": true, "status": "active" },
        { "taskId": "opt_rogue_ap_account", "title": "Optional: harvest a staff sign-in with the rogue AP's sign-in page", "type": "manual", "optional": true, "status": "active" },
        { "taskId": "opt_twin_signin", "title": "Optional: sign in at the hot desk with the account the portal harvested", "type": "manual", "optional": true, "status": "active" }
      ]
    }
  ],

  "rooms": {
    "reception": {
      "type": "room_reception",
      "door_sign": "Reception",
      "connections": { "north": "comms" },
      "lighting": {
        "emitters": {
          "lw_staff_ap": { "color": "#2a8cff", "radius": 6, "intensity": 0.6, "effect": "blink", "above": true, "offsetX": 0, "offsetY": -1 },
          "lw_guest_ap": { "color": "#2a8cff", "radius": 6, "intensity": 0.6, "effect": "blink", "above": true, "offsetX": 0, "offsetY": -1 },
          "planted_rogue_ap": { "color": "#3fa8ff", "radius": 5, "intensity": 0.7, "effect": "blink", "above": true, "offsetX": -4, "offsetY": 3 }
        }
      },
      "objects": [
        <%# Wall-fade proof: a plant-large11 on the back-wall strip (top two tile rows); a hiding spot by the plant rule. %>
        {
          "type": "plant",
          "id": "wall_strip_plant",
          "name": "Plant by the back wall",
          "sprite": "plant-large11",
          "position": { "x": 3.6, "y": 1.0 },
          "takeable": false,
          "observations": "A tall plant against the back wall."
        },
        {
          "type": "pc",
          "id": "planted_rogue_ap",
          "name": "Planted rogue AP",
          "sprite": "rogue_ap_planted",
          "hiddenWith": "kit_rogue_ap",
          "takeable": false,
          "interactable": true,
          "active": true,
          "wifiTwin": true,
          "observations": "Your pocket rogue AP, tucked into the plant. Click the plant to open its console.",
          "apScan": [
            { "ssid": "Ledgerwell-Staff", "security": "WPA2", "signal": 4, "clients": 3, "inScope": true,
              "cloneGlobals": { "ap_twin_staff": true, "ap_twin_wrong": false },
              "cloneLog": {
                "wifi_key": "Copy of Ledgerwell-Staff up (open), showing the Wi-Fi key page. Simulated disconnect (a real test would not send these). Waiting for someone to pick the copy.",
                "staff_signin": "Copy of Ledgerwell-Staff up (open), showing the staff sign-in page. Simulated disconnect (a real test would not send these). Waiting for someone to pick the copy."
              },
              "knownClients": [ { "npcId": "kieran", "label": "Kieran's laptop" } ] },
            { "ssid": "Ledgerwell-Guest", "security": "WPA2", "signal": 3, "clients": 1, "inScope": true,
              "cloneGlobals": { "ap_twin_wrong": true, "ap_twin_staff": false },
              "cloneLog": "Copy of Ledgerwell-Guest up (open). It harvests nothing worth having: the guest key is printed on a card in reception, and staff laptops hold the staff network, not this one." },
            { "ssid": "BT-Hub-4F2A", "security": "WPA2", "signal": 2, "clients": 2, "inScope": false,
              "refusal": "Out of scope. BT-Hub-4F2A is not the client." },
            { "ssid": "Corrigan-Dental", "security": "WPA2", "signal": 1, "clients": 1, "inScope": false,
              "refusal": "Out of scope. Corrigan Dental is not the client." }
          ],
          "apPortal": {
            "templates": [
              { "id": "wifi_key", "label": "Key page", "setGlobals": { "ap_portal_account": false },
                "page": {
              "brands": [ { "id": "ledgerwell", "name": "Ledgerwell", "look": "generic", "realDomain": "ledgerwell.example", "domains": [ { "id": "d_wifi", "domain": "wifi-login.example", "trick": "unrelated", "tier": 0 } ] } ],
              "purposes": [ { "id": "wifi", "label": "Reconnect", "button": "Reconnect" } ],
              "wordings": [ { "id": "w_key", "match": true, "text": "Ledgerwell-Staff: the router has been updated. Enter the Wi-Fi key to reconnect." } ],
              "fields": ["password"],
              "fieldLabels": { "password": "Wi-Fi key" },
              "choices": { "brand": "ledgerwell", "purpose": "wifi", "domainId": "d_wifi", "wording": "w_key", "fields": ["password"], "logo": true, "padlock": false }
            } },
              { "id": "staff_signin", "label": "Sign-in page", "setGlobals": { "ap_portal_account": true },
                "page": {
              "brands": [ { "id": "ledgerwell", "name": "Ledgerwell", "look": "generic", "realDomain": "ledgerwell.example", "domains": [ { "id": "d_wifi", "domain": "wifi-login.example", "trick": "unrelated", "tier": 0 } ] } ],
              "purposes": [ { "id": "wifi", "label": "Sign in", "button": "Sign in" } ],
              "wordings": [ { "id": "w_signin", "match": true, "text": "Ledgerwell-Staff: the network now uses staff accounts. Sign in with your Ledgerwell username and password." } ],
              "fields": ["email", "password"],
              "fieldLabels": { "email": "Ledgerwell username" },
              "choices": { "brand": "ledgerwell", "purpose": "wifi", "domainId": "d_wifi", "wording": "w_signin", "fields": ["email", "password"], "logo": true, "padlock": false }
            } }
            ]
          },
          "apCaptureLog": [
            { "global": "kp_twin_captured", "text": "Kieran's laptop joined the copy; Wi-Fi key page submitted.", "npcId": "kieran" },
            { "global": "kp_twin_account_captured", "text": "Kieran's laptop joined the copy; staff sign-in page submitted.", "npcId": "kieran" }
          ]
        },
        {
          "type": "pc",
          "id": "lw_staff_ap",
          "name": "Ledgerwell-Staff access point",
          "sprite": "lw_staff_ap",
          "position": { "x": 5, "y": 2.2 },
          "takeable": false,
          "wifiAp": true,
          "network": "office_lan",
          "observations": "A wall access point above the waiting area. Its label reads Ledgerwell-Staff. It asks for a key."
        },
        {
          "type": "pc",
          "id": "lw_guest_ap",
          "name": "Ledgerwell-Guest access point",
          "sprite": "lw_guest_ap",
          "position": { "x": 2, "y": 2.2 },
          "takeable": false,
          "wifiAp": true,
          "network": "lw_guest",
          "observations": "A second access point on the wall. Its label reads Ledgerwell-Guest."
        },
        {
          "type": "notes1",
          "id": "lw_guest_card",
          "name": "Reception Wi-Fi card",
          "sprite": "lw_guest_card",
          "position": { "x": 0.4375, "y": 3.25 },
          "takeable": false,
          "readable": true,
          "readDisplay": "gameDisplay",
          "addToNotes": false,
          "text": "Visitors: connect your laptop to the wireless.\nNetwork name (SSID): Ledgerwell-Guest\nKey: Visitor-Pebble-2026",
          "observations": "A printed flyer pinned to the wall with the guest Wi-Fi details."
        },
        {
          "type": "pc",
          "id": "hot_desk_pc",
          "name": "Hot desk PC",
          "network": "office_lan",
          "host": "LW-HOT-01",
          "sprite": "pc_desktop",
          "position": { "x": 7.5, "y": 5 },
          "takeable": false,
          "interactable": true,
          "active": true,
          "locked": true,
          "lockType": "login",
          "access": { "people": ["kieran"] },
          "observations": "A spare desk with a PC on the office domain. Only Kieran's account signs in here in this test."
        },
        {
          "type": "pc",
          "id": "kieran_laptop",
          "owner": ["kieran"],
          "private": true,
          "name": "Kieran's laptop",
          "sprite": "laptop1",
          "position": { "x": 3.6, "y": 5.2, "elevation": 30 },
          "takeable": false,
          "affordance": { "satisfies": "work", "restores": 60, "useSeconds": 3, "useFrom": { "dx": 0, "dy": -1 } },
          "observations": "Kieran's laptop on the front desk."
        }
      ],
      "npcs": [
        {
          "id": "ruth_phone",
          "displayName": "Ruth Adeyemi",
          "npcType": "phone",
          "avatar": "assets/characters/ruth_adeyemi_headshot.png",
          "spriteTalk": "assets/characters/ruth_adeyemi_talk.png",
          "spriteVisemes": "assets/characters/ruth_adeyemi_visemes.png",
          "phoneId": "player_phone",
          "storyPath": "scenarios/test_access_devices/ink/ruth_phone.json",
          "currentKnot": "start",
          "eventMappings": [
            { "eventPattern": "npc_used:kieran_laptop", "condition": "globalVars.ap_twin_staff === true && globalVars.ap_portal_account !== true", "onceOnly": true,
              "addCapture": { "targetId": "staff_wifi_key", "roleLabel": "Ledgerwell Ltd, reception", "kind": "credential", "host": "Ledgerwell-Staff, rogue access point", "address": "Ledgerwell-Staff", "secret": "<%= @random_password %>", "note": "Kieran's laptop picked the copy and the Wi-Fi key page took the key (proof: planted).", "proof": { "planted": "kit_rogue_ap" } },
              "setGlobal": { "kp_twin_captured": true },
              "completeTask": "wireless_harvest" },
            { "eventPattern": "global_variable_changed:kp_twin_captured", "condition": "value === true", "onceOnly": true,
              "bark": "That is the staff Wi-Fi key. Read it on your tablet, then try it on the staff access point.",
              "completeTask": "opt_rogue_ap" },
            { "eventPattern": "global_variable_changed:kp_twin_account_captured", "condition": "value === true", "onceOnly": true,
              "bark": "That is Kieran's sign-in. Read it on your tablet and try it at the hot desk.",
              "completeTask": "opt_rogue_ap_account" },
            { "eventPattern": "global_variable_changed:ap_twin_staff", "condition": "value === true && globalVars.ap_planted === true && globalVars.ap_twin_staff === true && !globalVars.kp_twin_captured && !globalVars.kp_twin_account_captured", "onceOnly": true, "delayMs": 60000,
              "bark": "Nothing has picked your copy yet. Kieran's laptop is the likely one; give him a minute. If you reloaded, the capture lands once Kieran is working again." },
            { "eventPattern": "global_variable_changed:ap_portal_account", "condition": "value === true && globalVars.ap_portal_account === true && globalVars.ap_twin_staff === true && !globalVars.kp_twin_account_captured", "onceOnly": true, "delayMs": 60000,
              "bark": "Your copy now asks for a staff sign-in. Kieran's laptop has to pick it again; give him a minute. If you reloaded, the capture lands once Kieran is working again." },
            { "eventPattern": "network_joined", "condition": "data.apId === 'lw_staff_ap'", "onceOnly": true,
              "addCapture": { "targetId": "wifi_join", "roleLabel": "Ledgerwell Ltd, reception", "kind": "foothold", "host": "Ledgerwell-Staff access point", "note": "Joined the staff Wi-Fi with the harvested key: one shared key, and the staff Wi-Fi is the office LAN." },
              "setGlobal": { "kp_wifi_joined": true } },
            { "eventPattern": "pc_signed_in:hot_desk_pc", "condition": "data.npcId === 'kieran' && data.via === 'password'", "onceOnly": true,
              "addCapture": { "targetId": "twin_signin", "roleLabel": "Ledgerwell Ltd, reception", "kind": "foothold", "host": "Hot desk PC", "note": "A password typed into a fake Wi-Fi page opened a staff desk. The control is a second factor on every sign-in." },
              "setGlobal": { "kp_twin_signed_in": true },
              "completeTask": "opt_twin_signin" }
          ]
        },
        {
          "id": "kieran",
          "displayName": "Kieran Doyle",
          "npcType": "person",
          "position": { "x": 3.5, "y": 4.3 },
          "behavior": { "facePlayer": true, "facePlayerDistance": 96 },
          "spriteSheet": "kieran_doyle",
          "spriteTalk": "assets/characters/kieran_doyle_talk.png",
          "spriteVisemes": "assets/characters/kieran_doyle_visemes.png",
          "storyPath": "scenarios/test_access_devices/ink/kieran.json",
          "currentKnot": "start",
          "voice": { "name": "Achird", "style": "Office junior on the front desk of a small British firm, early twenties, Irish, from Dublin. Speak with a consistent Dublin accent throughout. Do not shift to any other accent. Light, quick, cheerful; always slightly in a hurry, never rude.", "language": "en-GB" },
          "needsHome": "kieran_laptop",
          "needsDeferMin": 0.5,
          "role": "facilities",
          "creds": { "username": "k.doyle", "password": "Quarry-Beacon-Saffron-59" },
          "captureProof": [ { "planted": "kit_rogue_ap" } ],
          "needs": { "work": { "decayPerMin": 90, "urgentAt": 50, "initial": 40 } },
          "eventMappings": [
            { "eventPattern": "npc_used:kieran_laptop", "condition": "globalVars.ap_twin_staff === true && globalVars.ap_portal_account !== true", "onceOnly": true,
              "bark": "My Wi-Fi dropped, so I picked the network again. It wanted the key again, so I typed it in." },
            { "eventPattern": "npc_used:kieran_laptop", "condition": "globalVars.ap_twin_staff === true && globalVars.ap_portal_account === true", "onceOnly": true,
              "bark": "The Wi-Fi dropped again, and this time it wanted my Ledgerwell sign-in, so I typed that in.",
              "addCapture": { "targetId": "kieran", "roleLabel": "Ledgerwell Ltd, reception", "kind": "credential", "address": "k.doyle", "host": "Ledgerwell-Staff, rogue access point", "note": "Typed his staff sign-in into the rogue AP's sign-in page (proof: planted)." },
              "setGlobal": { "kp_twin_account_captured": true },
              "completeTask": "wireless_harvest" }
          ]
        }
      ]
    },
    <%# B1: the comms cupboard. p3_patch_panel lists five ports (four jacked on three networks, one
        unpatched). voice_port and guest_port are reached only through the panel (panelOf: no sprite,
        no position); network_port and secured_port keep their sprites and are also listed. %>
    "comms": {
      "type": "room_lw_comms",
      "door_sign": "Comms Cupboard",
      "connections": { "south": "reception" },
      "objects": [
        {
          "type": "notes", "id": "p3_patch_panel", "name": "Patch panel and comms cabinet",
          "sprite": "comms_cabinet1", "position": { "x": 2, "y": 1 },
          "takeable": false, "readable": false, "interactable": true, "active": true,
          "observations": "A wall patch panel, the ports labelled by desk.",
          "panelPorts": [
            { "port": 1, "label": "D01", "desk": "Desk 1, data", "jack": "network_port" },
            { "port": 2, "label": "V02", "desk": "Reception phone", "jack": "voice_port" },
            { "port": 3, "label": "G03", "desk": "Guest meeting room", "jack": "guest_port" },
            { "port": 4, "label": "M04", "desk": "Managed uplink", "jack": "secured_port" },
            { "port": 5, "label": "D05", "desk": "Spare desk" }
          ]
        },
        {
          "type": "pc", "id": "network_port", "name": "Live wall network port",
          "sprite": "network_rack1", "position": { "x": 1, "y": 3 },
          "takeable": false, "interactable": true, "active": true,
          "networkJack": true, "network": "office_lan", "plantedSprite": "pi_cluster1",
          "linkName": "Drop box: comms cupboard",
          "jackConfirm": "Plug the network drop box into this live port?",
