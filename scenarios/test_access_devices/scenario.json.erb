          "networkJack": true, "network": "office_lan", "portSecurity": true,
          "portSecurityMessage": "The switch logs the drop box's address and shuts the port, so an unknown device gets no network.",
          "jackConfirm": "Try the network drop box in this managed switch port?",
          "requiresItemHint": "You would need the network drop box from your kit to try this port.",
          "observations": "A wall port running to a managed switch with port security on."
