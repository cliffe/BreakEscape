        {
          "type": "pc", "id": "voice_port", "name": "Voice VLAN port",
          "takeable": false, "interactable": true, "active": true,
          "networkJack": true, "network": "lw_voice", "panelOf": "p3_patch_panel",
          "linkName": "Drop box: voice VLAN port",
          "jackConfirm": "Plug the network drop box into the patch panel's voice port?",
          "requiresItemHint": "You need the network drop box from your kit in hand to plant it on the port.",
          "observations": "A patch panel port patched through to the phones."
        },
        {
          "type": "pc", "id": "guest_port", "name": "Guest VLAN port",
          "takeable": false, "interactable": true, "active": true,
          "networkJack": true, "network": "lw_guest", "panelOf": "p3_patch_panel",
          "linkName": "Drop box: guest VLAN port",
          "jackConfirm": "Plug the network drop box into the patch panel's guest port?",
          "requiresItemHint": "You need the network drop box from your kit in hand to plant it on the port.",
          "observations": "A patch panel port patched through to the guest network."
        },
        {
          "type": "pc", "id": "lan_signin_pc", "name": "Back office PC", "host": "LW-PC-BACK",
          "sprite": "pc_desktop", "position": { "x": 5, "y": 3 }, "network": "office_lan",
          "takeable": false, "locked": true, "lockType": "login", "loginPicker": false,
          "observations": "A sign-in host on the office network."
        }
      ],
      "npcs": []
    }
  }
}
