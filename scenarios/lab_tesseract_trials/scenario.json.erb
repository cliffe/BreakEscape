<%
# ============================================================================
# THE KEYHOLDER TRIALS (folder lab_tesseract_trials) - scenario file
# Lab scenario with SAFETYNET spy framing. Design: DESIGN.md (v4).
#
# Per-game generation. Rules (DESIGN section 5):
#  - no `def` here: methods would land on the shared ScenarioBinding class, so
#    helpers are lambdas with a kh_ prefix and everything else is a local;
#  - every interpolated string goes through .to_json;
#  - no generated value ever appears in a spoken line (ink, barks, timed texts),
#    because the TTS batch renders this template separately;
#  - copyable text is ciphertext only; instructions go in observations.
# Proof that each recipe gives back its answer: tools/verify_*.
# ============================================================================
require 'openssl'
require 'base64'
require 'securerandom'

kh_words_t1 = %w[lantern harbour compass granite meadow falcon orchard thistle bramble cobble ember fennel gravel heather hollow kettle lichen marrow nettle pebble quill saddle sorrel tinder willow yarrow]
kh_words_t3 = %w[signal beacon quartz pewter cobalt saffron juniper marble amber basalt cinder copper indigo jasper lantana magenta nickel ochre pumice russet silver tawny umber velvet walnut zircon]
kh_words_t4 = %w[stairwell archway landing bellrope clocktower gargoyle balcony buttress cloister corbel cupola doorway gable gallery lintel mezzanine parapet portico quadrangle rafter spire steeple transom turret vestibule wainscot]
kh_words_t6 = %w[parchment vellum folio quarto codex scroll almanac atlas binding chapbook colophon errata flyleaf gazetteer glossary incunable lexicon marginalia octavo palimpsest primer quire recto treatise verso woodcut]
kh_vig_keys = %w[ledger merkle nonce genesis anchor witness]
kh_passphrase = %w[keyholder lockstock deadbolt tumbler skeleton keystone padlock latchkey wardkey mortise]
kh_token_word = %w[kestrel osprey merlin hobby peregrine harrier]
kh_porter_word = %w[postmark franking satchel parcel sorting letterbox]

kh_pin4 = -> { format('%04d', rand(1000..9999)) }
# Caesar exactly as CyberChef's ROT13 operation: letters only, case kept
kh_caesar = lambda do |text, n|
  text.gsub(/[a-z]/) { |ch| ((ch.ord - 97 + n) % 26 + 97).chr }
      .gsub(/[A-Z]/) { |ch| ((ch.ord - 65 + n) % 26 + 65).chr }
end
# Vigenere exactly as CyberChef's "Vigenère Encode": key advances only on letters
kh_vigenere = lambda do |text, key|
  k = key.downcase.chars.map { |ch| ch.ord - 97 }
  i = 0
  text.chars.map do |ch|
    if ch =~ /[a-z]/
      r = ((ch.ord - 97 + k[i % k.size]) % 26 + 97).chr; i += 1; r
    elsif ch =~ /[A-Z]/
      r = ((ch.ord - 65 + k[i % k.size]) % 26 + 65).chr; i += 1; r
    else
      ch
    end
  end.join
end

# --- L1: ASCII decimal, spaced (Jordan's leaflet) ---
kh_l1 = kh_words_t1.sample
kh_leaflet_text = kh_l1.bytes.join(' ')
# --- L2: the PIN's digits as ASCII codes, run together ---
kh_l2 = kh_pin4.call
kh_card2_text = kh_l2.bytes.join('')
# --- L3: binary ---
kh_l3 = kh_words_t3.sample
kh_card3_text = kh_l3.bytes.map { |b| format('%08b', b) }.join(' ')
# --- L4: hex, run together ---
kh_l4 = kh_words_t4.sample
kh_trial4_hex = "corridor door passphrase: #{kh_l4}".unpack1('H*')
# --- L5: Base64 ---
kh_l5 = kh_pin4.call
kh_poster5 = Base64.strict_encode64("Library keypad: #{kh_l5}. The returns shelf has your next trial.")
# --- L6: Base64 around Caesar shift 6 ---
kh_l6 = kh_words_t6.sample
kh_slip6 = Base64.strict_encode64(kh_caesar.call("Special Collections safe password: #{kh_l6}", 6))

# --- Player key pair (Tom's lab account) ---
kh_player = OpenSSL::PKey::RSA.new(2048)
kh_player_priv = kh_player.to_pem.strip
kh_player_pub = kh_player.public_key.to_pem.strip

# --- L8: AES-128-CBC; key sealed to the player's public key; IV only in Trial VII ---
kh_aes_key = SecureRandom.random_bytes(16)
kh_aes_iv = SecureRandom.random_bytes(16)
kh_l8 = kh_passphrase.sample + '-' + rand(10..99).to_s
kh_cipher = OpenSSL::Cipher.new('aes-128-cbc')
kh_cipher.encrypt
kh_cipher.key = kh_aes_key
kh_cipher.iv = kh_aes_iv
kh_tag_hex = (kh_cipher.update(kh_l8) + kh_cipher.final).unpack1('H*')
kh_iv_hex = kh_aes_iv.unpack1('H*')
kh_env_raw = nil
loop do
  kh_env_raw = kh_player.public_encrypt(kh_aes_key.unpack1('H*'), OpenSSL::PKey::RSA::PKCS1_OAEP_PADDING)
  break unless kh_env_raw.dup.force_encoding('UTF-8').valid_encoding?
end
kh_envelope = Base64.strict_encode64(kh_env_raw)

# --- L7: Vigenere; key on Sidhu's whiteboard; plaintext gives porter's code, pigeonhole, IV ---
kh_vkey = kh_vig_keys.sample
kh_hole = rand(2..5)
kh_l7 = kh_porter_word.sample + '-' + rand(10..99).to_s
kh_hole_word = %w[zero one two three four five six][kh_hole]
kh_trial7 = kh_vigenere.call("The pigeonholes open with #{kh_l7}. Yours is number #{kh_hole_word}. Your envelope is sealed to your public key. The IV travels with this letter: #{kh_iv_hex}", kh_vkey)
# the four pigeonholes: the player's envelope in kh_hole, three decoys sealed to other keys
kh_pigeon = {}
(2..5).each do |n|
  if n == kh_hole
    kh_pigeon[n] = kh_envelope
  else
    other = OpenSSL::PKey::RSA.new(2048)
    kh_pigeon[n] = Base64.strict_encode64(other.public_encrypt(SecureRandom.hex(16), OpenSSL::PKey::RSA::PKCS1_OAEP_PADDING))
  end
end

# --- L10: first 8 hex of SHA-256 of the drop box passphrase ---
kh_l10 = OpenSSL::Digest::SHA256.hexdigest(kh_l8)[0, 8]

# --- Climax: Ghost's report with a tracking pixel; hash; signature ---
kh_ghost = OpenSSL::PKey::RSA.new(2048)
kh_token = "#{kh_token_word.sample}-#{rand(1000..9999)}"
kh_report_plain = <<~TXT.strip
  KEYHOLDER FIELD REPORT
  FROM: Agent 0x00 (undercover, Miskatonic University UK)
  TO: Agent HaX
  STATUS: Recruited. Candidate passed all trials. Recruiter met on screen only.
  ASSESSMENT: Cell interested in crypto students for future operations. No names yet.
  RECOMMENDATION: Maintain cover. Await next contact.
  <img src="https://cdn.cryptosecure-recovery.example/px/locate/#{kh_token}.png" width="1" height="1">
TXT
kh_report_b64 = Base64.strict_encode64(kh_report_plain)
kh_report_sha = OpenSSL::Digest::SHA256.hexdigest(kh_report_b64)
kh_report_sig = Base64.strict_encode64(kh_ghost.sign(OpenSSL::Digest::SHA256.new, kh_report_b64))
kh_ghost_pub = kh_ghost.public_key.to_pem.strip
kh_fingerprint = OpenSSL::Digest::SHA256.hexdigest(kh_ghost_pub)[0, 16]

# --- Optional: EBCDIC (code page 037) job tape ---
kh_ebcdic = "MISKATONIC UNIVERSITY COMPUTING SERVICE 1979. JOB 0412 OWNER [REDACTED]. PROJECT KEYHOLDER. STATUS: STILL RUNNING.".encode('IBM037').unpack1('H*').scan(/../).join(' ')

# --- Static texts (field notes and documents). No per-game values in here. ---
kh_txt = {}
kh_txt[:brief] = "Freshers' week at Miskatonic University UK. CryptoSecure Recovery, the front for Ransomware Incorporated, is talent-spotting first-years through a puzzle trail called the Keyholder Trials. You're undercover as a student. Get picked. Every Trial opens with something you decode in CyberChef: get a lab laptop from Dr Shaw in the teaching lab first. If your phone is ever compromised, submit what HaX most needs to know as a flag on a Hacktivity terminal (lower case, exactly as found); the one in this building is in Dr Schreuders' workshop."
kh_txt[:comms] = "COMMS DISCIPLINE\n\nIf you think your handset is compromised, don't message me.\n\nSubmit what I most need to know as a flag on any Hacktivity terminal. It reaches me and nobody else.\n\nFlags are lower case, exactly as you find them: usually a word, a dash and some digits.\n\nThe only Hacktivity terminal in that building is in Dr Schreuders' workshop.\n\n- H."
kh_txt[:ascii] = "ASCII CHART (printable characters)\n\nDec Hex Char | Dec Hex Char | Dec Hex Char\n 32  20 space|  64  40 @    |  96  60 `\n 33  21 !    |  65  41 A    |  97  61 a\n 34  22 \"    |  66  42 B    |  98  62 b\n 35  23 #    |  67  43 C    |  99  63 c\n 36  24 $    |  68  44 D    | 100  64 d\n 37  25 %    |  69  45 E    | 101  65 e\n 38  26 &    |  70  46 F    | 102  66 f\n 39  27 '    |  71  47 G    | 103  67 g\n 40  28 (    |  72  48 H    | 104  68 h\n 41  29 )    |  73  49 I    | 105  69 i\n 42  2A *    |  74  4A J    | 106  6A j\n 43  2B +    |  75  4B K    | 107  6B k\n 44  2C ,    |  76  4C L    | 108  6C l\n 45  2D -    |  77  4D M    | 109  6D m\n 46  2E .    |  78  4E N    | 110  6E n\n 47  2F /    |  79  4F O    | 111  6F o\n 48  30 0    |  80  50 P    | 112  70 p\n 49  31 1    |  81  51 Q    | 113  71 q\n 50  32 2    |  82  52 R    | 114  72 r\n 51  33 3    |  83  53 S    | 115  73 s\n 52  34 4    |  84  54 T    | 116  74 t\n 53  35 5    |  85  55 U    | 117  75 u\n 54  36 6    |  86  56 V    | 118  76 v\n 55  37 7    |  87  57 W    | 119  77 w\n 56  38 8    |  88  58 X    | 120  78 x\n 57  39 9    |  89  59 Y    | 121  79 y\n 58  3A :    |  90  5A Z    | 122  7A z\n 59  3B ;    |  91  5B [    | 123  7B {\n 60  3C <    |  92  5C \\    | 124  7C |\n 61  3D =    |  93  5D ]    | 125  7D }\n 62  3E >    |  94  5E ^    | 126  7E ~\n 63  3F ?    |  95  5F _    |"
kh_txt[:tape] = "PUNCHED PAPER TAPE, 1979\n\n  ○ ● ○ ○ ● ○ ○ ○\n  ○ ● ○ ○ ● ○ ○ ●\n\nEach row across the tape is one byte: a hole (●) is a 1, no hole (○) is a 0.\nRow 1: 01001000 = 64 + 8 = 72 = H\nRow 2: 01001001 = 64 + 8 + 1 = 73 = I"
kh_txt[:fn01] = "FIELD NOTE 1: BITS, BYTES, BASES, AND CYBERCHEF\n(from Dr Shaw's induction pack)\n\nWHAT IT IS\nA bit is 0 or 1. Eight bits make a byte: 256 possible values, 0-255.\nPlace values, left to right: 128 64 32 16 8 4 2 1.\nWorked: 01001101 = 64 + 8 + 4 + 1 = 77. The same value is 4D in hex.\nOne hex digit is exactly four bits, so a byte is always two hex digits.\n\nDRIVING CYBERCHEF\n1. Copy the code, never retype it: in a note, drag across the text and press Ctrl+C (Cmd+C on a Mac); files have a Copy button. Paste into Input (top right).\n2. Type the operation's name in Search (top left) and double-click it to add it to the Recipe (middle).\n3. The answer appears in Output (bottom right). The bin icon on the Recipe clears it.\nThe up-arrow next to the cross on the laptop pops CyberChef into its own tab, recipe and all.\nYour notepad has a pencil on every page: paste anything you'll need later there.\n\nON THE COMMAND LINE\nprintf '%d\\n' 0x4D"
kh_txt[:fn02] = "FIELD NOTE 2: CHARACTERS ARE NUMBERS\n\nWHAT IT IS\nA character encoding is an agreed table from numbers to characters. ASCII covers English letters, digits and punctuation in 0-127.\n\"A\" = 65, \"a\" = 97, space = 32, and the digit \"4\" is 52, not 4.\n\nHOW TO SPOT IT\nNumbers between 32 and 126, usually separated by spaces.\nDecimal codes are 2 or 3 digits long, so codes run together need splitting by thinking about the range: digits (48-57) are two digits each; lowercase letters (97-122) are three.\nIf you get capital letters instead of what you expected, something has read your digits as hex.\n\nIN CYBERCHEF\nFrom Decimal\n\nON THE COMMAND LINE\npython3 -c \"print(bytes([104,105]).decode())\""
kh_txt[:fn03] = "FIELD NOTE 3: HEX AND BINARY\n\nWHAT IT IS\nHex uses 0-9 and a-f for the values 0-15. Two hex digits per byte, always, so hex can run together and still be read, unlike decimal.\nBinary is eight 0s and 1s per byte.\n\nHOW TO SPOT IT\nHex: only 0-9 and a-f, an even number of them.\nBinary: only 0 and 1, in groups of eight.\n\nIN CYBERCHEF\nFrom Hex, From Binary\n\nON THE COMMAND LINE\necho 6869 | xxd -r -p"
kh_txt[:fn04] = "FIELD NOTE 4: BASE64\n\nHandler note: posters on campus aren't usually written in this. Take a look. - H.\n\nWHAT IT IS\nTake the bytes three at a time (24 bits), cut them into four 6-bit pieces, and write each piece as one of 64 symbols: A-Z, a-z, 0-9, + and /. \"=\" pads the end.\nWorked: \"Hi!\" = 01001000 01101001 00100001 -> 010010 000110 100100 100001 -> 18 6 36 33 -> S G k h.\nIt's an encoding, not encryption: there's no key, and CyberChef's Magic undoes it for anyone.\nA .pem key file is Base64 too, between two header lines.\n\nHOW TO SPOT IT\nThat alphabet, a length that's a multiple of 4, often ending in = or ==.\n\nIN CYBERCHEF\nFrom Base64\n\nON THE COMMAND LINE\necho SGkh | base64 -d"
kh_txt[:fn05] = "FIELD NOTE 5: LAYERS, AND YOUR FIRST KEY\n\nWHAT IT IS\nEncodings stack. Peel the outside layer first and look at what's left.\nA Caesar cipher shifts every letter the same number of places. The shift is the key. There are only 25 possible keys, so trying them all is quick, which is why it isn't secure.\n\nHOW TO SPOT IT\nAfter decoding, words of normal lengths made of the wrong letters.\n\nIN CYBERCHEF\nFrom Base64, then ROT13 with Amount set to minus the shift (-6 undoes a shift of 6). Or ROT13 Brute Force.\n\nON THE COMMAND LINE\ntr 'G-ZA-Fg-za-f' 'A-Za-z'   (undoes a shift of 6)"
kh_txt[:fn06] = "FIELD NOTE 6: VIGENERE\n\nWHAT IT IS\nThe key is a word. Each letter of the key gives the shift for one letter of the message, then the key repeats. The same letter can encrypt differently each time, so counting letters stops working.\nWithout the key you're stuck. Keys travel separately from messages.\n\nHOW TO SPOT IT\nScrambled words of normal lengths, with punctuation and digits left alone.\n\nIN CYBERCHEF\nVigenère Decode (Key: the word).\nCopy only the ciphertext: any letters before it, such as a heading, knock the key out of step.\nKeep what the plaintext tells you: paste it into your notepad with the pencil.\n\nON THE COMMAND LINE\nNo standard tool. A five-line Python loop does it."
kh_txt[:fn07] = "FIELD NOTE 7: HASHES AND FINGERPRINTS\n\nWHAT IT IS\nA hash turns any input into a fixed-length fingerprint. SHA-256 gives 256 bits, which is 64 hex digits, because each hex digit is four bits.\nSame input, same hash. Change one byte, even an invisible new line, and it changes completely. You can't run it backwards.\nUsed to check nothing has changed, and to store passwords without storing them.\n\nIN CYBERCHEF\nSHA2, and set Size to 256 (it starts on 512). Leave Rounds alone.\nEasiest: add SHA2 underneath the operation that produced your input, so no stray new line gets in.\n\nON THE COMMAND LINE\nprintf '%s' 'text' | sha256sum   (echo adds a new line, so its hash differs)"
kh_txt[:fn08] = "FIELD NOTE 8: SYMMETRIC ENCRYPTION, AES\n\nWHAT IT IS\nOne shared secret key locks and unlocks. DES used 56-bit keys (2^56 possibilities: now too few). AES uses 128, 192 or 256 bits.\nAES works on 16-byte blocks. CBC mode mixes each block with the one before, and the first block with an IV. An IV needn't be secret, but it has to arrive with the message.\nGetting the key to the other person safely is the key distribution problem.\n\nIN CYBERCHEF\nAES Decrypt: paste the key and the IV (both hex). Leave everything else as it is.\n\nON THE COMMAND LINE\nxxd -r -p ct.hex | openssl enc -d -aes-128-cbc -K <key> -iv <iv>"
kh_txt[:fn09] = "FIELD NOTE 9: PUBLIC-KEY ENCRYPTION\n\nHandler note: Dr Shaw put your key pair on your lab account. You'll want the private one. - H.\n\nWHAT IT IS\nTwo keys that belong together. The public key can go to anyone. For encryption, it only locks. The private key stays with you and unlocks.\nYour public key sits in a directory, so anyone can send you a secret using a key that was never secret. That answers the key distribution problem.\nReal systems send a fresh AES key this way (hybrid encryption). So does ransomware.\nKeep private keys secret, as with symmetric keys.\n\nIN CYBERCHEF\nFrom Base64, then RSA Decrypt: paste your private key PEM. Leave the rest.\n\nON THE COMMAND LINE\nbase64 -d env.b64 | openssl pkeyutl -decrypt -inkey private.pem -pkeyopt rsa_padding_mode:oaep"
kh_txt[:fn10] = "FIELD NOTE 10: SIGNATURES\n\nWHAT IT IS\nThe sender signs a hash of the message with their private key. Anyone with their public key can check it. Change one character and the check fails.\nA signature proves who sent something and that nothing changed. It hides nothing, so read what you send. A document can even carry a remote image that reports where it was opened.\nCheck exactly what was signed: if they signed a Base64 file, decode it and you're checking a different message.\nGet the sender's public key from somewhere you trust, and compare its fingerprint.\n\nIN CYBERCHEF\nFrom Base64 on the signature, then RSA Verify:\n - paste the public key;\n - Message = the signed text exactly as given;\n - Message format: leave on Raw;\n - Message Digest Algorithm: SHA-256.\n\"Verified OK\" means it checks out.\n\nON THE COMMAND LINE\nopenssl dgst -sha256 -verify pub.pem -signature sig.bin msg"
kh_txt[:fn11] = "FIELD NOTE 11: NOT EVERYTHING IS ASCII\n\nWHAT IT IS\nIBM mainframes used EBCDIC, where \"A\" is 0xC1, not 0x41. Same letters, a different table, so the bytes look like nonsense if you assume ASCII.\n\nIN CYBERCHEF\nFrom Hex, then Decode text (IBM EBCDIC US-Canada (37)).\n\nON THE COMMAND LINE\nxxd -r -p tape.hex | iconv -f IBM037 -t UTF-8"
kh_txt[:readme] = "README\n\nYour lab account has a key pair: two keys made together.\nA .pem file is the key's bytes in Base64 between two header lines.\nYour public key goes in the department directory, so anyone can use it to send you something. That's the point.\nThe private key stays private. Don't email it to anyone, including me.\n\n- T. Shaw"
kh_txt[:assessments] = "CANDIDATE ASSESSMENTS (Keyholder Studentship)\n\nC1. Strong on encodings, weak on patience. Retain for now.\nC2. Asked Magic for everything. Release.\nC3. Megan Oyelaran. Overdraft eleven thousand four hundred pounds; mother's care-home fees two months behind. Quick, proud, short of options. Highly retainable.\nC4. Copied C1's answers. Release both.\nC5. Has not yet opened the lockbox. Unlikely.\nC6. Strong, careful, and asks the wrong questions for a student.\nC7. See separate file."
kh_txt[:whiteboard] = "BLOCKCHAIN 101: A TOY LEDGER\n\nBlock 1 | data: genesis-0 | prev: 0000 | hash: 7c1e\nBlock 2 | data: alice->bob | prev: 7c1e | hash: 9b04\nBlock 3 | data: bob->carol | prev: 9b04 | hash: e21d\nBlock 4 | data: %s | prev: e21d | hash: 51a8\n\nChange one letter in block 2 and every hash after it changes."
