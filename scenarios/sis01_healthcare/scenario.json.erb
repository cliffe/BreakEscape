          { "text": "INCIDENT CONTAINED — WITH LOSSES",     "style": "title", "condition": "globalVars.network_isolated && (globalVars.patient_bed4_deceased || globalVars.patient_bed2_deceased)" },
          { "text": "INCIDENT NOT CONTAINED",               "style": "title", "condition": "!globalVars.network_isolated && !globalVars.patient_bed4_deceased && !globalVars.patient_bed2_deceased" },
          { "text": "INCIDENT NOT CONTAINED — WITH LOSSES", "style": "title", "condition": "!globalVars.network_isolated && (globalVars.patient_bed4_deceased || globalVars.patient_bed2_deceased)" },
          { "text": "NORTHGATE GENERAL HOSPITAL — RANSOMWARE RESPONSE", "style": "subtitle" },

          { "text": "── CLINICAL OUTCOMES ──", "style": "section-header" },
          { "text": "Ms Okafor (Bed 2): Stable — prescribed rate kept when the pump called it too low; checked with pharmacy by phone", "style": "entry", "condition": "!globalVars.patient_bed2_deceased && globalVars.drug_library_override" },
          { "text": "Ms Okafor (Bed 2): Stable — prescribed rate set after the library was restored",   "style": "entry", "condition": "!globalVars.patient_bed2_deceased && globalVars.pump_dose_correct && !globalVars.drug_library_override" },
          { "text": "Ms Okafor (Bed 2): Infusion not renewed during response",                           "style": "entry", "condition": "!globalVars.patient_bed2_deceased && !globalVars.pump_dose_correct && !globalVars.pump_dose_error" },
          { "text": "Ms Okafor (Bed 2): Wrong rate went in; the alarm was raised in time and naloxone given", "style": "entry", "condition": "!globalVars.patient_bed2_deceased && globalVars.pump_dose_error && globalVars.bed2_alarm_raised" },
          { "text": "Ms Okafor (Bed 2): Wrong rate went in; left over-sedated, and the alarm was never raised", "style": "entry", "condition": "!globalVars.patient_bed2_deceased && globalVars.pump_dose_error && !globalVars.bed2_alarm_raised" },
          { "text": "Ms Okafor (Bed 2): Deceased — morphine overdose; the tampered library accepted the wrong rate", "style": "entry", "condition": "globalVars.patient_bed2_deceased" },
          { "text": "Mr Ahmed (Bed 4): Escalated on your honest estimate — one-to-one care until outreach arrived",                          "style": "entry", "condition": "globalVars.bed4_escalated && !globalVars.sarah_given_soon_estimate && !globalVars.patient_bed4_deceased" },
          { "text": "Mr Ahmed (Bed 4): Sarah was told 'soon'; escalated late, then one-to-one care until outreach arrived", "style": "entry", "condition": "globalVars.bed4_escalated && globalVars.sarah_given_soon_estimate && !globalVars.patient_bed4_deceased" },
          { "text": "Mr Ahmed (Bed 4): Not escalated; survived the response window by luck",                   "style": "entry", "condition": "!globalVars.bed4_escalated && !globalVars.patient_bed4_deceased" },
          { "text": "Mr Ahmed (Bed 4): Deceased — deterioration not escalated before cardiac arrest",   "style": "entry", "condition": "globalVars.patient_bed4_deceased" },
          { "text": "Drug library: Restored — pump safety guardrails operational",                       "style": "entry", "condition": "globalVars.drug_library_restored" },
          { "text": "Drug library: Compromised — raised morphine minimum not corrected during response", "style": "entry", "condition": "globalVars.drug_library_compromised && !globalVars.drug_library_restored" },
          { "text": "Drug library: Tampering not discovered during response",                            "style": "entry", "condition": "!globalVars.drug_library_compromised" },

          { "text": "── NETWORK RESPONSE ──", "style": "section-header" },
          { "text": "Network isolation: Authorised — dual sign-off confirmed before isolation",          "style": "entry", "condition": "globalVars.network_isolated && globalVars.network_isolation_authorised" },
          { "text": "Isolation cost: allergy and drug printouts on every ward, and pharmacy checks by phone, before the link was cut", "style": "entry", "condition": "globalVars.network_isolated && globalVars.isolation_compensating_controls" },
          { "text": "Isolation cost: no printouts or pharmacy cover; risk accepted with a named owner", "style": "entry", "condition": "globalVars.network_isolated && !globalVars.isolation_compensating_controls && globalVars.isolation_risk_accepted" },
          { "text": "Network isolation: Bypassed — isolated without dual sign-off (CLAIM-HC-007 violated)", "style": "entry", "condition": "globalVars.network_isolated && !globalVars.network_isolation_authorised" },
          { "text": "Network isolation: Not completed during response",                                  "style": "entry", "condition": "!globalVars.network_isolated" },
          { "text": "SIEM investigation: Critical alerts escalated; traced back to the contractor VPN account m.blake, logged in from a Tor exit node", "style": "entry", "condition": "globalVars.siem_escalated && globalVars.vpn_anomaly_identified" },
          { "text": "SIEM investigation: Critical alerts escalated; the spread was seen, but not how they got in", "style": "entry", "condition": "globalVars.siem_escalated && !globalVars.vpn_anomaly_identified" },
          { "text": "SIEM investigation: Alerts not reviewed — attack vector unconfirmed",              "style": "entry", "condition": "!globalVars.siem_escalated" },
          { "text": "VPN anomaly: m.blake's stolen login flagged — London, then Bucharest thirty minutes later, with no MFA", "style": "entry", "condition": "globalVars.vpn_anomaly_identified" },
          { "text": "VPN anomaly: Not identified — initial access vector unknown",                      "style": "entry", "condition": "!globalVars.vpn_anomaly_identified" },

          { "text": "── GOVERNANCE ──", "style": "section-header" },
          { "text": "CLAIM-HC-001: Judged not supported — its own conditions were never met",            "style": "entry", "condition": "globalVars.safety_claim_hc001_assessed && globalVars.hc001_verdict === 'invalid'" },
          { "text": "CLAIM-HC-001: You judged it to hold; it never did — its conditions (no exception rules, no dual-homed PCs) were already false", "style": "entry", "condition": "globalVars.safety_claim_hc001_assessed && globalVars.hc001_verdict === 'holds'" },
          { "text": "CLAIM-HC-001: You judged it to hold until the attack; it never did — the exceptions were older than the attack", "style": "entry", "condition": "globalVars.safety_claim_hc001_assessed && globalVars.hc001_verdict === 'held_until_attack'" },
          { "text": "CLAIM-HC-001: Reviewed with Clinical Engineering before isolation",                "style": "entry", "condition": "globalVars.safety_claim_hc001_assessed && globalVars.hc001_verdict !== 'invalid' && globalVars.hc001_verdict !== 'holds' && globalVars.hc001_verdict !== 'held_until_attack'" },
          { "text": "CLAIM-HC-001: Not reviewed during response",                                        "style": "entry", "condition": "!globalVars.safety_claim_hc001_assessed" },
          { "text": "CLAIM-HC-003: Change control failed — an unauthorised library change reached the pumps", "style": "entry", "condition": "globalVars.safety_claim_hc003_assessed" },
          { "text": "CLAIM-HC-003: Library checked and restored from a verified copy; the claim itself was not reviewed with Clinical Engineering", "style": "entry", "condition": "!globalVars.safety_claim_hc003_assessed && globalVars.drug_library_restored" },
          { "text": "CLAIM-HC-003: Tampered library found but not restored; the claim was not reviewed with Clinical Engineering", "style": "entry", "condition": "!globalVars.safety_claim_hc003_assessed && globalVars.drug_library_compromised && !globalVars.drug_library_restored" },
          { "text": "CLAIM-HC-003: Not reviewed during response",                                        "style": "entry", "condition": "!globalVars.safety_claim_hc003_assessed && !globalVars.drug_library_compromised && !globalVars.drug_library_restored" },
          { "text": "CLAIM-HC-007: Joint sign-off honoured; the annual rehearsal had lapsed (19 months)", "style": "entry", "condition": "globalVars.network_isolation_authorised" },
          { "text": "CLAIM-HC-007: Joint sign-off skipped; the annual rehearsal had lapsed (19 months)", "style": "entry", "condition": "globalVars.network_isolated && !globalVars.network_isolation_authorised" },
          { "text": "CLAIM-HC-007: Not engaged — network isolation not completed",                      "style": "entry", "condition": "!globalVars.network_isolated" },
          { "text": "Pump console: advised keeping pumps off it until the library was verified",       "style": "entry", "condition": "globalVars.pump_console_advice === 'hold'" },
          { "text": "Pump console: advised giving it back once the restore was clean",                 "style": "entry", "condition": "globalVars.pump_console_advice === 'console_back'" },
          { "text": "Pump console: advised bringing it back to monitor only, library pushes off",      "style": "entry", "condition": "globalVars.pump_console_advice === 'view_only'" },
          { "text": "Patients (Article 34): told now, before forensics",                                "style": "entry", "condition": "globalVars.patient_disclosure === 'now'" },
          { "text": "Patients (Article 34): told only after forensics",                                "style": "entry", "condition": "globalVars.patient_disclosure === 'wait'" },
          { "text": "Patients (Article 34): told only if the records leak",                            "style": "entry", "condition": "globalVars.patient_disclosure === 'only_if_leaked'" },
          { "text": "Ransom: advised not to pay",                                                      "style": "entry", "condition": "globalVars.ransom_advice === 'dont_pay'" },
          { "text": "Ransom: advised keeping payment open as a fallback",                                             "style": "entry", "condition": "globalVars.ransom_advice === 'pay'" },
          { "text": "Ransom: left to the Board, with the costs of each option",                        "style": "entry", "condition": "globalVars.ransom_advice === 'board'" },

          { "text": "── RECOVERY ──", "style": "section-header" },
          { "text": "Backup restoration: Vendor cloud copy — clean, about 18 hours on paper",          "style": "entry", "condition": "globalVars.backup_restore_initiated && !globalVars.backup_reinfected && globalVars.backup_recovery_source === 'cloud_vendor'" },
          { "text": "Backup restoration: NAS, Sunday's snapshot — about 5 hours; scanned for known indicators only; Monday's records re-entered from paper", "style": "entry", "condition": "globalVars.backup_restore_initiated && !globalVars.backup_reinfected && globalVars.backup_recovery_source === 'nas_snapshot'" },
          { "text": "Backup restoration: Tape — clean, but three to five days, and nothing after Friday night", "style": "entry", "condition": "globalVars.backup_restore_initiated && !globalVars.backup_reinfected && globalVars.backup_recovery_source === 'tape_library'" },
          { "text": "Backup restoration: Initiated — source not recorded",                              "style": "entry", "condition": "globalVars.backup_restore_initiated && !globalVars.backup_reinfected && globalVars.backup_recovery_source !== 'cloud_vendor' && globalVars.backup_recovery_source !== 'tape_library' && globalVars.backup_recovery_source !== 'nas_snapshot'" },
          { "text": "Backup restoration: Reinfected — restore ran while the network was still exposed",  "style": "entry", "condition": "globalVars.backup_reinfected" },
          { "text": "Backup restoration: Not initiated during response",                                 "style": "entry", "condition": "!globalVars.backup_restore_initiated" },
          { "text": "ICO notification: Submitted early, before containment (Article 33 applied correctly)", "style": "entry", "condition": "globalVars.ico_notified_early" },
          { "text": "ICO notification: Submitted after isolation, inside the 72-hour window",             "style": "entry", "condition": "globalVars.ico_notified && !globalVars.ico_notified_early && !globalVars.ico_deadline_missed" },
          { "text": "NIS incident report: Made to NHS England on Monday night",                          "style": "entry" },
          { "text": "NCSC: Support requested directly",                                                  "style": "entry", "condition": "globalVars.ncsc_notified" },
          { "text": "ICO notification: Deadline missed — regulatory consequences pending",               "style": "entry", "condition": "globalVars.ico_deadline_missed" },
          { "text": "ICO notification: Not submitted during response",                                   "style": "entry", "condition": "!globalVars.ico_notified && !globalVars.ico_deadline_missed" }
        ]
      }
    ]
  },

  "timers": [
<%# [Phase 5] Scenario Timer System — event-based countdown display
    Countdown widget shows "Next Event:" + mm:ss for soonest pending timer.
    When timer fires (delayMs elapsed), `setGlobal` executes and markFired() removes from countdown.
    Urgent alerts: < 5min = amber, < 1min = red with pulse animation. %>
    {
      "id": "bed4_deterioration_1",
      "label": "Patient Deterioration",
      "delayMs": 480000,
      "condition": "!globalVars.bed4_escalated",
      "setGlobal": { "patient_bed4_state": "distressed" },
      "showCountdown": true,
      "onceOnly": true
    },
    {
      "id": "bed4_deterioration_2",
      "label": "Patient Deterioration",
      "delayMs": 900000,
      "condition": "!globalVars.bed4_escalated",
      "setGlobal": { "patient_bed4_state": "critical" },
      "showCountdown": true,
      "onceOnly": true
    },
    {
      "id": "bed4_deterioration_3",
      "label": "Critical Event",
      "delayMs": 1320000,
      "condition": "!globalVars.bed4_escalated && !globalVars.patient_bed4_deceased",
      "setGlobal": { "patient_bed4_deceased": true, "patient_bed4_state": "deceased" },
      "showCountdown": true,
      "onceOnly": true
    },
    {
      "id": "ico_deadline",
      "label": "ICO 72-hour deadline",
      "delayMs": 2700000,
      "countdownHours": 63,
<%# Blind playtest D10 (decision): the HUD shows game-time hours left ("63 h left") instead of
    an unlabelled mm:ss. countdownHours (engine, opt-in) maps the whole delay onto 63 hours:
    Tue 07:30 to Thu 22:38 is the part of the 72-hour window left when the player arrives. %>
<%# 45-minute game-time window representing the 72-hour GDPR ICO deadline.
    Incident occurred Mon 22:38; 72-hour deadline is Thu 22:38.
    Timer fires if ico_notified is still false at 45 minutes of game time.
    Adjust delayMs to match session pacing — 45 min = 2700000ms. %>
      "condition": "!globalVars.ico_notified",
      "setGlobal": { "ico_deadline_missed": true },
      "showCountdown": true,
      "onceOnly": true
    },
    {
      "id": "nas_integrity_scan",
      "label": "NAS Integrity Scan",
      "delayMs": 90000,
      "startOnGlobal": "nas_scan_requested",
<%# Ravi's scan of Sunday's NAS snapshot (npc_ravi.ink nas_question). When it finishes, the NAS
    source on the backup console becomes selectable (its key slot needs nas_integrity_checked). %>
      "setGlobal": { "nas_integrity_checked": true },
      "showCountdown": false,
      "onceOnly": true
    },
    {
      "id": "bed2_respiratory_arrest",
      "label": "Patient Critical Event",
      "delayMs": 90000,
      "startOnGlobal": "pump_dose_error",
<%# M-8 (2026-10-02): a 20 mg/hr morphine overdose takes minutes, not seconds. 90 s after a wrong
    rate goes in under the tampered library, Ms Okafor stops breathing properly (critical); 180 s after,
    she dies. Raising the alarm (Mrs Kowalski's "I'll get the nurse now", or telling Sarah) sets
    bed2_alarm_raised, which cancels both timers: naloxone, and she survives. After the library is
    restored a wrong rate has to pass the double-check modal and only sedates. %>
      "condition": "!globalVars.drug_library_restored && !globalVars.bed2_alarm_raised",
      "cancelOnGlobal": "bed2_alarm_raised",
      "setGlobal": { "patient_bed2_state": "critical" },
      "showCountdown": false,
      "onceOnly": true
    },
    {
      "id": "bed2_double_jeopardy",
      "label": "Patient Death",
      "delayMs": 180000,
      "startOnGlobal": "pump_dose_error",
      "condition": "!globalVars.drug_library_restored && !globalVars.bed2_alarm_raised",
      "cancelOnGlobal": "bed2_alarm_raised",
      "setGlobal": { "patient_bed2_state": "deceased", "patient_bed2_deceased": true },
      "showCountdown": false,
      "onceOnly": true
    }
  ],

