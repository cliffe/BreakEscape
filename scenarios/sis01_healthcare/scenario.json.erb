      "ambientVolume": 0.3,
      "lighting": {
        "emitters": {
          "bed4_monitor": [
            { "condition": "globalVars.patient_bed4_deceased", "color": "#ff2414", "radius": 20, "offsetY": -20, "intensity": 1.0, "effect": null, "above": true },
            { "color": "#ff2414", "radius": 20, "offsetY": -20, "intensity": 1.0, "effect": "pulse", "above": true }
          ]
        }
      },
      "connections": { "north": "it_security_office" },
<%# Ward 7 is open — no RFID lock. Players start here and can always re-enter.
    The IT security office (north) is RFID-locked; Sarah gives the card during arrival_briefing.
    Players are directed to assess the ward before leaving; patient timers provide incentive. %>

      "npcs": [

        {
          "id": "sarah_mitchell",
          "displayName": "Sarah Mitchell",
          "npcType": "person",
          "observations": "Sarah Mitchell, Charge Nurse — she's waving you over.",
          "position": { "x": 16, "y": 4 },
          "spriteSheet": "sarah_mitchell",
          "spriteTalk": "assets/characters/sarah_mitchell_talk.png",
          "spriteVisemes": "assets/characters/sarah_mitchell_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/sis01_healthcare/ink/npc_sarah.json",
<%# INK: scenarios/sis01_healthcare/ink/npc_sarah.ink — compiled ✓
    Knots: arrival_briefing, start, bed4_concern, bed4_options, post_isolation,
           post_drug_tamper, tamper_choices, pump_override_report, bed4_death, hub
    KEY: bed4_options asks the player for an honest estimate. "Hours" or "don't know" sets
    bed4_escalated (outreach + Amy on one-to-one); "could be soon" sets sarah_given_soon_estimate
    and the deterioration timers run on. start routes to post_isolation once network_isolated. %>
          "currentKnot": "start",
          "voice": {
            "name": "Kore",
            "style": "Black British charge nurse in her mid-40s, calm, tired but professional. Speak with a consistent Leeds, West Yorkshire accent throughout — do not shift to any other accent.",
            "language": "en-GB"
          },
          "taskOnKO": "talk_to_sarah",
          "puzzle_graph_actions": [
            { "id": "talk_to_sarah", "label": "Receive incident briefing", "unlocks_aim": "assess_ward" }
          ],
          "itemsHeld": [
            {
              "type": "keycard",
              "name": "Northgate IT Security — Visitor Access Card",
              "card_id": "ravi_rfid_card",
              "takeable": true,
              "important": true,
              "observations": "A visitor RFID access card on a lanyard. 'NORTHGATE GENERAL HOSPITAL — IT SECURITY VISITOR' printed on the front. A handwritten sticky note on the back reads: 'Authorised — R. Anand, IT Sec Manager'.",
              "puzzle_graph_unlocks": "it_security_office"
            }
<%# Ravi left his access card with Sarah for the response team. Transferred via #give_item:keycard
    in npc_sarah.ink:arrival_briefing. Required to enter the IT Security office (RFID lock).
    puzzle_graph_unlocks updated from ward_7 to it_security_office (card now gates IT office entry). %>
          ],
          "timedConversation": {
            "delay": 0,
            "targetKnot": "arrival_briefing",
            "background": "assets/backgrounds/northgate_hospital.png",
            "waitForEvent": "game_loaded",
            "skipIfGlobal": "briefing_played",
            "setGlobalOnStart": "briefing_played",
            "disableClose": true
          },
          "eventMappings": [
            {
<%# Round 3: Sarah answers the Bed 2 alarm herself when Amy is at Bed 4, and stays at the bedside. %>
              "eventPattern": "global_variable_changed:bed2_alarm_raised",
              "condition": "value === true && globalVars.bed4_escalated && !globalVars.patient_bed2_deceased",
              "onceOnly": true,
              "setGlobal": { "sarah_at_bed2": true },
              "patrolOverride": { "targetTile": { "x": 8, "y": 4 }, "speed": 150, "stopOnArrival": true }
            },
            {
              "eventPattern": "game_loaded",
              "condition": "globalVars.sarah_at_bed2 === true",
              "patrolOverride": { "targetTile": { "x": 8, "y": 4 }, "speed": 200, "stopOnArrival": true }
            },
            {
              "eventPattern": "global_variable_changed:monitoring_station_viewed",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "check_monitoring_station"
            },
<%# Blind 2 (objectives stall, run 2): each aim opened only when the aim before it was complete,
    so a skipped task early on hid every later aim. Revealing an aim when one of its tasks completes
    is engine behaviour (objectives-manager). These two relays cover the stages where no task of
    the next aim completes: the isolation opens the restore aim (and the isolation aim, after a
    SEVER without sign-off), and Priya's arrival opens the debrief aim even if the ICO report is
    still to go. The aimCompleted conditions stay, so the usual order still works; unlockAim does
    nothing to an open aim and is saved. Sarah's room is the start room, so these always listen. %>
            {
              "eventPattern": "global_variable_changed:network_isolated",
              "condition": "value === true",
              "onceOnly": true,
              "unlockAim": ["authorise_isolation", "restore_operations"]
            },
            {
              "eventPattern": "global_variable_changed:debrief_started",
              "condition": "value === true",
              "onceOnly": true,
              "unlockAim": ["restore_operations", "ncsc_debrief"]
            },
            {
              "eventPattern": "game_loaded",
              "condition": "globalVars.network_isolated === true",
              "unlockAim": ["authorise_isolation", "restore_operations"]
            },
            {
              "eventPattern": "game_loaded",
              "condition": "globalVars.debrief_started === true",
              "unlockAim": ["restore_operations", "ncsc_debrief"]
            },
<%# Tidy round (F2): a SEVER without both signed forms closes off whichever sign-off is still open.
    skipTask (engine) shows it as skipped, not done: it doesn't count towards tasks_completed or the
    score, and "Authorise Network Isolation" completes with the gap. A completed sign-off is left
    alone. The game_loaded twin covers a reload before the skip reached the server. %>
            {
              "eventPattern": "global_variable_changed:network_isolated",
              "condition": "value === true && !globalVars.network_isolation_authorised",
              "onceOnly": true,
              "skipTask": ["ravi_signoff", "david_safety_case"]
            },
            {
              "eventPattern": "game_loaded",
              "condition": "globalVars.network_isolated === true && !globalVars.network_isolation_authorised",
              "skipTask": ["ravi_signoff", "david_safety_case"]
            },
<%# Tidy round (F1): "Tell Sarah the drug library was tampered with" stays hidden until the tamper
    is found. unlockTask is saved, so no game_loaded twin is needed. %>
            {
              "eventPattern": "global_variable_changed:drug_library_compromised",
              "condition": "value === true",
              "onceOnly": true,
              "unlockTask": "warn_sarah"
            },
            {
              "eventPattern": "global_variable_changed:network_isolated",
              "condition": "value === true",
              "onceOnly": true,
              "bark": "The pump console's just dropped off. Come and tell me what's happened.",
              "barkDelay": 2000
            },
            {
              "eventPattern": "global_variable_changed:drug_library_compromised",
              "condition": "value === true && !globalVars.pump_dose_correct && !globalVars.pump_dose_error",
              "onceOnly": true,
              "bark": "Come down when you can. Ms Okafor needs a new bag, and I need to know about that library.",
              "barkDelay": 3000
            },
            {
              "eventPattern": "global_variable_changed:drug_library_compromised",
              "condition": "value === true && globalVars.pump_dose_correct",
              "onceOnly": true,
