          "observations": "A PC under the corporate policy: five wrong passwords lock a username out here."
        },
        {
          "type": "notes1",
          "id": "sign_s7",
          "name": "Sign: S7 Lockout",
          "position": { "x": 2, "y": 3 },
          "takeable": false,
          "readable": true,
          "readDisplay": "gameDisplay",
          "addToNotes": false,
          "text": "S7. Five wrong passwords for Sam count down, then This account is locked on this PC. Sam's right password gets the same answer.\nAn invented username gets the same sequence. Ian still signs in here, and Sam still signs in at the hot desk.",
          "observations": "A sign by the lockout PC."
        }
      ]
    }
  }
}
