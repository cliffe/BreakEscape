<%# ==========================================================================
    CORE (2x2). RL 2.8. The outer lock: PIN 6083 (the shift code). Tesseract
    is koImmune for the whole scene; every talk enters core_router, which
    routes on globals (a person-chat restarts after a reload). His own
    mappings open it on entry and as flag 4 lands; the closing scenes open
    on his conversation_closed (NPCs at the forward post). After his ending
    he is hidden (stage 8 m-8; no down pose yet, ASSET_LIST 8). ============ %>
    "core": {
      "type": "room_m10_core",
      "chatBackground": "assets/backgrounds/rooms/m10_core_blended.png",
      "lighting": {"mode": "on", "ambient": "#aeb2bc", "panels": false, "lights": [{"x": 2.3, "y": 2.6, "color": "#ece8dc", "radius": 80, "intensity": 0.5}, {"x": 6.9, "y": 2.6, "color": "#ece8dc", "radius": 80, "intensity": 0.5}], "emitters": {"m10_caged_lamp": {"color": "#ece8dc", "radius": 12, "intensity": 0.7, "above": true, "offsetY": 4}, "m10_key_console": {"color": "#8fb0d0", "radius": 18, "intensity": 0.45, "effect": "screen", "above": true, "offsetX": -10, "offsetY": -10}, "m10_wall_screen": {"color": "#a0c0e0", "radius": 24, "intensity": 0.4, "effect": "screen", "above": true}, "m10_readout": {"color": "#ffb040", "radius": 10, "intensity": 0.5, "above": true}, "vm-launcher": {"color": "#9fd4ff", "radius": 18, "intensity": 0.4, "effect": "screen", "above": true}, "safetynet_flag_terminal": {"color": "#9fd4ff", "radius": 18, "intensity": 0.4, "effect": "screen", "above": true}}},
      "door_sign": "Outer Lock",
      "locked": true,
      "lockType": "pin",
      "requires": "<%= outer_lock_pin %>",
      "difficulty": "hard",
      "connections": { "west": "gallery" },
      "npcs": [
<%# T-46 (Tesseract's line on a failed flag-4 submission) is cut: the engine has no failed-flag event (texts review minor 1). %>
        {
          "id": "tesseract",
          "displayName": "Dr Adrian Tesseract",
          "npcType": "person",
          "position": { "x": 6, "y": 4 },
          "spriteSheet": "adrian_tesseract",
          "spriteTalk": "assets/characters/adrian_tesseract_talk.png",
          "spriteVisemes": "assets/characters/adrian_tesseract_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/m10_full_disclosure/ink/m10_tesseract.json",
          "currentKnot": "start",
          "voice": <%= voice.(:tesseract) %>,
          "koImmune": true,
          "behavior": { "facePlayer": true },
          "eventMappings": [
            { "eventPattern": "room_entered:core", "condition": "!globalVars.core_greeted && globalVars.ending === ''", "conversationMode": "person-chat", "targetKnot": "core_router", "delayMs": 800 },
            { "eventPattern": "global_variable_changed:flag4_submitted", "condition": "value === true && globalVars.ending === ''", "conversationMode": "person-chat", "targetKnot": "core_router", "delayMs": 1500 },
            { "eventPattern": "object_interacted", "condition": "data.objectType === 'vm-launcher' && data.roomId === 'core' && globalVars.core_greeted === true && !globalVars.flag4_submitted", "onceOnly": true, "bark": "The long way. It's also the right one." },
            { "eventPattern": "global_variable_changed:guide4_given", "condition": "value === true && !globalVars.flag4_submitted", "onceOnly": true, "bark": "Your reports say thorough. I didn't believe them." },
<% %w[scorched joined arrest surrender lethal executed].each do |ending| %>
            { "eventPattern": "conversation_closed:tesseract", "condition": "globalVars.ending === '<%= ending %>'", "setVisible": false },
<% end %>
            { "eventPattern": "room_entered:core", "condition": "globalVars.ending !== ''", "setVisible": false }
          ],
          "observations": "A man in his sixties at the key console, one hand resting beside a key under a hinged cover. He looks up as if you were expected, which you were."
        },
        {
          "id": "kowalczyk_core_waiting",
          "displayName": "Agent 0x5E 'Lantern'",
          "npcType": "person",
          "position": { "x": 8, "y": 5 },
          "spriteSheet": "halina_kowalczyk",
          "spriteTalk": "assets/characters/halina_kowalczyk_talk.png",
          "spriteVisemes": "assets/characters/halina_kowalczyk_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/m10_full_disclosure/ink/m10_kowalczyk_core.json",
          "currentKnot": "start",
          "voice": <%= voice.(:kowalczyk) %>,
          "koImmune": true,
          "behavior": { "initiallyHidden": true },
          "eventMappings": [
            <%= after_end_json.('core') %>
