            { "condition": "globalVars.database_outcome === 'published'", "value": "RELEASED. ALL CITIES." }
          ],
          "text": <%= j.(clock_default_text) %>,
          "textVariants": <%= j.(countdown_variants.()) %>
        },
        {
          "type": "flag-station",
