          "spriteSheet": "security_guard",
          "spriteVisemes": "assets/characters/security_guard_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/m10_full_disclosure/ink/m10_guards.json",
          "currentKnot": "monitor",
          "voice": <%= voice.(:guard_m) %>,
          "behavior": { "hostile": { "chaseSpeed": 130, "attackDamage": 10, "pauseToAttack": true } },
          "eventMappings": [
            <%= after_end_json.('gallery') %>
