            { "eventPattern": "room_entered:gallery", "condition": "globalVars.at_keypad === true", "setGlobal": { "at_keypad": false } },
            { "eventPattern": "player_spotted:lock_guard", "conversationMode": "person-chat", "targetKnot": "challenge", "cooldown": 0 },
            { "eventPattern": "door_unlock_attempt", "condition": "data.connectedRoom === 'core' && !globalVars.lock_guard_known && !globalVars.fonoti_ko", "onceOnly": true, "bark": "That takes the shift code. It's on my card, and it stays there." },
            { "eventPattern": "door_unlocked", "condition": "data.connectedRoom === 'core' && globalVars.ghost_gift === 'code' && !globalVars.fonoti_ko", "onceOnly": true, "bark": "Who gave out the code?" },
            { "eventPattern": "room_entered:gallery", "condition": "globalVars.imran_outcome === 'talked_round' && globalVars.gallery_camera_blinded === true && !globalVars.fonoti_ko", "onceOnly": true, "delayMs": 4000, "bark": "Where's Farah? She was on till six." },
            { "eventPattern": "conversation_closed:lock_guard", "condition": "globalVars.lock_guard_challenged === true", "targetKnot": "talk" }
          ],
          "observations": "A big man walking the walkway slowly, a code card clipped to his belt."
        },
        {
          "id": "monitor_guard",
          "displayName": "Guard",
          "npcType": "person",
