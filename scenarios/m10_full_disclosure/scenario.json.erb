          "spriteTalk": "assets/characters/pieter_vos_talk.png",
          "spriteVisemes": "assets/characters/pieter_vos_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/m10_full_disclosure/ink/m10_vos.json",
