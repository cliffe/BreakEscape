# Walkthrough R1b-M1: once the night has closed, nobody in the raid can be
# talked to (the credits can be closed and play resumes). Each NPC hides itself:
# on the change (its room loaded), on load, and on entering its room.
# Implementation R1 ROOMS M1: a later setVisible:true on the same event wins, so
# every reveal in the file also carries `&& !globalVars.closing_done`.
after_end = lambda do |room|
  [
    { 'eventPattern' => 'global_variable_changed:closing_done', 'condition' => 'value === true', 'setVisible' => false, 'delayMs' => 500 },
    # game_loaded only for the start room: later rooms' mappings register when the room loads, and room_entered covers them.
    (room == 'forward_post' ? { 'eventPattern' => 'game_loaded', 'condition' => 'globalVars.closing_done === true', 'setVisible' => false } : nil),
    { 'eventPattern' => "room_entered:#{room}", 'condition' => 'globalVars.closing_done === true', 'setVisible' => false }
  ].compact
end
