vm_ip_for = lambda do |title, fallback|
  if vm_context && vm_context['hacktivity_mode'] && vm_context['vms']
    vm = vm_context['vms'].find { |v| v['title'] == title }
    return vm['ip'] if vm && vm['ip']
  end
