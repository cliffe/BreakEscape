<%# ==========================================================================
    GALLERY (2x1). RL 2.7. A straight walkway: the stair at the west end, the
    outer lock (PIN 6083) at the east end. HaX is jammed here (her mappings)
    and the music is silence. Five ways through the lock (OT 4.5): the
    cracker outside Fonoti's drawn cone, the dusted plate, the code card,
    Victoria or Vos from inside, Ghost's code. Nobody can open the gallery
    stair but HaX's unlockDoor mapping (intended validator warning). ====== %>
    "gallery": {
      "type": "room_m10_gallery",
      "chatBackground": [{"x": [0, 0.6], "image": "assets/backgrounds/rooms/m10_gallery_left_blended.png"}, {"x": [0.6, 1], "image": "assets/backgrounds/rooms/m10_gallery_blended.png"}],
      "lighting": {"mode": "on", "ambient": "#a8b0c0", "panels": false, "lights": [{"x": 3.6, "y": 3.0, "color": "#ffd090", "radius": 52, "intensity": 0.5}, {"x": 5.5, "y": 3.0, "color": "#ffd090", "radius": 52, "intensity": 0.5}, {"x": 3.7, "y": 2.4, "color": "#c8d8f0", "radius": 60, "intensity": 0.35}], "emitters": {"m10_caged_lamp": {"color": "#ffd9a0", "radius": 12, "intensity": 0.8, "above": true, "offsetY": 4}, "m10_slit_window": {"color": "#c8d8f0", "radius": 56, "intensity": 0.4, "above": true, "floorTint": 0.5, "offsetY": 20}, "m10_door_panel": {"color": "#ffb040", "radius": 8, "intensity": 0.5, "above": true}}},
      "door_sign": "Gallery Stair",
      "locked": true,
      "lockType": "rfid",
      "requires": "tg_story_lock_gallery",
      "connections": { "west": "server_hall", "east": "core" },
      "npcs": [
        {
          "id": "victoria_gallery",
          "displayName": "Victoria Sterling",
          "npcType": "person",
          "position": { "x": 5, "y": 3 },
          "spriteSheet": "victoria_sterling",
          "spriteVisemes": "assets/characters/victoria_sterling_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/m10_full_disclosure/ink/m10_victoria.json",
          "currentKnot": "start",
          "puzzle_graph_actions": [{ "id": "opened_from_inside", "label": "Opened from inside (Victoria or Vos)" }],
          "voice": <%= voice.(:victoria) %>,
          "unlockable": ["core"],
          "behavior": { "initiallyHidden": true, "hostile": { "chaseSpeed": 120, "attackDamage": 8, "pauseToAttack": true } },
          "eventMappings": [
            <%= after_end_json.('gallery') %>
            { "eventPattern": "room_entered:gallery", "condition": "globalVars.m03_victoria_fate === 'recruited' && globalVars.victoria_gallery !== 'walked' && !globalVars.closing_done", "setVisible": true },
            { "eventPattern": "room_entered:gallery", "condition": "globalVars.m03_victoria_fate === 'escaped' && !globalVars.m03_sterling_on_call_seen && globalVars.victoria_gallery !== 'walked' && !globalVars.closing_done", "setVisible": true },
            <%# She leaves back down the gallery stair, past the player: after selling the raid (trusted on a live or traced share), or on "[Go.]". %>
            { "eventPattern": "conversation_closed:victoria_gallery", "condition": "globalVars.victoria_gallery === 'trusted' && globalVars.share_zero_day !== 'stopped'", "setVisible": false },
            { "eventPattern": "conversation_closed:victoria_gallery", "condition": "globalVars.victoria_gallery === 'walked'", "setVisible": false }
          ],
          "observations": "Victoria Sterling on the walkway in a good coat, as if she has been expecting a meeting."
        },
        {
          "id": "victoria_threat",
          "displayName": "Victoria Sterling",
          "npcType": "person",
          "position": { "x": 5, "y": 3 },
          "spriteSheet": "victoria_sterling",
          "spriteVisemes": "assets/characters/victoria_sterling_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/m10_full_disclosure/ink/m10_victoria.json",
          "currentKnot": "threat",
          "voice": <%= voice.(:victoria) %>,
          "behavior": { "initiallyHidden": true, "hostile": { "chaseSpeed": 125, "attackDamage": 12, "pauseToAttack": true } },
          "eventMappings": [
            <%= after_end_json.('gallery') %>
            { "eventPattern": "room_entered:gallery", "condition": "globalVars.m03_victoria_fate === 'escaped' && globalVars.m03_sterling_on_call_seen === true && globalVars.victoria_gallery !== 'talked_down' && !globalVars.closing_done", "setVisible": true },
            { "eventPattern": "conversation_closed:victoria_threat", "condition": "globalVars.victoria_gallery === 'talked_down'", "setVisible": false }
          ],
          "observations": "Victoria Sterling on the walkway, a pistol held low against her coat."
        },
