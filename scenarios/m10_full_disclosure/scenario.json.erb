<% end %>
        <%= raid_copy.('kowalczyk', 'kowalczyk_hall', 'server_hall', 'hall', 15, 6, ["#{not_tethered} && !globalVars.wren_warned"], 'Kowalczyk near the hatch end, looking east as if she can see through the wall.') %>,
