     sched << ["#{f2}globalVars.m03_victoria_fate === '#{fate}'", schedule.('none', who)]
   end
   sched << ["#{f2}globalVars.m07_team_redirected === true", schedule.('small', 'P. VOS')]
   sched << ["#{f2}globalVars.m07_completed === true && globalVars.m07_team_assignment !== 'trojan_horse'", schedule.('large', 'P. VOS')]
   sched << ['globalVars.flag2_submitted === true', schedule.('none', 'P. VOS')]
   sched.each_with_index do |(cond, val), i| %>
            { "condition": "<%= cond %>", "value": <%= j.(val) %> }<%= i < sched.size - 1 ? ',' : '' %>
<% end %>
          ]
        },
        {
