<%# OBJECTIVES (OT 2, copied). Every task ships active except the backdoor
    task (locked until its channel exists), since a locked aim reveals itself
    when a task completes and unlockAim activates only the first task. The
    WREN aim is story-gated on whodunit_open (opened at the aside). Station
    ids carry the flag's index in that station's one-flag list. Titles never
    name WREN or an answer. concludeRequires: the four flags only. %>
  "objectives": [
    {
      "aimId": "breach_the_perimeter",
      "title": "Breach The Perimeter",
      "description": "Netherton runs the briefing at the forward post. Settle the business at the table, then get a foothold on the bunker's security monitoring from the gate terminal. The breach goes when both are done.",
      "status": "active",
      "order": 0,
      "tasks": [
        { "taskId": "take_the_briefing", "title": "Take Netherton's briefing at the forward post", "type": "custom", "status": "active" },
        { "taskId": "settle_the_table", "title": "Finish the business at the table", "type": "custom", "status": "active" },
        { "taskId": "submit_flag_1", "title": "Get a foothold on the security monitoring host and submit the flag at the gate terminal", "type": "submit_flags", "targetFlags": [<%= j.(target_flag.(1)) %>], "targetCount": 1, "currentCount": 0, "showProgress": true, "status": "active", "puzzle_graph_unlocks": "blast_tunnel" },
        { "taskId": "go_through_the_blast_door", "title": "Go through the blast door", "type": "enter_room", "targetRoom": "blast_tunnel", "status": "active" }
      ]
    },
    {
      "aimId": "get_below_ground",
      "title": "Get Below Ground",
      "description": "Through the tunnel to the security office, the first room below. The stair down to the workshop floor is behind it.",
      "status": "locked",
      "order": 1,
      "unlockCondition": { "aimCompleted": "breach_the_perimeter" },
      "tasks": [
        { "taskId": "reach_security_office", "title": "Get past the tunnel post to the security office", "type": "enter_room", "targetRoom": "security_office", "status": "active" },
        { "taskId": "answer_the_handset", "title": "Answer the duty handset", "type": "custom", "status": "active" },
        { "taskId": "take_the_stair_down", "title": "Take the stair down to the workshop floor", "type": "enter_room", "targetRoom": "workshop_floor", "status": "active" }
      ]
    },
    {
      "aimId": "cut_the_gallery_power",
      "title": "Cut The Gallery's Power",
      "description": "The gallery's blast shutter runs off the old power room. Get through the workshop floor, then have the shutter cut: by whoever runs the power room, or by hand with someone on the line.",
      "status": "locked",
      "order": 2,
      "unlockCondition": { "aimCompleted": "get_below_ground" },
      "tasks": [
        { "taskId": "read_the_casualty_sheet", "title": "Read the casualty sheet pinned above the bench", "type": "custom", "optional": true, "status": "active" },
        { "taskId": "decode_the_margin", "title": "Decode the note in the casualty sheet's margin", "type": "custom", "optional": true, "status": "active" },
        { "taskId": "reach_power_room", "title": "Get through the workshop to the power room", "type": "enter_room", "targetRoom": "power_room", "status": "active" },
        { "taskId": "cut_the_shutter", "title": "Get the gallery's blast shutter cut", "type": "custom", "status": "active" }
      ]
    },
    {
      "aimId": "find_the_release",
      "title": "Find The Release",
      "description": "The release runs from the old command room. Take the schedule, then get under the release service at the sealed section's hatch, so the release can be stopped from the core. The release console can do one thing about the cells' head start before it goes.",
      "status": "locked",
      "order": 3,
      "unlockCondition": { "aimCompleted": "cut_the_gallery_power" },
      "tasks": [
        { "taskId": "reach_server_hall", "title": "Get into the server hall", "type": "enter_room", "targetRoom": "server_hall", "status": "active" },
        { "taskId": "submit_flag_2", "title": "Take the staging schedule and submit the flag at the release console", "type": "submit_flags", "targetFlags": [<%= j.(target_flag.(2)) %>], "targetCount": 1, "currentCount": 0, "showProgress": true, "status": "active", "puzzle_graph_unlocks": "gallery" },
        { "taskId": "submit_flag_3", "title": "Get out of the release service onto its host and submit the flag at the sealed section's hatch", "type": "submit_flags", "targetFlags": [<%= j.(target_flag.(3)) %>], "targetCount": 1, "currentCount": 0, "showProgress": true, "status": "active", "puzzle_graph_unlocks": "gallery" },
        { "taskId": "use_the_console", "title": "Use the release console on the head start: kill one share, or trace one", "type": "custom", "optional": true, "status": "active" },
        { "taskId": "close_the_backdoor", "title": "Close the backdoor channel from the release console", "type": "custom", "optional": true, "status": "locked" }
      ]
    },
    {
      "aimId": "reach_the_core",
      "title": "Reach The Core",
      "description": "Up the stair and along the gallery to the core's outer lock. HaX can't reach you up there. Tesseract is waiting at his console in the core.",
      "status": "locked",
      "order": 4,
      "unlockCondition": { "aimCompleted": "find_the_release" },
      "tasks": [
        { "taskId": "cross_the_gallery", "title": "Climb to the gallery", "type": "enter_room", "targetRoom": "gallery", "status": "active" },
        { "taskId": "open_the_outer_lock", "title": "Get through the core's outer lock", "type": "custom", "status": "active" },
        { "taskId": "submit_flag_4", "title": "Get onto the core host and submit the flag at its terminal", "type": "submit_flags", "targetFlags": [<%= j.(target_flag.(4)) %>], "targetCount": 1, "currentCount": 0, "showProgress": true, "status": "active" },
        { "taskId": "hear_him_out", "title": "Hear him out", "type": "custom", "status": "active" }
      ]
    },
    {
      "aimId": "end_it",
      "title": "End It",
      "description": "His console, the database and the man. Each choice is yours, and each one costs someone. Then the night closes.",
      "status": "locked",
      "order": 5,
      "missionConclusion": true,
      "concludeRequires": { "tasksCompleted": ["submit_flag_1", "submit_flag_2", "submit_flag_3", "submit_flag_4"] },
      <%# Walkthrough R1 M-2 / R1b (PASS2 lesson 46; m09's debrief_closed pattern): close_the_night completes when the closing scene CLOSES (HaX's mappings set night_closed), not on its last line, so the conclusion screen can't cover that line. The card and credits trigger on night_closed. %>
      "conclusionScreen": { "type": "bond_visualiser" },
      "unlockCondition": { "aimCompleted": "reach_the_core" },
      "tasks": [
        { "taskId": "decide_the_console", "title": "Decide what happens at his console", "type": "custom", "status": "active" },
        { "taskId": "decide_the_database", "title": "Decide what happens to the database", "type": "custom", "status": "active" },
        { "taskId": "decide_his_end", "title": "Decide how it ends for him", "type": "custom", "status": "active" },
        { "taskId": "close_the_night", "title": "Close the night", "type": "custom", "status": "active" }
      ]
    },
    {
      "aimId": "find_the_sleeper",
      "title": "Find The Sleeper (Optional)",
      "description": "One of tonight's team was placed eleven years ago. Netherton won't tell them you know. Find them before you reach the core, or don't.",
      "status": "locked",
      "order": 6,
      "unlockCondition": { "globalVariable": "whodunit_open" },
      "tasks": [
        { "taskId": "read_the_door_log", "title": "Read the door log at the security office's monitoring desk", "type": "custom", "optional": true, "status": "active" },
        { "taskId": "check_the_alibis", "title": "Work out who nobody could see at ten past two", "type": "custom", "optional": true, "status": "active" },
        { "taskId": "read_the_bench_log", "title": "Find out who signed out the breaching case", "type": "custom", "optional": true, "status": "active" },
        { "taskId": "name_the_sleeper", "title": "Name the sleeper, or decide not to", "type": "custom", "optional": true, "status": "active" }
      ]
    }
  ],

  "rooms": {

<%# ==========================================================================
    FORWARD POST (start; 4x2). RL 2.1. Every phone NPC and every closing-scene
    NPC lives here, so their mappings register at load (F-21). HaX's phone
    (agent_0x99) carries every global mapping: doors, clock, shares, tasks,
    jam, guides, texts. The road end (west) is the vans and table; the gate
    end (east) is the gate, its terminal and the blast door. ========== %>
    "forward_post": {
      "type": "room_m10_forward",
      "chatBackground": [{"x": [0, 0.45], "image": "assets/backgrounds/rooms/m10_forward_post_west_blended.png"}, {"x": [0.45, 0.7], "image": "assets/backgrounds/rooms/m10_forward_post_centre_blended.png"}, {"x": [0.7, 1], "image": "assets/backgrounds/rooms/m10_forward_post_east_blended.png"}],
      "lighting": {"mode": "on", "ambient": "#a4b0d0", "panels": false, "lights": [{"x": 16.4, "y": 3.4, "color": "#ffc070", "radius": 120, "intensity": 0.85}, {"x": 9.0, "y": 6.2, "color": "#fff0d0", "radius": 100, "intensity": 0.6}, {"x": 3.1, "y": 3.3, "color": "#ffb060", "radius": 44, "intensity": 0.55}, {"x": 2.75, "y": 7.2, "color": "#ffb060", "radius": 44, "intensity": 0.55}, {"x": 6.0, "y": 8.4, "color": "#eef2ff", "radius": 40, "intensity": 0.3}], "emitters": {"outdoor-lamp": {"color": "#ffc070", "radius": 16, "intensity": 0.8, "above": true, "offsetY": -20}, "m10_work_lamp": {"color": "#fff0d0", "radius": 14, "intensity": 0.8, "above": true, "offsetY": -20}, "m10_field_screen": {"color": "#9fd4ff", "radius": 18, "intensity": 0.45, "effect": "screen", "above": true}, "m10_field_screen_dark": {"intensity": 0}, "m10_field_screen_curve": {"color": "#ffb0a0", "radius": 18, "intensity": 0.45, "effect": "screen", "above": true}, "safetynet_flag_terminal": {"color": "#9fd4ff", "radius": 18, "intensity": 0.4, "effect": "screen", "above": true}, "vm-launcher": {"color": "#9fd4ff", "radius": 18, "intensity": 0.4, "effect": "screen", "above": true}, "m10_gate_post": [{"condition": "globalVars.m06_assets_seized === true", "intensity": 0}, {"color": "#ffd090", "radius": 22, "intensity": 0.6, "above": true, "offsetX": 10, "offsetY": -10}], "m10_van1": {"color": "#ffb060", "radius": 30, "intensity": 0.75, "above": true, "floorTint": 0.3, "offsetX": 7, "offsetY": 0}, "m10_van2": {"color": "#ffb060", "radius": 30, "intensity": 0.75, "above": true, "floorTint": 0.3, "offsetX": 0, "offsetY": -5}}},
      "door_sign": "Forward Post",
      "connections": { "east": "blast_tunnel" },
      "npcs": [
        {
          "_comment": "Director Netherton at the table all night (no gate copy; at the breach he is on the net in HaX's breach_call). His conversation holds the briefing cutscene (start routes to briefing, then the aside), the silent branch's tether, and the split line. koImmune: a forced-scene holder.",
          "id": "director_netherton",
          "displayName": "Director Magnus Netherton",
          "npcType": "person",
          "position": { "x": 6, "y": 5 },
          "spriteSheet": "netherton",
          "spriteVisemes": "assets/characters/netherton_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/m10_full_disclosure/ink/m10_director_netherton.json",
          "currentKnot": "start",
          "puzzle_graph_actions": [{ "id": "tether_question", "label": "The tether, on the silent branch (door_scene_done)" }, { "id": "split_line", "label": "The split line" }],
          "voice": <%= voice.(:netherton) %>,
          "koImmune": true,
          <%# ASSET_LIST 3: the briefing plays over the forward post's west POV background. %>
          "timedConversation": {
            "delay": 0,
            "targetKnot": "start",
            "background": "assets/backgrounds/rooms/m10_forward_post_west_blended.png",
            "waitForEvent": "game_loaded",
            "skipIfGlobal": "briefing_played",
            "setGlobalOnStart": "briefing_played",
            "disableClose": true
          },
          "eventMappings": [
            <%# Walkthrough R1 m-1: a reload before the aside's last line reopens his router (briefing or aside), so aside_done and the WREN aim always land. %>
            { "eventPattern": "game_loaded", "condition": "globalVars.briefing_played === true && !globalVars.aside_done", "conversationMode": "person-chat", "targetKnot": "start", "disableClose": true, "delayMs": 2000 },
            <%# The split (OT 6): the second of door_scene_done and the gate console's first use; catch-ups on load and on a try at the blast door. %>
            { "eventPattern": "global_variable_changed:door_scene_done", "condition": "value === true && globalVars.gate_console_used === true && !globalVars.split_started", "conversationMode": "person-chat", "targetKnot": "split_line", "delayMs": 1500 },
            { "eventPattern": "global_variable_changed:gate_console_used", "condition": "value === true && globalVars.door_scene_done === true && !globalVars.split_started", "conversationMode": "person-chat", "targetKnot": "split_line", "delayMs": 1500 },
            { "eventPattern": "game_loaded", "condition": "globalVars.door_scene_done === true && globalVars.gate_console_used === true && !globalVars.split_started", "conversationMode": "person-chat", "targetKnot": "split_line", "delayMs": 2000 },
            { "eventPattern": "door_unlock_attempt", "condition": "data.connectedRoom === 'blast_tunnel' && globalVars.door_scene_done === true && globalVars.gate_console_used === true && !globalVars.split_started", "conversationMode": "person-chat", "targetKnot": "split_line", "delayMs": 1500, "cooldown": 0 },
            <%# After the split line, a click starts at his router again, never at split_line (targetKnot alone only moves currentKnot). %>
            { "eventPattern": "conversation_closed:director_netherton", "condition": "globalVars.split_started === true", "targetKnot": "start" }
          ],
          "observations": "Director Netherton at the folding table, coat buttoned to the throat, reading the map as if it might change."
        },
        {
          "_comment": "HaX in person at the van end (RL 2.1). Her calls and every global mapping are on the phone NPC agent_0x99 below. koImmune.",
          "id": "hax_post",
          "displayName": "Agent HaX",
          "npcType": "person",
          "position": { "x": 3, "y": 5 },
          "spriteSheet": "agent_hax",
          "avatar": "assets/characters/agent_hax_headshot.png",
          "spriteTalk": "assets/characters/agent_hax_talk.png",
          "spriteVisemes": "assets/characters/agent_hax_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/m10_full_disclosure/ink/m10_hax_post.json",
          "currentKnot": "start",
          <%# One HaX voice block for both her records: a line prefixed "Agent HaX:" in anyone's conversation resolves to either record, so they must sound the same. %>
          "voice": <%= voice.(:hax_phone) %>,
          "koImmune": true,
          "observations": "HaX at the van end with a headset round her neck and three screens on the bench behind her."
        },
        {
          "_comment": "Agent HaX on the phone: home knot start (silent; routes to the jam or the hub). Seven voiced calls, each named by targetKnot (F20): breach_call, inner_door_call, tripwire_call, ladder_call, stair_call, gallery_open_call, cut_call. Her calls never use resume (OT 13 rule 4); cut_call routes on cut_step instead. Every HaX call and text carries !hax_jammed and every call delayMs 1500. This NPC also carries the mission's global wiring.",
          "id": "agent_0x99",
          "displayName": "Agent HaX",
          "npcType": "phone",
          "phoneId": "player_phone",
          "avatar": "assets/characters/agent_hax_headshot.png",
          "storyPath": "scenarios/m10_full_disclosure/ink/m10_phone_agent0x99.json",
          "currentKnot": "start",
          "voice": <%= voice.(:hax_phone) %>,
          <%# VM-WIRE: guide ids and labUrls come with the VM plan and the lab sheets (lab sheets last, by the user's rule). %>
          "itemsHeld": [
            { "type": "lab-workstation", "id": "m10_guide_flag1", "name": "SAFETYNET Field Guide: The Monitoring Host", "takeable": true },
            { "type": "lab-workstation", "id": "m10_guide_flag2", "name": "SAFETYNET Field Guide: The Staging Copy", "takeable": true },
            { "type": "lab-workstation", "id": "m10_guide_flag3", "name": "SAFETYNET Field Guide: Out of the Container", "takeable": true },
            { "type": "lab-workstation", "id": "m10_guide_flag4", "name": "SAFETYNET Field Guide: The Core Host", "takeable": true }
          ],
          "eventMappings": [
<%# --- Load-time derivations from the imports (one mapping per arm) ----------- %>
            { "eventPattern": "game_loaded", "condition": "globalVars.m09_recruiter_offer === 'taken' && globalVars.whodunit_live === true", "setGlobal": { "whodunit_live": false } },
            { "eventPattern": "game_loaded", "condition": "globalVars.m09_recruiter_offer === 'double_crossed' && globalVars.whodunit_live === true", "setGlobal": { "whodunit_live": false } },
            { "eventPattern": "game_loaded", "condition": "globalVars.m09_sleeper_named === true && globalVars.m09_recruiter_offer === 'taken' && !globalVars.sleeper_caught", "setGlobal": { "sleeper_caught": true } },
            { "eventPattern": "game_loaded", "condition": "globalVars.m08_completed === true && !globalVars.m08_vector_hostile && !globalVars.m08_accused_vector && !globalVars.vector_on_team", "setGlobal": { "vector_on_team": true } },
            { "eventPattern": "game_loaded", "condition": "globalVars.m08_completed === true && !globalVars.m08_vector_hostile && globalVars.m08_vector_apologised === true && !globalVars.vector_on_team", "setGlobal": { "vector_on_team": true } },
            { "eventPattern": "game_loaded", "condition": "globalVars.m08_completed === true && !globalVars.m08_phantom_hostile && !globalVars.m08_accused_phantom && !globalVars.phantom_on_team", "setGlobal": { "phantom_on_team": true } },
            { "eventPattern": "game_loaded", "condition": "globalVars.m08_completed === true && !globalVars.m08_phantom_hostile && globalVars.m08_phantom_apologised === true && !globalVars.phantom_on_team", "setGlobal": { "phantom_on_team": true } },
            { "eventPattern": "game_loaded", "condition": "globalVars.m07_team_redirected === true && !globalVars.backdoor_channel_live", "setGlobal": { "backdoor_channel_live": true } },
            { "eventPattern": "game_loaded", "condition": "globalVars.m07_completed === true && globalVars.m07_team_assignment !== 'trojan_horse' && !globalVars.backdoor_channel_live", "setGlobal": { "backdoor_channel_live": true } },
            { "eventPattern": "game_loaded", "condition": "!globalVars.m04_vance_is_ally && globalVars.m07_elena_outcome !== 'turned' && !globalVars.m04_voltage_captured && !globalVars.phone_voice_is_hax", "setGlobal": { "phone_voice_is_hax": true } },
            { "eventPattern": "game_loaded", "condition": "globalVars.hax_jammed === true", "setGlobal": { "hax_jammed": false } },
            { "eventPattern": "game_loaded", "condition": "globalVars.at_keypad === true", "setGlobal": { "at_keypad": false } },
<%# --- The WREN aim (OT 2): story-gated, opened at the aside's end ----------- %>
            { "eventPattern": "global_variable_changed:aside_done", "condition": "value === true && globalVars.whodunit_live === true", "onceOnly": true, "setGlobal": { "whodunit_open": true }, "unlockAim": "find_the_sleeper" },
            { "eventPattern": "game_loaded", "condition": "globalVars.aside_done === true && globalVars.whodunit_live === true", "setGlobal": { "whodunit_open": true }, "unlockAim": "find_the_sleeper" },
            { "eventPattern": "global_variable_changed:aside_done", "condition": "value === true && globalVars.m09_sleeper_shortlist === true && !globalVars.m09_sleeper_named && globalVars.whodunit_live === true", "onceOnly": true, "setGlobal": { "clue_alibi": true } },
<%# --- Rooms: first entry, the clock's room steps, the jam (OT 5, 6) -------- %>
<% [['forward_post', 'forward_post_entered', nil], ['blast_tunnel', 'blast_tunnel_entered', nil], ['security_office', 'security_office_entered', 't0245'],
    ['workshop_floor', 'workshop_entered', 't0300'], ['power_room', 'power_room_entered', 't0315'], ['server_hall', 'server_hall_entered', 't0330'],
    ['gallery', 'gallery_entered', nil], ['core', 'core_entered', nil]].each do |room, flag, step| %>
            { "eventPattern": "room_entered:<%= room %>", "condition": "!globalVars.<%= flag %>", "setGlobal": { "<%= flag %>": true } },
<% if step %>
            { "eventPattern": "room_entered:<%= room %>", "condition": "globalVars.raid_clock < '<%= step %>'", "setGlobal": { "raid_clock": "<%= step %>" } },
<% end %>
<% if room == 'gallery' %>
            { "eventPattern": "room_entered:gallery", "condition": "!globalVars.outer_lock_open && !globalVars.hax_jammed", "setGlobal": { "hax_jammed": true } },
<% else %>
            { "eventPattern": "room_entered:<%= room %>", "condition": "globalVars.hax_jammed === true", "setGlobal": { "hax_jammed": false } },
<% end %>
<% end %>
            { "eventPattern": "global_variable_changed:hax_jammed", "condition": "value === false && !globalVars.outer_lock_open", "onceOnly": true, "sendTimedMessage": { "delay": 1500, "message": "Lost you up there. I'm back." } },
<%# --- The clock's story steps (OT 6), each forward-only --------------------- %>
            <%# Impl R1 minor 12: 02:00 on the second of door_scene_done and gate_console_used (OT 6 L348), so it shows before the split line; split_started stays as a backstop. 02:10 waits for Arakawa standing (OT L349). %>
            { "eventPattern": "global_variable_changed:door_scene_done", "condition": "value === true && globalVars.gate_console_used === true && globalVars.raid_clock < 't0200'", "setGlobal": { "raid_clock": "t0200" } },
            { "eventPattern": "global_variable_changed:gate_console_used", "condition": "value === true && globalVars.door_scene_done === true && globalVars.raid_clock < 't0200'", "setGlobal": { "raid_clock": "t0200" } },
            { "eventPattern": "game_loaded", "condition": "globalVars.door_scene_done === true && globalVars.gate_console_used === true && globalVars.raid_clock < 't0200'", "setGlobal": { "raid_clock": "t0200" } },
            { "eventPattern": "global_variable_changed:split_started", "condition": "value === true && globalVars.raid_clock < 't0200'", "setGlobal": { "raid_clock": "t0200" } },
            { "eventPattern": "conversation_closed:director_netherton", "condition": "globalVars.split_started === true && !globalVars.arakawa_ko && globalVars.raid_clock < 't0210'", "setGlobal": { "raid_clock": "t0210" } },
            { "eventPattern": "global_variable_changed:pair_back", "condition": "value === true && globalVars.raid_clock < 't0220'", "setGlobal": { "raid_clock": "t0220" } },
            { "eventPattern": "global_variable_changed:breach_open", "condition": "value === true && globalVars.raid_clock < 't0230'", "setGlobal": { "raid_clock": "t0230" } },
            { "eventPattern": "global_variable_changed:gallery_open", "condition": "value === true && globalVars.raid_clock < 't0345'", "setGlobal": { "raid_clock": "t0345" } },
            { "eventPattern": "global_variable_changed:head_start_out", "condition": "globalVars.raid_clock < 't0400'", "setGlobal": { "raid_clock": "t0400" } },
            <%# Ruling 16 (stage 8 M-3): t0600 on six_done, never on the 06:00 scene's open. %>
            { "eventPattern": "global_variable_changed:six_done", "condition": "value === true && globalVars.raid_clock < 't0600'", "setGlobal": { "raid_clock": "t0600" } },
<%# --- VM flags: each station's emit_event reward sets its global; the task's completion is the fallback --- %>
<% (1..4).each do |n| %>
            { "eventPattern": "flag_<%= n %>_in", "condition": "!globalVars.flag<%= n %>_submitted", "setGlobal": { "flag<%= n %>_submitted": true } },
