          "voice": <%= voice.(:vos) %>,
          "unlockable": ["core"],
          "behavior": { "initiallyHidden": true, "hostile": { "chaseSpeed": 110, "attackDamage": 6, "pauseToAttack": true } },
          "itemsHeld": [
            { "type": "notes", "id": "vos_code_card", "name": "Visitor's Code Card", "takeable": true, "readable": true, "text": "TOMB GAMMA. VISITOR: ZERO DAY.\nOuter lock: <%= outer_lock_pin %>.\nTonight only.", "puzzle_graph_role": "clue", "puzzle_graph_unlocks": "core", "puzzle_graph_optional": true }
          ],
          "eventMappings": [
            <%= after_end_json.('gallery') %>
            { "eventPattern": "room_entered:gallery", "condition": "globalVars.m03_victoria_fate !== 'recruited' && globalVars.m03_victoria_fate !== 'escaped' && !globalVars.closing_done", "setVisible": true }
          ],
          "observations": "Pieter Vos by the slit windows with a briefcase at his feet, checking his watch against the lock panel."
        },
        {
          "_comment": "Sione Fonoti, the lock guard (S6 2.4). His cone is drawn so the player can see when the keypad is clear. challengeOnSight is scoped to the keypad (requireGlobal at_keypad) and skips once he has challenged (R3-M1: not outer_lock_open, which a crack sets before his check). Sight isn't checked during a minigame; a sighting that holds as the cracker closes fires then.",
          "id": "lock_guard",
          "displayName": "Sione Fonoti",
          "npcType": "person",
          <%# Dressing R3 G1: was (7, 4) patrolling to (2, 4), through the standing row every lap; the beat is now the east half, behind the lock party (7.9, 3.4) <-> (6.2, 3.4) (8.4 fell outside the gallery's pathfinding bounds, tiles x 2-8, and was dropped), with the long dwell at the west end, his back to the keypad. %>
          "position": { "x": 7.9, "y": 3.4 },
          "spriteSheet": "sione_fonoti",
          "spriteTalk": "assets/characters/sione_fonoti_talk.png",
          "spriteVisemes": "assets/characters/sione_fonoti_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/m10_full_disclosure/ink/m10_fonoti.json",
          "currentKnot": "talk",
          "voice": <%= voice.(:fonoti) %>,
          "globalVarOnKO": "fonoti_ko",
          "itemsHeld": [
            { "type": "notes", "id": "gallery_code_card", "name": "Gallery Shift Code Card", "takeable": true, "readable": true, "text": "TOMB GAMMA. GALLERY, NIGHT SHIFT.\nOuter lock: <%= outer_lock_pin %>.\nThis card stays on the walkway.", "onPickup": { "setVariable": { "lock_guard_known": true, "lock_guard_stood_down": true } }, "puzzle_graph_role": "clue", "puzzle_graph_unlocks": "core", "puzzle_graph_optional": true }
          ],
          "behavior": {
            "hostile": { "chaseSpeed": 125, "attackDamage": 14, "pauseToAttack": true, "fightStyle": "slugger", "maxHP": 140 },
            "patrol": { "enabled": true, "speed": 45, "waypoints": [{ "x": 7.9, "y": 3.4, "dwellTime": 3000 }, { "x": 6.2, "y": 3.4, "dwellTime": 20000 }], "loop": true, "pauseForPlayer": false }
          },
          "los": {
            "enabled": true, "range": 160, "angle": 100, "visualize": true,
            "challengeOnSight": { "cooldown": 15000, "rooms": ["gallery"], "requireGlobal": "at_keypad", "skipIfGlobal": ["lock_guard_challenged", "lock_guard_stood_down", "outer_lock_open"] }
          },
          "eventMappings": [
            <%= after_end_json.('gallery') %>
            { "eventPattern": "door_unlock_attempt", "condition": "data.connectedRoom === 'core'", "cooldown": 0, "setGlobal": { "at_keypad": true } },
            <%# Confirmation run: his own handover ("Go on through") sets only an ink-local flag, so the card's onPickup and this net set lock_guard_known and his challenge stands down. %>
            { "eventPattern": "item_picked_up:notes", "condition": "data.itemId === 'gallery_code_card' && !globalVars.lock_guard_stood_down", "setGlobal": { "lock_guard_known": true, "lock_guard_stood_down": true } },
