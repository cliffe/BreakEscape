    end
  end
  v << { 'condition' => "globalVars.raid_clock === 't0600'", 'value' => "RELEASE 06:00 UTC · NOW 06:00\nRELEASE: DISARMED. NOTHING WENT AT SIX." }
  [["globalVars.head_start_out === 'none'", 'NOTHING TO RELEASE · NOW 04:00'],
   ["globalVars.head_start_out !== 'none'", 'EARLY ACCESS: RELEASED · NOW 04:00']].each do |hcond, line1|
    zd_word_after.each do |zd, zw|
