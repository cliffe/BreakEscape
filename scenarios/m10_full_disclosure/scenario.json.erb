        v << { 'condition' => "globalVars.raid_clock === 't0400' && #{hcond} && globalVars.share_zero_day === '#{zd}' && globalVars.share_resale === '#{rs}'",
               'value' => "#{line1}\nZERO DAY: #{zw}\nSECOND BUYER: #{rw}" }
      end
    end
  end
  v << { 'condition' => "globalVars.raid_clock === 't0400'", 'value' => 'EARLY ACCESS: RELEASED · NOW 04:00' }
  %w[t0330 t0345].each do |t|
    zd_word_before.each do |zd, zw|
      resale_before.each do |rs, rw|
        v << { 'condition' => "globalVars.flag2_submitted === true && globalVars.raid_clock === '#{t}' && globalVars.share_zero_day === '#{zd}' && globalVars.share_resale === '#{rs}'",
               'value' => "#{clock_line1.(t)}\nZERO DAY: #{zw}\nSECOND BUYER: #{rw}" }
      end
    end
  end
  clock_times.keys.reject { |t| t == 't0145' }.each do |t|
    v << { 'condition' => "globalVars.raid_clock === '#{t}'", 'value' => clock_line1.(t) }
  end
  v
end

