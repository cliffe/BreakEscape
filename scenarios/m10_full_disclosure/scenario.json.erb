# Impl R1 minor 6: the copy must match credits_sections.json (checked when the
# file is reachable from the working directory, as for the validator and Rails).
credits_src = 'scenarios/m10_full_disclosure/credits_sections.json'
if File.exist?(credits_src)
  src = JSON.parse(File.read(credits_src))
  %w[safetynet safetynet_join in_memory].each do |k|
    raise "m10: credits_fragment['#{k}'] differs from #{credits_src}" unless src[k] == credits_fragment[k]
  end
end
safetynet_name = {
  'DIRECTOR MAGNUS NETHERTON' => 'DIRECTOR MAGNUS NETHERTON', 'AGENT HAX' => 'AGENT HAX',
  'MARISOL QUINTERO' => "AGENT 0x2D 'ANCHOR'", 'HALINA KOWALCZYK' => "HALINA KOWALCZYK, 'WREN'",
  'OFFICER DEV MALHOTRA' => 'OFFICER DEV MALHOTRA', 'OFFICER KENJI ARAKAWA' => 'OFFICER KENJI ARAKAWA',
  "AGENT 0x23 'VECTOR'" => "AGENT 0x23 'VECTOR'", "AGENT 0x88 'PHANTOM'" => "AGENT 0x88 'PHANTOM'"
}
credits_for = lambda do |ending|
  join = ending == 'joined'
  c = []
  if join
    c << cl.('MISSION FAILED', nil, 'title')
    c << cl.('FULL DISCLOSURE', nil, 'subtitle')
    c << { 'text' => '' }
    c << cl.('THE PUBLICATION: RELEASED BY KEY. ALL CITIES, ONE MINUTE.', nil, w)
    c << cl.('PROJECTED DEATHS, FIRST THIRTY DAYS: 1,100 TO 2,600. HIS FIGURE.', nil, w)
    c << cl.('CORRECTED: 2,100 TO 3,600.', nil, w)
    c << { 'text' => '' }
  else
    c << cl.('MISSION COMPLETE', nil, 'title')
    c << cl.('AGENT 0x00: IN CUSTODY', nil, w) if ending == 'executed'
    c << cl.('AGENT 0x00: SUSPENDED', nil, w) if ending == 'scorched'
    c << cl.('FULL DISCLOSURE', nil, 'subtitle')
    c << { 'text' => '' }
  end
  # Alignment R1 m4, R2-m14: one entry per SAFETYNET person. Order: their
  # SAFETYNET conditional clauses, then their IN THIS OPERATION conditional
  # clauses, then the SAFETYNET default; they leave IN THIS OPERATION.
  # credits_sections.json is unchanged (the drift check still holds).
  ito = in_this_operation.(ending)
  sn = JSON.parse(JSON.generate(credits_fragment[join ? 'safetynet_join' : 'safetynet']))
  sn_names = sn['people'].map { |pp| pp['name'] }
  ito['people'] = ito['people'].reject do |pp|
    target = safetynet_name[pp['name']]
    next false unless target && sn_names.include?(target)
    entry = sn['people'].find { |q| q['name'] == target }
    sn_cond = entry['clauses'].select { |cc| cc['condition'] }
    sn_default = entry['clauses'].reject { |cc| cc['condition'] }
    entry['clauses'] = sn_cond + pp['clauses'].select { |cc| cc['condition'] } + sn_default
    true
  end
  c << ito
  c << the_cells unless join
  # ELSEWHERE: three movements in order; Join keeps movement 1 only (W-21).
  c << { 'section' => 'ELSEWHERE', 'lines' => join ? elsewhere_one : elsewhere_one + elsewhere_two + elsewhere_three }
  c << sn
  c << credits_fragment['in_memory']
  c
end
