            { "eventPattern": "room_entered:server_hall", "condition": "globalVars.m07_mercer_ko === true && !globalVars.closing_done", "setVisible": true },
            { "eventPattern": "room_entered:server_hall", "condition": "globalVars.m07_mercer_fate === 'arrested' && !globalVars.closing_done", "setVisible": true }
