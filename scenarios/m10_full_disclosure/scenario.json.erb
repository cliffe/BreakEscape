            { "eventPattern": "room_entered:core", "condition": "globalVars.quintero_enters_core === true && !globalVars.quintero_ko && !globalVars.closing_done", "setVisible": true }
          ],
          "observations": "Quintero at the outer lock's inner side, keeping the door."
        }
      ],
      "objects": [
        {
          "type": "hq_console1",
