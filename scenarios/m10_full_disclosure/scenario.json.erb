<%
# --- The raid team's bunker copies (RL 2.9): one copy per person per room. ----
# Each reveals itself on room_entered:<its room>, one mapping per arm, carrying
# its person's guards; each hides itself when its person is sent back, and
# Kowalczyk's when she is named or goes ahead (after the conversation closes:
# delayMs waits for any open minigame). Field copies are knockable.
raid = {
  'kowalczyk' => { name: "Agent 0x5E 'Lantern'", sprite: 'halina_kowalczyk', ink: 'm10_kowalczyk.json', voice: :kowalczyk },
  'quintero'  => { name: "Agent 0x2D 'Anchor'",  sprite: 'marisol_quintero',       ink: 'm10_quintero.json',  voice: :quintero },
  'arakawa'   => { name: 'Officer Kenji Arakawa', sprite: 'kenji_arakawa',         ink: 'm10_arakawa.json',   voice: :arakawa }
}
raid_guard = lambda do |p|
  g = "globalVars.breach_open === true && !globalVars.#{p}_ko && globalVars.officer_out !== '#{p}'"
  # Walkthrough R1b-M3: never again once she has come through his door.
  g += " && globalVars.whodunit_live === true && globalVars.accused !== 'kowalczyk' && !globalVars.kowalczyk_gone_ahead && !globalVars.wren_entering && !globalVars.wren_at_core && globalVars.ending === ''" if p == 'kowalczyk'
  g
end
raid_copy = lambda do |p, id, room, knot, x, y, arms, look|
  r = raid[p]
  maps = after_end.(room)
  maps += arms.map do |arm|
    m = { 'eventPattern' => "room_entered:#{room}", 'condition' => [raid_guard.(p), arm, '!globalVars.closing_done'].compact.join(' && '), 'setVisible' => true }
    # Playtest B-03: a raid copy standing in the hall lets the player call the team up (ink: hall_team_present). HaX clears it first on entry and on leaving.
    m['setGlobal'] = { 'hall_team_present' => true } if room == 'server_hall'
    m
  end
  # Walkthrough R1 m-3: gone when the player moves on, as vector_so (they are "a room ahead").
  maps << { 'eventPattern' => 'room_exited', 'condition' => "data.roomId === '#{room}'", 'setVisible' => false }
  maps << { 'eventPattern' => 'global_variable_changed:officer_out', 'condition' => "value === '#{p}'", 'setVisible' => false, 'delayMs' => 500 }
  if p == 'kowalczyk'
    maps << { 'eventPattern' => 'global_variable_changed:accused', 'condition' => "value === 'kowalczyk'", 'setVisible' => false, 'delayMs' => 500 }
    maps << { 'eventPattern' => 'global_variable_changed:kowalczyk_gone_ahead', 'condition' => 'value === true', 'setVisible' => false, 'delayMs' => 500 }
    maps << { 'eventPattern' => 'global_variable_changed:wren_entering', 'condition' => 'value === true', 'setVisible' => false }
  end
  {
    'id' => id, 'displayName' => r[:name], 'npcType' => 'person',
    'position' => { 'x' => x, 'y' => y }, 'spriteSheet' => r[:sprite],
    'spriteTalk' => "assets/characters/#{r[:sprite].sub('_v2', '')}_talk.png", 'spriteVisemes' => "assets/characters/#{r[:sprite].sub('_v2', '')}_visemes.png",
    'spriteConfig' => { 'idleFrameRate' => 6, 'walkFrameRate' => 10 },
    'storyPath' => "scenarios/m10_full_disclosure/ink/#{r[:ink]}", 'currentKnot' => knot,
    'voice' => voices.fetch(r[:voice]), 'globalVarOnKO' => "#{p}_ko",
    'behavior' => { 'initiallyHidden' => true, 'hostile' => { 'chaseSpeed' => 120, 'attackDamage' => 8, 'pauseToAttack' => true } },
    'eventMappings' => maps, 'observations' => look
  }.to_json
end
