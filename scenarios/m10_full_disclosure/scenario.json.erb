          "text": "RELEASE SERVICE. OPERATOR ON SHIFT.\nHost: <%= release_host_ip %>\nRelease service login: <%= release_login_user %>\nPassword: <%= release_login_password %>\nSign the log at handover.",
          "puzzle_graph_role": "key",
          "puzzle_graph_unlocks": "sealed_hatch"
