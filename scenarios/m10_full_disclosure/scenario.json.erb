            { "condition": "globalVars.flag2_submitted === true", "value": "The staging copy of the release schedule, open on the screen now." }
          ],
          "text": "",
          "textVariants": [
<% f2 = 'globalVars.flag2_submitted === true && '
   sched = []
   [['recruited', 'V. STERLING'], ['escaped', 'V. STERLING']].each do |fate, who|
     sched << ["#{f2}globalVars.m03_victoria_fate === '#{fate}' && globalVars.m07_team_redirected === true", schedule.('small', who)]
