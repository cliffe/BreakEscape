        {
          "id": "quintero_core",
          "displayName": "Agent 0x2D 'Anchor'",
          "npcType": "person",
          "position": { "x": 5, "y": 7 },
          "spriteSheet": "marisol_quintero",
          "spriteTalk": "assets/characters/marisol_quintero_talk.png",
          "spriteVisemes": "assets/characters/marisol_quintero_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/m10_full_disclosure/ink/m10_quintero.json",
          "currentKnot": "core",
          "voice": <%= voice.(:quintero) %>,
          "globalVarOnKO": "quintero_ko",
