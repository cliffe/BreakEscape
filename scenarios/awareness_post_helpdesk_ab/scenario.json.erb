            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "quayholt.example",
              "replyTo": "it-notices@quayholt.example"
            },
            "truth": {
              "isPhish": false,
              "flags": [],
              "whyFine": {
                "linkCredible": "The link goes where it says, to Quayholt's own service desk site.",
                "urgencyCalibrated": "Bookings open a week ahead, with no deadline pushing anyone.",
                "default": "IT's real address, a planned rollout, and a line saying nobody needs to share a password."
              }
            }
          },
          {
            "id": "hb_coo_reset_bypass",
            "from": {
              "name": "Patrick Kerrigan",
              "address": "patrick.kerrigan.coo@quickpost-mail.example"
            },
            "to": "servicedesk@quayholt.example",
            "subject": "Reset my password and send it here",
            "time": "09:05",
            "body": "I'm locked out and boarding in twenty minutes. Reset my Quayholt password and send the new one to this address. Keep it off the ticket system, it's a sensitive week, and there's no need to ring me.\nPatrick\nSent from my phone",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "quickpost-mail.example",
              "replyTo": "patrick.kerrigan.coo@quickpost-mail.example"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "senderTrust",
                "secrecy_or_bypass",
                "urgencyCalibrated"
              ],
              "perFlagNote": {
                "senderTrust": "The chief operating officer's name on a personal inbox at quickpost-mail.example, not quayholt.example",
                "secrecy_or_bypass": "'Keep it off the ticket system' and 'no need to ring me' remove the record and the check",
                "urgencyCalibrated": "'Boarding in twenty minutes' leaves no time to ring him"
              },
              "headerNote": "The automatic checks pass because the message really was sent from quickpost-mail.example. A pass tells you which mail system sent it, not that it's Patrick.",
              "ifTrusted": "A new password would go to whoever owns that inbox, and they would be in Patrick's account.",
              "reportReply": "Thanks. Patrick didn't send it. His real address is on quayholt.example."
            }
          },
          {
            "id": "hb_resets_spoof",
            "from": {
              "name": "Security Review",
              "address": "reviews@quayholt-team.example"
            },
            "to": "servicedesk@quayholt.example",
            "subject": "This week's password resets",
            "time": "10:12",
            "body": "Hi,\nFor a review I'm running, could you reply with this week's password resets: name, team and the phone number each person gave? A pasted list is fine.\nThanks,\nSecurity Review",
            "auth": {
              "spf": "pass",
              "dkim": "pass",
              "dmarc": "pass",
              "envelopeFrom": "quayholt-team.example",
              "replyTo": "reviews@quayholt-team.example"
            },
            "truth": {
              "isPhish": true,
              "flags": [
                "senderTrust",
                "lookalike_domain"
              ],
              "flagAlternatives": [
                [
                  "senderTrust",
                  "lookalike_domain"
                ]
              ],
              "perFlagNote": {
                "senderTrust": "A review like this would come from a Quayholt address the desk already knows, not from a sender nobody has dealt with",
                "lookalike_domain": "Read the address: it ends in quayholt-team.example, not quayholt.example. The added '-team' makes a separate domain anyone can register"
              },
              "ifTrusted": "A list of who was reset, and the numbers they gave, tells an attacker who to impersonate next and how.",
              "reportReply": "Thanks. That address isn't ours, and no review asked for that list. We've blocked quayholt-team.example."
            }
          },
          {
            "id": "hb_hr_relay",
