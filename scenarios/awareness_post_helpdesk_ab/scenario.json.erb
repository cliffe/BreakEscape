            "transcript": [
              {
                "who": "Reuben",
                "text": "Hi, Reuben in Claims. My laptop says my account's locked. I'm in the office all day, so ring me back on 4423 when you get a chance. It's in the directory. Cheers."
              }
            ],
            "truth": {
              "isPhish": false,
              "flags": [],
