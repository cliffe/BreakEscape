#                                  dropped on a KO (PASS 5: three lockers; 0x47 holds the stick)
#   (print)  the USB stick in the locker carries Nightshade's thumbprint (PASS 4): the
#            start-kit fingerprint kit lifts it (optional; confrontation line + credit)
#
# CLOCK (PASS 3): the Citadel keeps UTC and SAFETYNET logs print UTC. T-0, the
# Portland order, is 10:41 UTC (m07). The plan was opened D-2 10:38-11:25 UTC.
#
# WIN CONDITION (PASS 2, PASS 5 Option B): all four flags in AND the mole named
# (mole_identified) -> the confrontation opens as a
# disableClose cutscene on entering the interrogation room; the fate choice is
# made in that ink (nightshade_arrested XOR nightshade_triple_agent, fate_decided,
# decide_the_fate). The disposition screen on the wall only DISPLAYS the outcome.
# The old terminal's triggerOnInteract used {"task": ...} where applyActions
# reads action.taskId, so decide_the_fate could never complete, and it could be
# pressed before the confrontation had happened. A KO of the confrontation NPC
# resolves the fate to a handover via an npc_ko mapping on HaX.
# The debrief lives in main_lobby (always loaded; lesson 43) and opens on the
# confrontation closing or any room entry once fate + all four flags are in.
# See PASS2_IMPROVEMENTS.md.
# ============================================================================

require 'base64'

def base64_encode(text)
  Base64.strict_encode64(text)
end

def rot13(text)
  text.tr('A-Za-z', 'N-ZA-Mn-za-m')
end

# --- Secrets -----------------------------------------------------------------
# Director's safe. The Director's own service number. It is printed in the
# "requested by" line of the personnel printout on the ops floor, and the
# printout's margin note says everyone uses their service number on their safe.
# (PASS 2: it used to be Nightshade's service number opening Netherton's safe.)
safe_pin = "2407"
nightshade_service_no = "4719"
# PASS 5 (M1): the printout lists all three suspects.
vector_service_no = "3318"
phantom_service_no = "5562"

# Security Archives door. On the break-room post-it only; ATHENA hints at where
# facilities keep it and never reads it out (PASS 3).
archives_password = "TrustNoOne"

# Interrogation suite keypad (PASS 3, P4). One source: the room's requires, the
# code card in the Director's safe and the synced global suite_code (which
# Netherton's ink prints) all render this value.
# Keep it a fixed constant: do not mark it @random_pin or randomise it.
# Netherton speaks it in voiced ink (m08_director_netherton.ink, {suite_code}),
# and TTS caches audio by text, so a per-game code would never hit the cache.
suite_code = "5386"

# Visitor badge printer at reception (second route to the server room). The
# facilities post-it in the break room carries it.
badge_pin = "0311"

# Nightshade's sent mail, on a USB stick in his break-room locker (PASS 3):
# Base64, then ROT13. The player decodes it at the Crypto Lab's CyberChef
# workstation.
backup_plain = "SENT -- To: architect@entropy.onion  From: nightshade_deep_state. Package delivered: deployment, timeline, agent ID, all confirmed. Your coordination held. They spent the night choosing which fire to fight and never saw the vault open behind them. I know what the unanswered sites cost. You do not need to tell me the number. I made the trade with my eyes open. Order is a candle in a hurricane; I would rather help the wind than keep relighting the wick. Awaiting next tasking. -- N"
