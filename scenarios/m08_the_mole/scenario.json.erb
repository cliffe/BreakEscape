<%
# ============================================================================
# MISSION 8: THE MOLE - SCENARIO FILE
# ============================================================================
# Break Escape - Season 1: The Architect's Shadow
#
# Rebuilt to the current schema (m07 house style). The authoritative identifier
# contract for this mission is CONTRACT.md (to be written in WP2). Anything in
# this file that names an NPC, room, object, global, flag, task or ink knot is
# fixed there. Do not rename without updating that file.
#
# CONTINUITY: this mission opens on the m07 closer. m07's last lore drop
# (mole_intercept_evidence) reads: "The leak was not the operation timing. The
# leak was the agent." M08 finds out who. The traitor is Agent 0x47 Nightshade,
# an ideological convert who traded the lives lost in m07 for ENTROPY's cause.
#
# VM: SecGen "Such a git" (SecGen/scenarios/ctf/such_a_git.xml). GitList 0.4.0
# argument-injection RCE (no creds) -> stashed username/password -> proper login
# for a home-directory flag -> sudo apt-get -> root. SecGen system_name for the
# target is `safetynet_gitlist_server`. Four flags; the fallback strings below are placeholders
# for standalone/dev render -- the real per-build flags arrive via vm_context in
# Hacktivity mode. FLAG ORDER against flags_by_vm['safetynet_gitlist_server'] STILL NEEDS
# VERIFICATION against a real build (see ALIGNMENT_PLAN Open Decisions).
#
# ROOM LAYOUT (grid units; door sides verified by predict_door_sides.py):
#
#                 [Intel Analysis]      [Server Room] (rfid)
#                        |                     |
#   [Break Room]--[Crypto Lab]--[Main Lobby]--[Ops Floor]
#                        |             |            |
#   [Interrogation](key) |    [Director's Office]   [Security Archives](password)
#
#   Connections (all reciprocal):
#     main_lobby        N director_office  E operations_floor  W cryptography_lab
#     operations_floor  N intel_analysis   E server_room       S security_archives
#     cryptography_lab  S interrogation_room  W break_room
#
# LOCK CHAIN - every gate has a redundant source so no KO strands the run:
#   rfid     server_room        <- Director Netherton's keycard   | badge printer (lobby, PIN on the break-room post-it)
#   password security_archives  <- post-it in break room      | ATHENA log query (lobby)
#   pin      director_safe       <- the Director's service number, printed as
#                                   "requested by" on the ops-floor personnel
#                                   printout (ATHENA and HaX point at it)
#   key      interrogation_room  <- key inside director_safe    | lockpick (start inventory)
#
# WIN CONDITION (PASS 2): all four flags in -> the confrontation opens as a
# disableClose cutscene on entering the interrogation room; the fate choice is
# made in that ink (nightshade_arrested XOR nightshade_triple_agent, fate_decided,
# decide_the_fate). The disposition screen on the wall only DISPLAYS the outcome.
# The old terminal's triggerOnInteract used {"task": ...} where applyActions
# reads action.taskId, so decide_the_fate could never complete, and it could be
# pressed before the confrontation had happened. A KO of the confrontation NPC
# resolves the fate to a handover via an npc_ko mapping on HaX.
# The debrief lives in main_lobby (always loaded; lesson 43) and opens on the
# confrontation closing or any room entry once fate + all four flags are in.
# See PASS2_IMPROVEMENTS.md.
# ============================================================================

require 'base64'

def base64_encode(text)
  Base64.strict_encode64(text)
end

def rot13(text)
  text.tr('A-Za-z', 'N-ZA-Mn-za-m')
end

# --- Secrets -----------------------------------------------------------------
# Director's safe. The Director's own service number. It is printed in the
# "requested by" line of the personnel printout on the ops floor, and the
# printout's margin note says everyone uses their service number on their safe.
# (PASS 2: it used to be Nightshade's service number opening Netherton's safe.)
safe_pin = "2407"
nightshade_service_no = "4719"

# Security Archives door. On the break-room post-it; ATHENA reads it from the
# facilities log as the redundant source.
archives_password = "TrustNoOne"

# Visitor badge printer at reception (second route to the server room). The
# facilities post-it in the break room carries it.
badge_pin = "0311"

# Nightshade's sent mail, as he left it on his own desk: Base64, then ROT13.
# The player decodes it at the Crypto Lab's CyberChef workstation.
backup_plain = "SENT -- To: architect@entropy.onion  From: nightshade_deep_state. Package delivered: assignments, timeline, agent ID, all confirmed. Your coordination held. They spent the night choosing which fire to fight and never saw the vault open behind them. I know what the two unanswered sites cost. You do not need to tell me the number. I made the trade with my eyes open. Order is a candle in a hurricane; I would rather help the wind than keep relighting the wick. Awaiting next tasking. -- N"
%>
{
  "scenario_brief": "Nine days ago four ENTROPY operations went live inside the same minute, and one of them cost lives. Since that night you have known why. An intercept pulled off the wire was timestamped before the deployment order was ever written -- which means ENTROPY did not guess where SAFETYNET would send you. Somebody told them. The leak was not the operation. The leak was the agent. Director Netherton has pulled you back to the Citadel, SAFETYNET's own headquarters, and handed you three names. One of them has been feeding the people who got your colleagues killed. Find the mole. Do it quietly -- the moment they know you are looking, they are gone.",

  "show_scenario_brief": "on_resume",

  "startRoom": "main_lobby",

  "flags": {
    "safetynet_gitlist_server": <%= vm_flags_json('safetynet_gitlist_server', ['flag{gitlist_argument_injection}', 'flag{stashed_credentials_recovered}', 'flag{home_directory_access}', 'flag{root_via_sudo_apt}']) %>
  },

  "narrator": {
    "id": "narrator",
    "skipTextValidation": true,
    "voice": {
      "name": "Algenib",
      "style": "Cinematic thriller narrator. Consistent British Received Pronunciation accent throughout -- do not shift to any other accent. Low, unhurried, careful. A building full of people who have stopped trusting each other, and one of them is guilty.",
      "language": "en-GB"
    }
  },

<%# Dynamic music. Structure copied from m07 / m02. Beat map:
      arrival, paranoid HQ ......... noir       (game_loaded, brief not done)
      investigation underway ....... noir       (game_loaded, brief done)
      the repo cracks open ......... tension    (flag2_submitted -- creds recovered)
      evidence closes on Nightshade  threat     (all_flags_submitted / mole_identified)
      the interrogation room ....... spy-action (room_entered:interrogation_room)
      debrief closes ............... victory + credits
    'victory' auto-opens the Bond Visualiser, so it is held to the debrief
    actually finishing -- the m01/m02/m07 pattern. %>
  "music": {
    "events": [
      { "trigger": "game_loaded", "condition": "!globalVars.briefing_played", "playlist": "cutscene", "fade": false },
      { "trigger": "game_loaded", "condition": "globalVars.briefing_played === true", "playlist": "noir", "fade": false },
      { "trigger": "global_variable_changed:flag2_submitted", "condition": "value === true", "playlist": "tension" },
      { "trigger": "global_variable_changed:mole_identified", "condition": "value === true", "playlist": "threat" },
      { "trigger": "room_entered:interrogation_room", "condition": "globalVars.all_flags_submitted === true && !globalVars.fate_decided", "playlist": "spy-action" },
<%# PASS 2: was "conversation_ended:m08_closing_debrief", an event nothing
    emits, so the victory track and the bond visualiser never ran and there were
    no credits at all. Now the m07 shape: conversation_closed on the debrief NPC,
    with credits that read back the player's choices. %>
      {
        "trigger": "conversation_closed:closing_debrief",
        "playlist": "victory",
        "autoStop": true,
        "disableClose": true,
        "fade": true,
        "credits": [
          { "text": "MISSION COMPLETE", "style": "title" },
          { "text": "THE MOLE", "style": "subtitle" },
          { "text": "" },
          { "text": "THE LEAK: Agent 0x47 'Nightshade', placed by ENTROPY during training and dormant for fifteen years", "style": "entry" },
          { "text": "" },
          { "text": "── THE FATE ──", "style": "section-header" },
          { "text": "NIGHTSHADE: Handed to the police with the full case file. No deal.", "style": "entry", "condition": "globalVars.nightshade_arrested && !globalVars.nightshade_confront_ko" },
          { "text": "NIGHTSHADE: Knocked down before he could answer, then handed to the police. No deal.", "style": "warning", "condition": "globalVars.nightshade_confront_ko" },
          { "text": "NIGHTSHADE: Left in place as a triple agent, on the Director's signature", "style": "warning", "condition": "globalVars.nightshade_triple_agent" },
          { "text": "TOMB GAMMA: Coordinates given up in the interrogation room -- Montana", "style": "entry", "condition": "globalVars.tomb_gamma_location_known" },
          { "text": "TOMB GAMMA: Named, not located -- the coordinate is still in Nightshade's head", "style": "warning", "condition": "!globalVars.tomb_gamma_location_known" },
          { "text": "" },
          { "text": "── THE SUSPECTS ──", "style": "section-header" },
          { "text": "CIPHER: Accused to his face, then cleared by the logs", "style": "warning", "condition": "globalVars.accused_cipher && !globalVars.cipher_ko" },
          { "text": "CIPHER: Knocked out. Innocent.", "style": "warning", "condition": "globalVars.cipher_ko" },
          { "text": "CIPHER: Cleared on the evidence. His post-quantum work goes on.", "style": "entry", "condition": "!globalVars.accused_cipher && !globalVars.cipher_ko" },
          { "text": "PHANTOM: Accused to his face, then cleared by a flight manifest", "style": "warning", "condition": "globalVars.accused_phantom && !globalVars.phantom_ko" },
          { "text": "PHANTOM: Knocked out mid-hunt. Innocent, and the only other person looking.", "style": "warning", "condition": "globalVars.phantom_ko" },
          { "text": "PHANTOM: Cleared. His off-book hunt pointed the right way.", "style": "entry", "condition": "!globalVars.accused_phantom && !globalVars.phantom_ko" },
          { "text": "YOUR FIRST CALL TO THE DIRECTOR: Nightshade", "style": "entry", "condition": "globalVars.suspect_theory === 'nightshade'" },
          { "text": "YOUR FIRST CALL TO THE DIRECTOR: Cipher -- wrong, and corrected", "style": "warning", "condition": "globalVars.suspect_theory === 'cipher'" },
          { "text": "YOUR FIRST CALL TO THE DIRECTOR: Phantom -- wrong, and corrected", "style": "warning", "condition": "globalVars.suspect_theory === 'phantom'" },
          { "text": "" },
          { "text": "── RECOVERED ──", "style": "section-header" },
          { "text": "SEALED PSYCH EVALUATION: Read. The warning was in writing a year ago.", "style": "entry", "condition": "globalVars.found_nightshade_profile" },
          { "text": "'DEEP STATE' RECRUITMENT BRIEF: Recovered from his desk", "style": "entry", "condition": "globalVars.found_deep_state_manual" },
          { "text": "GLOBAL THREAT DATABASE: Confirmed stolen during the four-site night", "style": "warning", "condition": "globalVars.database_theft_understood" },
          { "text": "" },
          { "text": "── ON THE RECORD ──", "style": "section-header" },
          { "text": "AGENT 0x00 TO THE DIRECTOR: He's the crime, not you", "style": "entry", "condition": "globalVars.debrief_stance === 'defended'" },
          { "text": "AGENT 0x00 TO THE DIRECTOR: Own the gap", "style": "entry", "condition": "globalVars.debrief_stance === 'owned'" },
          { "text": "DIRECTOR NETHERTON: Knocked down in his own office. He did not mention it again.", "style": "warning", "condition": "globalVars.netherton_ko" },
          { "text": "" },
          { "text": "THE ARCHITECT: At large, with every weakness SAFETYNET ever catalogued.", "style": "warning" },
          { "text": "ENTROPY: Still operational.", "style": "warning" }
        ]
      }
    ]
  },

  "startItemsInInventory": [
