    "intel_analysis": {
      "type": "room_control_1x2gu",
      "door_sign": "Intelligence Analysis",
      "connections": { "south": "operations_floor" },
      "npcs": [
        {
          "_comment": "Agent Phantom -- red herring. The 'suspicious' behaviour is an off-books mole hunt of his own. globalVarOnKO wired; optional; clears from evidence.",
          "id": "agent_phantom",
          "displayName": "Agent 0x88 'Phantom'",
          "npcType": "person",
          "position": { "x": 5.0, "y": 4.3 },
          "spriteSheet": "male_spy_v2",
          "spriteTalk": "assets/characters/male_spy_talk.png",
          "spriteVisemes": "assets/characters/male_spy_visemes.png",
          "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 },
          "storyPath": "scenarios/m08_the_mole/ink/m08_suspect_phantom.json",
          "voice": {
            "name": "Fenrir",
            "style": "A charismatic field coordinator who is running his own unauthorised investigation and enjoying being underestimated. Consistent British Received Pronunciation accent throughout -- do not shift to any other accent. Warm, quick, deflects with charm, keeps turning your questions back on you -- which is exactly why he is on the suspect list.",
            "language": "en-GB"
          },
          "currentKnot": "start",
          "globalVarOnKO": "phantom_ko",
          <%# PASS 2 review (lesson 27): the interview task completes only once the brief is taken. %>
          "eventMappings": [
            {
              "eventPattern": "global_variable_changed:phantom_interviewed",
              "condition": "value === true && globalVars.brief_taken === true",
              "onceOnly": true,
              "completeTask": "interview_phantom"
            },
            {
              "eventPattern": "global_variable_changed:brief_taken",
              "condition": "value === true && globalVars.phantom_interviewed === true",
              "onceOnly": true,
              "completeTask": "interview_phantom"
            }
          ],
          "observations": "Phantom works a wall of tactical feeds with a coffee going cold beside him. He clocks you the second you enter, and smiles like he was expecting you."
        }
      ],
      "objects": [
        {
          "type": "chart",
          "id": "tactical_board",
          "name": "Four-Site Night Tactical Board",
          "takeable": false,
          "readable": true,
          "observations": "The tactical board from the night of the four attacks, still up. Somebody could not bring themselves to take it down.",
          "observationDisplay": "gameDisplay",
          "text": "FOUR SITES, ONE TEAM -- AFTERMATH\n\nFour simultaneous operations. One tactical team, committed to one. Two crises went unanswered because ENTROPY knew, in advance, exactly where our people would and would not be.\n\nOF THE TWO UNANSWERED:\n  - Confirmed dead: 2 SAFETYNET field agents, plus civilians at both sites.\n  - The agent on the ground was compromised before deployment.\n\nENTROPY did not out-think us. They were told. Everything on this board -- the assignments, the timing, the agent -- was in the leak.\n\nHandwritten, Phantom's pen: 'Two of ours. HOW DID THEY KNOW.'",
          "puzzle_graph_role": "clue",
          "puzzle_graph_reveals": "the_leak_got_people_killed"
        },
        {
          "type": "notes",
          "id": "phantom_notes",
          "name": "Phantom's Off-Book Notes",
          "takeable": true,
          "readable": true,
          "observations": "A private notebook Phantom did not quite hide.",
          "observationDisplay": "gameDisplay",
          "text": "MINE. Not for the file.\n\nThe leak had planning access + timing + the agent's ID. That's a very short list.\nTracked server auth: someone's been in mission_planning from a Crypto Lab terminal at hours nobody's rostered.\nNetherton won't give me the suspect list, so I'm building my own. If I'm on it -- fine. I'd put me on it too.\n\nWhoever it is: they didn't do it for money. Money leaves a trail. This is someone who thinks they were RIGHT.",
          "onPickup": { "setVariable": { "found_phantom_lead": true } },
          "puzzle_graph_role": "clue",
          "puzzle_graph_reveals": "the_leak_came_from_the_crypto_lab"
        }
      ]
    },

    "server_room": {
      "type": "room_servers",
      "locked": true,
      "lockType": "rfid",
      "requires": "server_zone_badge",
      "difficulty": "medium",
      "door_sign": "Server Room -- Restricted",
      "connections": { "west": "operations_floor" },
      "npcs": [],
      "objects": [
        {
          "type": "vm-launcher",
          "id": "vm_launcher_gitlist",
          "name": "GitList Repository Server",
          "takeable": false,
          "observations": "SAFETYNET's internal code server, humming in the corner rack. It hosts the org's source -- and, it turns out, a great deal that was never meant to be source.",
          "hacktivityMode": <%= vm_context && vm_context['hacktivity_mode'] ? 'true' : 'false' %>,
          "vm": <%= vm_object('attack_vm', {"id":1,"title":"kali","ip":"192.168.100.50","enable_console":true}) %>,
          "puzzle_graph_role": "vm"
        },
        {
          "type": "flag-station",
          "id": "flag_station_evidence_relay",
          "name": "Evidence Relay Terminal",
          "takeable": false,
          "observations": "Secure relay for submitting recovered evidence back to Director Netherton. Everything you pull off the repository server goes through here.",
          "acceptsVms": ["safetynet_gitlist_server"],
          "flags": <%= flags_for_vm('safetynet_gitlist_server', ['flag{gitlist_argument_injection}', 'flag{stashed_credentials_recovered}', 'flag{home_directory_access}', 'flag{root_via_sudo_apt}']) %>,
<%# flagRewards is INDEX-PARALLEL to flags -- one reward per flag, in order.
    set_global is forwarded to the client untouched. emit_event is NOT usable
    here. The narrative globals (found_gitlist_vuln, found_leaked_creds,
    found_architect_comms, found_access_logs, all_flags_submitted,
    mole_identified) hang off these four booleans as eventMappings on
    agent_0x99, because one flag can carry exactly one reward. %>
          "flagRewards": [
            { "type": "set_global", "key": "flag1_submitted", "value": true, "description": "GitList argument injection -- RCE on SAFETYNET's own repo browser, no login" },
            { "type": "set_global", "key": "flag2_submitted", "value": true, "description": "Stashed credentials recovered from repository history" },
            { "type": "set_global", "key": "flag3_submitted", "value": true, "description": "Logged in properly -- home directory holds the ENTROPY correspondence" },
            { "type": "set_global", "key": "flag4_submitted", "value": true, "description": "Root via sudo apt-get -- access logs place the mole" }
          ]
        },
        {
          "type": "text_file",
          "id": "server_access_logs",
          "name": "Server Access Log (excerpt)",
          "takeable": true,
          "readable": true,
          "observations": "A printed excerpt of the auth log, left by the rack. Whoever printed it ran it through the redaction filter first. Only root on the box will tell you whose account this is.",
          "observationDisplay": "gameDisplay",
          "text": "AUTH LOG -- mission_planning share\n\n... routine ...\nUSER [REDACTED]  T-48h (before Portland)  OPEN portland_operations.enc  DURATION 00:47:00\n... routine ...\n\nPencilled underneath: '47 minutes on a file you read in five. Same window ENTROPY started coordinating. Whoever this is, they weren't reading the plan. They were copying it. Need root to unmask the account.'",
          "onRead": { "setVariable": { "found_access_logs_hint": true } }
        }
      ]
    },

