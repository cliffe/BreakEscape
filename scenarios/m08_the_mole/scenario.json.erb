              "setGlobal": { "nightshade_arrested": true, "fate_decided": true },
              "completeTask": "decide_the_fate",
              "sendTimedMessage": { "delay": 2000, "message": "You put him on the floor before he'd say his piece. Then it's a handover: no deal, no triple agent, he goes to the police with the case file. We have Tomb Gamma's name and not its coordinates. Go and see the Director." }
            },
            {
