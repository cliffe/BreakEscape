              "condition": "!globalVars.fate_decided",
              "sendTimedMessage": { "delay": 3000, "message": "You walked out on him before it was entered. He hasn't moved. Step back out of that room and go in again when you're ready to finish it. Nothing goes to the Director until you do." }
            },
            {
