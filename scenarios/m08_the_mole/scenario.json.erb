      "status": "locked",
      "order": 3,
      "unlockCondition": { "aimCompleted": "get_into_the_repo" },
      "tasks": [
        {
          "taskId": "recover_home_flag",
          "title": "Log in properly and submit the home-directory flag",
          "type": "submit_flags",
