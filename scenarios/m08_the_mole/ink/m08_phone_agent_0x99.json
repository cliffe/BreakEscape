{"inkVersion":21,"root":[[["done",{"#n":"g-0"}],null],"done",{"start":["ev",{"VAR?":"first_call"},"/ev",[{"->":".^.b","c":true},{"b":["\n","ev",false,"/ev",{"VAR=":"first_call","re":true},{"->":"first_call_text"},{"->":"start.4"},null]}],"nop","\n",{"->":"hub"},null],"first_call_text":["^Line's open. Same as Portland, except this time the target has a SAFETYNET lanyard and a name I probably know.","\n","^So I'm going to be very professional tonight. Bear with me.","\n",{"->":"hub"},null],"hub":[["ev","str","^How do I get into the server room?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^What am I looking at on this box?","/str",{"VAR?":"found_gitlist_vuln"},"/ev",{"*":".^.c-1","flg":5},"ev","str","^I've got credentials. Now what?","/str",{"VAR?":"found_leaked_creds"},"/ev",{"*":".^.c-2","flg":5},"ev","str","^The mail's real. How do I make it stick?","/str",{"VAR?":"found_architect_comms"},{"VAR?":"found_access_logs"},"!","&&","/ev",{"*":".^.c-3","flg":5},"ev","str","^How do I get into the interrogation suite?","/str",{"VAR?":"mole_identified"},"!","/ev",{"*":".^.c-4","flg":5},"ev","str","^How do I get into the interrogation suite?","/str",{"VAR?":"mole_identified"},"/ev",{"*":".^.c-5","flg":5},"ev","str","^Where would the door logs be?","/str",{"VAR?":"found_badge_audit"},"!","/ev",{"*":".^.c-6","flg":5},"ev","str","^Why isn't he in the interrogation room yet?","/str",{"VAR?":"mole_identified"},{"VAR?":"all_flags_submitted"},"!","&&","/ev",{"*":".^.c-7","flg":5},"ev","str","^It's really Nightshade.","/str",{"VAR?":"mole_identified"},{"VAR?":"fate_decided"},"!","&&","/ev",{"*":".^.c-8","flg":5},"ev","str","^I need a field guide.","/str",{"VAR?":"recon_guide_offered"},{"VAR?":"recon_guide_hint_given"},"!","&&",{"VAR?":"scanning_guide_offered"},{"VAR?":"scanning_guide_hint_given"},"!","&&","||",{"VAR?":"vulnanalysis_guide_offered"},{"VAR?":"vulnanalysis_guide_hint_given"},"!","&&","||",{"VAR?":"cyberchef_guide_offered"},{"VAR?":"cyberchef_guide_hint_given"},"!","&&","||",{"VAR?":"gitsecrets_guide_offered"},{"VAR?":"gitsecrets_guide_hint_given"},"!","&&","||",{"VAR?":"privesc_guide_offered"},{"VAR?":"privesc_guide_hint_given"},"!","&&","||","/ev",{"*":".^.c-9","flg":5},"ev","str","^Nothing right now.","/str","/ev",{"*":".^.c-10","flg":4},{"c-0":["\n",["ev",{"VAR?":"netherton_card_cloned"},"/ev",{"->":".^.b","c":true},{"b":["\n","^Reader's east of the ops floor. Open the cloner, pick his card from Saved, emulate it. EM4100 has no crypto; the reader can't tell.","\n",{"->":".^.^.^.6"},null]}],["ev",{"VAR?":"netherton_card_taken"},{"VAR?":"badge_cloned"},"||","/ev",{"->":".^.b","c":true},{"b":["\n","^Reader's east of the ops floor. You've already got what it wants.","\n",{"->":".^.^.^.6"},null]}],["ev",{"VAR?":"netherton_ko"},"/ev",{"->":".^.b","c":true},{"b":["\n","^His card's on the floor beside him. Or the visitor printer at reception: a badge behind a facilities PIN. Facilities write PINs down.","\n",{"->":".^.^.^.6"},null]}],["ev",{"VAR?":"cipher_seen"},{"VAR?":"phantom_seen"},"&&",{"VAR?":"nightshade_seen"},"&&","/ev",{"->":".^.b","c":true},{"b":["\n","^You've seen all three. Back to the Director, and stand close with the cloner. Or the visitor printer at reception.","\n",{"->":".^.^.^.6"},null]}],[{"->":".^.b"},{"b":["\n","^See all three suspects, then clone the Director's card. Or try the visitor printer at reception. Facilities write their PINs down.","\n",{"->":".^.^.^.6"},null]}],"nop","\n",{"->":"hub"},null],"c-1":["\n","^A GitList instance our own team stood up and never patched.","\n","^One crafted request gets you code execution with no login at all. That's your first flag.","\n","^And our first national embarrassment.","\n",{"->":"hub"},null],"c-2":["\n","^Log in properly with them. Whoever committed those thought no one would ever read that far.","\n","^Get into the account and let's find out whose it is.","\n",{"->":"hub"},null],"c-3":["\n","^You need root. A user shell shows you the mailbox. Root shows you the logs, and logs put a body in a chair.","\n","^There's a sudo rule on that box begging to be abused. Take it.","\n",{"->":"hub"},null],"c-4":["\n","^Keypad, south of the Crypto Lab. The code's in the Director's safe.","\n","^How his safe opens is the building's worst-kept secret. Ask ATHENA, or look at what he signs.","\n",{"->":"hub"},null],"c-5":["\n","^Keypad, south of the Crypto Lab. The code's in the Director's office safe.","\n","^The safe combination is his service number. Everyone in this building uses their own.","\n","^He signs it on anything he pulls from personnel. There's one of those printouts in the ops-floor tray.","\n",{"->":"hub"},null],"c-6":["\n","^Security Archives, south of the ops floor. Facilities set the passphrase, and facilities write things down. Kettle.","\n","^The lab's got one door. Whatever that door saw, it saw everyone.","\n",{"->":"hub"},null],"c-7":["\n","^The Director wants all four flags through the relay first. Give Nightshade half a case and he'll take it apart.","\n","^Get the rest of the box submitted.","\n",{"->":"hub"},null],"c-8":["\n","^Yeah. It's really Nightshade.","\n","^We did survival training together. He carried me two miles once.","\n","^Get the interrogation room open. I'll be fine. I'll be fine after.","\n",{"->":"hub"},null],"c-9":["^ ",{"->":"guides"},"\n",null],"c-10":["\n","^I'm here. Always am.","\n","#","^exit_conversation","/#",{"->":"hub"},null]}],null],"guides":["^Course. Which one.","\n",{"->":"guides_menu"},null],"guides_menu":[["ev","str","^Recon and network mapping.","/str",{"VAR?":"recon_guide_offered"},{"VAR?":"recon_guide_hint_given"},"!","&&","/ev",{"*":".^.c-0","flg":5},"ev","str","^Scanning and exploitation.","/str",{"VAR?":"scanning_guide_offered"},{"VAR?":"scanning_guide_hint_given"},"!","&&","/ev",{"*":".^.c-1","flg":5},"ev","str","^Secrets in git history.","/str",{"VAR?":"gitsecrets_guide_offered"},{"VAR?":"gitsecrets_guide_hint_given"},"!","&&","/ev",{"*":".^.c-2","flg":5},"ev","str","^Decoding with CyberChef.","/str",{"VAR?":"cyberchef_guide_offered"},{"VAR?":"cyberchef_guide_hint_given"},"!","&&","/ev",{"*":".^.c-3","flg":5},"ev","str","^Vulnerability analysis.","/str",{"VAR?":"vulnanalysis_guide_offered"},{"VAR?":"vulnanalysis_guide_hint_given"},"!","&&","/ev",{"*":".^.c-4","flg":5},"ev","str","^Privilege escalation.","/str",{"VAR?":"privesc_guide_offered"},{"VAR?":"privesc_guide_hint_given"},"!","&&","/ev",{"*":".^.c-5","flg":5},"ev","str","^That's all.","/str","/ev",{"*":".^.c-6","flg":4},{"c-0":["\n","^Map before you shoot. ","#","^give_item:lab-workstation:m08_recon_field_guide","/#","\n","ev",true,"/ev",{"VAR=":"recon_guide_hint_given","re":true},{"->":".^.^.^"},null],"c-1":["\n","^Fingerprint the service, then hit the GitList flaw. ","#","^give_item:lab-workstation:m08_scanning_field_guide","/#","\n","ev",true,"/ev",{"VAR=":"scanning_guide_hint_given","re":true},{"->":".^.^.^"},null],"c-2":["\n","^Credentials in commit history -- classic, and exactly what he did. Read the log, then check the stash. ","#","^give_item:lab-workstation:m08_gitsecrets_field_guide","/#","\n","ev",true,"/ev",{"VAR=":"gitsecrets_guide_hint_given","re":true},{"->":".^.^.^"},null],"c-3":["\n","^Last layer first. You know this one. ","#","^give_item:lab-workstation:m08_cyberchef_field_guide","/#","\n","ev",true,"/ev",{"VAR=":"cyberchef_guide_hint_given","re":true},{"->":".^.^.^"},null],"c-4":["\n","^Know why the flaw works before you lean on it. ","#","^give_item:lab-workstation:m08_vulnanalysis_field_guide","/#","\n","ev",true,"/ev",{"VAR=":"vulnanalysis_guide_hint_given","re":true},{"->":".^.^.^"},null],"c-5":["\n","^The sudo route to root. ","#","^give_item:lab-workstation:m08_privesc_field_guide","/#","\n","ev",true,"/ev",{"VAR=":"privesc_guide_hint_given","re":true},{"->":".^.^.^"},null],"c-6":["\n",{"->":"hub"},null]}],null],"global decl":["ev","str","^Agent 0x00","/str",{"VAR=":"player_name"},false,{"VAR=":"found_gitlist_vuln"},false,{"VAR=":"found_leaked_cred