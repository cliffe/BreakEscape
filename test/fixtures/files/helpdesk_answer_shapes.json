{
  "_about": "S8b answer shapes (unit 04). Name -> { status, body, vary, guess }. Every key set is exact at every level. Values are equal except at the body paths in `vary` (there only the type must match). `guess` lists paths (or `status`) that the brief did not pin and the controller unit must CONFIRM against the real answer, then delete from `guess` (the owner of unit 04 makes the correction). Paths: dotted keys, array positions as [0]. Keys starting with an underscore are not entries.",
  "helpdesk.granted_password": {
    "status": 200,
    "body": { "granted": true, "what": "password", "password": "Tern-Harbour-41", "lockoutPcIds": ["vault_pc"] },
    "vary": ["body.password", "body.lockoutPcIds"],
    "guess": []
  },
  "helpdesk.granted_mfa": {
    "status": 200,
    "body": { "granted": true, "what": "mfa" },
    "vary": [],
    "guess": ["body: whether a repeat grant of mfa also carries lockoutPcIds (brief says the repeat carries 'the current lockoutPcIds' without saying for which `what`)"]
  },
  "helpdesk.refused": {
    "status": 422,
    "body": { "reason": "refused", "triesLeft": 2 },
    "vary": ["body.triesLeft"],
    "guess": ["body: no `success: false` key (brief says reason and triesLeft and nothing else)"]
  },
  "helpdesk.refused_last": {
    "status": 422,
    "body": { "reason": "refused", "triesLeft": 0 },
    "vary": [],
    "guess": ["body: no `success: false` key"]
  },
  "helpdesk.blocked": {
    "status": 422,
    "body": { "reason": "blocked", "retryIn": 240 },
    "vary": ["body.retryIn"],
    "guess": ["body: no `success: false` key"]
  },
  "helpdesk.unavailable": {
    "status": 422,
    "body": { "reason": "unavailable" },
    "vary": [],
    "guess": ["body: the key is `reason` (the brief names only the status and the word)"]
  },
  "helpdesk.not_found": {
    "status": 404,
    "body": { "reason": "not_found" },
    "vary": [],
    "guess": ["body: the key is `reason`"]
  },
  "helpdesk.bad_request": {
