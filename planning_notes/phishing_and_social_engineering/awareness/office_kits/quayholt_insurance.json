        }
      ],
      "timers": [
        {
          "id": "kit_ca03_t_done",
          "startOnGlobal": "kit_ca03_out",
          "delayMs": 12000,
          "condition": "!globalVars.kit_ca03_done",
          "setGlobal": {
            "kit_ca03_done": true
          }
        }
      ],
      "staff": {
        "anjali_rao": {
          "needs": {
            "thirst": {
              "decayPerMin": 0.01,
              "urgentAt": 50,
              "initial": 65
            }
          },
          "eventMappings": [
            {
              "eventPattern": "global_variable_changed:kit_ca03_out",
              "condition": "value === true",
              "onceOnly": true,
              "needs": "suspend"
            },
            {
              "eventPattern": "global_variable_changed:kit_ca03_out",
              "condition": "value === true",
              "onceOnly": true,
              "delayMs": 1000,
              "patrolOverride": {
                "targetTile": {
                  "x": 6,
                  "y": 7
                },
                "speed": 90
              }
            },
            {
              "eventPattern": "npc_arrived:kit_anjali_rao",
              "condition": "data.owner !== 'needs' && globalVars.kit_ca03_out === true && globalVars.kit_quiet === true",
              "onceOnly": true,
              "setGlobal": {
                "kit_ca03_there": true
              },
              "bark": "I came over to use the spare and it's on the sign-in screen, asking for everything again. Darren, is it doing this to everyone?"
            },
            {
              "eventPattern": "global_variable_changed:kit_ca03_there",
              "condition": "value === true",
              "onceOnly": true,
              "needs": "resume",
              "delayMs": 3000
            },
            {
              "eventPattern": "global_variable_changed:kit_ca03_done",
              "condition": "value === true",
              "onceOnly": true,
              "needs": "resume"
            }
          ]
        },
        "niamh_doherty": {
          "eventMappings": [
            {
              "eventPattern": "global_variable_changed:kit_ca03_out",
              "condition": "value === true",
              "onceOnly": true,
              "needs": "suspend"
            },
            {
              "eventPattern": "global_variable_changed:kit_ca03_done",
              "condition": "value === true",
              "onceOnly": true,
              "needs": "resume"
            }
          ]
        }
      },
      "mappings": [
        {
          "eventPattern": "global_variable_changed:kit_ca03_there",
          "condition": "value === true && globalVars.kit_ca03_out === true && globalVars.kit_quiet === true",
          "onceOnly": true,
          "delayMs": 4500,
          "setGlobal": {
            "kit_ca03_done": true
          },
          "bark": "Someone's password got out, and whoever had it wanted to walk in as a name we'd all trust. That's why IT is signing everyone out."
        }
      ]
    },
