    "ca01_recall": {
      "_note": "The ca01 chain, written once here so --kit regenerates it (wrap review M3). Look up sets {out}: Gwen and Agnieszka stop their needs, Agnieszka walks to the notice (4,3) after 1 s, says her line on arrival, Adaeze answers 4 s after that and sets kit_ca01_done, and Gwen resumes then. The bark conditions never read a global their own mapping writes (stillValid re-runs the condition every 250 ms, so that would cancel the bubble). Every bark carries kit_quiet === true, so a line held across a kiosk reopen is dropped on release (plan 4.5). kit_ca01_t_done is the timer fallback: if the walk is blocked and Agnieszka never arrives, 12 s after {out} it sets kit_ca01_done anyway, and both colleagues resume on it. The two lines in the barks are fixed text that went through five dialogue rounds.",
      "globals": { "kit_{chain}_agn_there": false, "kit_{chain}_done": false },
      "timers": [
        { "id": "kit_{chain}_t_done", "startOnGlobal": "{out}", "delayMs": 12000, "condition": "!globalVars.kit_{chain}_done", "setGlobal": { "kit_{chain}_done": true } }
      ],
      "mappings": [
        {
          "_kitKey": "chg_chain_agn_there_sets_chain_done",
          "eventPattern": "global_variable_changed:kit_{chain}_agn_there",
          "condition": "value === true && globalVars.{out} === true && globalVars.kit_quiet === true",
          "onceOnly": true,
          "delayMs": 4000,
          "setGlobal": { "kit_{chain}_done": true },
          "bark": "One call to confirm the new details, and the money never moves. Saves a lot of phoning round afterwards."
        }
      ],
      "objects": [
        {
          "type": "notice_board1",
          "id": "kit_ca01_notice",
          "name": "Payments team notice",
          "sprite": "notes6",
          "wallMounted": true,
          "position": { "x": 4.03125, "y": 0.6875 },
          "takeable": false,
          "interactable": true,
          "revealOnGlobal": "{out}",
          "observations": "A notice the payments team taped to the wall about an earlier case: a supplier redirect that got through last spring. The run paid an account that wasn't the supplier's, and finance spent weeks getting the money back from the bank."
        }
      ],
      "staff": {
        "agnieszka_duda": {
          "needs": { "caffeine": { "decayPerMin": 0.01, "urgentAt": 50, "initial": 100 } },
          "eventMappings": [
            { "_kitKey": "chg_out", "eventPattern": "global_variable_changed:{out}", "condition": "value === true", "onceOnly": true, "needs": "suspend" },
            { "_kitKey": "chg_out_2", "eventPattern": "global_variable_changed:{out}", "condition": "value === true", "onceOnly": true, "delayMs": 1000,
              "patrolOverride": { "targetTile": { "x": 4, "y": 3 }, "speed": 90 } },
            { "_kitKey": "npc_arrived_agnieszka_duda_sets_chain_agn_there", "eventPattern": "npc_arrived:kit_agnieszka_duda",
              "condition": "data.owner !== 'needs' && globalVars.{out} === true && globalVars.kit_quiet === true",
              "onceOnly": true, "setGlobal": { "kit_{chain}_agn_there": true },
              "bark": "That notice on the wall is from last spring. A redirect that went through, and the supplier was left waiting to be paid." },
            { "_kitKey": "chg_chain_agn_there", "eventPattern": "global_variable_changed:kit_{chain}_agn_there", "condition": "value === true", "onceOnly": true, "delayMs": 3000, "needs": "resume" },
            { "_kitKey": "chg_chain_done", "eventPattern": "global_variable_changed:kit_{chain}_done", "condition": "value === true", "onceOnly": true, "needs": "resume" }
          ]
        },
        "gwen_pritchard": {
          "eventMappings": [
            { "_kitKey": "chg_out", "eventPattern": "global_variable_changed:{out}", "condition": "value === true", "onceOnly": true, "needs": "suspend" },
            { "_kitKey": "chg_chain_done", "eventPattern": "global_variable_changed:kit_{chain}_done", "condition": "value === true", "onceOnly": true, "needs": "resume" }
          ]
        }
      }
    },
