diff --git a/test/js/npc-needs-usb-policy.test.mjs b/test/js/npc-needs-usb-policy.test.mjs
new file mode 100644
index 000000000..c358ce1c7
--- /dev/null
+++ b/test/js/npc-needs-usb-policy.test.mjs
@@ -0,0 +1,130 @@
+// The USB policy in the needs system (access slice 9.2 sub-slice U): an NPC carrying a device to
+// a PC whose policy refuses its class. Spec: ACCESS_MODEL_SLICE_9_2_PLAN.md section 7.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { NPCNeedsSystem } from '../../public/break_escape/js/systems/npc-needs.js';
+import { makeWorld } from './fixtures/needs-stub-world.mjs';
+
+// dropHeld puts the item back where the NPC stands (the live adapter does the same)
+function world(cfg) {
+    const w = makeWorld(cfg);
+    w.world.dropHeld = (npcId, itemId) => {
+        w.calls.dropped.push({ npcId, itemId });
+        const o = w.objs.find(x => x.id === itemId);
+        const p = w.pos[npcId];
+        if (o) { o.roomId = 'office'; o.x = p.x; o.y = p.y; }
+    };
+    return w;
+}
+
+function setup({ lenaPolicy = 'storage_blocked', kiosk = true, usbClass = 'storage', chatter } = {}) {
+    const cfg = {
+        npcs: {
+            lena: { pos: { x: 100, y: 100 }, rec: { id: 'lena', needsHome: 'lena_pc', interests: { dev_usb: { weight: 2 } }, ...(chatter ? {} : {}) } }
+        },
+        objects: [
+            { id: 'lena_pc', x: 100, y: 68, affordance: { accepts: ['dev_usb'], useSeconds: 5 }, usbPolicy: lenaPolicy },
+            ...(kiosk ? [{ id: 'kiosk_pc', x: 300, y: 68, affordance: { accepts: ['dev_usb'], useSeconds: 5 }, usbPolicy: 'allowed' }] : [])
+        ]
+    };
+    const w = world(cfg);
+    if (chatter) w.world.chatterConfig = () => chatter;
+    const sys = new NPCNeedsSystem(w.world, { seed: 'usb', manualClock: true });
+    w.attach(sys);
+    sys.registerAll();
+    sys.step(2000);
+    const item = { id: 'kit_usb', x: 150, y: 150, roomId: 'office', pickable: true, needsTag: 'dev_usb' };
+    if (usbClass) item.usbClass = usbClass;
+    w.objs.push(item);
+    return { sys, w };
+}
+
+const named = (w, prefix) => w.calls.emits.filter(e => e.name.startsWith(prefix));
+
+test('storage refused at a managed PC (no npc_used), then delivered to a permitted one', () => {
+    const { sys, w } = setup();
+    sys.step(30000);
+    const refused = named(w, 'npc_use_refused:');
+    assert.equal(refused.length, 1);
+    assert.equal(refused[0].name, 'npc_use_refused:lena_pc');
+    assert.deepEqual(refused[0].data, { npcId: 'lena', objectId: 'lena_pc', itemId: 'kit_usb', tag: 'dev_usb', usbClass: 'storage' });
+    assert.equal(named(w, 'npc_used:lena_pc').length, 0);
+    const used = named(w, 'npc_used:kiosk_pc');
+    assert.equal(used.length, 1);
+    assert.equal(used[0].data.itemId, 'kit_usb');
+    assert.deepEqual(w.calls.consumed, [{ npcId: 'lena', itemId: 'kit_usb' }]);
+    const log = sys.getLog().filter(e => e.npc === 'lena').map(e => e.ev);
+    assert.ok(log.indexOf('use_refused') < log.indexOf('retarget'));
+    assert.ok(log.indexOf('retarget') < log.indexOf('used'));
+    // she left her post for the kiosk (a real leave) and came back
+    assert.ok(named(w, 'npc_left_post:lena').some(e => e.data.targetId === 'kiosk_pc'));
+});
+
+test('with nowhere else, the device is put down and not picked up again', () => {
+    const { sys, w } = setup({ lenaPolicy: 'blocked', kiosk: false });
+    sys.step(60000);
+    assert.equal(named(w, 'npc_use_refused:lena_pc').length, 1);
+    assert.deepEqual(w.calls.dropped, [{ npcId: 'lena', itemId: 'kit_usb' }]);
+    assert.equal(w.calls.consumed.length, 0);
+    assert.equal(named(w, 'npc_used:').length, 0);
+    const item = w.objs.find(o => o.id === 'kit_usb');
+    assert.equal(item.roomId, 'office');
+    assert.equal(sys.getLog().filter(e => e.npc === 'lena' && e.ev === 'picked_up').length, 1, 'picked up once only');
+    assert.equal(sys.getState('lena').job, null);
+});
+
+test('a hid item is accepted under storage_blocked and refused under blocked', () => {
+    let { sys, w } = setup({ usbClass: 'hid' });
+    sys.step(30000);
+    assert.equal(named(w, 'npc_use_refused:').length, 0);
+    assert.equal(named(w, 'npc_used:lena_pc').length, 1);
+    ({ sys, w } = setup({ usbClass: 'hid', lenaPolicy: 'blocked' }));
+    sys.step(30000);
+    assert.equal(named(w, 'npc_use_refused:lena_pc').length, 1);
+    assert.equal(named(w, 'npc_used:kiosk_pc').length, 1);
+});
+
+test('an item with no usbClass is never refused', () => {
+    const { sys, w } = setup({ usbClass: null, lenaPolicy: 'blocked' });
+    sys.step(30000);
+    assert.equal(named(w, 'npc_use_refused:').length, 0);
+    assert.equal(named(w, 'npc_used:lena_pc').length, 1);
+});
+
+test('an ungoverned tray (usbPolicy null) under a blocking default accepts', () => {
+    const { sys, w } = setup({ lenaPolicy: null, kiosk: false });
+    sys.step(30000);
+    assert.equal(named(w, 'npc_use_refused:').length, 0);
+    assert.equal(named(w, 'npc_used:lena_pc').length, 1);
+});
+
+test('the mutter: a usb_refused line for its time, seeded; the picture without one', () => {
+    const chatter = { usb_refused: ["USB's disabled. Typical.", 'Not this again.'] };
+    const runOnce = () => {
+        const { sys, w } = setup({ chatter });
+        let seen = null;
+        for (let i = 0; i < 120 && !seen; i++) { sys.step(250); const t = sys.getState('lena').talking; if (t && t.topic === 'usb_refused') seen = { ...t, at: sys.clockMs }; }
+        return seen;
+    };
+    const a = runOnce(), b = runOnce();
+    assert.ok(a, 'the mutter shows');
+    assert.ok(chatter.usb_refused.includes(a.line));
+    assert.equal(a.line, b.line, 'seeded');
+    // no line: the blocked picture
+    const { sys } = setup();
+    let pic = null;
+    for (let i = 0; i < 120 && !pic; i++) { sys.step(250); const t = sys.getState('lena').talking; if (t && t.topic === 'usb_refused') pic = t; }
+    assert.ok(pic);
+    assert.equal(pic.picture, 'blocked');
+});
+
+test('mutter(npcId, topic) is public and ignores the chatter cooldown', () => {
+    const chatter = { usb_refused: ['One.'], work_fail: ['Two.'] };
+    const { sys } = setup({ chatter, kiosk: false, lenaPolicy: null });
+    assert.equal(sys.mutter('lena', 'work_fail'), true);
+    assert.equal(sys.getState('lena').talking.line, 'Two.');
+    sys.step(5000);
+    assert.equal(sys.mutter('lena', 'usb_refused'), true);
+    assert.equal(sys.getState('lena').talking.line, 'One.');
+    assert.equal(sys.mutter('nobody', 'work_fail'), false);
+});
diff --git a/test/js/pc-policy.test.mjs b/test/js/pc-policy.test.mjs
new file mode 100644
index 000000000..42d0fa7e3
--- /dev/null
+++ b/test/js/pc-policy.test.mjs
@@ -0,0 +1,85 @@
+// The USB policy module (systems/pc-policy.js), access slice 9.2 sub-slice U.
+// Spec: docs/achitechture/ACCESS_MODEL_SLICE_9_2_PLAN.md section 7.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { effectivePolicy, usbGoverned, usbRefused, usbPolicyFor, plantRefusal, USB_REFUSAL_LINES } from '../../public/break_escape/js/systems/pc-policy.js';
+import { usbRefusedBy } from '../../public/break_escape/js/systems/npc-needs.js';
+
+const scenario = {
+    defaultPolicy: 'managed',
+    policies: {
+        managed: { usb: 'storage_blocked', autoLockMin: 5 },
+        locked_down: { usb: 'blocked' },
+        lax: { usb: 'allowed' },
+        quiet: { autoLockMin: 3 }
+    }
+};
+
+test('the table: allowed or absent accepts both; storage_blocked refuses storage only; blocked refuses both', () => {
+    for (const usb of ['allowed', undefined, null]) {
+        assert.equal(usbRefused(usb, 'storage'), false);
+        assert.equal(usbRefused(usb, 'hid'), false);
+    }
+    assert.equal(usbRefused('storage_blocked', 'storage'), true);
+    assert.equal(usbRefused('storage_blocked', 'hid'), false);
+    assert.equal(usbRefused('blocked', 'storage'), true);
+    assert.equal(usbRefused('blocked', 'hid'), true);
+    // an item with no usbClass is never refused
+    assert.equal(usbRefused('blocked', undefined), false);
+    assert.equal(usbRefused('blocked', null), false);
+});
+
+test('the needs copy of the table agrees with the module', () => {
+    for (const usb of ['allowed', 'storage_blocked', 'blocked', null]) {
+        for (const cls of ['storage', 'hid', null, 'other']) assert.equal(usbRefusedBy(usb, cls), usbRefused(usb, cls), `${usb}/${cls}`);
+    }
+});
+
+test('effectivePolicy: the PC\'s own policy, else the default, else null', () => {
+    assert.deepEqual(effectivePolicy({ id: 'pc', policy: 'lax' }, scenario), scenario.policies.lax);
+    assert.deepEqual(effectivePolicy({ id: 'pc' }, scenario), scenario.policies.managed);
+    assert.equal(effectivePolicy({ id: 'pc' }, { policies: scenario.policies }), null);
+    assert.equal(effectivePolicy({ id: 'pc', policy: 'nope' }, scenario), null);
+});
+
+test('usbGoverned: a workstation by its fields or an object naming a policy; not a tray under a default', () => {
+    assert.equal(usbGoverned({ id: 'a', lockType: 'login' }), true);
+    assert.equal(usbGoverned({ id: 'a', workstation: true }), true);
+    assert.equal(usbGoverned({ id: 'a', lockChance: 0 }), true);
+    assert.equal(usbGoverned({ id: 'a', locksScreenOnLeave: true }), true);
+    assert.equal(usbGoverned({ id: 'dock', policy: 'locked_down' }), true);
+    assert.equal(usbGoverned({ id: 'tray', type: 'bin' }), false);
+    assert.equal(usbPolicyFor({ id: 'tray', type: 'bin' }, scenario), null);
+    assert.equal(usbPolicyFor({ id: 'pc', lockType: 'login' }, scenario), 'storage_blocked');
+    assert.equal(usbPolicyFor({ id: 'pc', lockType: 'login', policy: 'quiet' }, scenario), 'allowed');
+    assert.equal(usbPolicyFor({ id: 'dock', policy: 'locked_down' }, scenario), 'blocked');
+});
+
+const stick = { scenarioData: { id: 'kit_usb', type: 'usb', usbClass: 'storage' } };
+const badusb = { scenarioData: { id: 'kit_badusb', type: 'usb', usbClass: 'hid' } };
+const logger = { scenarioData: { id: 'keylogger', type: 'keylogger' } };
+
+test('plantRefusal: the first held item the policy accepts is used', () => {
+    const dock = { id: 'dock', policy: 'managed' };
+    assert.deepEqual(plantRefusal([stick, badusb], dock, scenario), { item: badusb, refusal: null });
+    assert.deepEqual(plantRefusal([badusb, stick], dock, scenario), { item: badusb, refusal: null });
+    // an item with no usbClass is never refused
+    assert.deepEqual(plantRefusal([logger], { id: 'd', policy: 'locked_down' }, scenario), { item: logger, refusal: null });
+});
+
+test('plantRefusal: refused only when every matching item is refused, with the line for the value', () => {
+    const r1 = plantRefusal([stick], { id: 'dock', policy: 'managed' }, scenario);
+    assert.equal(r1.item, null);
+    assert.equal(r1.refusal, 'USB storage is disabled on this PC.');
+    assert.equal(r1.usbClass, 'storage');
+    const r2 = plantRefusal([stick, badusb], { id: 'dock', policy: 'locked_down' }, scenario);
+    assert.equal(r2.item, null);
+    assert.equal(r2.refusal, USB_REFUSAL_LINES.blocked);
+    assert.equal(r2.refusal, 'USB devices are disabled on this PC.');
+});
+
+test('plantRefusal: a non-governed object under a blocking default is not refused; nothing held is no refusal', () => {
+    const sc = { ...scenario, defaultPolicy: 'locked_down' };
+    assert.deepEqual(plantRefusal([stick], { id: 'tray' }, sc), { item: stick, refusal: null });
+    assert.deepEqual(plantRefusal([], { id: 'dock', policy: 'locked_down' }, sc), { item: null, refusal: null });
+});
diff --git a/test/js/validator-access-work.test.mjs b/test/js/validator-access-work.test.mjs
new file mode 100644
index 000000000..8bdb2386b
--- /dev/null
+++ b/test/js/validator-access-work.test.mjs
@@ -0,0 +1,100 @@
+// scripts/validate_access_work.rb (access slice 9.2, ACCESS_MODEL_SLICE_9_2_PLAN.md section 10):
+// the USB policy (sub-slice U) and work, outages and frustration (sub-slice A). One fixture per
+// error and warning, and a clean fixture that raises none.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '../..');
+const ruby = spawnSync('ruby', ['--version']);
+const skip = ruby.status !== 0 && 'ruby not found';
+
+function run(scenario, fn = 'check') {
+    const script = `require ${JSON.stringify(join(root, 'scripts/validate_scenario.rb'))}
+      puts JSON.generate(ValidateAccessWork.${fn}(JSON.parse(STDIN.read)))`;
+    const r = spawnSync('ruby', ['-e', script], {
+        input: JSON.stringify(scenario), encoding: 'utf8', env: { ...process.env, LANG: 'C.UTF-8' }
+    });
+    assert.equal(r.status, 0, r.stderr);
+    return JSON.parse(r.stdout.trim().split('\n').pop());
+}
+const issues = s => run(s, 'check');
+const errors = list => list.filter(s => s.startsWith('❌'));
+const warnings = list => list.filter(s => s.startsWith('⚠️'));
+const has = (list, frag) => list.some(s => s.includes(frag));
+const assertHas = (list, frag) => assert.ok(has(list, frag), `expected "${frag}" in:\n${list.join('\n')}`);
+const clone = o => JSON.parse(JSON.stringify(o));
+
+// ── sub-slice U ────────────────────────────────────────────────────────
+
+function usbClean() {
+    return {
+        startRoom: 'lobby',
+        chatter: { usb_refused: ["USB's disabled. Typical."] },
+        policies: { managed: { usb: 'storage_blocked' }, lax: { usb: 'allowed' }, locked_down: { usb: 'blocked' } },
+        defaultPolicy: 'managed',
+        rooms: {
+            lobby: {
+                type: 'room_office',
+                objects: [
+                    { id: 'kit_usb', type: 'usb', name: 'USB stick', needsTag: 'dev_usb', droppable: true, usbClass: 'storage' },
+                    { id: 'lena_pc', type: 'pc', name: 'PC', workstation: true, affordance: { accepts: ['dev_usb'] } },
+                    { id: 'kiosk_pc', type: 'pc', name: 'Kiosk', workstation: true, policy: 'lax', affordance: { accepts: ['dev_usb'] } },
+                    { id: 'priya_dock', type: 'usb_hub', name: 'Dock', policy: 'locked_down', requiresItem: 'usb', triggerOnInteract: [] }
+                ],
+                npcs: [{ id: 'lena', displayName: 'Lena', npcType: 'person', needsHome: 'lena_pc', interests: { dev_usb: { weight: 2 } } }]
+            }
+        }
+    };
+}
+
+test('USB: a clean fixture raises nothing', { skip }, () => {
+    assert.deepEqual(issues(usbClean()), []);
+});
+
+test('USB: an unknown usb or social value, and an unknown usbClass, are errors', { skip }, () => {
+    const s = usbClean();
+    s.policies.managed.usb = 'storage_only';
+    s.policies.lax.social = 'sometimes';
+    s.rooms.lobby.objects[0].usbClass = 'mouse';
+    const e = errors(issues(s));
+    assertHas(e, "policies.managed.usb is 'storage_only'");
+    assertHas(e, "policies.lax.social is 'sometimes'");
+    assertHas(e, "usbClass 'mouse'");
+});
+
+test('USB: a blocking policy over objects whose items have no usbClass does nothing', { skip }, () => {
+    const s = usbClean();
+    delete s.rooms.lobby.objects[0].usbClass;
+    const w = warnings(issues(s));
+    assertHas(w, 'policies.managed sets usb');
+    assertHas(w, 'policies.locked_down sets usb');
+});
+
+test('USB: a device accepted by an ungoverned object under a blocking default is warned', { skip }, () => {
+    const s = usbClean();
+    s.rooms.lobby.objects.push({ id: 'lost_property_tray', type: 'bin', name: 'Tray', affordance: { accepts: ['dev_usb'] } });
+    const w = warnings(issues(s));
+    assertHas(w, "'lost_property_tray' takes 'kit_usb'");
+    // a non-blocking default does not warn
+    s.defaultPolicy = 'lax';
+    assert.ok(!has(issues(s), 'lost_property_tray'));
+});
+
+test('USB: an NPC that can be refused a device needs a usb_refused line, except under "chatter": false', { skip }, () => {
+    const s = usbClean();
+    delete s.chatter;
+    assertHas(warnings(issues(s)), 'lena can be refused a USB device');
+    s.rooms.lobby.npcs[0].chatter = { usb_refused: ['Typical.'] };
+    assert.ok(!has(issues(s), 'can be refused'));
+    const t = usbClean();
+    t.chatter = false;
+    assert.ok(!has(issues(t), 'can be refused'));
+    // nobody can be refused: the PC accepts the class
+    const u = usbClean();
+    delete u.chatter;
+    u.rooms.lobby.objects[0].usbClass = 'hid';
+    assert.ok(!has(issues(u), 'can be refused'));
+});
