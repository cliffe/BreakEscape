-{"inkVersion":21,"root":[[["done",{"#n":"g-0"}],null],"done",{"start":["#","^speaker:irina_volkova","/#","ev",-1,"/ev",{"VAR=":"exec_badge_turn","re":true},"ev",{"VAR?":"irina_fate_decided"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"after_choice"},{"->":"start.11"},null]}],"nop","\n","ev",{"VAR?":"first_meeting"},{"VAR?":"exchange_infiltrated"},"!","&&","/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"first_meeting_scene"},{"->":"start.20"},null]}],"nop","\n","ev",false,"/ev",{"VAR=":"first_meeting","re":true},"^Dr. Irina Volkova: Back again. What do you need?","\n","ev",true,"/ev",{"VAR=":"hub_quiet","re":true},{"->":"hub"},null],"first_meeting_scene":[["#","^speaker:irina_volkova","/#","#","^complete_task:meet_irina","/#","^Narrator: A sharp-eyed woman in her mid-thirties looks up from three monitors of transaction graphs.","\n","^Dr. Irina Volkova: You must be the FCA. Dr Irina Volkova, Chief Technology Officer.","\n","^Dr. Irina Volkova: A supervisory visit. Always a pleasure, I'm sure.","\n","ev","str","^Thanks for making the time, Dr Volkova. I know these visits are a nuisance.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Let's be quick. I need your servers, your logs and your wallets.","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^Thirty-seven papers and nearly three thousand citations. I've read some of your work.","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["\n","ev",false,"/ev",{"VAR=":"first_meeting","re":true},"ev",{"VAR?":"irina_trust"},15,"+",{"VAR=":"irina_trust","re":true},"/ev","#","^influence_increased","/#",{"->":"professional_response"},null],"c-1":["\n","ev",false,"/ev",{"VAR=":"first_meeting","re":true},"ev",{"VAR?":"irina_trust"},5,"-",{"VAR=":"irina_trust","re":true},"/ev","#","^influence_decreased","/#","ev",true,"/ev",{"VAR=":"irina_suspicious","re":true},"#","^set_variable:irina_suspicious=true","/#",{"->":"suspicious_response"},null],"c-2":["\n","ev",false,"/ev",{"VAR=":"first_meeting","re":true},"ev",{"VAR?":"irina_trust"},