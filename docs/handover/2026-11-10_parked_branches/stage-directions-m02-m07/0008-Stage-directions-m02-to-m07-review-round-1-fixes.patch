+{"inkVersion":21,"root":[[["done",{"#n":"g-0"}],null],"done",{"start":["ev",{"VAR?":"awaiting_ambush"},{"VAR?":"mission_complete"},"!","&&","/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"press_terminal_ambush"},{"->":"start.7"},null]}],"nop","\n","ev",{"VAR?":"insider_confronted"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"already_resolved"},{"->":"start.13"},null]}],"nop","\n","ev",{"VAR?":"insider_identified"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"confrontation"},{"->":"start.19"},null]}],"nop","\n","ev",{"CNT?":"cover_friendly"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"cover_return"},{"->":"start.25"},null]}],"nop","\n",{"->":"cover_friendly"},null],"cover_return":["^Graham Reeves: Still here. What can I do for you?","\n",{"->":"cover_hub"},null],"cover_friendly":["#","^set_global:reeves_known:true","/#","^Narrator: He stands beside the comms relay, hands loosely clasped, like a man who has stood in exactly that spot for a very long time and doesn't mind.","\n","^Graham Reeves: Evening. You'll be the consultant Dr Kim brought in.","\n","^Graham Reeves: Graham Reeves, night security supervisor. I've the comms watch while the systems are down.","\n","^Graham Reeves: Anything you want to send from that terminal comes through me first. Just process. It's a bad night for half a story getting out.","\n",{"->":"cover_hub"},{"#f":1}],"cover_hub":[["ev","str","^What are you guarding in here, and why no uniform?","/str",{"VAR?":"asked_guarding"},"!","/ev",{"*":".^.c-0","flg":5},"ev","str","^Somebody told security control I was never booked in. Any idea who?","/str",{"VAR?":"cover_burned"},{"VAR?":"cover_restored"},"!","&&",{"VAR?":"cover_probed"},"!","&&","/ev",{"*":".^.c-1","flg":5},"ev","str","^Ghost's log names badge SC-4471. That's this post's badge.","/str",{"VAR?":"cover_burned"},{"VAR?":"insider_badge_id_found"},"&&",{"VAR?":"inspected_asset_post"},"&&",{"VAR?":"insider_identified"},"!","&&","/ev",{"*":".^.c-2","flg":5},"ev","str","^Friday's drill ran on a security override. Whose?","/str",{"VAR?":"read_handover_board"},{"VAR?":"asked_drill_doors"},"!","&&",{"VAR?":"insider_identified"},"!","&&","/ev",{"*":".^.c-3","flg":5},"ev","str","^What badge number do you carry on this post?","/str",{"VAR?":"insider_badge_id_found"},{"VAR?":"inspected_asset_post"},"!","&&",{"VAR?":"asked_badge"},"!","&&","/ev",{"*":".^.c-4","flg":5},"ev","str","^Nothing for now.","/str","/ev",{"*":".^.c-5","flg":4},{"c-0":["\n",{"->":"cover_guarding"},null],"c-1":["\n",{"->":"cover_probe"},null],"c-2":["\n",{"->":"name_him"},null],"c-3":["\n","ev",true,"/ev",{"VAR=":"asked_drill_doors","re":true},"^Graham Reeves: Doors are Officer Okonkwo's department. Corridor, keys, the fire panel.","\n","^Graham Reeves: I watch a telephone. I couldn't open a door in this building if I tried.","\n",{"->":".^.^.^"},null],"c-4":["\n","ev",true,"/ev",{"VAR=":"asked_badge","re":true},"^Graham Reeves: The one security issued me, same as everybody's. Why do you ask?","\n","^Graham Reeves: If it's badge numbers you're after, Officer Okonkwo keeps the rota. She's very thorough.","\n",{"->":".^.^.^"},null],"c-5":["\n","^Graham Reeves: Of course. I'll be here.","\n","^Graham Reeves: Do get those wards back, won't you. People are relying on it.","\n","#","^exit_conversation","/#","done",null]}],null],"cover_guarding":["ev",true,"/ev",{"VAR=":"asked_guarding","re":true},"^Graham Reeves: The relay, principally. It's the only line out of this building that still works.","\n","^Graham Reeves: The danger tonight is the press getting half of it. People fill the gaps with whatever frightens them most.","\n","^Graham Reeves: So what leaves this room is the whole picture, or nothing at all.","\n",{"->":"cover_plainclothes"},null],"cover_plainclothes":["ev",true,"/ev",{"VAR=":"asked_plainclothes","re":true},"^Graham Reeves: As for the suit, crisis protocol. A uniform in a corridor makes people ask what's happened, and then you've a queue of anxious relatives.","\n","^Graham Reeves: I've held this post since the summer. I know this building better than most who work in it. That's just what nights do to you.","\n",{"->":"cover_hub"},null],"cover_probe":[["ev",true,"/ev",{"VAR=":"cover_probed","re":true},"^Graham Reeves: How very odd. ","#","^delivery: perfectly composed, giving nothing away","/#","\n","^Graham Reeves: In fairness to control, they've no way of confirming anybody tonight. A phone call and a paper book, both only as good as whoever last touched them.","\n","^Graham Reeves: If somebody wanted to make a person disappear tonight, they wouldn't need to be clever. They'd need a telephone.","\n","ev","str","^That's a very complete answer for someone hearing it for the first time.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Thanks. I'll bear it in mind.","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["\n","^Graham Reeves: ...I've been in security a long while.","\n","^Graham Reeves: You get so you can see how a thing was done. It's an unattractive habit.","\n",{"->":"cover_hub"},{"#f":5}],"c-1":["\n","^Graham Reeves: Do.","\n",{"->":"cover_hub"},{"#f":5}]}],null],"name_him":["ev",true,"/ev",{"VAR=":"insider_identified","re":true},"#","^set_global:insider_identified:true","/#","#","^complete_task:unmask_identify","/#",{"->":"confrontation"},null],"confrontation":["^Narrator: You say the badge number out loud. SC-4471. The fire drill nobody scheduled.","\n","^Narrator: The courteous expression switches off, cleanly, like a lamp.","\n","^Graham Reeves: So you did the work.","\n","^Graham Reeves: Good. Otherwise I'd have sat here another six hours being helpful, and that's far more tiring than this.","\n","ev",{"VAR?":"cover_burned"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"confrontation_the_call"},{"->":".^.^.^.12"},null]}],"nop","\n",{"->":"confrontation_why"},null],"confrontation_the_call":[["^Narrator: He tilts his head at the wall phone.","\n","^Graham Reeves: You'll want to ask about the telephone. ","#","^delivery: lightly","/#","\n","^Graham Reeves: I rang control from that phone and told them there was no consultant booked. That was all. Eleven words.","\n","^Graham Reeves: No violence. Nothing anyone could charge me with. I removed your standing.","\n","^Graham Reeves: Someone with no standing spends the night explaining themselves in corridors instead of reading logs.","\n","ev",{"VAR?":"insider_method_confirmed"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Graham Reeves: You've read their note about it, haven't you. \"Better at this than we pay him to be.\"","\n","^Graham Reeves: I did rather enjoy that.","\n",{"->":".^.^.^.17"},null]}],"nop","\n","ev","str","^It cost me twenty minutes.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^You've stood here all night being helpful, after you'd sabotaged me.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^It didn't work. Bernie put her own name against mine.","/str",{"VAR?":"bernie_vouched"},"/ev",{"*":".^.c-2","flg":21},{"c-0":["\n","^Graham Reeves: Twenty minutes. On a twelve-hour generator.","\n","^Graham Reeves: That's the scale I work in. Nobody ever notices the twenty minutes. That's why it works.","\n",{"->":"confrontation_why"},{"#f":5}],"c-1":["\n","^Graham Reeves: Yes.","\n","^Graham Reeves: I've been helpful to this entire hospital all night. You're the first person who's noticed that's the point.","\n",{"->":"confrontation_why"},{"#f":5}],"c-2":["\n","^Narrator: For the first time, something crosses his face that he hasn't chosen.","\n","^Graham Reeves: ...Bernadette did that.","\n","^Graham Reeves: Six months, and she never once made me sign her book. I took that for laziness.","\n","^Graham Reeves: It appears it was manners.","\n",{"->":"confrontation_why"},{"#f":5}]}],null],"confrontation_why":[["^Graham Reeves: You want to know why. They always want to know why.","\n","ev","str","^You held the door open for people who put a ward on generators.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Six months on this post and you sold it. What did they pay you?","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^I don't need why. I need you away from that terminal.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","^Graham Reeves: I held a door open. Be precise about that. Everyone in this building held one, and none of them will be asked about it.","\n",{"->":"monologue_1"},{"#f":5}],"c-1":["\n","^Graham Reeves: Ask the second question first next time. It's the one you actually want answered.","\n",{"->":"monologue_1"},{"#f":5}],"c-2":["\n","^Graham Reeves: You'll get the why anyway. It's the only part of this I'm here for.","\n",{"->":"monologue_1"},{"#f":5}]}],null],"monologue_1":[["^Graham Reeves: Money. That's the first guess, always.","\n","^Graham Reeves: Do you know what this hospital pays a night supervisor to hold a building full of sick people together, ten till six?","\n","^Graham Reeves: Less than the catering for the meeting where they cut Gary Whitlock's budget. I carried the trays out afterwards.","\n","^Graham Reeves: I raised the servers too. I've been raising things since the day I arrived. I was told to mind my post.","\n","ev","str","^Being ignored doesn't give you licence.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^So they came along and listened.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Gary was ignored too. He wrote seven emails. He didn't do this.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","^Graham Reeves: No. Licences are what people with titles issue each other.","\n",{"->":"monologue_2"},{"#f":5}],"c-1":["\n","^Graham Reeves: They asked about my own building and wrote the answers down. Do you know how long it had been?","\n",{"->":"monologue_2"},{"#f":5}],"c-2":["\n","^Graham Reeves: No. He wrote his seven emails and waited to be listened to. In a fortnight they'll sack him for it.","\n","^Graham Reeves: That's not a counter-argument. That's my closing statement.","\n",{"->":"monologue_2"},{"#f":5}]}],null],"monologue_2":["^Graham Reeves: \"Recruited\" is the word everyone reaches for. They agreed with me. That's all.","\n","^Graham Reeves: And look at what I did. I confirmed a window. I walked two men through a lobby during a drill. I made one telephone call.","\n","^Graham Reeves: The deferred patch, the scanner over the servers: every one of those was decided by somebody with a title, in daylight, with minutes taken.","\n","^Graham Reeves: They built it. I only stopped it being invisible.","\n","^Narrator: His hand settles near the lanyard at his collar.","\n",{"->":"confrontation_choice"},null],"confrontation_choice":[["^Graham Reeves: So. You've found me. What happens now is your call, agent.","\n","ev","str","^Quietly. You're under arrest. SAFETYNET has you.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^You go public. Your name, alongside every one of theirs.","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^I'm done talking. Explain it to SAFETYNET.","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^You don't walk out of here.","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["\n",{"->":"choice_arrest"},null],"c-1":["\n",{"->":"choice_expose"},null],"c-2":["\n",{"->":"choice_handover"},null],"c-3":["^ ","#","^color:red","/#","\n",{"->":"choice_hostile"},null]}],null],"choice_arrest":["ev",true,"/ev",{"VAR=":"insider_confronted","re":true},"^Graham Reeves: No fuss. Good.","\n","^Graham Reeves: I told them a fuss was beneath the point.","\n","^Graham Reeves: The point is that nobody in this sector can ever say they didn't know. Give it a year. You'll see it in the budgets.","\n","^Narrator: He offers his wrists without being asked. Whatever else he is, he came to work tonight ready to be caught.","\n","ev",{"VAR?":"gary_protected"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Graham Reeves: The IT lad. Whitlock.","\n","^Graham Reeves: If you've really put his warnings on the record, then something came of tonight I couldn't manage on my own. I'd like that noted.","\n",{"->":".^.^.^.16"},null]}],"nop","\n","#","^set_global:insider_confronted:true","/#","#","^set_global:insider_asset_arrested:true","/#","#","^exit_conversation","/#","done",null],"choice_expose":["ev",true,"/ev",{"VAR=":"insider_confronted","re":true},"^Graham Reeves: Publish it?","\n","^Graham Reeves: Then publish all of it. My name against the board's, same paragraph, same size type.","\n","^Graham Reeves: Let the readers decide which of us they're angrier at. I suspect it won't be me. That's the whole thesis.","\n","^Narrator: You log his identity into the SAFETYNET evidence package. He doesn't resist when backup takes the door.","\n","#","^set_global:insider_confronted:true","/#","#","^set_global:insider_asset_arrested:true","/#","#","^set_global:insider_asset_exposed:true","/#","#","^exit_conversation","/#","done",null],"choice_handover":["ev",true,"/ev",{"VAR=":"insider_confronted","re":true},"^Graham Reeves: Straight to the agency. Cleaner.","\n","^Graham Reeves: Fewer chances for either of us to say something we actually mean.","\n","^Narrator: You signal SAFETYNET. Reeves sits at the boardroom table, folds his hands, and waits like a man who thinks he's already won the argument.","\n","#","^set_global:insider_confronted:true","/#","#","^set_global:insider_asset_arrested:true","/#","#","^exit_conversation","/#","done",null],"choice_hostile":["ev",true,"/ev",{"VAR=":"insider_confronted","re":true},"^Narrator: He steps back from the terminal.","\n","^Graham Reeves: Then we're past talking.","\n","^Graham Reeves: Everyone always is. Right up until the lights go out.","\n","#","^hostile:night_security_supervisor","/#","#","^set_global:insider_confronted:true","/#","#","^set_global:insider_hostile:true","/#","#","^set_global:insider_asset_arrested:true","/#","#","^exit_conversation","/#","done",null],"press_terminal_ambush":[["ev",true,"/ev",{"VAR=":"insider_confronted","re":true},"#","^set_global:insider_confronted:true","/#","#","^set_global:insider_ambushed:true"