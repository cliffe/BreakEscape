-{"inkVersion":21,"root":[[["done",{"#n":"g-0"}],null],"done",{"start":["ev",{"VAR?":"awaiting_ambush"},{"VAR?":"mission_complete"},"!","&&","/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"press_terminal_ambush"},{"->":"start.7"},null]}],"nop","\n","ev",{"VAR?":"insider_confronted"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"already_resolved"},{"->":"start.13"},null]}],"nop","\n","ev",{"VAR?":"insider_identified"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"confrontation"},{"->":"start.19"},null]}],"nop","\n","ev",{"CNT?":"cover_friendly"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"cover_return"},{"->":"start.25"},null]}],"nop","\n",{"->":"cover_friendly"},null],"cover_return":["^Graham Reeves: Still here. What can I do for you?","\n",{"->":"cover_hub"},null],"cover_friendly":["#","^set_global:reeves_known:true","/#","^Narrator: He stands beside the comms relay, hands loosely clasped, like a man who has stood in exactly that spot for a very long time and doesn't mind.","\n","^Graham Reeves: Evening. You'll be the consultant Dr Kim brought in.","\n","^Graham Reeves: Graham Reeves, night security supervisor. I've the comms watch while the systems are down.","\n","^Graham Reeves: Anything you want to send from that terminal comes through me first. Just process. It's a bad night for half a story getting out.","\n",{"->":"cover_hub"},{"#f":1}],"cover_hub":[["ev","str","^What are you guarding in here, and why no uniform?","/str",{"VAR?":"asked_guarding"},"!","/ev",{"*":".^.c-0","flg":5},"ev","str","^Somebody told security control I was never booked in. Any idea who?","/str",{"VAR?":"cover_burned"},{"VAR?":"cover_restored"},"!","&&",{"VAR?":"cover_probed"},"!","&&","/ev",{"*":".^.c-1","flg":5},"ev","str","^Ghost's log names badge SC-4471. That's this post's badge.","/str",{"VAR?":"cover_burned"},{"VAR?":"insider_badge_id_found"},"&&",{"VAR?":"inspected_asset_post"},"&&",{"VAR?":"insider_identified"},"!","&&","/ev",{"*":".^.c-2","flg":5},"ev","str","^Friday's 