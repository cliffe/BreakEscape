+{"inkVersion":21,"root":[[["done",{"#n":"g-0"}],null],"done",{"start":["ev",{"VAR?":"spoke_to_player"},"!","/ev",[{"->":".^.b","c":true},{"b":["\n","ev",true,"/ev",{"VAR=":"spoke_to_player","re":true},"^Ms Chen: You'll be the one they've brought in about the computers. ","#","^delivery: looking up from her book, mildly","/#","\n",{"->":"first_words"},{"->":"start.5"},null]}],"nop","\n","ev",{"VAR?":"spoke_to_player"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"hub"},{"->":"start.11"},null]}],"nop","\n",null],"first_words":[["^Ms Chen: The young doctor said \"ransomware\", as though the word explained itself.","\n","^Ms Chen: Forty years I taught in Edinburgh and never once had to think about it.","\n","ev","str","^We're working on it. Your own care isn't affected.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^How are you holding up?","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["\n","^Ms Chen: I believe the nurse about me.","\n","^Ms Chen: But Mrs Hargreaves in bed two is on that machine, and the screen above her has been off since three.","\n","^Ms Chen: I've been watching it for her. Sister cannot be in six places.","\n","ev",true,"/ev",{"VAR=":"hub_quiet","re":true},{"->":"hub"},{"#f":5}],"c-1":["\n","^Ms Chen: I've had my operation. Waiting I can do.","\n","^Ms Chen: If I were you, I'd worry about the ones who can't tell you they're in trouble.","\n","ev",true,"/ev",{"VAR=":"hub_quiet","re":true},{"->":"hub"},{"#f":5}]}],null],"hub":[["ev",{"VAR?":"hub_quiet"},"/ev",[{"->":".^.b","c":true},{"b":["\n","ev",false,"/ev",{"VAR=":"hub_quiet","re":true},{"->":"hub.0.5"},null]}],[{"->":".^.b"},{"b":["\n","^Ms Chen: Any progress, or are we still guessing?","\n",{"->":"hub.0.5"},null]}],"nop","\n","ev","str","^Thank you for watching the others.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^I'll let you rest.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","^Ms Chen: I'm in the same room as them. What else would I do?","\n","ev",true,"/ev",{"VAR=":"hub_quiet","re":true},{"->":"hub"},null],"c-1":["\n","^Ms Chen: Go and fix it, then.","\n","ev",true,"/ev",{"VAR=":"hub_quiet","re":true},"#","^exit_conversation","/#",{"->":"hub"},null]}],null],"global decl":["ev",false,{"VAR=":"spoke_to_player"},false,{"VAR=":"hub_quiet"},"/ev","end",null]}],"listDefs":{}}
