,"\n","ev",true,"/ev",{"VAR=":"asked_who","re":true},{"->":"back"},null]}],null],"back":["ev",true,"/ev",{"VAR=":"hub_quiet","re":true},{"->":"hub"},null],"hub":[["ev",{"VAR?":"hub_quiet"},"!","/ev",[{"->":".^.b","c":true},{"b":["\n","^Elena Rodriguez: ",["ev","visit",2,"%","/ev","ev","du",0,"==","/ev",{"->":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"nop",{"s0":["pop","^Ask. I can listen and type.",{"->":".^.^.17"},null],"s1":["pop","^I haven't moved. Neither have the tables.",{"->":".^.^.17"},null],"#f":5}],"\n",{"->":"hub.0.5"},null]}],"nop","\n","ev",false,"/ev",{"VAR=":"hub_quiet","re":true},"ev","str","^What were you told this was?","/str",{"VAR?":"asked_told"},"!","/ev",{"*":".^.c-0","flg":5},"ev","str","^Why does an engineer end up working for ENTROPY?","/str",{"VAR?":"asked_why"},"!","/ev",{"*":".^.c-1","flg":5},"ev","str","^You know what's coming. Why are you still in the building?","/str",{"VAR?":"asked_stayed"},"!","/ev",{"*":".^.c-2","flg":5},"ev","str","^Tell me about Mercer.","/str",{"VAR?":"asked_mercer"},"!","/ev",{"*":".^.c-3","flg":5},"ev","str","^The other three operations tonight. What were you told about them?","/str",{"VAR?":"asked_told"},{"VAR?":"revision_heard"},"!","&&","/ev",{"*":".^.c-4","flg":5},"ev","str","^I've read the casualty projection. His signature's on it.","/str",{"VAR?":"casualty_projection_found"},{"VAR?":"revision_heard"},"!","&&","/ev",{"*":".^.c-5","flg":5},"ev","str","^Help me stop it. You know this system and I don't.","/str",{"VAR?":"revision_heard"},{"VAR?":"elena_outcome"},"str","^","/str","==","&&","/ev",{"*":".^.c-6","flg":5},"ev","str","^You built this. Give me the control room or I take it out of you.","/str",{"VAR?":"revision_heard"},{"VAR?":"elena_outcome"},"str","^","/str","==","&&","/ev",{"*":".^.c-7","flg":5},"ev","str","^I need to keep moving.","/str","/ev",{"*":".^.c-8","flg":4},{"c-0":["\n",{"->":"q_told"},null],"c-1":["\n",{"->":"q_why"},null],"c-2":["\n",{"->":"q_stayed"},null],"c-3":["\n",{"->":"q_mercer"},null],"c-4":["\n",{"->":"lever_briefing"},null],"c-5":["\n",{"->":"lever_projection"},null],"c-6":["\n",{"->":"turn_offer"},null],"c-7":["\n",{"->":"pressure_break"},null],"c-8":["\n","^Elena Rodriguez: Yes. You do.","\n","#","^exit_conversation","/#",{"->":"back"},null]}],null],"q_told":["ev",true,"/ev",{"VAR=":"asked_told","re":true},"^Elena Rodriguez: Six hours. One region. Ten at night to four in the morning, on a Sunday in September, when nobody needs the heating.","\n","^Elena Rodriguez: It's December. It's below freezing out there.","\n","^Elena Rodriguez: Hospitals, dialysis, water treatment, all carved out. I asked about each one, and got a schedule with all three on it.","\n","^Elena Rodriguez: Long enough that the committee that's ignored this grid for eleven years would have to read about it. Nobody hurt.","\n","^Elena Rodriguez: That was the plan I agreed to. I have the version I signed off. It's on that laptop.","\n",{"->":"back"},null],"q_why":["ev",true,"/ev",{"VAR=":"asked_why","re":true},"^Elena Rodriguez: Because the grid really is that fragile. That part was never a lie. It's the part nobody wants to hear.","\n","^Elena Rodriguez: I wrote a cascade study in 2019. Twenty-three transformers. If the spares were gone, eighteen months to build replacements.","\n","^Elena Rodriguez: They found spares since. Four to seven days, this time. In December, that's long enough.","\n","^Elena Rodriguez: I sent it to the operator, the regulator and a congressional committee. One of them acknowledged receipt.","\n","^Elena Rodriguez: Then somebody read it properly. Asked me about page forty. Nobody had ever asked me about page forty.","\n","^Elena Rodriguez: That's how they get people like me. You'd think it was money.","\n",{"->":"back"},null],"q_stayed":["ev",true,"/ev",{"VAR=":"asked_stayed","re":true},"^Elena Rodriguez: Where would I go? There isn't a version of tonight where I'm not part of it.","\n","^Elena Rodriguez: I could be out of the parking lot in four minutes. I'd still have written the sequencing.","\n","^Elena Rodriguez: And there's a small chance. The load-shed tables decide who stays on. Get them back, and the hospitals stay lit whatever else goes.","\n","^Elena Rodriguez: It's a thin plan. The other one is feeling bad in a different building.","\n",{"->":"back"},null],"q_mercer":["ev",true,"/ev",{"VAR=":"asked_mercer","re":true},"^Elena Rodriguez: James Mercer. My professor's professor. Twenty years at the Department of Energy, until he said out loud what everyone said in the corridor.","\n","^Elena Rodriguez: He's the most convincing man I've ever met. I think he lied to himself first, and I was downstream.","\n","^Elena Rodriguez: He's in the control room, through the north door. He won't come out. He'd have to look at somebody who believed him.","\n","ev",{"VAR?":"scada_password_found"},"!",{"VAR?":"elena_outcome"},"str","^","/str","==","&&","/ev",[{"->":".^.b","c":true},{"b":["\n","^Elena Rodriguez: Don't ask me for the door. Not yet.","\n",{"->":".^.^.^.21"},null]}],"nop","\n",{"->":"back"},null],"lever_briefing":[["^Narrator: She stops working. For the first time, both her hands are still.","\n","^Elena Rodriguez: Told? Nothing. I was copied on their schedule. What were you told about Austin?","\n","ev","str","^The desk summary says ninety days dormant. No deaths projected.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Why Austin?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","ev",true,"/ev",{"VAR=":"told_ninety","re":true},{"->":"revision_beat"},null],"c-1":["\n",{"->":"revision_beat"},null]}],null],"lever_projection":["^Narrator: You hold out the projection. She reads all of it, standing.","\n","^Elena Rodriguez: My schedule had a hospital carve-out on page one.","\n","^Elena Rodriguez: Same document. Carve-out removed, signature added. He didn't argue with me. He gave me a different copy.","\n","^Elena Rodriguez: There's something else you need to see. Austin.","\n",{"->":"revision_beat"},null],"revision_beat":[["ev",true,"/ev",{"VAR=":"revision_heard","re":true},"#","^set_global:projection_revised:true","/#","^Elena Rodriguez: I was copied on the coordination summaries. All four cells, one schedule, so we didn't step on each other.","\n","^Elena Rodriguez: I read the Austin row because it was the boring one.","\n","^Elena Rodriguez: The dormancy field says T plus nine. Nine days. ","ev",{"VAR?":"told_ninety"},"/ev",[{"->":".^.b","c":true},{"b":["^ Same table your ninety came out of, one column over.",{"->":".^.^.^.17"},null]}],[{"->":".^.b"},{"b":["^The column next to it says ninety. That's the one somebody wanted read.",{"->":".^.^.^.17"},null]}],"nop","\n","^Elena Rodriguez: And I read the vendor manifest. Over a third of the entries are prefixed EHR or CAD.","\n","ev","str","^Assume I don't know what those prefixes mean.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Dispatch. As in 911 call routing.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","^Elena Rodriguez: Electronic health records. And computer-aided dispatch.","\n",{"->":"revision_dispatch"},null],"c-1":["\n","^Elena Rodriguez: Yes. Where every nine-one-one call goes first.","\n",{"->":"revision_dispatch"},null]}],null],"revision_dispatch":["^Elena Rodriguez: They hold signing keys for the systems that decide whether an ambulance comes, and where, and how fast.","\n","^Elena Rodriguez: Whoever wrote your brief didn't have the manifest, or was handed it by somebody who wanted it filed under strategic.","\n","^Elena Rodriguez: I spent six months telling myself I was the one operation where nobody dies. I wasn't even the worst one on the page.","\n","ev",{"VAR?":"found_coordination_traffic"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Elena Rodriguez: You've already pulled the traffic off that export, haven't you. Good. I'd rather not be your only source.","\n",{"->":".^.^.^.11"},null]}],[{"->":".^.b"},{"b":["\n","^Elena Rodriguez: It's on the backup server, on a share nobody locked down. Read it yourself. Don't take it from me.","\n",{"->":".^.^.^.11"},null]}],"nop","\n","ev",{"VAR?":"team_assigned"},{"VAR?":"team_assignment"},"str","^trojan_horse","/str","!=","&&",{"VAR?":"redirect_window_closed"},"!","&&","/ev",[{"->":".^.b","c":true},{"b":["\n","^Elena Rodriguez: If you've already sent people somewhere tonight, you sent them on those numbers.","\n",{"->":".^.^.^.26"},null]}],"nop","\n","ev",{"VAR?":"team_assigned"},{"VAR?":"team_assignment"},"str","^trojan_horse","/str","!=","&&",{"VAR?":"redirect_window_closed"},"&&","/ev",[{"->":".^.b","c":true},{"b":["\n","^Elena Rodriguez: You've already sent them, haven't you. I'm sorry. I'd rather have known this in June.","\n",{"->":".^.^.^.40"},null]}],"nop","\n","ev",{"VAR?":"team_assignment"},"str","^trojan_horse","/str","==","/ev",[{"->":".^.b","c":true},{"b":["\n","^Elena Rodriguez: If your people are in Austin, they're in the right place. Tell them about dispatch.","\n",{"->":".^.^.^.50"},null]}],"nop","\n",{"->":"back"},null],"turn_offer":[["^Elena Rodriguez: You know what you're asking. Help you, and there's no version of my life after this that isn't a courtroom.","\n","ev","str","^I'm not going to pretend otherwise. There isn't.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Then do it for the reason you wrote page forty.","/str",{"VAR?":"asked_why"},"/ev",{"*":".^.c-1","flg":5},"ev","str","^Nine days. Dispatch systems. Decide.","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["\n","^Elena Rodriguez: No. There isn't. Thank you for not making it sound like a deal.","\n",{"->":"turn_yes"},null],"c-1":["\n","^Elena Rodriguez: That's a cheap thing to say to me.","\n","^Elena Rodriguez: It's also the only true thing anyone's said in this building since Thursday.","\n",{"->":"turn_yes"},null],"c-2":["\n","^Narrator: She does not answer for a long moment. Then she closes the laptop and stands up.","\n",{"->":"turn_yes"},null]}],null],"turn_yes":["ev","str","^turned","/str","/ev",{"VAR=":"elena_outcome","re":true},"#","^set_global:elena_outcome:turned","/#","#","^set_global:scada_password_found:true","/#","ev",true,"/ev",{"VAR=":"gave_keys","re":true},"^Narrator: She flattens a folded worksheet against the rack.","\n","^Elena Rodriguez: Control room door: CascadeWindow19, capitals exactly as I've written them. He's too vain to change it twice.","\n","^Elena Rodriguez: Mercer's tech reset the vault keypad after my survey. The plant log's out of date.","\n","^Elena Rodriguez: The new code is the last four of the serial on the transfer switch plate.","\n","^Elena Rodriguez: The trunk runs are down there. That's where the physical half of this got in.","\n","^Elena Rodriguez: He'll be at the master console. He won't be armed. He'll want to explain.","\n",{"->":"post_turn_back"},null],"post_turn_back":["ev",true,"/ev",{"VAR=":"hub_quiet","re":true},{"->":"post_turn_hub"},null],"post_turn_hub":[["ev",{"VAR?":"hub_quiet"},"!","/ev",[{"->":".^.b","c":true},{"b":["\n","^Elena Rodriguez: ",["ev","visit",2,"%","/ev","ev","du",0,"==","/ev",{"->":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"nop",{"s0":["pop","^The tables are coming back. Slowly.",{"->":".^.^.17"},null],"s1":["pop","^What else?",{"->":".^.^.17"},null],"#f":5}],"\n",{"->":".^.^.^.5"},null]}],"nop","\n","ev",false,"/ev",{"VAR=":"hub_quiet","re":true},"ev","str","^Give me the control room door and the vault code again.","/str",{"VAR?":"scada_door_reached"},{"VAR?":"vault_entered"},"&&","!","/ev",{"*":".^.c-0","flg":5},"ev","str","^What do I say to him?","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^What happens to you after tonight?","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^Stay on the load-shed tables. Keep the hospitals lit.","/str","/ev",{"*":".^.c-3","flg":4},"ev","str","^Go. Get out of the building.","/str","/ev",{"*":".^.c-4","flg":4},{"c-0":["\n","^Elena Rodriguez: CascadeWindow19, capitals as written. The vault code is the last four of the serial on the transfer switch plate.","\n",{"->":"post_turn_back"},null],"c-1":["\n","^Elena Rodriguez: Nothing that sounds like a negotiation. He's better at those than you are.","\n","^Elena Rodriguez: Ask him what the carve-out page says. He'll answer, because he can't help it, and then you'll both know.","\n",{"->":"post_turn_back"},null],"c-2":["\n","^Elena Rodriguez: I tell somebody with a recorder everything I know, for as long as they want. Then I go where they put me.","\n","^Elena Rodriguez: Don't call it brave. It's the only door left I don't have to lie my way through.","\n",{"->":"post_turn_back"},null],"c-3":["\n","^Elena Rodriguez: That was the plan anyway. It helps, being told.","\n","^Narrator: She is back on the floor beside the rack before you reach the door.","\n","#","^exit_conversation","/#",{"->":"post_turn_back"},null],"c-4":["\n","^Elena Rodriguez: I'll go when the tables are back. Not before.","\n","#","^exit_conversation","/#",{"->":"post_turn_back"},null]}],null],"pressure_break":[["^Narrator: She is on her feet before you finish, back against the rack.","\n","^Elena Rodriguez: No. No, you don't get to do that. Not you as well.","\n","^Elena Rodriguez: That's what he did. Put a number in front of me and told me what I owed. You've just done it with a different number.","\n","ev","str","^That wasn't a threat. Sit down.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^I don't have time to be gentle with you.","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^(Say nothing.)","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["\n",{"->":"pressure_recover"},null],"c-1":["\n",{"->":"flee"},null],"c-2":["\n","^Narrator: The silence goes on a beat too long, and she reads it.","\n",{"->":"flee"},null]}],null],"pressure_recover":[["^Elena Rodriguez: Yes, it was. You just didn't mean it.","\n","^Narrator: She stays standing, but her shoulders come down a fraction.","\n","^Elena Rodriguez: Ask me again. Properly. If I say no, you leave me at this rack.","\n","ev","str","^Help me stop it. You know this system and I don't.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Then stay at the rack. I'll do the rest.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"turn_offer"},null],"c-1":["\n","ev","str","^turned","/str","/ev",{"VAR=":"elena_outcome","re":true},"#","^set_global:elena_outcome:turned","/#","#","^set_global:scada_password_found:true","/#","ev",true,"/ev",{"VAR=":"gave_keys","re":true},"^Elena Rodriguez: Control room door is CascadeWindow19, capitals as written. Vault code is the last four of the serial on the transfer switch plate.","\n","^Elena Rodriguez: That's everything I have. Go.","\n",{"->":"post_turn_back"},null]}],null],"flee":["ev","str","^fled","/str","/ev",{"VAR=":"elena_outcome","re":true},"#","^set_global:elena_outcome:fled","/#","^Narrator: She goes sideways along the rack row, fast. She has walked this room in the dark a hundred times.","\n","^Elena Rodriguez: The tables are still read-only. Somebody has to fix that and it isn't going to be you.","\n","^Narrator: The service door swings. The stairwell is empty both ways.","\n","#","^exit_conversation","/#",{"->":"already_gone"},null],"already_gone":[["^Narrator: Her laptop lies by the backup rack, screen dark. The load-shed tables are half done.","\n","ev","str","^Nothing to find here.","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["\n","^Narrator: The half-finished tables stay as she left them.","\n","#","^exit_conversation","/#",{"->":".^.^.^"},null]}],null],"already_down":[["^Narrator: She is face down beside the backup rack, breathing. On the laptop by her hand, a hospital priority column, half put back.","\n","ev","str","^Leave her.","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["\n","#","^exit_conversation","/#",{"->":".^.^.^"},null]}],null],"global decl":["ev","str","^","/str",{"VAR=":"elena_outcome"},false,{"VAR=":"elena_ko"},false,{"VAR=":"projection_revised"},"str","^","/str",{"VAR=":"team_assignment"},false,{"VAR=":"team_assigned"},f