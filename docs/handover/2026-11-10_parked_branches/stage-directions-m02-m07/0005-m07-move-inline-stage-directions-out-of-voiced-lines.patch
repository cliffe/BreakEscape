-{"inkVersion":21,"root":[[["done",{"#n":"g-0"}],null],"done",{"start":["ev",{"VAR?":"mercer_fate"},"str","^","/str","!=","/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"already_resolved"},{"->":"start.8"},null]}],"nop","\n","ev",{"VAR?":"stance_taken"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"hub"},{"->":"start.14"},null]}],"nop","\n","#","^complete_task:confront_mercer","/#","ev",{"VAR?":"grid_saved"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Narrator: The control room is warm and quiet. One man at the master console, hands flat on the desk. His screen says ABORT ACCEPTED.","\n","^Dr. James Mercer: You took it off me at that console. I sat here and watched you do it.","\n",{"->":"start.24"},null]}],[{"->":".^.b"},{"b":["\n","^Narrator: The control room is warm and quiet. One man at the master console, sleeves turned back, typing. He does not stop when the door opens.","\n","^Dr. James Mercer: You're early. Not by much.","\n",{"->":"start.24"},null]}],"nop","\n","^Dr. James Mercer: James Mercer. I'd offer a hand, but you'd refuse it and we'd both be embarrassed.","\n","ev",{"VAR?":"countdown_expired"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Dr. James Mercer: You'll have noticed the schedule has passed its mark. It was never going to wait for a conversation.","\n",{"->":"start.32"},null]}],"nop","\n","^Dr. James Mercer: Sit if you like. You've walked a long way through my building.","\n",{"->":"stance_gate"},null],"stance_gate":[["ev",{"VAR?":"grid_saved"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Dr. James Mercer: There's no clock now, so we can be honest. Tell me how you've decided to hold this.","\n",{"->":".^.^.^.5"},null]}],[{"->":".^.b"},{"b":["\n","^Dr. James Mercer: Before you start. Tell me how you've decided to hold this. It changes how long it takes.","\n",{"->":".^.^.^.5"},null]}],"nop","\n","ev","str","ev",{"VAR?":"grid_saved"},"/ev",[{"->":".^.b","c":true},{"b":["^You were going to kill hundreds of people tonight, and you knew the number.",{"->":".^.^.^.14"},null]}],[{"->":".^.b"},{"b":["^You're going to kill hundreds of people tonight and you know the number.",{"->":".^.^.^.14"},null]}],"nop","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","ev",{"VAR?":"grid_saved"},"/ev",[{"->":".^.b","c":true},{"b":["^I want to understand the reasoning. Talk me through it.",{"->":".^.^.^.25"},null]}],[{"->":".^.b"},{"b":["^I want to understand the reasoning before I stop it. Talk me through it.",{"->":".^.^.^.25"},null]}],"nop","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^(Say nothing. Let him fill the silence.)","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["\n","ev",true,"/ev",{"VAR=":"stance_taken","re":true},"ev","str","^condemned","/str","/ev",{"VAR=":"mercer_stance","re":true},"#","^set_global:mercer_stance:condemned","/#","^Dr. James Mercer: Good. That's clean. I prefer it to the other thing.","\n","^Dr. James Mercer: The other thing is being told I don't really mean it. That underneath I'm frightened, or sorry.","\n","^Dr. James Mercer: It's insulting, and it wastes time.","\n",{"->":"back"},null],"c-1":["\n","ev",true,"/ev",{"VAR=":"stance_taken","re":true},"ev","str","^reasoned","/str","/ev",{"VAR=":"mercer_stance","re":true},"#","^set_global:mercer_stance:reasoned","/#","^Dr. James Mercer: Then you're the first in eleven years.","\n","^Dr. James Mercer: Understanding it won't change it. I'd rather you didn't expect it to.","\n","^Dr. James Mercer: People come away thinking they've found the loose thread. There isn't one. I've looked.","\n",{"->":"back"},null],"c-2":["\n","ev",true,"/ev",{"VAR=":"stance_taken","re":true},"ev","str","^silent","/str","/ev",{"VAR=":"mercer_stance","re":true},"#","^set_global:mercer_stance:silent","/#","^Narrator: The display on the wall behind him hums. He waits as well.","\n","^Dr. James Mercer: All right. It's a decent technique. It won't work on me, but I'll take the invitation.","\n","^Dr. James Mercer: I spent twenty years being listened to politely by people who had already decided. I know what silence in a room means.","\n",{"->":"back"},null]}],null],"back":["ev",true,"/ev",{"VAR=":"hub_quiet","re":true},{"->":"hub"},null],"hub":[["ev",{"VAR?":"hub_quiet"},"!",{"VAR?":"stance_taken"},"&&","/ev",[{"->":".^.b","c":true},{"b":["\n","ev",{"VAR?":"grid_saved"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Dr. James Mercer: Back. There's nothing left on that console for either of us.","\n",{"->":".^.^.^.6"},null]}],[{"->":".^.b"},{"b":["\n","^Dr. James Mercer: Back. The console hasn't changed its mind either.","\n",{"->":".^.^.^.6"},null]}],"nop","\n",{"->":"hub.0.7"},null]}],"nop","\n","ev",false,"/ev",{"VAR=":"hub_quiet","re":true},"ev","str","^Why the grid? You could have published. You could have testified.","/str",{"VAR?":"heard_the_lesson"},"!","/ev",{"*":".^.c-0","flg":5},"ev","str","ev",{"VAR?":"grid_saved"},"/ev",[{"->":".^.b","c":true},{"b":["^How many people were going to die tonight?",{"->":"hub.0.28"},null]}],[{"->":".^.b"},{"b":["^How many people die tonight?",{"->":"hub.0.28"},null]}],"nop","/str",{"VAR?":"heard_the_numbers"},"!","/ev",{"*":".^.c-1","flg":5},"ev","str","ev",{"VAR?":"elena_outcome"},"str","^turned","/str","==","/ev",[{"->":".^.b","c":true},{"b":["^Elena says to ask you what the carve-out page says.",{"->":"hub.0.45"},null]}],[{"->":".^.b"},{"b":["ev",{"VAR?":"elena_outcome"},"str","^","/str","!=","/ev",[{"->":".^.b","c":true},{"b":["^Elena Rodriguez thought this was a six-hour demonstration with nobody hurt.",{"->":".^.^.^.9"},null]}],[{"->":".^.b"},{"b":["^Elena Rodriguez thinks this is a six-hour demonstration with nobody hurt.",{"->":".^.^.^.9"},null]}],"nop",{"->":"hub.0.45"},null]}],"nop","/str",{"VAR?":"elena_met"},{"VAR?":"heard_elena"},"!","&&","/ev",{"*":".^.c-2","flg":5},"ev","str","^I've got your projection here. Read it back to me.","/str",{"VAR?":"casualty_projection_found"},{"VAR?":"showed_him_the_page"},"!","&&","/ev",{"*":".^.c-3","flg":5},"ev","str","^Four operations, one schedule, doctor. They're there to keep us busy. So are you.","/str",{"VAR?":"found_coordination_traffic"},{"VAR?":"mercer_told_diversion"},"!","&&","/ev",{"*":".^.c-4","flg":5},"ev","str","^Doctor, this ends here. How do you want it to end?","/str","/ev",{"*":".^.c-5","flg":4},"ev","str","^I've heard enough of you for now.","/str","/ev",{"*":".^.c-6","flg":4},{"c-0":["\n",{"->":"topic_lesson"},null],"c-1":["\n",{"->":"topic_numbers"},null],"c-2":["\n",{"->":"topic_elena"},null],"c-3":["\n",{"->":"topic_the_page"},null],"c-4":["\n",{"->":"topic_diversion"},null],"c-5":["\n",{"->":"resolution"},null],"c-6":["\n","ev",{"VAR?":"grid_saved"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Dr. James Mercer: Take your time. There's nothing left for either of us to hurry for.","\n",{"->":".^.^.^.6"},null]}],[{"->":".^.b"},{"b":["\n","^Dr. James Mercer: Take your time. I'm not going anywhere until the sequence does.","\n",{"->":".^.^.^.6"},null]}],"nop","\n","ev",true,"/ev",{"VAR=":"hub_quiet","re":true},"#","^exit_conversation","/#",{"->":"hub"},null]}],null],"topic_lesson":[["ev",true,"/ev",{"VAR=":"heard_the_lesson","re":true},"^Dr. James Mercer: I did publish. Four papers, two of them still cited. I gave evidence to two committees. The same submission went in twice in eight years.","\n","^Dr. James Mercer: Each time it was costed, deferred and declined by people who couldn't tell you what a phase angle was.","\n","^Dr. James Mercer: In 2019 a solar storm came within ninety minutes of taking the western grid down on its own, and nobody wrote a word about it.","\n","^Dr. James Mercer: The system doesn't respond to argument. It responds to consequence.","\n","^Dr. James Mercer: So I stopped arguing.","\n","ev","str","^That is a very long way to walk to reach murder.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^You wanted to be right more than you wanted to be listened to.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","^Dr. James Mercer: It's a very long way to walk to reach anything. That's what the length is for.","\n",{"->":"back"},null],"c-1":["\n","^Dr. James Mercer: No. I wanted to be listened to for eight years. Being right was what I had left.","\n",{"->":"back"},null]}],null],"topic_numbers":[["ev",true,"/ev",{"VAR=":"heard_the_numbers","re":true},"^Dr. James Mercer: Two hundred and forty at the low end. Three hundred and eighty-five at the high.","\n","^Dr. James Mercer: Hospitals, roads with no signals, old people in cold apartments. The breakdown is on the page.","\n","^Dr. James Mercer: Restoration is four to seven days, because nobody stocks transformers of that class. Which is itself the finding.","\n","ev","str","^You memorised them.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","ev",{"VAR?":"grid_saved"},"/ev",[{"->":".^.b","c":true},{"b":["^And you would have done it.",{"->":".^.^.^.23"},null]}],[{"->":".^.b"},{"b":["^And you are going to do it anyway.",{"->":".^.^.^.23"},null]}],"nop","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","^Dr. James Mercer: I wrote them. It would be a strange sort of cowardice to write them and then decline to know them.","\n",{"->":"back"},null],"c-1":["\n","^Dr. James Mercer: Yes.","\n",{"->":"back"},null]}],null],"topic_elena":[["ev",true,"/ev",{"VAR=":"heard_elena","re":true},"ev",{"VAR?":"elena_outcome"},"str","^turned","/str","==","/ev",[{"->":".^.b","c":true},{"b":["\n","^Dr. James Mercer: She's told you, then. I did wonder which way she'd go once somebody was kind to her.","\n","^Dr. James Mercer: Page one of her copy had the carve-out. Mine didn't.","\n",{"->":".^.^.^.13"},null]}],[{"->":".^.b"},{"b":["\n","^Dr. James Mercer: Elena. Yes.","\n",{"->":".^.^.^.13"},null]}],"nop","\n","^Dr. James Mercer: She had the outage model and the restoration curve. Both accurate. She didn't have the human-cost annex.","\n","^Dr. James Mercer: She'd have refused. I needed a substation engineer, not a conscience.","\n","ev","str","^You lied to her.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^She thought nobody would be hurt. You let her believe that.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","^Dr. James Mercer: I withheld from her. She'd say lied. On the balance of it I'd let her have the word.","\n","^Dr. James Mercer: I don't think worse of her. She can't carry the number. Most people can't. That's why most people don't get to decide.","\n",{"->":"back"},null],"c-1":["\n","^Dr. James Mercer: She thought it because I arranged the documents so she could. Yes.","\n","^Dr. James Mercer: You'll want to make that an accusation. Make it. It's accurate.","\n",{"->":"back"},null]}],null],"topic_the_page":[["ev",true,"/ev",{"VAR=":"showed_him_the_page","re":true},"^Narrator: You put the projection on the console beside his hand. His signature, his date, his handwriting along the foot of the page.","\n","^Dr. James Mercer: \"Twice now the warnings have been costed and declined. This is the third submission. It will be read.\"","\n","^Dr. James Mercer: I was rather pleased with that line. It's still true.","\n","^Dr. James Mercer: You brought it to make me look at it. I've looked at it more than you have.","\n","^Dr. James Mercer: I costed the hypothermia column myself. The modeller kept rounding down, and I thought that was dishonest.","\n","ev","str","^Then you'll say that in a room with a stenographer in it.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Call it a submission if you like. It's a spreadsheet of the dead.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","^Dr. James Mercer: Now that is an interesting offer.","\n",{"->":"back"},null],"c-1":["\n","^Dr. James Mercer: Those aren't different things. That's what I've been trying to tell you.","\n",{"->":"back"},null]}],null],"topic_diversion":[["ev",true,"/ev",{"VAR=":"mercer_told_diversion","re":true},"#","^set_global:mercer_told_diversion:true","/#","^Dr. James Mercer: I'm aware there are other operations. I am nobody's distraction.","\n","^Narrator: He pulls the coordination window up on the console himself, and reads it.","\n","^Dr. James Mercer: This is a scheduling artefact. Cells share infrastructure. It doesn't follow.","\n","^Narrator: He reads it again.","\n","^Dr. James Mercer: The lesson stands whether or not somebody else found it convenient. The grid is still fragile. The number is still the number.","\n","ev","str","^It stands. It just isn't yours. You were the noise.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^He needed somebody who'd sign the page. That's all you were for.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","^Dr. James Mercer: Then he chose well. I'd have been very hard to use for anything small.","\n",{"->":"back"},null],"c-1":["\n","^Dr. James Mercer: I'd like you to know that I would have done it regardless.","\n",{"->":"back"},null]}],null],"resolution":["ev",{"VAR?":"grid_saved"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Dr. James Mercer: End what? You put the abort through while I sat here. There's nothing left running.","\n",{"->":"resolution_choices"},{"->":".^.^.^.4"},null]}],"nop","\n","^Dr. James Mercer: End it how? This chair takes no abort while the host drives it, and the sequence doesn't care what happens to me.","\n","^Dr. James Mercer: I built it that way so I couldn't be leaned on.","\n","^Dr. James Mercer: You don't need me. That's the part everyone gets wrong. You need the host in the server hall.","\n","ev",{"VAR?":"flag4_submitted"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Dr. James Mercer: Which you appear to have reached. My job is gone from the schedule. Well done, genuinely.","\n",{"->":".^.^.^.16"},null]}],"nop","\n",{"->":"resolution_choices"},null],"resolution_choices":[["^Dr. James Mercer: So. Your decision, not mine.","\n","ev","str","^Sit down, doctor. The police are on the stairs.","/str",{"VAR?":"mercer_told_diversion"},"/ev",{"*":".^.c-0","flg":5},"ev","str","^On the record, doctor. Your name, your page, your words.","/str",{"VAR?":"casualty_projection_found"},"/ev",{"*":".^.c-1","flg":5},"ev","str","^Away from the console, or I put you on the floor. (Fight him.)","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^Go on. Walk out. You're not the emergency tonight.","/str","/ev",{"*":".^.c-3","flg":4},"ev","str","^Not yet. I've something else to ask you.","/str",{"f()":"topics_left"},"/ev",{"*":".^.c-4","flg":5},"ev","str","^Not yet. (Leave him for now.)","/str",{"f()":"topics_left"},"!","/ev",{"*":".^.c-5","flg":5},{"c-0":["\n",{"->":"ending_hollowed"},null],"c-1":["\n",{"->":"ending_record"},null],"c-2":["\n",{"->":"ending_hostile"},null],"c-3":["\n",{"->":"ending_walks"},null],"c-4":["\n","^Dr. James Mercer: By all means.","\n",{"->":"back"},null],"c-5":["\n","^Dr. James Mercer: ","ev",{"VAR?":"grid_saved"},"/ev",[{"->":".^.b","c":true},{"b":["^Take your time. There's nothing left for either of us to hurry for.",{"->":".^.^.^.7"},null]}],[{"->":".^.b"},{"b":["^Take your time. I'm not going anywhere until the sequence does.",{"->":".^.^.^.7"},null]}],"nop","\n","ev",true,"/ev",{"VAR=":"hub_quiet","re":true},"#","^exit_conversation","/#",{"->":"hub"},null]}],null],"topics_left":["ev",{"VAR?":"heard_the_lesson"},"!",{"VAR?":"heard_the_numbers"},"!","||",{"VAR?":"elena_met"},{"VAR?":"heard_elena"},"!","&&","||",{"VAR?":"casualty_projection_found"},{"VAR?":"showed_him_the_page"},"!","&&","||",{"VAR?":"found_coordination_traffic"},{"VAR?":"mercer_told_diversion"},"!","&&","||","/ev","~ret",null],"ending_record":["ev","str","^arrested","/str","/ev",{"VAR=":"mercer_fate","re":true},"#","^set_global:mercer_fate:arrested","/#","^Narrator: For the first time tonight, he looks surprised.","\n","^Dr. James Mercer: You'd let me speak. ... No. You'd let me be quoted. I know the difference.","\n","^Narrator: He unclips his facility badge, sets it on the console, and puts his hands where you can see them.","\n","^Dr. James Mercer: All right. On the record.","\n","^Dr. James Mercer: I'm agreeing because it suits me better than the alternative. Nothing you've said has moved me. Put that on the record too.","\n","^Narrator: Two state police officers come through the door. By the stairwell he is explaining transformer lead times to a man who did not ask.","\n","#","^exit_conversation","/#",{"->":"already_resolved"},null],"ending_hollowed":["ev","str","^arrested","/str","/ev",{"VAR=":"mercer_fate","re":true},"#","^set_global:mercer_fate:arrested","/#","^Narrator: He sits down, as though standing now needs a reason.","\n","ev",{"VAR?":"flag4_submitted"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Dr. James Mercer: Whatever you've done to the host, I didn't help you do it. I want you to be clear about that.","\n",{"->":".^.^.^.16"},null]}],[{"->":".^.b"},{"b":["\n","^Dr. James Mercer: The sequence still runs. I want you to be clear that I haven't stopped it and wouldn't.","\n",{"->":".^.^.^.16"},null]}],"nop","\n","^Narrator: He turns the chair towards the coordination window, still open on the screen.","\n","^Dr. James Mercer: Twenty years. Four papers. Three submissions. And a scheduling slot.","\n","^Narrator: He does not crumble. When the police arrive, he stands before they ask him to.","\n","^Dr. James Mercer: The grid is still fragile.","\n","^Narrator: He says it on the way out, the way a man checks for his keys.","\n","#","^exit_conversation","/#",{"->":"already_resolved"},null],"ending_hostile":["ev","str","^ko","/str","/ev",{"VAR=":"mercer_fate","re":true},"#","^set_global:mercer_fate:ko","/#","^Narrator: He stands. He is fifty-eight and not quick, and he comes towards you anyway. This is going to be a fight.","\n","^Dr. James Mercer: You've come a very long way to be one more person who won't listen.","\n","ev",{"VAR?":"flag4_submitted"},{"VAR?":"grid_saved"},"||","/ev",[{"->":".^.b","c":true},{"b":["\n","^Narrator: The console is behind him. The host is already yours, whatever happens in here.","\n",{"->":".^.^.^.20"},null]}],[{"->":".^.b"},{"b":["\n","^Narrator: The console is behind him. Whatever happens in here, the sequence still waits on the host in the server hall.","\n",{"->":".^.^.^.20"},null]}],"nop","\n","#","^hostile:james_mercer","/#","#","^exit_conversation","/#",{"->":"already_resolved"},null],"ending_walks":["ev","str","^escaped","/str","/ev",{"VAR=":"mercer_fate","re":true},"#","^set_global:mercer_fate:escaped","/#","^Dr. James Mercer: *a long pause* I'm sorry?","\n","ev",{"VAR?":"flag4_submitted"},{"VAR?":"grid_saved"},"||","/ev",[{"->":".^.b","c":true},{"b":["\n","^Dr. James Mercer: Ah. The host is yours. So I'm a man in a room with a signed piece of paper.","\n",{"->":".^.^.^.18"},null]}],[{"->":".^.b"},{"b":["\n","^Dr. James Mercer: Ah. It's decided on the host in the server hall, not by me. So I'm a man in a room with a signed piece of paper.","\n",{"->":".^.^.^.18"},null]}],"nop","\n","^Narrator: He takes his jacket from the chair, careful with the sleeves. At the door he stops.","\n","ev",{"VAR?":"flag4_submitted"},{"VAR?":"grid_saved"},"||","/ev",[{"->":".^.b","c":true},{"b":["\n","^Dr. James Mercer: It didn't happen tonight. When the fourth submission is declined, agent, somebody does this. It never had to be me.","\n",{"->":".^.^.^.29"},null]}],[{"->":".^.b"},{"b":["\n","^Dr. James Mercer: When the third submission is declined, agent, somebody does this. It never had to be me.","\n",{"->":".^.^.^.29"},null]}],"nop","\n","ev",{"VAR?":"flag4_submitted"},{"VAR?":"grid_saved"},"||","/ev",[{"->":".^.b","c":true},{"b":["\n","^Narrator: Then he is gone down the service stair, past a schedule that no longer has his sequence on it.","\n",{"->":".^.^.^.38"},null]}],[{"->":".^.b"},{"b":["\n","^Narrator: Then he is gone down the service stair, and the sequence carries on without him.","\n",{"->":".^.^.^.38"},null]}],"nop","\n","#","^exit_conversation","/#",{"->":"already_resolved"},null],"already_resolved":[["^Narrator: The console position is empty. The chair is still turned towards the door.","\n","ev","str","^Get to work.","/str","/ev",{"*":".^.c-0","flg":4},{"